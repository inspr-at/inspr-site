# inspr-at — environment template. Real values live in `.env` on csb1
# (gitignored). Generate fresh secrets per-deploy:
#
#   openssl rand -hex 16   → ZITADEL_MASTERKEY (32 chars exactly required)
#   openssl rand -hex 32   → COOKIE_KEY (64 hex chars = 32 bytes)
#   openssl rand -base64 24 | tr -d '=+/' → passwords
#
# OIDC_CLIENT_ID and OIDC_CLIENT_SECRET start as PLACEHOLDER_*; populate
# after Zitadel first-boot when the OIDC application is created (see
# docs/zitadel-bootstrap.md or auth/bootstrap-zitadel.sh).

# Zitadel — at-rest data crypto. EXACTLY 32 chars. Rotate = re-init.
ZITADEL_MASTERKEY=MasterkeyNeedsToBe32CharactersXX

# Zitadel — Postgres password (DB user "zitadel").
ZITADEL_POSTGRES_PASSWORD=changeme-strong-postgres-password

# Zitadel — initial admin (zitadel-admin@<instance>). Used for OIDC app
# bootstrap; rotate after via the console.
ZITADEL_ADMIN_PASSWORD=ChangemeAdmin1!

# inspr-auth — OIDC client credentials issued by Zitadel.
# Filled in by `auth/bootstrap-zitadel.sh` (or manually after creating
# the OIDC application in the Zitadel console).
OIDC_CLIENT_ID=PLACEHOLDER_set_after_bootstrap
OIDC_CLIENT_SECRET=PLACEHOLDER_set_after_bootstrap

# inspr-auth — HMAC session cookie key (64+ hex chars).
COOKIE_KEY=replace-with-openssl-rand-hex-32-output-please-do-not-use-this-string
