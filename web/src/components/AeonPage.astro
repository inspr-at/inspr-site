<script>
  // The lightbox: PhotoSwipe, bundled by Astro into a hashed module so
  // script-src 'self' covers it. Each [data-aeon-gallery] is one gallery.
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-aeon-gallery]",
    children: "a[data-aeon-shot]",
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.92,
    padding: { top: 28, bottom: 64, left: 28, right: 28 },
    wheelToZoom: true,
  });
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "custom-caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      onInit: (el, pswp) => {
        pswp.on("change", () => {
          const anchor = pswp.currSlide?.data?.element;
          el.textContent = anchor?.getAttribute("data-caption") ?? "";
        });
      },
    });
  });
  lightbox.on("beforeOpen", () => document.body.classList.add("lightbox-open"));
  lightbox.on("destroy", () => document.body.classList.remove("lightbox-open"));
  lightbox.init();
</script>

<script>
  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Reveal on scroll. Without IntersectionObserver or with reduced motion,
  // everything is simply visible.
  const initReveal = () => {
    const items = [...document.querySelectorAll<HTMLElement>(".aeon [data-reveal]")];
    if (!("IntersectionObserver" in window) || reduceMotion()) {
      items.forEach((item) => item.classList.add("is-in"));
      return;
    }
    document.documentElement.classList.add("aeon-reveal-ready");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-in");
        observer.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.12 });
    items.forEach((item) => observer.observe(item));
  };

  // The AEON specs. Hover or keyboard focus on a card fades its image in as
  // the section's background at 20%; click or tap fades the cards out and
  // opens a full-screen carousel on that capability: a dialog with prev/next
  // glass buttons, arrow keys, swipe, Escape, an inert page behind it, a
  // focus trap and focus returned to the card. All twenty images decode once
  // the section comes near, so both are instant.
  const initSpecsCarousel = () => {
    const root = document.querySelector<HTMLElement>(".specs--aeon");
    const grid = root?.querySelector<HTMLElement>(".specs__grid");
    const carousel = root?.querySelector<HTMLElement>("[data-specs-carousel]");
    if (!root || !grid || !carousel) return;
    const html = document.documentElement;
    const reduced = reduceMotion();
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const tiles = [...root.querySelectorAll<HTMLElement>(".specs__tile[data-spec]")];
    const tileById = new Map(tiles.map((tile) => [tile.dataset.spec ?? "", tile]));
    const bgs = new Map<string, HTMLImageElement>();
    root.querySelectorAll<HTMLImageElement>("[data-bg]").forEach((img) => bgs.set(img.dataset.bg ?? "", img));
    const slides = new Map<string, HTMLElement>();
    carousel.querySelectorAll<HTMLElement>("[data-slide]").forEach((slide) => slides.set(slide.dataset.slide ?? "", slide));
    const ticks = new Map<string, HTMLElement>();
    carousel.querySelectorAll<HTMLElement>("[data-tick]").forEach((tick) => ticks.set(tick.dataset.tick ?? "", tick));
    const order = [...slides.keys()];
    const indexEl = carousel.querySelector<HTMLElement>("[data-carousel-index]");
    const closeBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-close]");
    const motionBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-motion]");
    const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const tileOf = (target: EventTarget | null) =>
      target instanceof Element ? target.closest<HTMLElement>(".specs__tile[data-spec]") : null;

    // Entrance: tiles fade up as they scroll into view, in visual order.
    if (!reduced && "IntersectionObserver" in window) {
      root.classList.add("is-arming");
      const observer = new IntersectionObserver((entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .map((entry) => entry.target as HTMLElement)
          .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1))
          .forEach((tile, i) => {
            tile.style.setProperty("--i", String(i));
            tile.classList.add("is-in");
            observer.unobserve(tile);
          });
      }, { threshold: 0.2, rootMargin: "0px 0px -4% 0px" });
      tiles.forEach((tile) => observer.observe(tile));
    }

    // The light field only animates while the section is on screen.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        root.classList.toggle("is-offscreen", !entries.some((entry) => entry.isIntersecting));
      }, { rootMargin: "20% 0px" }).observe(root);
    }

    // Preload: within 1000px, fetch and decode every image.
    let warmed = false;
    const warm = () => {
      if (warmed) return;
      warmed = true;
      carousel.classList.add("is-warm");
      [...bgs.values(), ...carousel.querySelectorAll<HTMLImageElement>("img")].forEach((img) => {
        img.loading = "eager";
        img.decode().catch(() => {});
      });
    };
    if ("IntersectionObserver" in window) {
      const near = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        warm();
        near.disconnect();
      }, { rootMargin: "1000px 0px" });
      near.observe(root);
    } else {
      warm();
    }

    // ── Hover: the card's image as the section background ──
    let shown: string | null = null;
    const showBg = (id: string | null) => {
      if (id === shown) return;
      shown = id;
      bgs.forEach((img, key) => img.classList.toggle("is-active", key === id));
    };
    if (fine) {
      grid.addEventListener("pointerover", (event) => {
        const tile = tileOf(event.target);
        if (tile) showBg(tile.dataset.spec ?? null);
      });
      grid.addEventListener("pointerleave", () => showBg(null));
    }
    grid.addEventListener("focusin", (event) => {
      const tile = tileOf(event.target);
      if (!tile || !(event.target instanceof Element) || !event.target.matches(":focus-visible")) return;
      showBg(tile.dataset.spec ?? null);
    });
    grid.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && grid.contains(event.relatedTarget)) return;
      showBg(null);
    });

    // ── The carousel ──
    let current: string | null = null;
    let open = false;
    let opener: HTMLElement | null = null;
    let inerted: Element[] = [];
    let suppressHoverUntil = 0;
    let settleTimer = 0;

    const describe = (id: string) => {
      slides.forEach((slide, key) => {
        const on = key === id;
        slide.setAttribute("aria-hidden", String(!on));
        // Only the current slide takes focus, so the keyboard can scroll a
        // caption that overflows while page scrolling is locked.
        if (on) slide.tabIndex = 0;
        else slide.removeAttribute("tabindex");
        const img = slide.querySelector<HTMLImageElement>(".specs__slide-img");
        if (img) img.alt = on ? img.dataset.alt ?? "" : "";
      });
      carousel.setAttribute("aria-labelledby", `specs-carousel-title specs-slide-label-${id} specs-carousel-pos`);
      carousel.setAttribute("aria-describedby", `specs-slide-note-${id}`);
      if (indexEl) indexEl.textContent = id;
      ticks.forEach((tick, key) => tick.classList.toggle("is-current", key === id));
      // The pause button shows on a slide whose mark turns (never under
      // reduced motion, when it stands still); focus never stays on it
      // while it leaves.
      if (motionBtn) {
        const moving = !reduced && Boolean(slides.get(id)?.querySelector("[data-aeon-mark]"));
        if (!moving && document.activeElement === motionBtn) closeBtn?.focus({ preventScroll: true });
        motionBtn.hidden = !moving;
      }
    };

    // Slides move sideways in the direction of travel: the incoming one is
    // staged on the far side without a transition, then released. `force`
    // restores the whole state even for the slide already current, which
    // an open needs: a close leaves the last slide in place for its fade.
    const goTo = (id: string, direction: 1 | -1 | 0, force = false) => {
      const next = slides.get(id);
      if (!next || (id === current && !force)) return;
      // Focus on the outgoing slide follows to the incoming one, never
      // staying inside a slide that is about to be hidden.
      const outgoing = current ? slides.get(current) : undefined;
      const followFocus = Boolean(outgoing?.contains(document.activeElement));
      current = id;
      carousel.style.setProperty("--dir", String(direction));
      if (direction !== 0 && !reduced) {
        next.classList.add("is-staged");
        void next.offsetWidth;
        next.classList.remove("is-staged");
      }
      slides.forEach((slide, key) => slide.classList.toggle("is-current", key === id));
      next.scrollTop = 0;
      describe(id);
      if (followFocus) next.focus({ preventScroll: true });
    };

    const step = (delta: 1 | -1) => {
      if (!current) return;
      const index = order.indexOf(current);
      goTo(order[(index + delta + order.length) % order.length], delta);
    };

    const openCarousel = (id: string, from: HTMLElement | null) => {
      if (open) return;
      open = true;
      opener = from;
      window.clearTimeout(settleTimer);
      warm();
      showBg(null);
      goTo(id, 0, true);
      carousel.removeAttribute("inert");
      carousel.setAttribute("role", "dialog");
      carousel.setAttribute("aria-modal", "true");
      // Everything outside the dialog goes inert: every sibling on the way
      // up from the carousel to the body.
      inerted = [];
      for (let node: Element | null = carousel; node && node !== document.body; node = node.parentElement) {
        const parent: HTMLElement | null = node.parentElement;
        if (!parent) break;
        for (const sibling of Array.from(parent.children) as Element[]) {
          if (sibling !== node && !sibling.hasAttribute("inert")) {
            sibling.setAttribute("inert", "");
            inerted.push(sibling);
          }
        }
      }
      carousel.classList.add("is-open");
      root.classList.add("is-showing");
      html.classList.add("aeon-carousel");
      closeBtn?.focus({ preventScroll: true });
    };

    const closeCarousel = () => {
      if (!open) return;
      open = false;
      carousel.classList.remove("is-open");
      carousel.removeAttribute("role");
      carousel.removeAttribute("aria-modal");
      carousel.removeAttribute("aria-labelledby");
      carousel.removeAttribute("aria-describedby");
      inerted.forEach((node) => node.removeAttribute("inert"));
      inerted = [];
      html.classList.remove("aeon-carousel");
      slides.forEach((slide) => {
        slide.setAttribute("aria-hidden", "true");
        slide.removeAttribute("tabindex");
      });
      // Focus goes back to the card; neither that nor the browser's
      // synthetic hover under a resting pointer lights the background.
      suppressHoverUntil = performance.now() + 700;
      opener?.focus({ preventScroll: true });
      // Through the fade its controls leave the focus order and the
      // accessibility tree.
      carousel.setAttribute("inert", "");
      window.setTimeout(() => {
        if (!open) showBg(null);
      }, 0);
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        if (!open) {
          root.classList.remove("is-showing");
          slides.forEach((slide) => slide.classList.remove("is-current"));
          current = null;
        }
      }, reduced ? 0 : 800);
    };

    grid.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLElement>(".specs__open") : null;
      const tile = tileOf(button);
      if (!button || !tile) return;
      openCarousel(tile.dataset.spec ?? "", button);
    });
    if (fine) {
      grid.addEventListener("pointerover", (event) => {
        if (performance.now() < suppressHoverUntil) showBg(null);
      }, true);
    }
    closeBtn?.addEventListener("click", closeCarousel);
    // WCAG 2.2.2: the slide's decorative motion has a visible pause. The
    // choice stays for the whole visit to the carousel.
    motionBtn?.addEventListener("click", () => {
      const paused = carousel.dataset.motion !== "paused";
      if (paused) carousel.dataset.motion = "paused";
      else delete carousel.dataset.motion;
      motionBtn.toggleAttribute("data-paused", paused);
      motionBtn.setAttribute("aria-label", (paused ? motionBtn.dataset.labelPlay : motionBtn.dataset.labelPause) ?? "");
    });
    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));

    // Swipe.
    let swipeX: number | null = null;
    carousel.addEventListener("pointerdown", (event) => {
      if (!open || event.pointerType === "mouse") return;
      swipeX = event.clientX;
    });
    carousel.addEventListener("pointerup", (event) => {
      if (!open || swipeX === null) return;
      const dx = event.clientX - swipeX;
      swipeX = null;
      if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
    });
    carousel.addEventListener("pointercancel", () => {
      swipeX = null;
    });

    document.addEventListener("keydown", (event) => {
      if (!open) return;
      if (event.key === "Escape") {
        closeCarousel();
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        step(1);
      } else if (event.key === "Tab") {
        // Focus trap over the pause button (when shown), the close button,
        // the current slide (a scroll region) and the arrows, both ways.
        const slide = current ? slides.get(current) : undefined;
        const ring = [motionBtn && !motionBtn.hidden ? motionBtn : null, closeBtn, slide, prevBtn, nextBtn]
          .filter((el): el is HTMLElement => Boolean(el));
        if (!ring.length) return;
        const index = ring.indexOf(document.activeElement as HTMLElement);
        const target = event.shiftKey
          ? ring[(index - 1 + ring.length) % ring.length]
          : ring[(index + 1) % ring.length];
        event.preventDefault();
        target.focus();
      }
    });
  };

  // The screen theatre: accessible tabs with a guided tour that starts once
  // in view and stops at the first interaction.
  const initTheatre = () => {
    const root = document.querySelector<HTMLElement>("[data-theatre]");
    if (!root) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-theatre-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-theatre-panel]")];
    const dwell = 7000;
    let current = 0;
    let timer = 0;
    let playing = false;

    const select = (index: number, focus = false) => {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const selected = i === current;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        tab.classList.remove("is-running");
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== current;
      });
      if (focus) tabs[current].focus();
      if (playing) schedule();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      const tab = tabs[current];
      tab.classList.remove("is-running");
      void tab.offsetWidth;
      tab.style.setProperty("--dwell", `${dwell}ms`);
      tab.classList.add("is-running");
      timer = window.setTimeout(() => select(current + 1), dwell);
    };

    // WCAG 2.2.2: the tour has a visible pause. Any interaction also stops it
    // for good; only the toggle starts it again.
    const toggle = root.querySelector<HTMLButtonElement>("[data-theatre-toggle]");
    const toggleLabel = root.querySelector<HTMLElement>("[data-theatre-toggle-label]");
    const syncToggle = () => {
      if (!toggle || !toggleLabel) return;
      toggle.setAttribute("aria-pressed", String(!playing));
      toggleLabel.textContent = (playing ? toggle.dataset.labelPause : toggle.dataset.labelPlay) ?? "";
    };

    const stop = () => {
      playing = false;
      window.clearTimeout(timer);
      tabs.forEach((tab) => tab.classList.remove("is-running"));
      syncToggle();
    };

    toggle?.addEventListener("click", () => {
      if (playing) {
        stop();
      } else {
        playing = true;
        schedule();
        syncToggle();
      }
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        stop();
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1 };
        if (event.key in keys) {
          event.preventDefault();
          stop();
          select(current + keys[event.key], true);
        } else if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          stop();
          select(event.key === "Home" ? 0 : tabs.length - 1, true);
        }
      });
    });
    root.addEventListener("pointerenter", (event) => {
      if (!(event.target instanceof Element) || !event.target.closest("[data-theatre-toggle]")) stop();
    });
    root.addEventListener("focusin", (event) => {
      if (!(event.target instanceof Element) || !event.target.closest("[data-theatre-toggle]")) stop();
    });

    if (!reduceMotion() && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          playing = true;
          schedule();
          syncToggle();
          observer.disconnect();
        }
      }, { threshold: 0.5 });
      observer.observe(root);
      if (toggle) toggle.hidden = false;
    }
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
    });
  };

  // The hero's glass notes: a calm, continuous stream of what happens in AEON.
  // At most three show at once, each in its own place and long enough to read.
  const initChips = () => {
    const list = document.querySelector<HTMLElement>("[data-chips]");
    if (!list || reduceMotion()) return;
    const chips = [...list.querySelectorAll<HTMLElement>("[data-chip]")];
    const slots = [1, 2, 3, 4, 5, 6];
    // A new note every 3.7 s with three on screen: each one stays about 11 s.
    const CADENCE_MS = 3700;
    const shown = new Map<HTMLElement, number>();
    chips.forEach((chip, index) => { if (index < 3) shown.set(chip, index + 1); });
    let next = 3;
    let timer = 0;
    const hide = (chip: HTMLElement) => {
      chip.classList.remove("is-shown");
      chip.classList.add("is-leaving");
      window.setTimeout(() => {
        chip.classList.remove("is-leaving");
        slots.forEach((slot) => chip.classList.remove(`aeon-chip--slot-${slot}`));
        shown.delete(chip);
      }, 900);
    };
    const step = () => {
      const oldest = [...shown.keys()][0];
      if (oldest && shown.size >= 3) hide(oldest);
      const used = new Set(shown.values());
      const free = slots.filter((slot) => !used.has(slot) && slot !== (oldest ? shown.get(oldest) : 0));
      const slot = free[Math.floor(Math.random() * free.length)] ?? 1;
      const chip = chips[next % chips.length];
      next += 1;
      if (shown.has(chip)) return;
      chip.classList.add(`aeon-chip--slot-${slot}`);
      shown.set(chip, slot);
      requestAnimationFrame(() => chip.classList.add("is-shown"));
    };
    // The notes, the event ribbon and their float follow the hero loop, whose
    // visible Pause control (and its in-view and tab-visibility handling)
    // therefore pauses all hero motion (WCAG 2.2.2).
    const hero = list.closest<HTMLElement>(".aeon-hero");
    const video = hero?.querySelector<HTMLVideoElement>("[data-hero-video]");
    const run = () => {
      window.clearInterval(timer);
      timer = window.setInterval(step, CADENCE_MS);
      hero?.classList.remove("is-paused");
    };
    const pause = () => {
      window.clearInterval(timer);
      hero?.classList.add("is-paused");
    };
    if (!video) return;
    video.addEventListener("playing", run);
    video.addEventListener("pause", pause);
    if (video.paused) pause();
    else run();
  };

  // INSPR-498: a fine pointer tilts the glass mark slightly: --mx and --my in
  // -1..1 from the pointer to each visible mark's centre. Never under
  // reduced motion, and only while a mark is on screen.
  const initGlassMarks = () => {
    const marks = Array.from(document.querySelectorAll<HTMLElement>("[data-aeon-mark]"));
    if (!marks.length) return;
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let px = 0;
    let py = 0;
    const clamp = (value: number) => Math.max(-1, Math.min(1, value));
    const update = () => {
      frame = 0;
      if (!fine.matches || calm.matches) return;
      for (const mark of marks) {
        if (getComputedStyle(mark).visibility === "hidden") continue;
        const box = mark.getBoundingClientRect();
        if (!box.width || !box.height) continue;
        mark.style.setProperty("--mx", clamp((px - (box.left + box.width / 2)) / (window.innerWidth / 2)).toFixed(3));
        mark.style.setProperty("--my", clamp((py - (box.top + box.height / 2)) / (window.innerHeight / 2)).toFixed(3));
      }
    };
    document.addEventListener(
      "pointermove",
      (event) => {
        px = event.clientX;
        py = event.clientY;
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
  };

  initReveal();
  initChips();
  initSpecsCarousel();
  initGlassMarks();
  initTheatre();
</script>
