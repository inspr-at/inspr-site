---
/**
 * INSPR-492: the PAIMOS AEON release page at www.inspr.at/paimos-aeon.
 *
 * An iteration on the product-page system rather than a new one: the shared
 * header, hero loop, specs grid, source receipt and footer stay; the rest is
 * AEON's own story, told around the gold era arc from its mark. The page is
 * mounted below the www host, so every locale path and the brand link are
 * scoped to /paimos-aeon/ instead of a product host root.
 *
 * INSPR-497: the page at three levels (the header's Details switch). Level
 * ids stay simple, standard and technical; the switch names them Why, What
 * and How. What is the page as it was and the edition without JavaScript.
 * Blocks carry data-depth-min / data-depth-max; copy that changes sits in a
 * [data-copy-slot] with one child per level. The level map, pinned by
 * tests/paimos-aeon-levels-static.test.mjs:
 *
 *   section          Why                     What        How
 *   hero             lead: outcomes          as before   lead: the stack
 *     event ribbon   hidden                  shown       shown
 *   figures          3 (no log, no API)      all 5       all 5
 *   screens          lead: in daily use      as before   lead: technical
 *   specs            lead + card notes Why   as before   lead + card notes How
 *   control room     no pairing, no proof    as before   + How facts
 *   authority        no proof                as before   + How facts
 *   rules            hidden                  as before   + How facts
 *   delivery         no proof                as before   lead: technical
 *   architecture     hidden                  as before   + How facts
 *   what is coming   no "good to know"       as before   lead: technical
 *   open source      lead: outcomes          as before   lead: technical
 *   FAQ              answers Why, + servers  as before   answers How
 */
import { Image, getImage } from "astro:assets";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import MicrositeHeader from "./MicrositeHeader.astro";
import MicrositeFooter from "./MicrositeFooter.astro";
import ServiceRibbon from "./ServiceRibbon.astro";
import DetailLevels from "./DetailLevels.astro";
import ContextIcon from "./ContextIcon.astro";
import SpecsGrid, { type LensImage } from "./SpecsGrid.astro";
import HeroLoop from "./HeroLoop.astro";
import ProvenanceReceipt from "./ProvenanceReceipt.astro";
import AeonAuthority from "./AeonAuthority.astro";
import AeonJourney from "./AeonJourney.astro";
import AeonRulesPan from "./AeonRulesPan.astro";
import AeonReleasePlaque from "./AeonReleasePlaque.astro";
import AeonDeep from "./AeonDeep.astro";
import AeonText from "./AeonText.astro";
import type { AeonContent, AeonProof } from "../content/types";
import { siteUrls } from "../content/urls";
import captureManifest from "../assets/products/paimos-aeon/capture-manifest.json";
import "@fontsource-variable/geist/index.css";
import "../styles/aeon.css";
import "../styles/aeon-mark.css";

import aeonMark from "../assets/products/paimos/logo.svg";
import heroPoster from "../assets/products/paimos/hero.png";
import heroLoop from "../assets/products/paimos/hero-loop.mp4";
import sessionsDark from "../assets/products/paimos-aeon/sessions-dark.png";
import ticketsShot from "../assets/products/paimos-aeon/tickets.png";
import graphShot from "../assets/products/paimos-aeon/graph.png";
import knowledgeShot from "../assets/products/paimos-aeon/knowledge.png";
import usageShot from "../assets/products/paimos-aeon/usage.png";
import rulesShot from "../assets/products/paimos-aeon/rules.png";

interface Props {
  content: AeonContent;
  locale?: "en" | "de";
}

const { content } = Astro.props;
const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
// The same files serve paimos.inspr.at/ (canonical) and www.inspr.at/paimos/,
// so every in-page locale and home link is relative to the page itself.
const englishUrl = siteUrls.paimos;
const germanUrl = `${siteUrls.paimos}/de/`;
const localLinks = locale === "de" ? { en: "../", de: "./", home: "./" } : { en: "./", de: "de/", home: "./" };

const labels = locale === "de"
  ? {
      viewSource: "Quellcode ansehen",
      proof: "Nachweis im Quellcode",
      figuresAria: "AEON in Zahlen",
      detailsDescription: "Wie viel Detail diese Seite zeigt",
      detailsSimple: "Einfach",
      detailsTechnical: "Technisch",
      specsEli10: "Einfach erklärt",
      specsFlipAll: "Alle umdrehen",
      specsUnflipAll: "Alle zurückdrehen",
      specsShuffle: "Eckdaten-Raster mischen",
      lensLive: "Live-Ansicht, aeon.barta.cm",
      lensIllustration: "Illustration",
      lensWeb: "Öffentliches Repository, github.com",
      lensClose: "Schließen",
      lensPrev: "Vorherige Funktion",
      lensNext: "Nächste Funktion",
      lensDialog: "Funktion im Detail",
      lensMotionPause: "Bewegung anhalten",
      lensMotionPlay: "Bewegung fortsetzen",
      stepsAria: "Vom Schlüssel zur Berechtigung",
      tabsAria: "Ansichten der Live-Instanz",
      stagesAria: "Die acht Stufen einer Journey",
      layersAria: "Die sechs Regelebenen",
      stopsAria: "Zu einem Teil der Regelansicht springen",
      tourPause: "Tour pausieren",
      tourPlay: "Tour abspielen",
      panPause: "Bewegung pausieren",
      panResume: "Bewegung fortsetzen",
      panViewport: "Die Regelansicht von AEON, verschiebbar",
      panHint: "Ziehen, scrollen oder mit den Pfeiltasten bewegen. Die Schaltflächen darunter springen zu einem Abschnitt.",
      enterFull: "Vollbild",
      exitFull: "Vollbild beenden",
      layerLocked: "Gesperrte Regel",
      diagramAria: "Architektur von PAIMOS AEON",
      horizonAria: "Release-Zeitleiste",
      faqEyebrow: "Praktische Fragen",
      faqTitle: "Kurz gefragt.",
      ribbonAria: "Beispielhafte Ereignisse im Ereignisprotokoll",
      releaseAria: "Aktuelles Release",
      codename: "Codename",
    }
  : {
      viewSource: "View the source",
      proof: "Proof in the source",
      figuresAria: "AEON in figures",
      detailsDescription: "How much detail this page shows",
      detailsSimple: "Simple",
      detailsTechnical: "Technical",
      specsEli10: "ELI10 mode",
      specsFlipAll: "Flip all",
      specsUnflipAll: "Unflip all",
      specsShuffle: "Shuffle the specs grid",
      lensLive: "Live screen, aeon.barta.cm",
      lensIllustration: "Illustration",
      lensWeb: "Public repository, github.com",
      lensClose: "Close",
      lensPrev: "Previous capability",
      lensNext: "Next capability",
      lensDialog: "Capability in detail",
      lensMotionPause: "Pause motion",
      lensMotionPlay: "Play motion",
      stepsAria: "From key to grant",
      tabsAria: "Screens from the live instance",
      stagesAria: "The eight stages of a journey",
      layersAria: "The six rule layers",
      stopsAria: "Jump to a part of the rules view",
      tourPause: "Pause tour",
      tourPlay: "Play tour",
      panPause: "Pause motion",
      panResume: "Resume motion",
      panViewport: "The AEON rules view, draggable",
      panHint: "Drag, scroll or use the arrow keys to move it. The buttons below jump to a section.",
      enterFull: "Full screen",
      exitFull: "Exit full screen",
      layerLocked: "Locked rule",
      diagramAria: "PAIMOS AEON architecture",
      horizonAria: "Release timeline",
      faqEyebrow: "Practical questions",
      faqTitle: "In short.",
      ribbonAria: "Illustrative events in the event log",
      releaseAria: "Current release",
      codename: "Codename",
    };

const proofHref = (proof: AeonProof) => {
  const base = content.sourceTreeUrl.replace("/tree/", "/blob/");
  // Directories resolve through /tree/, files through /blob/.
  return /\.[a-z0-9]+$/i.test(proof.path)
    ? `${base}/${proof.path}`
    : `${content.sourceTreeUrl}/${proof.path}`;
};

// Full-resolution renditions for the lightbox; the captures are 2x.
const lightbox = async (image: ImageMetadata) => {
  const full = await getImage({ src: image, width: image.width, format: "webp", quality: 86 });
  return { src: full.src, width: image.width, height: image.height };
};
const shotImages: Record<string, ImageMetadata> = {
  tickets: ticketsShot,
  graph: graphShot,
  knowledge: knowledgeShot,
  usage: usageShot,
};
const screens = await Promise.all(
  content.theatre.screens.map(async (screen) => ({
    ...screen,
    image: shotImages[screen.id],
    full: await lightbox(shotImages[screen.id]),
  })),
);
const controlFull = await lightbox(sessionsDark);

// The capability lens: one image per capability, keyed by the NN prefix of
// src/assets/products/paimos-aeon/specs/NN-slug.{jpg,png,webp} in content
// order (01 to 20). Each image's kind (live screen, generated scene or public
// web page) comes from the capture manifest, the same record the capture gate
// verifies, so the caption's source line cannot drift from provenance.
const lensFiles = import.meta.glob<ImageMetadata>(
  "../assets/products/paimos-aeon/specs/*.{png,jpg,jpeg,webp}",
  { eager: true, import: "default" },
);
const lensKinds: Record<string, LensImage["kind"]> = { live: "live", generated: "art", "public-web": "web" };
const lensImages: LensImage[] = content.specs.items.map((item, i) => {
  const key = String(i + 1).padStart(2, "0");
  const hit = Object.entries(lensFiles).find(([path]) => path.includes(`/specs/${key}-`));
  if (!hit) throw new Error(`INSPR-492: missing lens image ${key} for "${item.label}" in src/assets/products/paimos-aeon/specs/`);
  const name = hit[0].slice(hit[0].indexOf("paimos-aeon/") + "paimos-aeon/".length);
  const recorded = captureManifest.files.find((file) => file.name === name);
  const kind = recorded ? lensKinds[recorded.kind] : undefined;
  if (!kind) throw new Error(`INSPR-492: lens image ${name} has no known kind in capture-manifest.json`);
  return { image: hit[1], kind };
});
// INSPR-498: the rotating glass mark goes into the centre of the generated
// scenes whose middle is open (a plaza or a cloud valley); a scene whose
// composition runs through the centre, and every live screen, stays clean.
const markSlugs = new Set(["capacity-routing", "tenant-isolation", "work-orders", "contract-first", "made-in-austria"]);
const markSlides = content.specs.items.flatMap((_, i) => {
  const key = String(i + 1).padStart(2, "0");
  const hit = Object.keys(lensFiles).find((path) => path.includes(`/specs/${key}-`));
  const slug = hit?.split(`/specs/${key}-`)[1]?.replace(/\.[a-z]+$/, "") ?? "";
  return markSlugs.has(slug) && lensImages[i]?.kind === "art" ? [key] : [];
});
const captionTail = content.theatre.note;

const ogImage = new URL(heroPoster.src, siteUrls.inspr).href;
// The canonical coordinate for the version chips (the tag carries a v).
const releaseVersion = content.release.version.replace(/^v/, "");
---

<MicrositeLayout
  title={content.seo.title}
  description={content.seo.description}
  canonical={content.canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  localePaths={{ en: localLinks.en, de: localLinks.de }}
  ogImage={ogImage}
  ogImageAlt={content.hero.alt}
  favicon={aeonMark.src}
  theme="paimos"
>
  <MicrositeHeader
    name={content.name}
    category={content.category}
    logo={aeonMark.src}
    active="paimos"
    homeHref={localLinks.home}
    nav={content.nav}
    locale={locale}
    languageLinks={{ en: localLinks.en, de: localLinks.de }}
    detailsSlider={{
      label: "Details",
      description: labels.detailsDescription,
      levels: [
        { id: "simple", label: labels.detailsSimple },
        { id: "standard", label: "Standard" },
        { id: "technical", label: labels.detailsTechnical },
      ],
    }}
  />

  <main id="main-content" class="aeon">
    <ServiceRibbon text={content.serviceIntro} locale={locale} />

    <!-- Hero: the agora loop under the era arc. -->
    <section class="aeon-hero" aria-labelledby="aeon-hero-title" data-section-pattern="era-hero">
      <div class="aeon-hero__grid page-shell">
        <div class="aeon-hero__copy">
          <p class="eyebrow aeon-hero__eyebrow">
            <span class="aeon-pulse" aria-hidden="true"></span>{content.hero.eyebrow} · <strong>{content.release.name}</strong>
          </p>
          <h1 id="aeon-hero-title">
            <span class="aeon-hero__title-lead">{content.hero.titleLead}</span>
            <em class="aeon-accent">{content.hero.titleAccent}</em>
          </h1>
          <p class="aeon-hero__lead" data-copy-slot>
            <DetailLevels
              simple={content.hero.depths.simple ?? content.hero.lead}
              standard={content.hero.lead}
              technical={content.hero.depths.technical ?? content.hero.lead}
            />
          </p>
          <div class="button-row">
            <a class="button" href={content.hero.primaryHref}>
              {content.hero.primaryLabel} <span aria-hidden="true">↓</span>
            </a>
            <a class="button button--ghost" href={content.repositoryUrl} target="_blank" rel="noopener noreferrer">
              {labels.viewSource} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <figure class="aeon-hero__stage">
          <svg class="aeon-hero__arc" viewBox="0 0 600 150" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="aeon-arc-gold" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#d69b31" stop-opacity="0.15" />
                <stop offset="0.5" stop-color="#e6b04c" />
                <stop offset="1" stop-color="#d69b31" stop-opacity="0.15" />
              </linearGradient>
            </defs>
            <!-- Apex at y 20 and ends at y 138: the whole stroke, glow included,
                 stays inside the viewBox, so no browser can clip it. -->
            <path class="aeon-hero__arc-glow" d="M30 138 A368 368 0 0 1 570 138" />
            <path class="aeon-hero__arc-line" d="M30 138 A368 368 0 0 1 570 138" />
          </svg>
          <div class="product-hero__visual aeon-hero__visual">
            <HeroLoop
              id="paimos"
              poster={heroPoster}
              video={heroLoop}
              alt={content.hero.alt}
              sizes="(min-width: 64rem) 52vw, 100vw"
              locale={locale}
            />
          </div>
          <ul class="aeon-chips" aria-hidden="true" data-chips>
            {content.hero.chips.map((chip, index) => (
              <li
                class:list={["aeon-chip", `aeon-chip--${chip.kind}`, index < 3 && `is-shown aeon-chip--slot-${index + 1}`]}
                data-chip
              >
                <span class="aeon-chip__dot"></span>
                <span class="aeon-chip__text">
                  <strong>{chip.label}</strong>
                  <small>{chip.detail}</small>
                </span>
              </li>
            ))}
          </ul>
        </figure>
      </div>

      <div class="page-shell aeon-hero__plaque">
        <AeonReleasePlaque release={content.release} mark={aeonMark.src} label={labels.releaseAria} locale={locale} />
      </div>

      <div class="aeon-ribbon" role="group" aria-label={labels.ribbonAria} data-section-pattern="event-ribbon" data-depth-min="standard">
        <p class="aeon-ribbon__label">{content.hero.ribbonLabel}</p>
        <div class="aeon-ribbon__track">
          <ol class="aeon-ribbon__list">
            {content.hero.ribbon.map((event, index) => (
              <li><span class="aeon-ribbon__seq">#{String(index + 1).padStart(3, "0")}</span>{event}</li>
            ))}
          </ol>
          <ol class="aeon-ribbon__list" aria-hidden="true">
            {content.hero.ribbon.map((event, index) => (
              <li><span class="aeon-ribbon__seq">#{String(index + 1).padStart(3, "0")}</span>{event}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Figures. -->
    <section class="aeon-figures page-shell" aria-label={labels.figuresAria} data-section-pattern="figure-ledger">
      <ol class="aeon-figures__list">
        {content.figures.map((figure) => (
          <li data-reveal data-flip data-depth-min={figure.depthMin}>
            <strong class="aeon-figures__value">{figure.value}</strong>
            <span class="aeon-figures__label">{figure.label}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Screens from the live instance, with a lightbox gallery. -->
    <section class="section aeon-theatre" id="screens" aria-labelledby="screens-title" data-section-pattern="screen-theatre" data-theatre>
      <div class="page-shell">
        <header class="aeon-theatre__head">
          <div>
            <p class="eyebrow">{content.theatre.eyebrow}</p>
            <h2 id="screens-title">{content.theatre.title}</h2>
          </div>
          <p class="section-lead" data-copy-slot>
            <DetailLevels
              simple={content.theatre.depths.simple}
              standard={content.theatre.lead}
              technical={content.theatre.depths.technical}
            />
          </p>
        </header>

        <div class="aeon-theatre__bar">
        <div class="aeon-tabs" role="tablist" aria-label={labels.tabsAria}>
          {screens.map((screen, index) => (
            <button
              type="button"
              role="tab"
              id={`aeon-tab-${screen.id}`}
              aria-controls={`aeon-panel-${screen.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
              class="aeon-tab"
              data-theatre-tab
            >
              <span class="aeon-tab__index">{String(index + 1).padStart(2, "0")}</span>
              <span>{screen.tab}</span>
              <span class="aeon-tab__progress" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <button
          type="button"
          class="aeon-motion-toggle"
          data-theatre-toggle
          aria-pressed="false"
          data-label-pause={labels.tourPause}
          data-label-play={labels.tourPlay}
          hidden
        >
          <span class="aeon-motion-toggle__icon" aria-hidden="true"></span>
          <span data-theatre-toggle-label>{labels.tourPause}</span>
        </button>
        </div>

        <div class="aeon-theatre__stage" data-aeon-gallery>
          {screens.map((screen, index) => (
            <div
              class="aeon-theatre__panel"
              role="tabpanel"
              id={`aeon-panel-${screen.id}`}
              aria-labelledby={`aeon-tab-${screen.id}`}
              data-theatre-panel
              hidden={index !== 0}
            >
              <a
                class="aeon-window aeon-shot"
                href={screen.full.src}
                target="_blank"
                rel="noopener"
                data-aeon-shot
                data-pswp-width={screen.full.width}
                data-pswp-height={screen.full.height}
                data-caption={`${screen.title} · ${captionTail}`}
              >
                <span class="aeon-window__bar" aria-hidden="true"><i></i><i></i><i></i><span>aeon.barta.cm</span></span>
                <Image
                  src={screen.image}
                  alt={screen.alt}
                  widths={[800, 1200, 1600, 2400]}
                  sizes="(min-width: 90rem) 88rem, 94vw"
                  format="webp"
                  quality={84}
                />
                <span class="aeon-shot__zoom" aria-hidden="true">{content.theatre.openLabel} ⤢</span>
              </a>
              <p class="aeon-theatre__caption"><strong>{screen.title}</strong> {screen.body}</p>
            </div>
          ))}
        </div>
        <p class="aeon-theatre__note">{content.theatre.note}</p>
      </div>
    </section>

    <SpecsGrid
      specs={content.specs}
      variant="aeon"
      groupLabels={content.specGroups}
      lens={{
        images: lensImages,
        labels: {
          live: labels.lensLive,
          illustration: labels.lensIllustration,
          web: labels.lensWeb,
          close: labels.lensClose,
          prev: labels.lensPrev,
          next: labels.lensNext,
          dialog: labels.lensDialog,
          motionPause: labels.lensMotionPause,
          motionPlay: labels.lensMotionPlay,
        },
        marks: markSlides,
        markSrc: aeonMark.src,
      }}
      labels={{
        eli10: labels.specsEli10,
        flipAll: labels.specsFlipAll,
        unflipAll: labels.specsUnflipAll,
        shuffle: labels.specsShuffle,
      }}
    />

    <!-- Control room: the live sessions view. -->
    <section class="section section--ink aeon-control" id="control-room" aria-labelledby="control-title" data-section-pattern="control-room">
      <div class="page-shell">
        <header class="aeon-split-head">
          <div>
            <p class="eyebrow">{content.controlRoom.eyebrow}</p>
            <h2 id="control-title">{content.controlRoom.title}</h2>
          </div>
          <p class="section-lead" data-copy-slot>
            <DetailLevels
              simple={content.controlRoom.depths.simple}
              standard={content.controlRoom.lead}
              technical={content.controlRoom.depths.technical}
            />
          </p>
        </header>

        <div class="aeon-control__shot" data-aeon-gallery data-reveal>
          <a
            class="aeon-window aeon-window--dark aeon-shot"
            href={controlFull.src}
            target="_blank"
            rel="noopener"
            data-aeon-shot
            data-pswp-width={controlFull.width}
            data-pswp-height={controlFull.height}
            data-caption={`${content.controlRoom.title} · ${captionTail}`}
          >
            <span class="aeon-window__bar" aria-hidden="true"><i></i><i></i><i></i><span>/agents</span></span>
            <Image
              src={sessionsDark}
              alt={content.controlRoom.screenAlt}
              widths={[800, 1200, 1600, 2400]}
              sizes="(min-width: 90rem) 88rem, 94vw"
              format="webp"
              quality={84}
            />
            <span class="aeon-shot__zoom" aria-hidden="true">{content.theatre.openLabel} ⤢</span>
          </a>
        </div>

        <ul class="aeon-features">
          {content.controlRoom.items.map((item) => (
            <li class="aeon-feature" data-reveal>
              <span class="aeon-feature__icon" aria-hidden="true">
                <ContextIcon name={item.icon} size={20} strokeWidth={1.9} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {item.caveat && <p class="aeon-feature__caveat">{item.caveat}</p>}
            </li>
          ))}
        </ul>

        <div class="aeon-pairing" data-reveal data-depth-min="standard">
          <div class="aeon-pairing__copy">
            <p class="eyebrow">{content.controlRoom.pairing.eyebrow}</p>
            <h3>{content.controlRoom.pairing.title}</h3>
            <ul class="aeon-harnesses" aria-label={content.controlRoom.pairing.harnessesLabel}>
              {content.controlRoom.pairing.harnesses.map((harness) => <li>{harness}</li>)}
            </ul>
          </div>
          <ol class="aeon-terminal">
            {content.controlRoom.pairing.steps.map((step, index) => (
              <li>
                <span class="aeon-terminal__step" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="aeon-terminal__body">
                  <span>{step.label}</span>
                  {step.command ? (
                    <code><span aria-hidden="true">$ </span>{step.command}</code>
                  ) : (
                    <span class="aeon-code" aria-hidden="true"><i></i><i></i><i></i><b></b><i></i><i></i><i></i><b></b><i></i><i></i><i></i></span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </div>

        <AeonDeep deep={content.controlRoom.deep} id="control-deep" version={releaseVersion} locale={locale} ink />

        <p class="aeon-proof aeon-proof--ink" data-depth-min="standard">
          <span class="aeon-proof__label">{labels.proof}</span>
          {content.controlRoom.proof.map((proof) => (
            <a href={proofHref(proof)} target="_blank" rel="noopener noreferrer">{proof.label} <span aria-hidden="true">↗</span></a>
          ))}
        </p>
      </div>
    </section>

