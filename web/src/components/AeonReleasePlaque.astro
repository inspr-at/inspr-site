---
/**
 * INSPR-492: the hero release plaque, a small liquid-glass object.
 *
 * The AEON mark, the marketing name and a live pulse; the whole glass links
 * to the release (a stretched link, so the version chip is no nested
 * control). INSPR-497: no release numbers. The calendar version appears only
 * on hover, keyboard focus or a first tap, as the footer's version chip:
 * a history glyph and "26·09·30 11:53" drawn by the one calendar-version
 * adapter (the pinned renderer collapses the seconds). The chip always
 * holds its place, so revealing it moves nothing. It sits on a
 * light of its own (two slow orbs and faint era arcs) so the glass has
 * something to blur and, in Chromium, to refract through a bezel map. The
 * specular rim follows a fine pointer; hover lifts it and deepens the
 * glass. Reduced motion keeps the glass and stops the light, the pulse and
 * the lift. Styles in aeon-plaque.css.
 */
import CalendarVersion from "./CalendarVersion.astro";
import type { AeonContent } from "../content/types";
import "../styles/aeon-plaque.css";

interface Props {
  release: AeonContent["release"];
  /** The AEON mark, as a URL. */
  mark: string;
  /** Accessible prefix, e.g. "Current release". */
  label: string;
  locale?: "en" | "de";
}

const { release, mark, label, locale = "en" } = Astro.props;
// The same word in both editions.
const live = "Live";
const ariaLabel = `${label}: ${release.name} ${release.codename}, ${live}`;
// The tag carries a v; the adapter takes the canonical coordinate.
const version = release.version.replace(/^v/, "");

// The refraction map, a 96px SVG image: red ramps across x, green down y,
// 128 (no shift) in the middle and a bend at each edge, so the backdrop
// refracts inward along the rim like a thick slab. Chromium takes an SVG
// filter as a backdrop-filter; elsewhere the plain frost stays.
const stops = (channel: "r" | "g") => {
  const c = (v: number) => (channel === "r" ? `rgb(${v},0,0)` : `rgb(0,${v},0)`);
  return `<stop offset="0" stop-color="${c(0)}"/><stop offset=".16" stop-color="${c(128)}"/><stop offset=".84" stop-color="${c(128)}"/><stop offset="1" stop-color="${c(255)}"/>`;
};
const bezelSvg =
  `<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96">` +
  `<linearGradient id="x" x1="0" y1="0" x2="1" y2="0">${stops("r")}</linearGradient>` +
  `<linearGradient id="y" x1="0" y1="0" x2="0" y2="1">${stops("g")}</linearGradient>` +
  `<rect width="96" height="96" fill="url(#x)"/>` +
  `<rect width="96" height="96" fill="url(#y)" style="mix-blend-mode:screen"/></svg>`;
const bezelMap = `data:image/svg+xml,${encodeURIComponent(bezelSvg)}`;
---

<div class="aeon-plaque-stage" data-aeon-plaque>
  <div class="aeon-plaque-stage__light" aria-hidden="true">
    <i class="aeon-plaque-stage__orb aeon-plaque-stage__orb--a"></i>
    <i class="aeon-plaque-stage__orb aeon-plaque-stage__orb--b"></i>
  </div>
  <svg class="aeon-plaque-stage__lens" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="aeon-plaque-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feImage href={bezelMap} preserveAspectRatio="none" result="bezel" />
      <feDisplacementMap in="SourceGraphic" in2="bezel" scale="18" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <div class="aeon-plaque" data-plaque>
    <span class="aeon-plaque__sheen" aria-hidden="true"></span>
    <a class="aeon-plaque__link" href={release.url} target="_blank" rel="noopener noreferrer" aria-label={ariaLabel} data-plaque-link></a>
    <span class="aeon-plaque__mark" aria-hidden="true">
      <img src={mark} alt="" width="48" height="48" />
    </span>
    <span class="aeon-plaque__title" aria-hidden="true">
      <span class="aeon-plaque__name">{release.name}</span>
      <span class="aeon-plaque__codename">{release.codename}</span>
    </span>
    <span class="aeon-plaque__live" aria-hidden="true">
      <i></i>
      {live}
    </span>
    <span class="aeon-plaque__version" data-plaque-version>
      <span class="aeon-plaque__chip">
        <svg class="aeon-plaque__chip-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
          <path d="M12 7v5l4 2" />
        </svg>
        <CalendarVersion value={version} scheme="inspr-calver-3" locale={locale} />
      </span>
    </span>
    <span class="aeon-plaque__go" aria-hidden="true">
      <svg viewBox="0 0 16 16" focusable="false"><path d="M4 12 L12 4 M6 4 H12 V10" /></svg>
    </span>
  </div>
</div>

<script>
  // The plaque: the specular rim follows a fine pointer, and Chromium gets
  // the refraction. Everything else is CSS.
  const initPlaque = () => {
    const stage = document.querySelector<HTMLElement>("[data-aeon-plaque]");
    if (!stage) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if ("userAgentData" in navigator && CSS.supports("backdrop-filter", "url(#aeon-plaque-lens)")) {
      stage.classList.add("has-lens");
    }
    if (reduced || !window.matchMedia("(pointer: fine)").matches) return;
    const plaque = stage.querySelector<HTMLElement>(".aeon-plaque");
    if (!plaque) return;
    let frame = 0;
    let last: PointerEvent | null = null;
    plaque.addEventListener("pointermove", (event) => {
      last = event;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!last) return;
        const box = plaque.getBoundingClientRect();
        plaque.style.setProperty("--mx", `${((last.clientX - box.left) / box.width) * 100}%`);
        plaque.style.setProperty("--my", `${((last.clientY - box.top) / box.height) * 100}%`);
      });
    });
  };

  initPlaque();
</script>

<script>
  // Touch has no hover: the first tap on the plaque shows the version chip,
  // the next one follows the link. A tap elsewhere hides it again.
  const coarse = window.matchMedia("(hover: none)");
  for (const plaque of document.querySelectorAll<HTMLElement>("[data-plaque]")) {
    const link = plaque.querySelector<HTMLAnchorElement>("[data-plaque-link]");
    if (!link) continue;
    link.addEventListener("click", (event) => {
      if (!coarse.matches || plaque.classList.contains("is-revealed")) return;
      event.preventDefault();
      plaque.classList.add("is-revealed");
    });
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !plaque.contains(event.target)) plaque.classList.remove("is-revealed");
    });
  }
</script>
