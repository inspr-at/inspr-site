---
import ContextIcon from "./ContextIcon.astro";
import type {
  AgentIntercomAvailability,
  AgentIntercomContent,
} from "../content/types";

interface Props {
  content: AgentIntercomContent;
}

const { content } = Astro.props;
const columns: Array<{
  key: "simpleInbox" | "managedCodex" | "managedClaude" | "unmanaged";
  label: string;
  detail: string;
}> = [
  { key: "simpleInbox", label: "Simple inbox", detail: "Registered receiver" },
  { key: "managedCodex", label: "Managed Codex", detail: "Owned live child" },
  { key: "managedClaude", label: "Managed Claude", detail: "Owned live Query" },
  { key: "unmanaged", label: "Unmanaged Claude / Grok", detail: "External session" },
];

const statusLabel = (cell: AgentIntercomAvailability) => ({
  supported: "Supported",
  conditional: "Conditional",
  unavailable: "Unavailable",
})[cell.state];
---

<section
  class="section intercom"
  id="agent-intercom"
  aria-labelledby="agent-intercom-title"
  data-section-pattern="agent-intercom"
>
  <div class="page-shell">
    <header class="intercom__header">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h2 id="agent-intercom-title">{content.title}</h2>
      </div>
      <div class="intercom__introduction">
        <p class="section-lead">{content.lead}</p>
        <p class="intercom__boundary">
          <span aria-hidden="true"><ContextIcon name="lock-keyhole" size={20} strokeWidth={2} /></span>
          <strong>Owned-session boundary</strong>
          <span>{content.boundary}</span>
        </p>
      </div>
    </header>

    <div class="intercom__flow" aria-labelledby="intercom-flow-title">
      <div class="intercom__flow-heading">
        <p class="eyebrow">Control flow</p>
        <h3 id="intercom-flow-title">The message is durable. Control is conditional.</h3>
      </div>
      <ol>
        {content.flow.map((step, index) => (
          <li>
            <article>
              <div class="intercom__step-topline">
                <span class="intercom__step-icon" aria-hidden="true">
                  <ContextIcon name={step.icon} size={22} strokeWidth={2} />
                </span>
                <span class="intercom__step-label">{step.label}</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
            {index < content.flow.length - 1 && (
              <span class="intercom__connector" aria-hidden="true">→</span>
            )}
          </li>
        ))}
      </ol>
    </div>

    <div class="intercom__matrix" aria-labelledby="intercom-matrix-title">
      <div class="intercom__matrix-intro">
        <div>
          <p class="eyebrow">Control truth table</p>
          <h3 id="intercom-matrix-title">What each path can honestly do.</h3>
        </div>
        <p>
          A requested delivery level is never proof that control happened. The effective result and its
          correlation evidence decide that.
        </p>
      </div>

      <p class="intercom__scroll-hint" aria-hidden="true">Swipe to compare paths <span>→</span></p>
      <div class="intercom__table-wrap" tabindex="0" aria-label="Agent Intercom control support matrix">
        <table>
          <caption class="visually-hidden">
            Support for tell, status, steer, interrupt and stop across simple inboxes, managed Codex,
            managed Claude and unmanaged Claude or Grok sessions.
          </caption>
          <thead>
            <tr>
              <th scope="col">Control</th>
              {columns.map((column) => (
                <th scope="col" data-column={column.key}>
                  <strong>{column.label}</strong>
                  <span>{column.detail}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {content.controls.map((row) => (
              <tr data-control={row.control.toLowerCase()}>
                <th scope="row" data-intent={row.intent}>
                  <strong>{row.control}</strong>
                  <span>{row.intent}</span>
                </th>
                {columns.map((column) => {
                  const cell = row[column.key];
                  return (
                    <td data-column={column.key} data-state={cell.state}>
                      <span class="intercom__status">
                        <span aria-hidden="true"></span>
                        {statusLabel(cell)}
                      </span>
                      <p>{cell.label}</p>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="intercom__codex-note">
        <span aria-hidden="true"><ContextIcon name="file-warning" size={18} strokeWidth={2} /></span>
        {content.unmanagedCodexNote}
      </p>
    </div>

    <div class="intercom__security" aria-labelledby="intercom-security-title">
      <div class="intercom__security-intro">
        <p class="eyebrow">Security boundary</p>
        <h3 id="intercom-security-title">A handoff cannot promote itself.</h3>
      </div>
      <ol>
        {content.security.map((item, index) => (
          <li>
            <span class="intercom__security-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="intercom__security-icon" aria-hidden="true">
              <ContextIcon name={item.icon} size={21} strokeWidth={2} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {item.meta && <strong>{item.meta}</strong>}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <aside class="intercom__recovery" aria-labelledby="intercom-recovery-title">
      <span class="intercom__recovery-icon" aria-hidden="true">
        <ContextIcon name="rotate-ccw" size={27} strokeWidth={1.9} />
      </span>
      <div>
        <p class="eyebrow">Recovery without pretending</p>
        <h3 id="intercom-recovery-title">{content.recovery.title}</h3>
        <p>{content.recovery.body}</p>
        <strong>{content.recovery.meta}</strong>
      </div>
      <nav aria-label="Agent Intercom evidence">
        {content.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </aside>
  </div>
</section>

<style>
  .intercom {
    position: relative;
    overflow: clip;
    color: var(--night-text);
    background:
      radial-gradient(circle at 8% 18%, color-mix(in srgb, var(--accent) 38%, transparent), transparent 29rem),
      radial-gradient(circle at 92% 88%, color-mix(in srgb, var(--secondary) 18%, transparent), transparent 32rem),
      var(--night-deep);
  }

  .intercom::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    opacity: 0.22;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 3.4rem 3.4rem;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
  }

  .intercom .page-shell {
    position: relative;
  }

  .intercom :is(h2, h3) {
    color: var(--night-text);
  }

  .intercom :is(p, .eyebrow) {
    color: var(--night-soft);
  }

  .intercom .eyebrow {
    color: color-mix(in srgb, var(--accent-soft) 82%, white);
  }

  .intercom__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.75fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .intercom__introduction {
    display: grid;
    gap: 1.5rem;
  }

  .intercom__boundary {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.8rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 62%, transparent);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.055);
  }

  .intercom__boundary > span:first-child {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 2.5rem;
    aspect-ratio: 1;
    color: var(--night-text);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--accent) 52%, transparent);
  }

  .intercom__boundary strong {
    color: var(--night-text);
    font-size: 0.96rem;
  }

  .intercom__boundary > span:last-child {
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .intercom__flow,
  .intercom__matrix,
  .intercom__security,
  .intercom__recovery {
    margin-top: clamp(3rem, 7vw, 6.5rem);
  }

  .intercom__flow-heading,
  .intercom__matrix-intro,
  .intercom__security-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(18rem, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .intercom__flow-heading h3,
  .intercom__matrix-intro h3,
  .intercom__security-intro h3 {
    max-width: 19ch;
    font-size: clamp(1.65rem, 3vw, 3rem);
  }

  .intercom__flow ol,
  .intercom__security ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .intercom__flow ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: var(--radius-lg);
    background: rgb(3 18 30 / 0.48);
    box-shadow: var(--shadow-deep);
  }

  .intercom__flow li {
    position: relative;
    min-width: 0;
  }

  .intercom__flow article {
    min-height: 100%;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .intercom__flow li + li article {
    border-inline-start: 1px solid rgb(255 255 255 / 0.12);
  }

  .intercom__step-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .intercom__step-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    aspect-ratio: 1;
    color: var(--night-text);
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .intercom__step-label {
    color: var(--night-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intercom__flow h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
  }

  .intercom__flow p {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .intercom__connector {
    position: absolute;
    top: 50%;
    right: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    aspect-ratio: 1;
    color: var(--night-deep);
    border-radius: 50%;
    background: var(--accent-soft);
    transform: translate(50%, -50%);
  }

  .intercom__matrix-intro > p {
    max-width: 58ch;
    justify-self: end;
  }

  .intercom__scroll-hint {
    display: none;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .intercom__table-wrap {
    overflow-x: auto;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: var(--radius-lg);
    background: rgb(3 18 30 / 0.56);
    box-shadow: var(--shadow-deep);
  }

  .intercom table {
    width: 100%;
    min-width: 68rem;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .intercom th,
  .intercom td {
    padding: 1.15rem;
    vertical-align: top;
    text-align: start;
    border-inline-start: 1px solid rgb(255 255 255 / 0.1);
    border-block-start: 1px solid rgb(255 255 255 / 0.1);
  }

  .intercom tr > :first-child {
    width: 14rem;
    border-inline-start: 0;
  }

  .intercom thead th {
    border-block-start: 0;
    background: rgb(255 255 255 / 0.045);
  }

  .intercom th strong {
    display: block;
    color: var(--night-text);
    font-size: 0.92rem;
  }

  .intercom th span,
  .intercom td p {
    display: block;
    margin-top: 0.32rem;
    color: var(--night-soft);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .intercom__status {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--night-text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .intercom__status > span {
    width: 0.55rem;
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.22rem color-mix(in srgb, currentColor 17%, transparent);
  }

  .intercom td[data-state="supported"] .intercom__status {
    color: #7ee0c8;
  }

  .intercom td[data-state="conditional"] .intercom__status {
    color: #f2c66f;
  }

  .intercom td[data-state="unavailable"] .intercom__status {
    color: #aebbc3;
  }

  .intercom td[data-state="unavailable"] .intercom__status > span {
    background: transparent;
  }

  .intercom__codex-note {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 70rem;
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    border-inline-start: 3px solid var(--secondary);
    background: rgb(255 255 255 / 0.045);
    font-size: 0.88rem;
  }

  .intercom__codex-note > span {
    flex: none;
    color: #f2c66f;
  }

  .intercom__security {
    display: grid;
    grid-template-columns: minmax(15rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .intercom__security-intro {
    position: sticky;
    top: 2rem;
    display: block;
    margin: 0;
  }

  .intercom__security-intro h3 {
    margin-top: 0.45rem;
  }

  .intercom__security ol {
    border-block-start: 1px solid rgb(255 255 255 / 0.15);
  }

  .intercom__security li {
    display: grid;
    grid-template-columns: 2.5rem 3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding-block: 1.35rem;
    border-block-end: 1px solid rgb(255 255 255 / 0.15);
  }

  .intercom__security-index {
    padding-top: 0.45rem;
    color: var(--night-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .intercom__security-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    aspect-ratio: 1;
    color: var(--night-text);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .intercom__security h3 {
    font-size: 1.12rem;
  }

  .intercom__security li p {
    margin-top: 0.38rem;
    font-size: 0.9rem;
  }

  .intercom__security li strong {
    display: block;
    margin-top: 0.6rem;
    color: color-mix(in srgb, var(--accent-soft) 80%, white);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .intercom__recovery {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid color-mix(in srgb, var(--secondary) 48%, transparent);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(125deg, color-mix(in srgb, var(--secondary) 13%, transparent), transparent 54%),
      rgb(255 255 255 / 0.06);
  }

  .intercom__recovery-icon {
    display: grid;
    place-items: center;
    width: 3.6rem;
    aspect-ratio: 1;
    color: #f2c66f;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--secondary) 18%, transparent);
  }

  .intercom__recovery h3 {
    margin-top: 0.25rem;
    font-size: clamp(1.35rem, 2vw, 2rem);
  }

  .intercom__recovery p:not(.eyebrow) {
    max-width: 68ch;
    margin-top: 0.45rem;
  }

  .intercom__recovery strong {
    display: block;
    margin-top: 0.65rem;
    color: var(--night-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .intercom__recovery nav {
    display: grid;
    gap: 0.55rem;
    min-width: 13rem;
  }

  .intercom__recovery a {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.72rem 0.9rem;
    color: var(--night-text);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 0.8rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .intercom__recovery a:hover {
    border-color: color-mix(in srgb, var(--accent-soft) 65%, transparent);
    background: rgb(255 255 255 / 0.06);
  }

  @media (max-width: 72rem) {
    .intercom__header,
    .intercom__flow-heading,
    .intercom__matrix-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .intercom__matrix-intro > p {
      justify-self: start;
    }

    .intercom__flow ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .intercom__flow li:nth-child(3) article {
      border-inline-start: 0;
      border-block-start: 1px solid rgb(255 255 255 / 0.12);
    }

    .intercom__flow li:nth-child(4) article {
      border-block-start: 1px solid rgb(255 255 255 / 0.12);
    }

    .intercom__flow li:nth-child(2) .intercom__connector {
      top: 100%;
      right: auto;
      left: 50%;
      transform: translate(-50%, -50%) rotate(90deg);
    }

    .intercom__security {
      grid-template-columns: 1fr;
    }

    .intercom__security-intro {
      position: static;
    }

    .intercom__recovery {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .intercom__recovery nav {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .intercom__scroll-hint {
      display: block;
    }

    .intercom__flow ol {
      grid-template-columns: 1fr;
    }

    .intercom__flow li + li article,
    .intercom__flow li:nth-child(3) article,
    .intercom__flow li:nth-child(4) article {
      border-inline-start: 0;
      border-block-start: 1px solid rgb(255 255 255 / 0.12);
    }

    .intercom__flow .intercom__connector {
      top: 100%;
      right: auto;
      left: 50%;
      transform: translate(-50%, -50%) rotate(90deg);
    }

    .intercom__step-topline {
      margin-bottom: 1.5rem;
    }

    .intercom__security li {
      grid-template-columns: 2.3rem minmax(0, 1fr);
    }

    .intercom__security-icon {
      display: none;
    }

    .intercom__recovery {
      grid-template-columns: 1fr;
    }

    .intercom__recovery nav {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intercom__recovery a {
      transition: none;
    }
  }

  @media print {
    .intercom {
      color: #112b43;
      background: white;
    }

    .intercom::before {
      display: none;
    }

    .intercom :is(h2, h3, p, .eyebrow, th strong, th span, td p) {
      color: #112b43;
    }

    .intercom__table-wrap,
    .intercom__flow ol,
    .intercom__recovery {
      color: #112b43;
      border-color: #ccd4d8;
      background: white;
      box-shadow: none;
    }
  }
</style>
