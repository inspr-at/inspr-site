---
import DetailLevels from "./DetailLevels.astro";
import DetailsControl from "./DetailsControl.astro";
import SiteHeaderMotion from "./SiteHeaderMotion.astro";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import ServiceRibbon from "./ServiceRibbon.astro";
import HeroLoop from "./HeroLoop.astro";
import FractureAtlas from "./FractureAtlas.astro";
import WorkflowExplorer from "./WorkflowExplorer.astro";
import FeatureExperience from "./FeatureExperience.astro";
import AudiencePaths from "./AudiencePaths.astro";
import ConstraintRegister from "./ConstraintRegister.astro";
import type { PreviewProductContent } from "../content/types";
import { productLinks, siteUrls, localeUrls } from "../content/urls";
import { releaseMetadata } from "../../release-metadata.mjs";
import CalendarVersion from "./CalendarVersion.astro";
import FamilyBand from "./FamilyBand.astro";
import StatusChip from "./StatusChip.astro";
import { products } from "../content/family";
import { aithemaHandover, aithemaReleaseVersion } from "../content/aithema";

import aithemaHero from "../assets/products/aithema/hero.png";
import aithemaHeroLoop from "../assets/products/aithema/hero-loop.mp4";
import aithemaLogo from "../assets/products/aithema/logo.svg";
import ShieldedMailto from "./ShieldedMailto.astro";

interface Props {
  content: PreviewProductContent;
  locale?: "en" | "de";
}

const { content } = Astro.props;
const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const sheetLabels = locale === "de"
  ? { repo: "Repo", runtime: "Laufzeit", gate: "Freigabe", artefact: "Artefakt", interfaces: "Schnittstellen", maturity: "Reife", command: "Befehl" }
  : { repo: "repo", runtime: "runtime", gate: "gate", artefact: "artifact", interfaces: "interfaces", maturity: "maturity", command: "command" };

// Shared product-host locale contract: English at the root, German at /de/.
const englishUrl = siteUrls.aithema;
const germanUrl = `${englishUrl}/de/`;

const labels = locale === "de"
  ? {
      navWhy: "Warum",
      navPath: "Weg",
      navCapabilities: "Funktionen",
      navLimits: "Grenzen",
      detailsDescription: "Wie viel Detail diese Seite zeigt",
      detailsSimple: "Einfach",
      detailsTechnical: "Technisch",
      primary: "Hauptnavigation",
      sections: "Bereiche",
      mobile: "Navigation für Mobilgeräte",
      products: "Produkte",
      opensInNewTab: "öffnet in einem neuen Tab",
      languages: "Sprache wählen",
      german: "Deutsch",
      english: "Englisch",
      proofAria: "Produktmerkmale",
      proofLabel: "Aktueller Stand",
      coreRelease: "Anforderungskern",
      workflowAlt: "Das Aithema-Anforderungsprisma markiert den Weg vom Input zur geprüften Entscheidung",
      requestAccess: "Zugang anfragen",
      faqEyebrow: "Praktische Fragen",
      faqTitle: "Bevor Sie es verwenden.",
      path: "Professioneller Weg",
      servicesCta: "Augmentoring-Services ansehen",
      familyDescription: "Teil von INSPR, der Produktfamilie für Menschen und KI-Agenten.",
      productsAria: "INSPR-Produkte",
      family: "Produktfamilie",
      availabilityAria: "Aithema-Verfügbarkeit",
      availability: "Verfügbarkeit",
      byInvitation: "Gehosteter Arbeitsbereich auf Einladung",
      sourceAria: "Quellcode, Lizenz und Verfügbarkeit",
      source: "Quellcode",
      releases: "Releases",
      license: "Projektlizenz: AGPL-3.0-only",
      agplText: "Offizieller AGPL-3.0-Text",
      viewSource: "Quellcode ansehen",
      operateAria: "Services und Identität",
      operate: "Betrieb",
      services: "Professionelle Services",
      identity: "ZITADEL-Identität",
      legal: "Impressum",
      privacy: "Datenschutz",
      inspectable: "Gebaut, um prüfbar zu bleiben.",
      releaseAria: "Website-Release",
      package: "Paket",
      release: "Release",
      deployed: "Ausgerollt",
      localBuild: "Lokaler Build",
    }
  : {
      navWhy: "Why",
      navPath: "Path",
      navCapabilities: "Capabilities",
      navLimits: "Limits",
      detailsDescription: "How much detail this page shows",
      detailsSimple: "Simple",
      detailsTechnical: "Technical",
      primary: "Primary navigation",
      sections: "Sections",
      mobile: "Mobile navigation",
      products: "Products",
      opensInNewTab: "opens in a new tab",
      languages: "Choose language",
      german: "German",
      english: "English",
      proofAria: "Product characteristics",
      proofLabel: "Current posture",
      coreRelease: "Requirements core",
      workflowAlt: "The Aithema Requirement Prism marking the path from input to a reviewed decision",
      requestAccess: "Request access",
      faqEyebrow: "Practical questions",
      faqTitle: "Before you use it.",
      path: "Professional path",
      servicesCta: "Explore Augmentoring services",
      familyDescription: "Part of INSPR, the technology umbrella for people and AI agents.",
      productsAria: "INSPR products",
      family: "Product family",
      availabilityAria: "Aithema availability",
      availability: "Availability",
      byInvitation: "Hosted workspace by invitation",
      sourceAria: "Source, license and availability",
      source: "Source",
      releases: "Releases",
      license: "Project license: AGPL-3.0-only",
      agplText: "Official AGPL-3.0 text",
      viewSource: "View the source",
      operateAria: "Services and identity",
      operate: "Operate",
      services: "Professional services",
      identity: "ZITADEL identity",
      legal: "Legal notice",
      privacy: "Privacy",
      inspectable: "Built to stay inspectable.",
      releaseAria: "Site release",
      package: "Package",
      release: "Release",
      deployed: "Deployed",
      localBuild: "Local build",
    };

const nav: { label: string; href: string; external?: boolean }[] = [
  { label: labels.navWhy, href: "#why" },
  { label: labels.navPath, href: "#model" },
  { label: labels.navCapabilities, href: "#capabilities" },
  { label: labels.navLimits, href: "#limits" },
];

// Same host-relative choice links MicrositeHeader renders; the shared
// locale-preference script persists the click on any [data-language-choice].
const languageChoiceHref = (href: string, choice: "en" | "de") => {
  const url = new URL(href, siteUrls.aithema);
  url.searchParams.set("lang", choice);
  return `${url.pathname}${url.search}${url.hash}`;
};

// Cross-host navigation keeps the reader's language: every product host
// serves its German edition at /de/, and ?lang=de records the choice on the
// destination origin (localStorage does not cross hosts).
const productHref = (href: string) =>
  locale === "de" ? `${href}/de/?lang=de` : href;

const ogImage = new URL(aithemaHero.src, content.canonicalUrl).href;
const year = new Date().getUTCFullYear();
const links = localeUrls(locale);
const deployedAtLabel = releaseMetadata.deployedAt
  ? `${new Intl.DateTimeFormat(locale === "de" ? "de-AT" : "en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "UTC",
    }).format(new Date(releaseMetadata.deployedAt))} UTC`
  : labels.localBuild;
---

<MicrositeLayout
  title={content.seo.title}
  description={content.seo.description}
  canonical={content.canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  ogImage={ogImage}
  ogImageAlt={content.hero.alt}
  favicon={aithemaLogo.src}
  theme="inspr"
>
  <header class="site-header">
    <div class="site-header__bar page-shell">
      <a class="site-brand" href={content.canonicalUrl} aria-label={content.name}>
        <img src={aithemaLogo.src} alt="" width="48" height="48" />
        <span>
          <strong>{content.name}</strong>
          <small>{products.aithema.name[locale]} · {products.aithema.verb[locale]}</small>
        </span>
      </a>

      <nav class="site-nav" aria-label={labels.primary}>
        {nav.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="site-header__actions">
        <DetailsControl
          label="Details"
          description={labels.detailsDescription}
          levels={[
            { id: "simple", label: labels.detailsSimple },
            { id: "standard", label: "Standard" },
            { id: "technical", label: labels.detailsTechnical },
          ]}
        />
        <nav class="language-switch" aria-label={labels.languages}>
          <a
            href={languageChoiceHref("/de/", "de")}
            lang="de"
            hreflang="de"
            aria-label={labels.german}
            aria-current={locale === "de" ? "page" : undefined}
            data-language-choice="de"
          >DE</a>
          <span aria-hidden="true">|</span>
          <a
            href={languageChoiceHref("/", "en")}
            lang="en"
            hreflang="en"
            aria-label={labels.english}
            aria-current={locale === "en" ? "page" : undefined}
            data-language-choice="en"
          >EN</a>
        </nav>
        <details class="mobile-navigation" data-mobile-navigation>
          <summary>{labels.sections}</summary>
          <nav class="mobile-navigation__panel" aria-label={labels.mobile}>
            {nav.map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </details>
        <details class="product-switcher">
          <summary>{labels.products}</summary>
          <div class="product-switcher__panel">
            {productLinks.map((item) => (
              <a
                href={productHref(item.href)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.label}, ${labels.opensInNewTab}`}
                aria-current={item.label === "Aithema" ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </header>

  <SiteHeaderMotion />

  <main id="main-content">
    <ServiceRibbon text={content.serviceIntro} locale={locale} />

    <section
      class="product-hero page-shell"
      aria-labelledby="hero-title"
      data-section-pattern="editorial-hero"
    >
      <div class="product-hero__copy">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title">{content.hero.title}</h1>
        <p>{products.aithema.oneLiner[locale]}</p>
        <p class="hero-lead"><DetailLevels simple={content.hero.depths?.simple ?? content.hero.lead} standard={content.hero.lead} technical={content.hero.depths?.technical ?? content.hero.lead} /></p>
        <p><StatusChip status={products.aithema.status} locale={locale} /> {labels.coreRelease} {aithemaReleaseVersion}; {products.aithema.statusNote?.[locale]}</p>
        <p><StatusChip status="planned" locale={locale} /> {aithemaHandover[locale]}</p>
        <div class="button-row">
          <a
            class="button"
            href={links.business}
            target="_blank"
            rel="noopener noreferrer"
          >
            {content.hero.primaryLabel} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="product-sheet details-drawer" data-drawer>
          <div class="details-drawer__inner">
            <dt>{sheetLabels.repo}</dt><dd>{content.hero.sheet.repo}</dd>
            <dt>{sheetLabels.runtime}</dt><dd>{content.hero.sheet.runtime}</dd>
            <dt>{sheetLabels.gate}</dt><dd>{content.hero.sheet.gate}</dd>
            <dt>{sheetLabels.artefact}</dt><dd>{content.hero.sheet.artefact}</dd>
            <dt>{sheetLabels.interfaces}</dt><dd>{content.hero.sheet.interfaces}</dd>
            <dt>{sheetLabels.maturity}</dt><dd>{content.hero.sheet.maturity}</dd>
            {content.hero.sheet.command && (
              <>
                <dt>{sheetLabels.command}</dt>
                <dd><code class="product-sheet__command">$ {content.hero.sheet.command}</code></dd>
              </>
            )}
          </div>
        </dl>
      </div>

      <figure class="product-hero__visual">
        <HeroLoop
          id="aithema"
          poster={aithemaHero}
          video={aithemaHeroLoop}
          alt={content.hero.alt}
          sizes="(min-width: 64rem) 55vw, 100vw"
          locale={locale}
        />
      </figure>
    </section>

    <FamilyBand highlight="aithema" locale={locale} />

    <section
      class="proof-console page-shell" data-depth-min="standard"
      aria-label={labels.proofAria}
      data-section-pattern="proof-strip"
    >
      <!-- INSPR-555: a plain list; no count cell, numbered circles or hover effects. -->
      <p class="proof-console__label" aria-hidden="true">{labels.proofLabel}</p>
      <ul class="proof-strip" role="list">
        {content.proof.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section data-depth-min="standard"
      class="section page-shell"
      id="why"
      aria-labelledby="problem-title"
      data-section-pattern="fracture-atlas"
    >
      <header class="section-intro">
        <p class="eyebrow">{content.problem.eyebrow}</p>
        <h2 id="problem-title">{content.problem.title}</h2>
        <p class="section-lead"><DetailLevels simple={content.problem.depths?.simple ?? content.problem.lead} standard={content.problem.lead} technical={content.problem.depths?.technical ?? content.problem.lead} /></p>
      </header>
      <FractureAtlas
        id="aithema-problem"
        items={content.problem.items}
        image={aithemaHero}
        alt={content.problem.visualAlt}
        caption={content.problem.visualCaption}
        locale={locale}
      />
    </section>

    <WorkflowExplorer
      id="model"
      eyebrow={content.model.eyebrow}
      title={content.model.title}
      lead={content.model.lead}
      leadDepths={content.model.depths}
      handoff={content.model.handoff}
      steps={content.model.steps}
      image={aithemaLogo}
      imageFit="contain"
      alt={labels.workflowAlt}
      closing={content.model.closing}
      tone="ink"
      pattern="guided-workflow"
      locale={locale}
    />

    <div id="capabilities">
      {content.featureSections.map((feature, index) => (
        <section data-depth-min="standard"
          class:list={["section", "page-shell", { "section--tint": index % 2 === 1 }]}
          id={`feature-${feature.id}`}
          aria-labelledby={`${feature.id}-title`}
          data-section-pattern={index % 2 === 0 ? "feature-ledger" : "feature-sequence"}
        >
          <header class="section-intro">
            <p class="eyebrow">{feature.eyebrow}</p>
            <h2 id={`${feature.id}-title`}>{feature.title}</h2>
            <p class="section-lead">{feature.lead}</p>
          </header>
          <FeatureExperience
            id={`aithema-${feature.id}`}
            items={feature.items}
            variant={index % 2 === 0 ? "ledger" : "sequence"}
            label={feature.eyebrow}
            locale={locale}
          />
        </section>
      ))}
    </div>

    <section data-depth-min="standard" data-depth-max="standard"
      class="section page-shell"
      aria-labelledby="audience-title"
      data-section-pattern="audience-paths"
    >
      <header class="section-intro">
        <p class="eyebrow">{content.audiences.eyebrow}</p>
        <h2 id="audience-title">{content.audiences.title}</h2>
        <p class="section-lead">{content.audiences.lead}</p>
      </header>
      <AudiencePaths id="aithema-audiences" items={content.audiences.items} locale={locale} />
    </section>

    <section data-depth-min="standard"
      class="section section--tint"
      id="limits"
      aria-labelledby="limits-title"
      data-section-pattern="constraint-register"
    >
      <div class="page-shell limits-grid">
        <header class="section-intro">
          <p class="eyebrow">{content.limits.eyebrow}</p>
          <h2 id="limits-title">{content.limits.title}</h2>
          <p class="section-lead">{content.limits.lead}</p>
        </header>
        <ConstraintRegister items={content.limits.items} locale={locale} />
      </div>
    </section>

    <section data-depth-min="standard"
      class="section page-shell open-source"
      id="release-path"
      aria-labelledby="release-path-title"
      data-section-pattern="preview-release-path"
    >
      <div>
        <p class="eyebrow">{content.releasePath.eyebrow}</p>
        <h2 id="release-path-title">{content.releasePath.title}</h2>
        <p class="section-lead">{content.releasePath.body}</p>
      </div>
      <div class="button-row">
        <a
          class="button"
          href={content.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {labels.viewSource} <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button button--ghost"
          href={links.business}
          target="_blank"
          rel="noopener noreferrer"
        >
          {labels.requestAccess} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section data-depth-min="standard"
      class="section page-shell faq"
      aria-labelledby="faq-title"
      data-section-pattern="faq-accordion"
    >
      <header class="section-intro">
        <p class="eyebrow">{labels.faqEyebrow}</p>
        <h2 id="faq-title">{labels.faqTitle}</h2>
      </header>
      <div class="faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <section class="footer-cta page-shell"
      aria-labelledby="footer-cta-title"
      data-section-pattern="professional-cta"
    >
      <div>
        <p class="eyebrow">{labels.path}</p>
        <h2 id="footer-cta-title">{content.finalCta.title}</h2>
        <p>{content.finalCta.body}</p>
      </div>
      <a
        class="button button--light"
        href={links.business}
        target="_blank"
        rel="noopener noreferrer"
      >
        {labels.servicesCta} <span aria-hidden="true">↗</span>
      </a>
    </section>

    <div class="site-footer__grid page-shell">
      <div class="site-footer__brand">
        <strong>{content.name}</strong>
        <p>{labels.familyDescription}</p>
      </div>

      <nav aria-label={labels.productsAria}>
        <p class="footer-label">{labels.family}</p>
        {productLinks.map((item) => (
          <a
            href={productHref(item.href)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${item.label}, ${labels.opensInNewTab}`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <nav aria-label={labels.sourceAria}>
        <p class="footer-label">{labels.source}</p>
        <a href={content.repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={content.releaseUrl} target="_blank" rel="noopener noreferrer">{labels.releases} <span aria-hidden="true">↗</span></a>
        <a href={content.licenseUrl} target="_blank" rel="noopener noreferrer">{labels.license} <span aria-hidden="true">↗</span></a>
        <a href={siteUrls.agpl} target="_blank" rel="noopener noreferrer">{labels.agplText} <span aria-hidden="true">↗</span></a>
        <p class="footer-text">{labels.byInvitation}</p>
      </nav>

      <nav aria-label={labels.operateAria}>
        <p class="footer-label">{labels.operate}</p>
        <a href={links.business} target="_blank" rel="noopener noreferrer">
          {labels.services} <span aria-hidden="true">↗</span>
        </a>
        <a href={siteUrls.identity} target="_blank" rel="noopener noreferrer">
          {labels.identity} <span aria-hidden="true">↗</span>
        </a>
        <ShieldedMailto address="hello@inspr.at" />
        <a href={links.imprint}>{labels.legal}</a>
        <a href={links.privacy}>{labels.privacy}</a>
      </nav>
    </div>

    <div class="site-footer__legal page-shell">
      <p class="site-footer__legal-copy">
        <span>
          © {year} <a href={siteUrls.author} target="_blank" rel="me noopener noreferrer">Markus Barta</a> · INSPR
        </span>
        <span>{labels.inspectable}</span>
      </p>

      <dl
        class="site-footer__release"
        aria-label={labels.releaseAria}
        data-release-id={releaseMetadata.releaseId}
      >
        {releaseMetadata.calendarVersion && releaseMetadata.versionScheme && (
          <div>
            <dt>Version</dt>
            <dd>
              <CalendarVersion
                value={releaseMetadata.calendarVersion}
                scheme={releaseMetadata.versionScheme}
                locale={locale}
              />
            </dd>
          </div>
        )}
        <div>
          <dt>Site</dt>
          <dd class="site-footer__release-token" title={`${labels.package} ${releaseMetadata.packageName}`}>v{releaseMetadata.version}</dd>
        </div>
        <div>
          <dt>Git</dt>
          <dd><code>{releaseMetadata.gitLabel}</code></dd>
        </div>
        <div>
          <dt>{labels.release}</dt>
          <dd><code>{releaseMetadata.releaseId}</code></dd>
        </div>
        <div>
          <dt>{labels.deployed}</dt>
          <dd>
            {releaseMetadata.deployedAt
              ? <time datetime={releaseMetadata.deployedAt}>{deployedAtLabel}</time>
              : deployedAtLabel}
          </dd>
        </div>
      </dl>
    </div>
  </footer>
</MicrositeLayout>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-navigation]")
    .forEach((menu) => {
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.removeAttribute("open"));
      });
      menu.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        menu.removeAttribute("open");
        menu.querySelector<HTMLElement>("summary")?.focus();
      });
    });
</script>
