---
/**
 * The Details switch (INSPR-497): one labelled choice, Why · What · How
 * (Warum · Was · Wie), naming the angle the page takes, not the reader.
 *
 *   simple     Why   results and value, fewer technical details
 *   standard   What  the product as it is (renders without JavaScript)
 *   technical  How   the technical detail for engineering and IT
 *
 * A radio group with a glass thumb that slides by transform; on narrow
 * headers it folds into the rising-bars glyph and the active name, and a
 * tap opens the three choices in a glass popover. A change says what the
 * page now shows in a short line beside the control.
 *
 * The control owns the level: it stamps `data-details-level` on <html>
 * (the head script already did for a stored or linked level, before the
 * first paint), remembers the choice like the language choice, honours
 * `?details=` on arrival so the depth travels between the family's hosts,
 * keeps cross-host links carrying it, and switches the specs grid's
 * plain-words mode on for Why. Other scripts listen for
 * `inspr:details-level`, `inspr:details-moving` (with the element that
 * keeps its place) and `inspr:details-settled`, and may ask for a change
 * with `inspr:details-request`. The motion itself lives in
 * ../scripts/details-engine.ts.
 */
import "../styles/details-control.css";

interface Props {
  locale?: "en" | "de";
  /** The region the switch reshapes, for aria-controls. */
  controls?: string;
}

const { locale = "en", controls } = Astro.props;

type Id = "simple" | "standard" | "technical";
const copy = locale === "de"
  ? {
      group: "Seitentiefe",
      open: "Seitentiefe wählen",
      names: { simple: "Warum", standard: "Was", technical: "Wie" },
      hints: {
        simple: "Ergebnisse und Nutzen, weniger technische Details",
        standard: "Das Produkt, wie es ist",
        technical: "Die technischen Details für Entwicklung und IT",
      },
      notes: {
        simple: "Warum: Ergebnisse und Nutzen zuerst",
        standard: "Was: das Produkt, wie es ist",
        technical: "Wie: die technischen Details",
      },
    }
  : {
      group: "Page depth",
      open: "Choose the page depth",
      names: { simple: "Why", standard: "What", technical: "How" },
      hints: {
        simple: "Results and value, fewer technical details",
        standard: "The product as it is",
        technical: "The technical detail for engineering and IT",
      },
      notes: {
        simple: "Why: results and value first",
        standard: "What: the product as it is",
        technical: "How: the technical detail",
      },
    };
const ids: Id[] = ["simple", "standard", "technical"];
---

<div
  class="details-switch"
  data-details-slider
  data-details-switch
  data-level="standard"
  style="--details-pos: 1;"
  data-notes={JSON.stringify(copy.notes)}
  data-names={JSON.stringify(copy.names)}
>
  <button
    type="button"
    class="details-switch__toggle"
    aria-expanded="false"
    aria-controls="details-switch-group"
    aria-label={copy.open}
    data-details-toggle
  >
    <span class="details-switch__glyph" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="details-switch__current" data-details-current>{copy.names.standard}</span>
    <svg class="details-switch__chevron" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
      <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div
    class="details-switch__group"
    id="details-switch-group"
    role="radiogroup"
    aria-label={copy.group}
    aria-controls={controls}
    data-details-group
  >
    <span class="details-switch__thumb" aria-hidden="true"></span>
    {ids.map((id) => (
      <button
        type="button"
        role="radio"
        class="details-switch__option"
        aria-checked={id === "standard" ? "true" : "false"}
        tabindex={id === "standard" ? 0 : -1}
        aria-label={copy.names[id]}
        aria-describedby={`details-hint-${id}`}
        data-details-choice={id}
      >
        <span class="details-switch__name">{copy.names[id]}</span>
        <span class="details-switch__hint" id={`details-hint-${id}`}>{copy.hints[id]}</span>
      </button>
    ))}
  </div>
  <span class="details-switch__note" aria-hidden="true" data-details-note></span>
  <span class="details-switch__status" role="status" aria-live="polite" data-details-status></span>
</div>

<script>
  import { createDepthEngine, EASE, isLevel, LEVELS, type Level } from "../scripts/details-engine";

  const root = document.documentElement;
  const storageKey = "inspr-details-level";
  const legacyStorageKey = "inspr-details";
  const linkParam = "details";
  const NOTE_MS = 3000;

  // The head script (/scripts/details-level.js) applied a stored or linked
  // level before the first paint; this reads the same sources.
  let level: Level = "standard";
  let fromLink = false;
  try {
    const url = new URL(window.location.href);
    const linked = url.searchParams.get(linkParam);
    if (isLevel(linked)) {
      level = linked;
      fromLink = true;
      url.searchParams.delete(linkParam);
      window.history.replaceState(window.history.state, "", url.toString());
    }
  } catch { /* The default works even without URL/history access. */ }
  if (!fromLink) {
    try {
      const remembered = localStorage.getItem(storageKey);
      if (isLevel(remembered)) level = remembered;
      else if (localStorage.getItem(legacyStorageKey) === "1") level = "technical";
    } catch { /* Storage is optional. */ }
  }
  const painted = root.getAttribute("data-details-level");

  const control = document.querySelector<HTMLElement>("[data-details-switch]");
  const group = control?.querySelector<HTMLElement>("[data-details-group]") ?? null;
  const options = Array.from(group?.querySelectorAll<HTMLButtonElement>("[data-details-choice]") ?? []);
  const toggle = control?.querySelector<HTMLButtonElement>("[data-details-toggle]") ?? null;
  const current = control?.querySelector<HTMLElement>("[data-details-current]") ?? null;
  const note = control?.querySelector<HTMLElement>("[data-details-note]") ?? null;
  const status = control?.querySelector<HTMLElement>("[data-details-status]") ?? null;
  const checked = () => options.find((option) => option.dataset.detailsChoice === level) ?? null;

  // Fill every live fact on the page once. It starts when the browser is
  // idle, at any level: the facts sit in folded drawers, so filling them
  // moves nothing, and a later switch to How measures them complete.
  let live: Promise<void> | null = null;
  const loadLive = () => {
    if (!document.querySelector("[data-live]")) return Promise.resolve();
    live ??= fillLive();
    return live;
  };
  const fillLive = async () => {
    const write = (name: string, value: string) => {
      for (const target of document.querySelectorAll<HTMLElement>(`[data-live="${name}"]`)) target.textContent = value;
    };
    try {
      const manifest = await fetch("/release.json", { cache: "no-store" }).then((response) => response.json());
      write("release", String(manifest?.deployment?.releaseId ?? "local build"));
      write("source", String(manifest?.source?.git ?? "unknown") + (manifest?.source?.dirty ? " (dirty)" : ""));
      write("deployed", String(manifest?.deployment?.deployedAt ?? "not deployed"));
    } catch {
      write("release", "unavailable");
      write("source", "unavailable");
      write("deployed", "unavailable");
    }
    try {
      const response = await fetch(window.location.pathname, { method: "HEAD", cache: "no-store" });
      const csp = response.headers.get("content-security-policy") ?? "";
      const hashes = csp.match(/'sha256-[^']+'/g)?.length ?? 0;
      write("csp", csp ? `script-src 'self' + ${hashes}` : "not exposed");
      write("hsts", response.headers.get("strict-transport-security") ? "preload" : "not exposed");
    } catch {
      write("csp", "unavailable");
      write("hsts", "unavailable");
    }
  };
  const idle = (task: () => void) => {
    const whenIdle = (window as { requestIdleCallback?: Window["requestIdleCallback"] }).requestIdleCallback;
    if (whenIdle) whenIdle.call(window, task, { timeout: 2500 });
    else window.setTimeout(task, 1200);
  };
  idle(() => void loadLive());

  const engine = createDepthEngine({
    initial: isLevel(painted) ? painted : "standard",
    beforeMove: (_, to) => (to === "technical" ? loadLive() : undefined),
    onMoveStart: (moving, anchor) => {
      document.dispatchEvent(new CustomEvent("inspr:details-moving", { detail: { level: moving, anchor } }));
    },
    onSettled: (settled, anchor) => {
      document.dispatchEvent(new CustomEvent("inspr:details-settled", { detail: { level: settled, anchor } }));
    },
    focusFallback: () => checked() ?? toggle,
  });
  // Land on the level at once: the page already paints it.
  void engine.apply(level, false);

  if (control && group && options.length === 3) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const notes = JSON.parse(control.dataset.notes ?? "{}") as Record<Level, string>;
    const names = JSON.parse(control.dataset.names ?? "{}") as Record<Level, string>;
    const familyHost = (url: URL) => url.hostname === "inspr.at" || url.hostname.endsWith(".inspr.at");

    // Links to other hosts of the family carry the depth, as they carry the
    // language; same-host links rely on storage.
    const syncLinks = () => {
      for (const link of document.querySelectorAll<HTMLAnchorElement>("a[href]")) {
        let url: URL;
        try {
          url = new URL(link.getAttribute("href") ?? "", window.location.href);
        } catch {
          continue;
        }
        if (url.origin === window.location.origin || !familyHost(url)) continue;
        if (level === "standard") url.searchParams.delete(linkParam);
        else url.searchParams.set(linkParam, level);
        link.setAttribute("href", url.toString());
      }
    };

    // The specs grid has a plain-words mode of its own; Why means on.
    const syncSpecs = () => {
      const specs = document.getElementById("specs");
      const specsControl = specs?.querySelector<HTMLButtonElement>("[data-specs-eli10]");
      if (!specs || !specsControl) return;
      const plain = specs.getAttribute("data-eli10") === "true";
      if (plain !== (level === "simple")) specsControl.click();
    };

    const afterScripts = (task: () => void) => {
      if (document.readyState === "complete") task();
      else window.addEventListener("DOMContentLoaded", task, { once: true });
    };

    // Popover and note hang from the control; on a narrow screen they shift
    // sideways (translate, never layout) to stay a gutter inside the edges.
    const GUTTER = 12;
    const keepInside = (element: HTMLElement) => {
      element.style.setProperty("--details-dx", "0px");
      const rect = element.getBoundingClientRect();
      const room = document.documentElement.clientWidth;
      const dx = rect.left < GUTTER ? GUTTER - rect.left : rect.right > room - GUTTER ? room - GUTTER - rect.right : 0;
      element.style.setProperty("--details-dx", `${Math.round(dx)}px`);
    };

    // The line beside the control: what the page now shows, or on hover
    // what a choice would show. Motion is opacity and transform only.
    let noteTimer = 0;
    const showNote = (text: string, hold = NOTE_MS) => {
      if (!note) return;
      window.clearTimeout(noteTimer);
      note.textContent = text;
      keepInside(note);
      control.classList.add("has-note");
      if (hold > 0) noteTimer = window.setTimeout(hideNote, hold);
    };
    const hideNote = () => {
      window.clearTimeout(noteTimer);
      control.classList.remove("has-note");
    };

    const setLevel = (next: Level, source: "init" | "user", persist = true) => {
      const changed = next !== level || source === "init";
      level = next;
      const position = LEVELS.indexOf(level);
      control.dataset.level = level;
      control.style.setProperty("--details-pos", String(position));
      for (const option of options) {
        const on = option.dataset.detailsChoice === level;
        option.setAttribute("aria-checked", String(on));
        option.tabIndex = on ? 0 : -1;
      }
      if (current) current.textContent = names[level] ?? level;
      if (source !== "init") void engine.apply(level, true);
      if (persist) {
        try {
          localStorage.setItem(storageKey, level);
        } catch {
          // Storage may be unavailable; the control still works for this visit.
        }
      }
      syncLinks();
      afterScripts(syncSpecs);
      if (level === "technical") void loadLive();
      if (source === "user" && changed) {
        showNote(notes[level] ?? "");
        if (status) status.textContent = notes[level] ?? "";
      }
      document.dispatchEvent(new CustomEvent("inspr:details-level", { detail: { level, source } }));
    };

    // ---- The phone popover ------------------------------------------------
    const popoverMode = () => toggle !== null && getComputedStyle(toggle).display !== "none";
    let open = false;
    const openPopover = () => {
      if (open || !toggle) return;
      open = true;
      control.dataset.open = "";
      toggle.setAttribute("aria-expanded", "true");
      keepInside(group);
      if (!reducedMotion.matches) {
        group.animate(
          [{ opacity: 0, transform: "translateY(-6px) scale(0.97)" }, { opacity: 1, transform: "none" }],
          { duration: 240, easing: EASE },
        );
      }
      checked()?.focus({ preventScroll: true });
    };
    const closePopover = (refocus: boolean) => {
      if (!open || !toggle) return;
      open = false;
      toggle.setAttribute("aria-expanded", "false");
      const done = () => {
        if (!open) delete control.dataset.open;
      };
      if (reducedMotion.matches) done();
      else {
        group.animate(
          [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-6px) scale(0.97)" }],
          { duration: 180, easing: EASE },
        ).finished.then(done, done);
      }
      if (refocus) toggle.focus({ preventScroll: true });
    };
    toggle?.addEventListener("click", () => (open ? closePopover(true) : openPopover()));
    toggle?.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && open) {
        event.preventDefault();
        event.stopPropagation();
        closePopover(true);
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (open && !control.contains(event.target as Node)) closePopover(false);
    });
    control.addEventListener("focusout", (event) => {
      if (open && !control.contains(event.relatedTarget as Node | null)) closePopover(false);
    });

    // ---- Choosing ---------------------------------------------------------
    for (const option of options) {
      option.addEventListener("click", () => {
        const next = option.dataset.detailsChoice;
        if (isLevel(next) && next !== level) setLevel(next, "user");
        if (open) closePopover(true);
      });
      // A fine pointer previews what a choice shows, in the same line.
      option.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse" || popoverMode()) return;
        const id = option.dataset.detailsChoice;
        if (isLevel(id)) showNote(notes[id] ?? "", 0);
      });
      option.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "mouse" && !popoverMode()) hideNote();
      });
    }

    // Radio-group keys: arrows move and choose, Home and End jump.
    group.addEventListener("keydown", (event) => {
      const index = LEVELS.indexOf(level);
      const target =
        event.key === "ArrowRight" || event.key === "ArrowDown" ? Math.min(2, index + 1) :
        event.key === "ArrowLeft" || event.key === "ArrowUp" ? Math.max(0, index - 1) :
        event.key === "Home" ? 0 :
        event.key === "End" ? 2 : null;
      if (event.key === "Escape" && open) {
        event.preventDefault();
        event.stopPropagation();
        closePopover(true);
        return;
      }
      if (target === null) return;
      event.preventDefault();
      event.stopPropagation();
      if (LEVELS[target] !== level) setLevel(LEVELS[target], "user");
      checked()?.focus({ preventScroll: true });
    });

    // In-page navigation also works when its destination is folded away.
    document.addEventListener("click", (event) => {
      const anchor = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      const id = anchor?.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target || target.getClientRects().length > 0) return;
      event.preventDefault();
      setLevel("standard", "user");
      history.replaceState(history.state, "", `#${id}`);
      const reveal = () => target.scrollIntoView({ behavior: reducedMotion.matches ? "instant" : "smooth" });
      document.addEventListener("inspr:details-settled", reveal, { once: true });
    });

    document.addEventListener("inspr:details-request", (event) => {
      const requested = (event as CustomEvent<{ level?: unknown }>).detail?.level;
      if (isLevel(requested)) setLevel(requested, "user");
    });

    setLevel(level, "init", fromLink);
  }
</script>
