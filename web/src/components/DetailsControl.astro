---
/**
 * The Details control: a wordless level slider, three notches, like a
 * volume control. Left of it a glyph of three rising bars fills with the
 * level. No visible level names, no caption, no tooltip; screen readers get
 * a real slider with a value text.
 *
 *   0 simple     plain words for deciders, less on the page
 *   1 standard   the page as most readers see it (renders without JavaScript)
 *   2 technical  terms of art, more on the page; the Overview opens its scene
 *
 * The control owns the level: it stamps `data-details-level` on <html>,
 * remembers the choice like the language choice, honours `?details=` on
 * arrival so the depth travels between the family's hosts, keeps cross-host
 * links carrying it, and switches the specs grid's plain-words mode on for
 * Simple. Other scripts listen for `inspr:details-level` and may ask for a
 * change with `inspr:details-request`.
 */
import "../styles/details-control.css";

interface Props {
  label: string;
  description: string;
  controls?: string;
  levels: Array<{ id: "simple" | "standard" | "technical"; label: string }>;
}

const { label, description, controls, levels } = Astro.props;
---

<div class="details-slider" data-details-slider data-level="standard" style="--details-pos: 1;">
  <span class="details-slider__label" aria-hidden="true">{label}</span>
  <span class="details-slider__glyph" aria-hidden="true"><i></i><i></i><i></i></span>
  <div
    class="details-slider__track"
    role="slider"
    tabindex="0"
    aria-label={description}
    aria-controls={controls}
    aria-valuemin="0"
    aria-valuemax="2"
    aria-valuenow="1"
    aria-valuetext={levels[1]?.label}
    data-details-track
  >
    <span class="details-slider__fill" aria-hidden="true"></span>
    {levels.map((level, index) => (
      <span
        class="details-slider__notch"
        style={`--i: ${index};`}
        data-details-level={level.id}
        data-details-name={level.label}
        aria-hidden="true"
      ></span>
    ))}
    <span class="details-slider__knob" aria-hidden="true"></span>
  </div>
</div>

<script>
  type Level = "simple" | "standard" | "technical";
  const LEVELS: Level[] = ["simple", "standard", "technical"];
  const isLevel = (value: unknown): value is Level => LEVELS.includes(value as Level);
  const root = document.documentElement;
  const storageKey = "inspr-details-level";
  const legacyStorageKey = "inspr-details";
  const linkParam = "details";
  let level: Level = "standard";
  let fromLink = false;
  try {
    const url = new URL(window.location.href);
    const linked = url.searchParams.get(linkParam);
    if (isLevel(linked)) {
      level = linked;
      fromLink = true;
      url.searchParams.delete(linkParam);
      window.history.replaceState(window.history.state, "", url.toString());
    }
  } catch { /* The default works even without URL/history access. */ }
  if (!fromLink) {
    try {
      const remembered = localStorage.getItem(storageKey);
      if (isLevel(remembered)) level = remembered;
      else if (localStorage.getItem(legacyStorageKey) === "1") level = "technical";
    } catch { /* Storage is optional. */ }
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const FOLD_STAGGER_MS = 25;
  const FOLD_STAGGER_CAP = 8;
  const FOLD_MIN_DURATION_MS = 450;
  const FOLD_MAX_DURATION_MS = 800;
  const FOLD_HEIGHT_CAP_PX = 1600;
  const FOLD_TIMEOUT_BUFFER_MS = 50;
  const folds = Array.from(document.querySelectorAll<HTMLElement>("[data-depth-min], [data-depth-max]"));
  // Outer boxes animate too, so removing a grid column or reducing its gaps
  // never instantly moves the following section. These boxes stay open.
  folds.push(...document.querySelectorAll<HTMLElement>("[data-depth-layout]:not([data-depth-min]):not([data-depth-max])"));
  folds.sort((a, b) => a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);
  const spacing = ["margin-block-start", "margin-block-end", "padding-block-start", "padding-block-end"];
  const pending = new Map<HTMLElement, () => void>();
  const isClosed = (element: HTMLElement, next: Level) => {
    const depth = LEVELS.indexOf(next);
    const min = element.dataset.depthMin;
    const max = element.dataset.depthMax;
    return (isLevel(min) && depth < LEVELS.indexOf(min)) || (isLevel(max) && depth > LEVELS.indexOf(max));
  };
  const settle = (element: HTMLElement, closed: boolean) => {
    element.classList.toggle("is-folding", closed);
    element.classList.toggle("is-folded", closed);
    element.inert = closed;
    element.style.height = closed ? "" : "auto";
    element.style.removeProperty("overflow");
    element.style.removeProperty("min-height");
    element.style.removeProperty("opacity");
    element.style.removeProperty("transition");
    element.style.removeProperty("transition-delay");
    element.style.removeProperty("transition-duration");
    spacing.forEach((property) => element.style.removeProperty(property));
  };
  const foldTo = (next: Level, animate: boolean) => {
    const previous = root.getAttribute("data-details-level");
    const compactChanged = (previous === "simple") !== (next === "simple");
    const activeElement = document.activeElement;
    const active = folds.map((element) => pending.has(element)
      || !isLevel(previous) || isClosed(element, previous) !== isClosed(element, next)
      || (compactChanged && element.hasAttribute("data-depth-layout") && !isClosed(element, next)));
    // Read every current box BEFORE changing copy depth or compact layout.
    // On reversal these are the interpolated pixels, never the old endpoint.
    const snapshots = folds.map((element) => {
      const css = getComputedStyle(element);
      return {
        height: element.getBoundingClientRect().height,
        opacity: css.opacity,
        spacing: spacing.map((property) => css.getPropertyValue(property)),
      };
    });
    root.setAttribute("data-details-level", next);
    const closed = folds.map((element) => isClosed(element, next));
    // Measure the complete destination layout in one pass: nested folds must
    // already have their destination state when their parent is measured.
    folds.forEach((element, index) => {
      pending.get(element)?.();
      settle(element, closed[index]);
      element.style.transition = "none";
    });
    if (!animate || reducedMotion.matches) {
      folds.forEach((element, index) => settle(element, closed[index]));
      return;
    }
    const targets = folds.map((element, index) => {
      const css = getComputedStyle(element);
      return {
        height: closed[index] ? 0 : element.scrollHeight + parseFloat(css.borderTopWidth) + parseFloat(css.borderBottomWidth),
        opacity: closed[index] ? "0" : css.opacity,
        spacing: spacing.map((property) => css.getPropertyValue(property)),
      };
    });
    folds.forEach((element, index) => {
      if (!active[index]) {
        settle(element, closed[index]);
        return;
      }
      const current = snapshots[index];
      element.classList.remove("is-folded");
      element.style.overflow = "hidden";
      element.style.minHeight = "0";
      element.style.height = `${current.height}px`;
      element.style.opacity = current.opacity;
      spacing.forEach((property, i) => element.style.setProperty(property, current.spacing[i]));
      if (closed[index] && element.contains(activeElement)) track?.focus({ preventScroll: true });
    });
    void root.offsetHeight;
    let activeIndex = 0;
    folds.forEach((element, index) => {
      if (!active[index]) return;
      const target = targets[index];
      const delay = Math.min(activeIndex, FOLD_STAGGER_CAP) * FOLD_STAGGER_MS;
      const height = Math.max(snapshots[index].height, target.height);
      const duration = FOLD_MIN_DURATION_MS
        + (Math.min(height, FOLD_HEIGHT_CAP_PX) / FOLD_HEIGHT_CAP_PX)
          * (FOLD_MAX_DURATION_MS - FOLD_MIN_DURATION_MS);
      activeIndex += 1;
      element.style.removeProperty("transition");
      element.style.transitionDelay = `${delay}ms`;
      element.style.transitionDuration = `${duration}ms`;
      element.style.height = `${target.height}px`;
      element.style.opacity = target.opacity;
      spacing.forEach((property, i) => element.style.setProperty(property, target.spacing[i]));
      const cancel = () => {
        window.clearTimeout(timer);
        element.removeEventListener("transitionend", onEnd);
        pending.delete(element);
      };
      const finish = () => {
        cancel();
        if (isClosed(element, level) === closed[index]) settle(element, closed[index]);
      };
      const onEnd = (event: TransitionEvent) => {
        if (event.target === element && event.propertyName === "height"
          && !folds.some((child) => child !== element && element.contains(child) && pending.has(child))) finish();
      };
      // Zero-height elements and detached/hidden ancestors emit no height end.
      const timer = window.setTimeout(finish, duration + delay + FOLD_TIMEOUT_BUFFER_MS);
      element.addEventListener("transitionend", onEnd);
      pending.set(element, cancel);
    });
  };

  // Apply remembered folds immediately, before numbering drawers or live work.
  foldTo(level, false);
  const drawers = Array.from(document.querySelectorAll<HTMLElement>("[data-drawer]"));
  drawers.forEach((drawer, index) => drawer.style.setProperty("--drawer-i", String(Math.min(index, 8))));
  const slider = document.querySelector<HTMLElement>("[data-details-slider]");
  const track = slider?.querySelector<HTMLElement>("[data-details-track]") ?? null;
  const notches = Array.from(slider?.querySelectorAll<HTMLElement>("[data-details-level]") ?? []);
  reducedMotion.addEventListener("change", () => foldTo(level, false));
  window.addEventListener("resize", () => {
    if (pending.size) foldTo(level, false);
  });

  // Fill every live fact on the page once, when Technical is first applied.
  let liveLoaded = false;

  const loadLive = async () => {
    if (liveLoaded || !document.querySelector("[data-live]")) return;
    liveLoaded = true;
    const write = (name: string, value: string) => {
      for (const target of document.querySelectorAll<HTMLElement>(`[data-live="${name}"]`)) target.textContent = value;
    };
    try {
      const manifest = await fetch("/release.json", { cache: "no-store" }).then((response) => response.json());
      write("release", String(manifest?.deployment?.releaseId ?? "local build"));
      write("source", String(manifest?.source?.git ?? "unknown") + (manifest?.source?.dirty ? " (dirty)" : ""));
      write("deployed", String(manifest?.deployment?.deployedAt ?? "not deployed"));
    } catch {
      write("release", "unavailable");
      write("source", "unavailable");
      write("deployed", "unavailable");
    }
    try {
      const response = await fetch(window.location.pathname, { method: "HEAD", cache: "no-store" });
      const csp = response.headers.get("content-security-policy") ?? "";
      const hashes = csp.match(/'sha256-[^']+'/g)?.length ?? 0;
      write("csp", csp ? `script-src 'self' + ${hashes}` : "not exposed");
      write("hsts", response.headers.get("strict-transport-security") ? "preload" : "not exposed");
    } catch {
      write("csp", "unavailable");
      write("hsts", "unavailable");
    }
  };

  if (slider && track && notches.length === 3) {
    const familyHost = (url: URL) => url.hostname === "inspr.at" || url.hostname.endsWith(".inspr.at");
    const nameOf = (value: Level) => notches.find((notch) => notch.dataset.detailsLevel === value)?.dataset.detailsName ?? value;

    // Links to other hosts of the family carry the depth, as they carry the
    // language; same-host links rely on storage.
    const syncLinks = () => {
      for (const link of document.querySelectorAll<HTMLAnchorElement>("a[href]")) {
        let url: URL;
        try {
          url = new URL(link.getAttribute("href") ?? "", window.location.href);
        } catch {
          continue;
        }
        if (url.origin === window.location.origin || !familyHost(url)) continue;
        if (level === "standard") url.searchParams.delete(linkParam);
        else url.searchParams.set(linkParam, level);
        link.setAttribute("href", url.toString());
      }
    };

    // The specs grid has a plain-words mode of its own; Simple means on.
    const syncSpecs = () => {
      const specs = document.getElementById("specs");
      const control = specs?.querySelector<HTMLButtonElement>("[data-specs-eli10]");
      if (!specs || !control) return;
      const plain = specs.getAttribute("data-eli10") === "true";
      if (plain !== (level === "simple")) control.click();
    };

    const afterScripts = (task: () => void) => {
      if (document.readyState === "complete") task();
      else window.addEventListener("DOMContentLoaded", task, { once: true });
    };

    const setLevel = (next: Level, source: "init" | "user", persist = true) => {
      level = next;
      const position = LEVELS.indexOf(level);
      foldTo(level, source !== "init");
      slider.dataset.level = level;
      slider.style.setProperty("--details-pos", String(position));
      track.setAttribute("aria-valuenow", String(position));
      track.setAttribute("aria-valuetext", nameOf(level));
      if (persist) {
        try {
          localStorage.setItem(storageKey, level);
        } catch {
          // Storage may be unavailable; the control still works for this visit.
        }
      }
      syncLinks();
      afterScripts(syncSpecs);
      if (level === "technical") void loadLive();
      document.dispatchEvent(new CustomEvent("inspr:details-level", { detail: { level, source } }));
    };

    const step = (delta: number) => {
      const next = LEVELS[Math.min(2, Math.max(0, LEVELS.indexOf(level) + delta))];
      if (next !== level) setLevel(next, "user");
    };

    // In-page navigation also works when its destination is folded.
    document.addEventListener("click", (event) => {
      const anchor = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      const id = anchor?.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;
      const folded = target?.closest<HTMLElement>(".is-folding, .is-folded")
        ?? (id === "capabilities" ? target?.querySelector<HTMLElement>(".is-folding, .is-folded") : null);
      if (!target || !folded) return;
      event.preventDefault();
      setLevel("standard", "user");
      history.replaceState(history.state, "", `#${id}`);
      window.setTimeout(
        () => target.scrollIntoView({ behavior: reducedMotion.matches ? "instant" : "smooth" }),
        reducedMotion.matches ? 0 : FOLD_MAX_DURATION_MS + FOLD_STAGGER_CAP * FOLD_STAGGER_MS + FOLD_TIMEOUT_BUFFER_MS,
      );
    });

    // Click or drag anywhere on the track; the nearest notch wins.
    const levelAt = (clientX: number): Level => {
      const rect = track.getBoundingClientRect();
      const inset = 8;
      const ratio = (clientX - rect.left - inset) / Math.max(1, rect.width - inset * 2);
      return LEVELS[Math.min(2, Math.max(0, Math.round(ratio * 2)))];
    };
    let dragging = false;
    track.addEventListener("pointerdown", (event) => {
      dragging = true;
      track.setPointerCapture(event.pointerId);
      const next = levelAt(event.clientX);
      if (next !== level) setLevel(next, "user");
      event.preventDefault();
    });
    track.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const next = levelAt(event.clientX);
      if (next !== level) setLevel(next, "user");
    });
    const endDrag = () => {
      dragging = false;
    };
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);

    // Wheel over the control nudges it; keys move it like any slider.
    let wheelBudget = 0;
    track.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        wheelBudget += event.deltaY !== 0 ? -event.deltaY : event.deltaX;
        if (Math.abs(wheelBudget) < 40) return;
        step(wheelBudget > 0 ? 1 : -1);
        wheelBudget = 0;
      },
      { passive: false },
    );
    track.addEventListener("keydown", (event) => {
      const delta =
        event.key === "ArrowRight" || event.key === "ArrowUp" ? 1 :
        event.key === "ArrowLeft" || event.key === "ArrowDown" ? -1 : 0;
      if (event.key === "Home") setLevel("simple", "user");
      else if (event.key === "End") setLevel("technical", "user");
      else if (delta !== 0) step(delta);
      else return;
      event.preventDefault();
      event.stopPropagation();
    });

    document.addEventListener("inspr:details-request", (event) => {
      const requested = (event as CustomEvent<{ level?: unknown }>).detail?.level;
      if (isLevel(requested)) setLevel(requested, "user");
    });

    setLevel(level, "init", fromLink);
  }
</script>
