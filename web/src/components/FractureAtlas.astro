---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ContextIcon from "./ContextIcon.astro";
import type { CardItem } from "../content/types";

interface Props {
  id: string;
  items: CardItem[];
  image: ImageMetadata;
  alt: string;
  caption: string;
}

const { id, items, image, alt, caption } = Astro.props;
const fallbackIcons = ["unplug", "eye-off", "file-warning", "database-zap"];
---

<div class="fracture-atlas" aria-label="Problem map">
  <figure class="fracture-atlas__field">
    <Image
      src={image}
      alt={alt}
      widths={[420, 640, 840]}
      sizes="(min-width: 54rem) 34vw, 100vw"
      loading="lazy"
      decoding="async"
    />
    <figcaption>{caption}</figcaption>
  </figure>

  <ol class="fracture-atlas__points">
    {items.map((item, index) => (
      <li>
        <article tabindex="0" aria-labelledby={`${id}-fracture-${index}`}>
          <span class="fracture-atlas__index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="fracture-atlas__icon" aria-hidden="true">
            <ContextIcon
              name={item.icon ?? fallbackIcons[index % fallbackIcons.length]}
              size={23}
              strokeWidth={2}
            />
          </span>
          <div>
            <h3 id={`${id}-fracture-${index}`}>{item.title}</h3>
            <p>{item.body}</p>
            {item.meta && <strong>{item.meta}</strong>}
            {item.reference && (
              <a
                href={item.reference.href}
                target={item.reference.external === false ? undefined : "_blank"}
                rel={item.reference.external === false ? undefined : "noopener noreferrer"}
              >
                {item.reference.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>
</div>

<style>
  .fracture-atlas {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .fracture-atlas__field {
    position: relative;
    min-height: 29rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
    border-radius: 2rem;
    background: color-mix(in srgb, var(--paper) 92%, var(--accent));
    box-shadow: var(--shadow-soft);
  }

  .fracture-atlas__field :global(img) {
    width: 100%;
    height: 100%;
    min-height: 29rem;
    object-fit: cover;
    object-position: center;
  }

  .fracture-atlas__field figcaption {
    position: absolute;
    inset: auto 1rem 1rem;
    z-index: 2;
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: 0.85rem 1rem;
    color: #f5f7f7;
    background: color-mix(in srgb, var(--ink) 78%, transparent);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 1rem;
    box-shadow: 0 0.75rem 2.5rem rgba(8, 27, 42, 0.18);
    backdrop-filter: blur(15px) saturate(120%);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    line-height: 1.45;
    letter-spacing: 0.045em;
  }

  .fracture-atlas__points {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .fracture-atlas__points article {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 1.15rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .fracture-atlas__points li:last-child article { border-bottom: 0; }

  .fracture-atlas__points article:hover,
  .fracture-atlas__points article:focus-visible {
    transform: translateX(0.35rem);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    background: color-mix(in srgb, var(--paper) 88%, var(--accent));
  }

  .fracture-atlas__points article:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 76%, white);
    outline-offset: -3px;
  }

  .fracture-atlas__index {
    padding-top: 0.45rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .fracture-atlas__icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
    border-radius: 0.9rem;
    color: var(--accent);
    background: var(--paper);
  }

  .fracture-atlas h3 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.05rem, 2vw, 1.32rem);
  }

  .fracture-atlas p { margin: 0; }

  .fracture-atlas strong {
    display: block;
    margin-top: 0.65rem;
    color: var(--accent-dark);
    font-size: 0.84rem;
  }

  .fracture-atlas a {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--accent-dark);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 54rem) {
    .fracture-atlas { grid-template-columns: 1fr; }
    .fracture-atlas__field { min-height: 18rem; }
  }

  @media (max-width: 34rem) {
    .fracture-atlas__points article { grid-template-columns: auto minmax(0, 1fr); }
    .fracture-atlas__index { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fracture-atlas__points article { transition: none; }
  }
</style>
