---
import ContextIcon from "./ContextIcon.astro";
import type { CardItem } from "../content/types";

interface Props {
  id: string;
  items: CardItem[];
}

const { id, items } = Astro.props;
const fallbackIcons = ["unplug", "eye-off", "file-warning", "database-zap"];
---

<div class="fracture-atlas" aria-label="Problem map">
  <div class="fracture-atlas__field" aria-hidden="true">
    <span class="fracture-atlas__fault"></span>
    <span class="fracture-atlas__pulse fracture-atlas__pulse--one"></span>
    <span class="fracture-atlas__pulse fracture-atlas__pulse--two"></span>
    <p>Disconnected signals create operational blind spots.</p>
  </div>

  <ol class="fracture-atlas__points">
    {items.map((item, index) => (
      <li>
        <article tabindex="0" aria-labelledby={`${id}-fracture-${index}`}>
          <span class="fracture-atlas__index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="fracture-atlas__icon" aria-hidden="true">
            <ContextIcon
              name={item.icon ?? fallbackIcons[index % fallbackIcons.length]}
              size={23}
              strokeWidth={2}
            />
          </span>
          <div>
            <h3 id={`${id}-fracture-${index}`}>{item.title}</h3>
            <p>{item.body}</p>
            {item.meta && <strong>{item.meta}</strong>}
            {item.reference && (
              <a
                href={item.reference.href}
                target={item.reference.external === false ? undefined : "_blank"}
                rel={item.reference.external === false ? undefined : "noreferrer"}
              >
                {item.reference.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      </li>
    ))}
  </ol>
</div>

<style>
  .fracture-atlas {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .fracture-atlas__field {
    position: relative;
    min-height: 29rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
    border-radius: 2rem;
    background:
      radial-gradient(circle at 18% 16%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 34%),
      linear-gradient(145deg, color-mix(in srgb, var(--paper) 92%, var(--accent)), var(--paper));
    box-shadow: var(--shadow-soft);
    isolation: isolate;
  }

  .fracture-atlas__field::before,
  .fracture-atlas__field::after {
    content: "";
    position: absolute;
    inset: 10%;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    border-radius: 1.1rem;
    transform: rotate(-9deg) skewY(-8deg);
  }

  .fracture-atlas__field::after {
    inset: 22%;
    transform: rotate(17deg) skewX(9deg);
  }

  .fracture-atlas__field p {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    z-index: 2;
    max-width: 17rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fracture-atlas__fault {
    position: absolute;
    inset: -12% auto -12% 48%;
    width: 0.32rem;
    background: linear-gradient(180deg, transparent, var(--accent), transparent);
    transform: rotate(17deg);
    filter: drop-shadow(0 0 1rem color-mix(in srgb, var(--accent) 45%, transparent));
  }

  .fracture-atlas__fault::before,
  .fracture-atlas__fault::after {
    content: "";
    position: absolute;
    width: 5.5rem;
    height: 0.18rem;
    background: inherit;
    transform-origin: left center;
  }

  .fracture-atlas__fault::before {
    top: 31%;
    transform: rotate(43deg);
  }

  .fracture-atlas__fault::after {
    top: 62%;
    transform: rotate(139deg);
  }

  .fracture-atlas__pulse {
    position: absolute;
    width: 1rem;
    aspect-ratio: 1;
    border-radius: 0.18rem;
    background: var(--accent);
    box-shadow: 0 0 0 0.7rem color-mix(in srgb, var(--accent) 10%, transparent);
    transform: rotate(45deg);
  }

  .fracture-atlas__pulse--one { top: 29%; left: 36%; }
  .fracture-atlas__pulse--two { top: 59%; left: 60%; }

  .fracture-atlas__points {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .fracture-atlas__points article {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 1.15rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .fracture-atlas__points li:last-child article { border-bottom: 0; }

  .fracture-atlas__points article:hover,
  .fracture-atlas__points article:focus-visible {
    transform: translateX(0.35rem);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    background: color-mix(in srgb, var(--paper) 88%, var(--accent));
  }

  .fracture-atlas__points article:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 76%, white);
    outline-offset: -3px;
  }

  .fracture-atlas__index {
    padding-top: 0.45rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .fracture-atlas__icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
    border-radius: 0.9rem;
    color: var(--accent);
    background: var(--paper);
  }

  .fracture-atlas h3 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.05rem, 2vw, 1.32rem);
  }

  .fracture-atlas p { margin: 0; }

  .fracture-atlas strong {
    display: block;
    margin-top: 0.65rem;
    color: var(--accent-dark);
    font-size: 0.84rem;
  }

  .fracture-atlas a {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--accent-dark);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 54rem) {
    .fracture-atlas { grid-template-columns: 1fr; }
    .fracture-atlas__field { min-height: 18rem; }
  }

  @media (max-width: 34rem) {
    .fracture-atlas__points article { grid-template-columns: auto minmax(0, 1fr); }
    .fracture-atlas__index { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fracture-atlas__points article { transition: none; }
  }
</style>
