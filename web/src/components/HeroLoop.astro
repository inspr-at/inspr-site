---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: "inspr" | "aithema" | "paimos" | "pharos" | "janus";
  poster: ImageMetadata;
  video: string;
  alt: string;
  sizes: string;
  locale?: "en" | "de";
  activation?: "autoplay" | "hover";
  showControl?: boolean;
  loading?: "eager" | "lazy";
}

const {
  id,
  poster,
  video,
  alt,
  sizes,
  locale = "en",
  activation = "autoplay",
  showControl = true,
  loading = "eager",
} = Astro.props;
const labels = locale === "de"
  ? {
      pause: "Pausieren",
      resume: "Fortsetzen",
      pauseAccessible: "Hero-Animation pausieren",
      resumeAccessible: "Hero-Animation fortsetzen",
    }
  : {
      pause: "Pause",
      resume: "Resume",
      pauseAccessible: "Pause hero animation",
      resumeAccessible: "Resume hero animation",
    };
---

<div
  class="hero-loop"
  data-hero-loop={id}
  data-pause-label={labels.pause}
  data-resume-label={labels.resume}
  data-pause-accessible-label={labels.pauseAccessible}
  data-resume-accessible-label={labels.resumeAccessible}
  data-activation={activation}
>
  <Image
    class="hero-loop__poster"
    src={poster}
    alt={alt}
    widths={[720, 960, 1280, 1600]}
    sizes={sizes}
    quality={84}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : "auto"}
  />

  <video
    class="hero-loop__video"
    data-hero-video={id}
    autoplay={activation === "autoplay"}
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster.src}
    aria-hidden="true"
    tabindex="-1"
  >
    <source
      src={video}
      type="video/mp4"
      media="(prefers-reduced-motion: no-preference)"
    />
  </video>

  {showControl && (
    <button
      class="hero-loop__control"
      type="button"
      aria-pressed="false"
      aria-label={labels.pauseAccessible}
      title={labels.pauseAccessible}
    >
      <svg class="hero-loop__pause" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="6.5" y="5" width="3.5" height="14" rx="1"></rect>
        <rect x="14" y="5" width="3.5" height="14" rx="1"></rect>
      </svg>
      <svg class="hero-loop__play" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.8a1 1 0 0 1 1.52-.85l10 6.2a1 1 0 0 1 0 1.7l-10 6.2A1 1 0 0 1 8 18.2V5.8Z"></path>
      </svg>
      <span>{labels.pause}</span>
    </button>
  )}
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-hero-loop]").forEach((loop) => {
    if (loop.dataset.heroLoopReady === "true") return;
    loop.dataset.heroLoopReady = "true";

    const video = loop.querySelector<HTMLVideoElement>("[data-hero-video]");
    const control = loop.querySelector<HTMLButtonElement>(".hero-loop__control");
    const label = control?.querySelector<HTMLElement>("span");
    if (!video) return;

    let userPaused = false;
    let inView = true;
    const hoverOnly = loop.dataset.activation === "hover";
    let hoverActive = !hoverOnly;

    const syncControl = () => {
      if (!control || !label) return;
      const action = userPaused
        ? loop.dataset.resumeLabel ?? "Resume"
        : loop.dataset.pauseLabel ?? "Pause";
      const accessibleName = userPaused
        ? loop.dataset.resumeAccessibleLabel ?? "Resume hero animation"
        : loop.dataset.pauseAccessibleLabel ?? "Pause hero animation";
      control.ariaPressed = String(userPaused);
      control.setAttribute("aria-label", accessibleName);
      control.title = accessibleName;
      label.textContent = action;
      loop.toggleAttribute("data-user-paused", userPaused);
    };

    const shouldPlay = () =>
      !reducedMotion.matches && !userPaused && inView && hoverActive && !document.hidden;

    const applyPlayback = () => {
      if (!shouldPlay()) {
        video.pause();
        return;
      }

      void video.play().catch(() => {
        loop.removeAttribute("data-video-playing");
      });
    };

    video.addEventListener("playing", () => {
      loop.setAttribute("data-video-ready", "true");
      loop.setAttribute("data-video-playing", "true");
    });
    video.addEventListener("pause", () => loop.removeAttribute("data-video-playing"));

    control?.addEventListener("click", () => {
      userPaused = !userPaused;
      syncControl();
      applyPlayback();
    });

    if (hoverOnly) {
      loop.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "touch") return;
        hoverActive = true;
        if (video.readyState > 0) video.currentTime = 0;
        applyPlayback();
      });
      loop.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "touch") return;
        hoverActive = false;
        applyPlayback();
        if (video.readyState > 0) video.currentTime = 0;
      });
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = entry?.isIntersecting ?? false;
        applyPlayback();
      },
      { threshold: 0.08 },
    );
    observer.observe(loop);

    reducedMotion.addEventListener("change", applyPlayback);
    document.addEventListener("visibilitychange", applyPlayback);
    syncControl();
    applyPlayback();
  });
</script>

<style>
  .hero-loop {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }

  .hero-loop :global(picture),
  .hero-loop :global(img),
  .hero-loop__video {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-loop :global(img),
  .hero-loop__video {
    object-fit: cover;
    object-position: center;
  }

  .hero-loop__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 380ms ease, transform 1.3s var(--ease, ease);
  }

  .hero-loop[data-activation="autoplay"][data-video-ready="true"] .hero-loop__video,
  .hero-loop[data-activation="hover"][data-video-playing="true"] .hero-loop__video {
    opacity: 1;
  }

  .hero-loop__control {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.55rem;
    padding: 0.55rem 0.8rem;
    color: var(--ink, #0b2a3d);
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 999px;
    background: rgb(255 253 249 / 0.82);
    box-shadow: 0 0.5rem 1.4rem rgb(8 31 43 / 0.14);
    opacity: 0;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transform: translateY(0.35rem);
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease, border-color 180ms ease;
    font: 700 0.72rem/1 var(--font-sans, sans-serif);
  }

  .hero-loop:hover .hero-loop__control,
  .hero-loop:focus-within .hero-loop__control,
  .hero-loop__control:focus-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hero-loop__control:hover,
  .hero-loop__control:focus-visible {
    border-color: color-mix(in srgb, var(--accent, #168b87) 55%, white);
  }

  .hero-loop__control:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent, #168b87) 70%, white);
    outline-offset: 3px;
  }

  .hero-loop__control svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .hero-loop__play,
  .hero-loop[data-user-paused] .hero-loop__pause {
    display: none;
  }

  .hero-loop[data-user-paused] .hero-loop__play {
    display: block;
  }

  @media (hover: none), (pointer: coarse) {
    .hero-loop__control {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-loop__video,
    .hero-loop__control {
      display: none;
    }
  }
</style>
