---
import { productLinks, siteUrls } from "../content/urls";
import { releaseMetadata } from "../../release-metadata.mjs";

interface Props {
  name: string;
  repositoryUrl: string;
  licenseName?: string;
  licenseUrl?: string;
  ctaTitle: string;
  ctaBody: string;
}

const {
  name,
  repositoryUrl,
  licenseName,
  licenseUrl,
  ctaTitle,
  ctaBody,
} = Astro.props;

const year = new Date().getUTCFullYear();
const deployedAtLabel = releaseMetadata.deployedAt
  ? `${new Intl.DateTimeFormat("en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "UTC",
    }).format(new Date(releaseMetadata.deployedAt))} UTC`
  : "Local build";
---

<footer class="site-footer">
  <section class="footer-cta page-shell" aria-labelledby="footer-cta-title">
    <div>
      <p class="eyebrow">Professional path</p>
      <h2 id="footer-cta-title">{ctaTitle}</h2>
      <p>{ctaBody}</p>
    </div>
    <a class="button button--light" href={siteUrls.business} target="_blank" rel="noopener noreferrer">
      Explore Augmentoring services <span aria-hidden="true">↗</span>
    </a>
  </section>

  <div class="site-footer__grid page-shell">
    <div class="site-footer__brand">
      <strong>{name}</strong>
      <p>Part of INSPR, the technology umbrella for people and AI agents.</p>
    </div>

    <nav aria-label="INSPR products">
      <p class="footer-label">Product family</p>
      {productLinks.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.label}, opens in a new tab`}>{item.label}</a>)}
    </nav>

    <nav aria-label="Source and license">
      <p class="footer-label">Source</p>
      <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href={siteUrls.agpl} target="_blank" rel="noopener noreferrer">
        Open-source repositories: AGPL-3.0-only
        <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <nav aria-label="Services and identity">
      <p class="footer-label">Operate</p>
      <a href={siteUrls.business} target="_blank" rel="noopener noreferrer">Professional services <span aria-hidden="true">↗</span></a>
      <a href={siteUrls.identity} target="_blank" rel="noopener noreferrer">ZITADEL identity <span aria-hidden="true">↗</span></a>
      <a href="mailto:hello@inspr.at">hello@inspr.at</a>
      <a href={siteUrls.imprint} target="_blank" rel="noopener noreferrer">Legal notice <span aria-hidden="true">↗</span></a>
      <a href={siteUrls.privacy} target="_blank" rel="noopener noreferrer">Privacy <span aria-hidden="true">↗</span></a>
    </nav>
  </div>

  <div class="site-footer__legal page-shell">
    <p class="site-footer__legal-copy">
      <span>
        © {year} <a href={siteUrls.author} target="_blank" rel="me noopener noreferrer">Markus Barta</a> · INSPR
      </span>
      <span>Built to stay inspectable.</span>
    </p>

    <dl
      class="site-footer__release"
      aria-label="Site release"
      data-release-id={releaseMetadata.releaseId}
    >
      <div>
        <dt>Site</dt>
        <dd title={`Package ${releaseMetadata.packageName}`}>v{releaseMetadata.version}</dd>
      </div>
      <div>
        <dt>Git</dt>
        <dd><code>{releaseMetadata.gitLabel}</code></dd>
      </div>
      <div>
        <dt>Release</dt>
        <dd><code>{releaseMetadata.releaseId}</code></dd>
      </div>
      <div>
        <dt>Deployed</dt>
        <dd>
          {releaseMetadata.deployedAt
            ? <time datetime={releaseMetadata.deployedAt}>{deployedAtLabel}</time>
            : deployedAtLabel}
        </dd>
      </div>
    </dl>
  </div>
</footer>
