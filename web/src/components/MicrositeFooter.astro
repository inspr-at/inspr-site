---
import { productLinks, siteUrls } from "../content/urls";
import { releaseMetadata } from "../../release-metadata.mjs";

interface Props {
  name: string;
  repositoryUrl: string;
  licenseName?: string;
  licenseUrl?: string;
  ctaTitle: string;
  ctaBody: string;
  locale?: "en" | "de";
}

const {
  name,
  repositoryUrl,
  licenseName,
  licenseUrl,
  ctaTitle,
  ctaBody,
  locale = "en",
} = Astro.props;

const year = new Date().getUTCFullYear();

// Product hosts serve their German edition at /de/; ?lang=de records the
// choice on the destination origin (localStorage does not cross hosts).
const productHref = (href: string) =>
  locale === "de" ? `${href}/de/?lang=de` : href;
const deployedAtLabel = releaseMetadata.deployedAt
  ? `${new Intl.DateTimeFormat(locale === "de" ? "de-AT" : "en-GB", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "UTC",
    }).format(new Date(releaseMetadata.deployedAt))} UTC`
  : locale === "de" ? "Lokaler Build" : "Local build";

const labels = locale === "de"
  ? {
      path: "Professioneller Weg",
      servicesCta: "Augmentoring-Services ansehen",
      familyDescription: "Teil von INSPR, der Produktfamilie für Menschen und KI-Agenten.",
      productsAria: "INSPR-Produkte",
      family: "Produktfamilie",
      overview: "Überblick",
      opensInNewTab: "öffnet in einem neuen Tab",
      sourceAria: "Quellcode und Lizenz",
      source: "Quellcode",
      repositories: "Open-Source-Repositories: AGPL-3.0-only",
      operateAria: "Services und Identität",
      operate: "Betrieb",
      services: "Professionelle Services",
      identity: "ZITADEL-Identität",
      legal: "Impressum",
      privacy: "Datenschutz",
      inspectable: "Gebaut, um prüfbar zu bleiben.",
      releaseAria: "Website-Release",
      package: "Paket",
      release: "Release",
      deployed: "Ausgerollt",
    }
  : {
      path: "Professional path",
      servicesCta: "Explore Augmentoring services",
      familyDescription: "Part of INSPR, the technology umbrella for people and AI agents.",
      productsAria: "INSPR products",
      family: "Product family",
      overview: "Overview",
      opensInNewTab: "opens in a new tab",
      sourceAria: "Source and license",
      source: "Source",
      repositories: "Open-source repositories: AGPL-3.0-only",
      operateAria: "Services and identity",
      operate: "Operate",
      services: "Professional services",
      identity: "ZITADEL identity",
      legal: "Legal notice",
      privacy: "Privacy",
      inspectable: "Built to stay inspectable.",
      releaseAria: "Site release",
      package: "Package",
      release: "Release",
      deployed: "Deployed",
    };
---

<footer class="site-footer">
  <section class="footer-cta page-shell" aria-labelledby="footer-cta-title">
    <div>
      <p class="eyebrow">{labels.path}</p>
      <h2 id="footer-cta-title">{ctaTitle}</h2>
      <p>{ctaBody}</p>
    </div>
    <a class="button button--light" href={siteUrls.business} target="_blank" rel="noopener noreferrer">
      {labels.servicesCta} <span aria-hidden="true">↗</span>
    </a>
  </section>

  <div class="site-footer__grid page-shell">
    <div class="site-footer__brand">
      <strong>{name}</strong>
      <p>{labels.familyDescription}</p>
    </div>

    <nav aria-label={labels.productsAria}>
      <p class="footer-label">{labels.family}</p>
      <a href={locale === "de" ? siteUrls.overviewGerman : siteUrls.overview}>{labels.overview}</a>
      {productLinks.map((item) => <a href={productHref(item.href)} target="_blank" rel="noopener noreferrer" aria-label={`${item.label}, ${labels.opensInNewTab}`}>{item.label}</a>)}
    </nav>

    <nav aria-label={labels.sourceAria}>
      <p class="footer-label">{labels.source}</p>
      <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href={siteUrls.agpl} target="_blank" rel="noopener noreferrer">
        {labels.repositories}
        <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <nav aria-label={labels.operateAria}>
      <p class="footer-label">{labels.operate}</p>
      <a href={siteUrls.business} target="_blank" rel="noopener noreferrer">{labels.services} <span aria-hidden="true">↗</span></a>
      <a href={siteUrls.identity} target="_blank" rel="noopener noreferrer">{labels.identity} <span aria-hidden="true">↗</span></a>
      <a href="mailto:hello@inspr.at">hello@inspr.at</a>
      <a href={siteUrls.imprint} target="_blank" rel="noopener noreferrer">{labels.legal} <span aria-hidden="true">↗</span></a>
      <a href={siteUrls.privacy} target="_blank" rel="noopener noreferrer">{labels.privacy} <span aria-hidden="true">↗</span></a>
    </nav>
  </div>

  <div class="site-footer__legal page-shell">
    <p class="site-footer__legal-copy">
      <span>
        © {year} <a href={siteUrls.author} target="_blank" rel="me noopener noreferrer">Markus Barta</a> · INSPR
      </span>
      <span>{labels.inspectable}</span>
    </p>

    <dl
      class="site-footer__release"
      aria-label={labels.releaseAria}
      data-release-id={releaseMetadata.releaseId}
    >
      <div>
        <dt>Site</dt>
        <dd title={`${labels.package} ${releaseMetadata.packageName}`}>v{releaseMetadata.version}</dd>
      </div>
      <div>
        <dt>Git</dt>
        <dd><code>{releaseMetadata.gitLabel}</code></dd>
      </div>
      <div>
        <dt>{labels.release}</dt>
        <dd><code>{releaseMetadata.releaseId}</code></dd>
      </div>
      <div>
        <dt>{labels.deployed}</dt>
        <dd>
          {releaseMetadata.deployedAt
            ? <time datetime={releaseMetadata.deployedAt}>{deployedAtLabel}</time>
            : deployedAtLabel}
        </dd>
      </div>
    </dl>
  </div>
</footer>
