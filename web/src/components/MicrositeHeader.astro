---
import { productLinks, siteUrls } from "../content/urls";

interface Props {
  name: string;
  category: string;
  logo: string;
  active: "inspr" | "paimos" | "pharos" | "janus";
  nav: Array<{ label: string; href: string }>;
  showSignIn?: boolean;
}

const { name, category, logo, active, nav, showSignIn = false } = Astro.props;
---

<header class="site-header">
  <div class="site-header__bar page-shell">
    <a class="site-brand" href={siteUrls[active]}>
      <img src={logo} alt="" width="48" height="48" />
      <span>
        <strong>{name}</strong>
        <small>{category}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      {showSignIn && <a class="quiet-link" href={siteUrls.signIn} target="_blank" rel="noopener noreferrer">Sign in</a>}
      <details class="mobile-navigation" data-mobile-navigation>
        <summary>Sections</summary>
        <nav class="mobile-navigation__panel" aria-label="Mobile navigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <details class="product-switcher">
        <summary>Products</summary>
        <div class="product-switcher__panel">
          {productLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.label}, opens in a new tab`}
              aria-current={item.label.toLowerCase() === active ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-navigation]")
    .forEach((menu) => {
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.removeAttribute("open"));
      });
      menu.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        menu.removeAttribute("open");
        menu.querySelector<HTMLElement>("summary")?.focus();
      });
    });
</script>
