---
import { productLinks, siteUrls } from "../content/urls";

interface Props {
  name: string;
  category: string;
  logo: string;
  active: "inspr" | "paimos" | "pharos" | "janus";
  nav: Array<{ label: string; href: string }>;
  showSignIn?: boolean;
  locale?: "en" | "de";
  languageLinks?: { en: string; de: string };
}

const {
  name,
  category,
  logo,
  active,
  nav,
  showSignIn = false,
  locale = "en",
  languageLinks,
} = Astro.props;

const labels = locale === "de"
  ? {
      primary: "Hauptnavigation",
      signIn: "Anmelden",
      sections: "Bereiche",
      mobile: "Navigation für Mobilgeräte",
      products: "Produkte",
      opensInNewTab: "öffnet in einem neuen Tab",
      languages: "Sprache wählen",
      german: "Deutsch",
      english: "Englisch",
    }
  : {
      primary: "Primary navigation",
      signIn: "Sign in",
      sections: "Sections",
      mobile: "Mobile navigation",
      products: "Products",
      opensInNewTab: "opens in a new tab",
      languages: "Choose language",
      german: "German",
      english: "English",
    };

const languageChoiceHref = (href: string, choice: "en" | "de") => {
  const isAbsolute = /^https?:\/\//.test(href);
  const url = new URL(href, siteUrls.inspr);
  url.searchParams.set("lang", choice);
  return isAbsolute ? url.toString() : `${url.pathname}${url.search}${url.hash}`;
};
---

<header class="site-header">
  <div class="site-header__bar page-shell">
    <a class="site-brand" href={siteUrls[active]}>
      <img src={logo} alt="" width="48" height="48" />
      <span>
        <strong>{name}</strong>
        <small>{category}</small>
      </span>
    </a>

    <nav class="site-nav" aria-label={labels.primary}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      {showSignIn && <a class="quiet-link" href={siteUrls.signIn} target="_blank" rel="noopener noreferrer">{labels.signIn}</a>}
      {languageLinks && (
        <nav class="language-switch" aria-label={labels.languages}>
          <a
            href={languageChoiceHref(languageLinks.de, "de")}
            lang="de"
            hreflang="de"
            aria-label={labels.german}
            aria-current={locale === "de" ? "page" : undefined}
            data-language-choice="de"
          >DE</a>
          <span aria-hidden="true">|</span>
          <a
            href={languageChoiceHref(languageLinks.en, "en")}
            lang="en"
            hreflang="en"
            aria-label={labels.english}
            aria-current={locale === "en" ? "page" : undefined}
            data-language-choice="en"
          >EN</a>
        </nav>
      )}
      <details class="mobile-navigation" data-mobile-navigation>
        <summary>{labels.sections}</summary>
        <nav class="mobile-navigation__panel" aria-label={labels.mobile}>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <details class="product-switcher">
        <summary>{labels.products}</summary>
        <div class="product-switcher__panel">
          {productLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.label}, ${labels.opensInNewTab}`}
              aria-current={item.label.toLowerCase() === active ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-navigation]")
    .forEach((menu) => {
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.removeAttribute("open"));
      });
      menu.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        menu.removeAttribute("open");
        menu.querySelector<HTMLElement>("summary")?.focus();
      });
    });
</script>
