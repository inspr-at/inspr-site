---
/**
 * The layers behind the Overview. One markup tree serves two presentations:
 * a static exploded stack (default, phones, coarse pointers, reduced motion)
 * and a fixed three-dimensional scene behind the translucent page (fine
 * pointer, wide viewport). The header's Details switch toggles it.
 *
 * Content rule: convey the kind of machine and the tool, never a host name,
 * internal domain, path or provider SKU. Nobody outside needs those.
 */
import "../styles/overview-details.css";

interface Props {
  locale?: "en" | "de";
}

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const copy = (english: string, german: string) => locale === "de" ? german : english;

const layers = [
  {
    id: "l1",
    number: "L1",
    name: copy("Hardware", "Hardware"),
    body: copy(
      "Workstations, home servers and a few rented cloud VMs. Extra servers appear on demand and vanish when the job is done.",
      "Arbeitsplätze, Heimserver und einige gemietete Cloud-VMs. Zusätzliche Server entstehen bei Bedarf und verschwinden nach getaner Arbeit.",
    ),
    tools: [
      copy("workstations", "Arbeitsplätze"),
      copy("home servers", "Heimserver"),
      copy("cloud VMs", "Cloud-VMs"),
      copy("on-demand VMs via Pharos", "On-demand-VMs via Pharos"),
    ],
  },
  {
    id: "l2",
    number: "L2",
    name: copy("Network", "Netzwerk"),
    body: copy(
      "Every machine sits on one private mesh, wherever it is. A self-hosted coordinator holds the keys. Public names go through Cloudflare.",
      "Jede Maschine hängt in einem privaten Mesh, egal wo sie steht. Ein selbst betriebener Koordinator hält die Schlüssel. Öffentliche Namen laufen über Cloudflare.",
    ),
    tools: ["Headscale", "Tailscale", "Cloudflare DNS + edge", "Traefik TLS"],
  },
  {
    id: "l3",
    number: "L3",
    name: copy("Host config", "Hostkonfiguration"),
    body: copy(
      "Each host is described in text and built from it. The repository is the truth; activation enforces it. Backups run from the same declaration to off-site storage.",
      "Jeder Host ist in Text beschrieben und wird daraus gebaut. Das Repository ist die Wahrheit; die Aktivierung setzt sie durch. Backups laufen aus derselben Deklaration auf externen Speicher.",
    ),
    tools: ["NixOS", "nix-darwin", "Home Manager", "disko", copy("ZFS snapshots", "ZFS-Snapshots"), "restic"],
  },
  {
    id: "l4",
    number: "L4",
    name: "Secrets",
    body: copy(
      "Secrets are encrypted at rest and unlocked only by the one host that owns the key. A vault is the human master copy. Agents load what they may use and never print it.",
      "Secrets liegen verschlüsselt und werden nur von dem Host entschlüsselt, dem der Schlüssel gehört. Ein Tresor ist die Stammkopie für Menschen. Agenten laden, was sie nutzen dürfen, und geben es nie aus.",
    ),
    tools: ["agenix", "1Password", copy("Janus permits", "Janus-Freigaben")],
  },
  {
    id: "l5",
    number: "L5",
    name: copy("Service config", "Dienstkonfiguration"),
    body: copy(
      "Online services with an API are declared as code too. Today that is the identity provider behind every sign-in; DNS and repository settings are next.",
      "Auch Online-Dienste mit API werden als Code deklariert. Heute ist das der Identitätsanbieter hinter jeder Anmeldung; DNS und Repository-Einstellungen folgen.",
    ),
    tools: ["OpenTofu", "Zitadel OIDC", copy("single sign-on", "Single Sign-on")],
  },
  {
    id: "l6",
    number: "L6",
    name: copy("Products", "Produkte"),
    body: copy(
      "Aithema (need), Paimos (what), Pharos (where), Janus (may) and this site: one static build, five hostnames, published by a script that can always roll back.",
      "Aithema (Bedarf), Paimos (Was), Pharos (Wo), Janus (Darf) und diese Website: ein statischer Build, fünf Hostnamen, veröffentlicht von einem Skript, das jederzeit zurückrollen kann.",
    ),
    tools: ["Astro", copy("Caddy pinned by digest", "Caddy per Digest fixiert"), copy("immutable releases", "unveränderliche Releases"), copy("strict CSP", "strikte CSP")],
    live: true,
  },
  {
    id: "l7",
    number: "L7",
    name: copy("Doctrine", "Doktrin"),
    body: copy(
      "The rulebook every AI agent loads at session start. A tiny always-on kernel for irreversible mistakes, deeper packs on demand, versioned and signed. A CLI checks and heals each machine.",
      "Das Regelwerk, das jeder KI-Agent zu Beginn jeder Sitzung lädt. Ein winziger, immer aktiver Kern für unumkehrbare Fehler, tiefere Pakete bei Bedarf, versioniert und signiert. Eine CLI prüft und heilt jede Maschine.",
    ),
    tools: [copy("kernel", "Kernel"), copy("domain packs", "Domänenpakete"), "inspr CLI", copy("signed releases", "signierte Releases")],
  },
];

const counterOf = copy("of", "von");
const hint = copy("Continue reading", "Weiter lesen");
const live = {
  heading: copy("This page, right now", "Diese Seite, jetzt"),
  release: copy("release", "Release"),
  source: copy("source", "Quelle"),
  deployed: copy("deployed", "veröffentlicht"),
  csp: copy("CSP script hashes", "CSP-Skript-Hashes"),
  hsts: copy("HSTS", "HSTS"),
  pending: copy("reading…", "wird gelesen…"),
};
---

<aside
  id="overview-details"
  class="overview-details"
  data-details-panel
  aria-labelledby="overview-details-title"
  hidden
>
  <div class="overview-details__frame">
    <header class="overview-details__header">
      <p class="overview-kicker">{copy("Details", "Details")}</p>
      <h2 id="overview-details-title">{copy("What this runs on.", "Worauf das läuft.")}</h2>
      <p class="overview-details__lede">{copy(
        "Seven layers, top to bottom. Every one that can be declared is declared; what remains is judgment.",
        "Sieben Schichten, von oben nach unten. Alles, was deklariert werden kann, ist deklariert; der Rest ist Urteilskraft.",
      )}</p>
      <p class="overview-details__counter" aria-live="polite">
        <span data-details-counter>1</span> {counterOf} 7
      </p>
    </header>

    <ol class="overview-details__layers" data-details-scene>
      {[...layers].reverse().map((layer, position) => (
        <li
          class="overview-layer"
          id={layer.id}
          data-details-layer={layer.id}
          data-details-position={position}
          style={`--layer-index: ${layers.length - 1 - position}; --layer-position: ${position};`}
        >
          <button
            class="overview-layer__tag"
            type="button"
            aria-expanded="false"
            aria-controls={`overview-layer-${layer.id}-body`}
            data-details-layer-tag
          >
            <span class="overview-layer__number">{layer.number}</span>
            <span class="overview-layer__name">{layer.name}</span>
          </button>
          <div class="overview-layer__body" id={`overview-layer-${layer.id}-body`}>
            <div class="overview-layer__inner">
              <p>{layer.body}</p>
              <ul class="overview-layer__tools" aria-label={copy("Tools", "Werkzeuge")}>
                {layer.tools.map((tool) => <li>{tool}</li>)}
              </ul>
              {layer.live && (
                <dl class="overview-layer__live" data-details-live aria-label={live.heading}>
                  <div><dt>{live.release}</dt><dd data-live="release">{live.pending}</dd></div>
                  <div><dt>{live.source}</dt><dd data-live="source">{live.pending}</dd></div>
                  <div><dt>{live.deployed}</dt><dd data-live="deployed">{live.pending}</dd></div>
                  <div><dt>{live.csp}</dt><dd data-live="csp">{live.pending}</dd></div>
                  <div><dt>{live.hsts}</dt><dd data-live="hsts">{live.pending}</dd></div>
                </dl>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>

    <p class="overview-details__hint" data-details-hint aria-hidden="true">{hint} <span>↓</span></p>
  </div>
</aside>

<script>
  // The layers behind the Overview as a vertical cover flow. The header's
  // Details control owns the depth; this scene follows it and opens at the
  // technical depth. One card is active and fully readable; the others are
  // tabs stacked above and below, offset left. Wheel, keys and clicks move
  // between them; after the last card the page scroll is released. Bundled
  // by Astro as a same-origin module, so the strict CSP needs no new hash.
  const root = document.documentElement;
  const panel = document.querySelector<HTMLElement>("[data-details-panel]");
  const scene = panel?.querySelector<HTMLElement>("[data-details-scene]") ?? null;
  const cards = Array.from(panel?.querySelectorAll<HTMLElement>("[data-details-layer]") ?? []);
  const counter = panel?.querySelector<HTMLElement>("[data-details-counter]") ?? null;
  const sceneQuery = window.matchMedia(
    "(hover: hover) and (pointer: fine) and (min-width: 56rem) and (prefers-reduced-motion: no-preference)",
  );

  let enabled = false;
  let owning = false;
  let active = 0;
  let liveLoaded = false;
  let wheelBudget = 0;
  let lastStep = 0;

  if (panel && scene && cards.length > 0) {
    const rem = () => parseFloat(getComputedStyle(root).fontSize) || 16;

    const loadLive = async () => {
      if (liveLoaded) return;
      liveLoaded = true;
      const write = (name: string, value: string) => {
        for (const target of document.querySelectorAll<HTMLElement>(`[data-live="${name}"]`)) target.textContent = value;
      };
      try {
        const manifest = await fetch("/release.json", { cache: "no-store" }).then((response) => response.json());
        write("release", String(manifest?.deployment?.releaseId ?? "local build"));
        write("source", String(manifest?.source?.git ?? "unknown") + (manifest?.source?.dirty ? " (dirty)" : ""));
        write("deployed", String(manifest?.deployment?.deployedAt ?? "not deployed"));
      } catch {
        write("release", "unavailable");
        write("source", "unavailable");
        write("deployed", "unavailable");
      }
      try {
        const response = await fetch(window.location.pathname, { method: "HEAD", cache: "no-store" });
        const csp = response.headers.get("content-security-policy") ?? "";
        const hashes = csp.match(/'sha256-[^']+'/g)?.length ?? 0;
        write("csp", csp ? `script-src 'self' + ${hashes}` : "not exposed");
        write("hsts", response.headers.get("strict-transport-security") ? "preload" : "not exposed");
      } catch {
        write("csp", "unavailable");
        write("hsts", "unavailable");
      }
    };

    // Lay the stack out around the active card: it sits at the vertical
    // centre; tabs fan out above and below, each step further left.
    const layout = () => {
      const unit = rem();
      const pitch = 3.1 * unit;
      const gap = 1.1 * unit;
      const shift = 1.7 * unit;
      const activeCard = cards[active];
      const tag = activeCard.querySelector<HTMLElement>("[data-details-layer-tag]");
      const inner = activeCard.querySelector<HTMLElement>(".overview-layer__inner");
      const activeHeight = Math.min(
        window.innerHeight * 0.62,
        (tag?.offsetHeight ?? 0) + (inner?.scrollHeight ?? 0) + 1.5 * unit,
      );
      const half = activeHeight / 2;
      // Keep the whole fan inside the band between the heading and the hint.
      const count = cards.length;
      const topReach = half + gap + Math.max(0, active - 0.5) * pitch + (active > 0 ? pitch * 0.5 : 0);
      const bottomReach = half + gap + Math.max(0, count - 1 - active - 0.5) * pitch + (active < count - 1 ? pitch * 0.5 : 0);
      const topLimit = 11.5 * unit;
      const bottomLimit = window.innerHeight - 4.5 * unit;
      let centre = window.innerHeight / 2;
      if (centre + bottomReach > bottomLimit) centre = bottomLimit - bottomReach;
      if (centre - topReach < topLimit) centre = topLimit + topReach;
      scene.style.setProperty("--details-centre", `${centre.toFixed(1)}px`);
      cards.forEach((card, index) => {
        const distance = index - active;
        const away = Math.abs(distance);
        const isActive = distance === 0;
        card.toggleAttribute("data-details-active", isActive);
        card.querySelector("[data-details-layer-tag]")?.setAttribute("aria-expanded", isActive ? "true" : "false");
        let y = 0;
        if (distance < 0) y = -(half + gap + (away - 1) * pitch + pitch * 0.5);
        if (distance > 0) y = half + gap + (away - 1) * pitch + pitch * 0.5;
        const x = -away * shift;
        const scale = isActive ? 1 : Math.max(0.82, 1 - away * 0.035);
        card.style.setProperty("--card-y", `${y.toFixed(1)}px`);
        card.style.setProperty("--card-x", `${x.toFixed(1)}px`);
        card.style.setProperty("--card-scale", scale.toFixed(3));
        card.style.zIndex = String(20 - away);
      });
      if (counter) counter.textContent = String(active + 1);
      panel.toggleAttribute("data-details-last", active === cards.length - 1);
    };

    // Every card has an address: #l1 … #l7. Browsing writes it silently;
    // arriving with one opens the technical depth at that card.
    const hashOf = (index: number) => `#${cards[index]?.dataset.detailsLayer ?? ""}`;
    const indexOfHash = (hash: string) => cards.findIndex((card) => `#${card.dataset.detailsLayer}` === hash);
    const writeHash = (index: number | null) => {
      const url = new URL(window.location.href);
      const next = index === null ? "" : hashOf(index);
      if (url.hash === next) return;
      url.hash = next;
      window.history.replaceState(window.history.state, "", url.toString());
    };

    const go = (index: number) => {
      const next = Math.min(cards.length - 1, Math.max(0, index));
      if (next === active) return false;
      active = next;
      layout();
      writeHash(active);
      return true;
    };

    const setOwning = (next: boolean) => {
      owning = next;
      root.toggleAttribute("data-details-reading", enabled && !owning);
      if (owning) window.scrollTo({ top: 0, behavior: "auto" });
    };

    const setEnabled = (next: boolean) => {
      enabled = next && sceneQuery.matches;
      root.toggleAttribute("data-details", enabled);
      root.toggleAttribute("data-details-reading", false);
      panel.hidden = !next;
      if (enabled) {
        const linked = indexOfHash(window.location.hash);
        active = linked >= 0 ? linked : 0;
        layout();
        setOwning(true);
        writeHash(active);
        void loadLive();
      } else {
        owning = false;
        for (const card of cards) {
          card.removeAttribute("data-details-active");
          card.querySelector("[data-details-layer-tag]")?.setAttribute("aria-expanded", "false");
        }
        if (next) {
          void loadLive();
          // Static stack: the linked card is simply scrolled into view.
          const linked = indexOfHash(window.location.hash);
          if (linked >= 0) cards[linked].scrollIntoView({ behavior: "smooth", block: "start" });
        } else {
          writeHash(null);
        }
      }
    };

    const followHash = () => {
      const linked = indexOfHash(window.location.hash);
      if (linked < 0) return;
      if (root.getAttribute("data-details-level") !== "technical") {
        document.dispatchEvent(new CustomEvent("inspr:details-request", { detail: { level: "technical" } }));
        return;
      }
      if (enabled) {
        if (!owning) setOwning(true);
        go(linked);
      } else {
        cards[linked].scrollIntoView({ behavior: "smooth", block: "start" });
      }
    };
    window.addEventListener("hashchange", followHash);

    const follow = () => {
      const technical = root.getAttribute("data-details-level") === "technical";
      if (technical === !panel.hidden) return;
      setEnabled(technical);
    };
    document.addEventListener("inspr:details-level", follow);

    // Wheel: one card per notch while the scene owns the page; past the last
    // card the page scrolls; at the top, wheeling up takes the scene back.
    const stepBy = (delta: number) => {
      const now = performance.now();
      if (now - lastStep < 420) return;
      lastStep = now;
      if (delta > 0 && active === cards.length - 1) {
        setOwning(false);
        return;
      }
      go(active + delta);
    };
    window.addEventListener(
      "wheel",
      (event) => {
        if (!enabled) return;
        if (!owning) {
          if (event.deltaY < 0 && window.scrollY <= 0) {
            event.preventDefault();
            setOwning(true);
          }
          return;
        }
        event.preventDefault();
        wheelBudget += event.deltaY;
        if (Math.abs(wheelBudget) < 48) return;
        const delta = wheelBudget > 0 ? 1 : -1;
        wheelBudget = 0;
        stepBy(delta);
      },
      { passive: false },
    );

    document.addEventListener("keydown", (event) => {
      if (!enabled) return;
      if ((event.target as HTMLElement | null)?.closest("[data-details-slider], input, textarea, select")) return;
      if (event.key === "Escape") {
        document.dispatchEvent(new CustomEvent("inspr:details-request", { detail: { level: "standard" } }));
        return;
      }
      if (!owning) return;
      const map: Record<string, number> = { ArrowDown: 1, PageDown: 1, ArrowUp: -1, PageUp: -1 };
      if (event.key === "Home") go(0);
      else if (event.key === "End") go(cards.length - 1);
      else if (event.key in map) stepBy(map[event.key]);
      else if (event.key === " ") stepBy(event.shiftKey ? -1 : 1);
      else return;
      event.preventDefault();
    });

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        if (!enabled) return;
        if (!owning) setOwning(true);
        go(index);
      });
    });

    // A whisper of parallax; navigation no longer depends on the pointer.
    window.addEventListener("pointermove", (event) => {
      if (!enabled || !owning) return;
      const x = event.clientX / window.innerWidth - 0.5;
      scene.style.setProperty("--details-tilt-y", `${(x * 6).toFixed(2)}deg`);
    });

    window.addEventListener("resize", () => {
      if (enabled) layout();
    });
    sceneQuery.addEventListener("change", follow);

    // The control's module may have run before this one; a layer address in
    // the URL asks for the technical depth.
    follow();
    followHash();
  }
</script>
