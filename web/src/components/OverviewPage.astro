---
import ContextIcon from "./ContextIcon.astro";
import HeroLoop from "./HeroLoop.astro";
import MicrositeHeader from "./MicrositeHeader.astro";
import DetailLevels from "./DetailLevels.astro";
import OverviewStack from "./OverviewStack.astro";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import "../styles/overview.css";

import { productTaxonomy, siteUrls } from "../content/urls";
import insprHero from "../assets/products/inspr/hero.png";
import insprLogo from "../assets/products/inspr/logo.svg";
import aithemaHero from "../assets/products/aithema/hero.png";
import aithemaHeroLoop from "../assets/products/aithema/hero-loop.mp4";
import aithemaLogo from "../assets/products/aithema/logo.svg";
import paimosHero from "../assets/products/paimos/hero.png";
import paimosHeroLoop from "../assets/products/paimos/hero-loop.mp4";
import paimosLogo from "../assets/products/paimos/logo.svg";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosHeroLoop from "../assets/products/pharos/hero-loop.mp4";
import pharosLogo from "../assets/products/pharos/mark.svg";
import janusHero from "../assets/products/janus/hero.png";
import janusHeroLoop from "../assets/products/janus/hero-loop.mp4";
import janusLogo from "../assets/products/janus/logo.svg";

interface Props {
  locale?: "en" | "de";
}

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const copy = (english: string, german: string) => locale === "de" ? german : english;

const openSourceUrl = "https://github.com/inspr-at";
const englishUrl = siteUrls.overview;
const germanUrl = siteUrls.overviewGerman;
const canonicalUrl = locale === "de" ? germanUrl : englishUrl;
const fullSiteUrl = locale === "de" ? `${siteUrls.inspr}/de/` : `${siteUrls.inspr}/`;
const ogImage = new URL(insprHero.src, siteUrls.inspr).href;

const nav = [
  { label: copy("Overview", "Überblick"), href: canonicalUrl, current: true },
  { label: copy("Products", "Produkte"), href: `${fullSiteUrl}#products` },
  { label: copy("Principles", "Prinzipien"), href: `${fullSiteUrl}#principles` },
  { label: copy("Source", "Quellcode"), href: `${fullSiteUrl}#source` },
];

const flowNodes = [
  { label: copy("Idea", "Idee"), logo: insprLogo, handoff: copy("conversation + files", "Gespräch + Dateien") },
  { label: copy("Requirements", "Anforderungen"), logo: aithemaLogo, handoff: copy("approved requirement set", "freigegebener Anforderungssatz") },
  { label: copy("Build", "Umsetzung"), logo: paimosLogo, handoff: copy("staged build + evidence", "Staging-Build + Nachweise") },
  { label: copy("Deploy", "Bereitstellung"), logo: pharosLogo, handoff: copy("release on a declared host", "Release auf deklariertem Host") },
  { label: copy("Access", "Zugriff"), logo: janusLogo, handoff: copy("bounded permit", "begrenzte Freigabe") },
];

// Technical depth: the enforcement behind each promise.
const sheetLabels = {
  repo: copy("repo", "Repo"),
  runtime: copy("runtime", "Laufzeit"),
  gate: copy("gate", "Gate"),
  artefact: copy("artefact", "Artefakt"),
  interfaces: copy("interfaces", "Schnittstellen"),
  maturity: copy("maturity", "Reife"),
  mechanism: copy("enforced by", "durchgesetzt durch"),
};

const promises = [
  {
    icon: "user-round-check",
    title: copy("Your decisions", "Ihre Entscheidungen"),
    simple: copy("Nothing happens without your yes.", "Ohne Ihr Ja passiert nichts."),
    body: copy("You stay in control from start to finish.", "Sie behalten vom Anfang bis zum Ende die Kontrolle."),
    technical: copy(
      "Every transition is an explicit approval gate; agents cannot approve themselves.",
      "Jede Übergabe ist ein explizites Freigabe-Gate; Agenten können sich nicht selbst freigeben.",
    ),
    mechanism: copy(
      "Gates live in the tools, not in a convention: approvals are recorded on the ticket, the deploy review and the permit. An agent has no approval capability.",
      "Gates leben in den Werkzeugen, nicht in einer Konvention: Freigaben werden am Ticket, an der Deploy-Prüfung und an der Freigabe festgehalten. Ein Agent hat keine Freigabe-Befugnis.",
    ),
  },
  {
    icon: "git-branch",
    title: copy("Open source", "Offener Quellcode"),
    simple: copy("The tools are free to inspect and use. One is still being built.", "Die Werkzeuge sind frei einsehbar und nutzbar. Eines wird noch gebaut."),
    body: copy(
      "Paimos, Pharos and Janus are open. Aithema's module is planned.",
      "Paimos, Pharos und Janus sind offen. Aithemas Modul ist geplant.",
    ),
    technical: copy(
      "Paimos, Pharos and Janus are AGPL-3.0-only on GitHub. Aithema's module is planned.",
      "Paimos, Pharos und Janus sind AGPL-3.0-only auf GitHub. Aithemas Modul ist geplant.",
    ),
    mechanism: copy(
      "Each repository declares its SPDX licence; releases are tagged and the site links the exact sources. Running it as a service obliges you to publish your changes.",
      "Jedes Repository deklariert seine SPDX-Lizenz; Releases sind getaggt, die Website verlinkt die exakten Quellen. Wer es als Dienst betreibt, muss Änderungen veröffentlichen.",
    ),
  },
  {
    icon: "database",
    title: copy("Your data", "Ihre Daten"),
    simple: copy("Nobody else gets your data.", "Niemand sonst bekommt Ihre Daten."),
    body: copy("Your data remains yours, throughout.", "Ihre Daten bleiben durchgehend Ihre Daten."),
    technical: copy(
      "Data stays in your instances; secret values never appear in transcripts or logs.",
      "Daten bleiben in Ihren Instanzen; Secret-Werte erscheinen nie in Transkripten oder Logs.",
    ),
    mechanism: copy(
      "Self-hosted instances behind your own sign-in. Secrets are encrypted at rest and handed out as references and bounded permits, so a value cannot end up in a prompt or a log.",
      "Selbst betriebene Instanzen hinter Ihrer eigenen Anmeldung. Secrets liegen verschlüsselt und werden als Referenzen und begrenzte Freigaben herausgegeben; ein Wert kann so nicht in einem Prompt oder Log landen.",
    ),
  },
  {
    icon: "server",
    title: copy("Your servers", "Ihre Server"),
    simple: copy("It runs where you say, even on your own machines.", "Es läuft, wo Sie es sagen, auch auf Ihren eigenen Maschinen."),
    body: copy("You choose where the result runs.", "Sie bestimmen, wo das Ergebnis läuft."),
    technical: copy(
      "Self-hosted by design: declared hosts, verified backups, your cloud or your basement.",
      "Self-hosted by Design: deklarierte Hosts, geprüfte Backups, Ihre Cloud oder Ihr Keller.",
    ),
    mechanism: copy(
      "Hosts are described in Nix and built from that description. Before a production deploy, Pharos checks the backup evidence of the target; the browser never sends commands to a host.",
      "Hosts sind in Nix beschrieben und werden daraus gebaut. Vor einem Produktions-Deploy prüft Pharos den Backup-Nachweis des Ziels; der Browser sendet nie Befehle an einen Host.",
    ),
  },
];

const steps = [
  {
    id: "aithema" as const,
    number: "01",
    name: "Aithema",
    role: copy("Requirements", "Anforderungen"),
    logo: aithemaLogo,
    hero: aithemaHero,
    video: aithemaHeroLoop,
    href: siteUrls.aithema,
    simple: copy("You talk, it writes down what you need.", "Sie reden, es schreibt auf, was Sie brauchen."),
    body: copy(
      "Conversation and files become clear requirements.",
      "Gespräche und Dateien werden zu klaren Anforderungen.",
    ),
    technical: copy(
      "Conversation and documents become structured, reviewable requirements before any code exists.",
      "Gespräche und Dokumente werden zu strukturierten, prüfbaren Anforderungen, bevor Code existiert.",
    ),
    approval: copy("You approve the requirements.", "Sie geben die Anforderungen frei."),
    sheet: {
      repo: copy("open module planned; hosted preview today", "offenes Modul geplant; heute gehostete Vorschau"),
      runtime: copy("hosted web preview", "gehostete Web-Vorschau"),
      gate: copy("a person reviews the requirement set and chooses Continue; nothing downstream starts on a draft", "ein Mensch prüft den Anforderungssatz und wählt Weiter; nichts Nachgelagertes startet auf einem Entwurf"),
      artefact: copy("structured, versioned requirement set with its sources", "strukturierter, versionierter Anforderungssatz mit seinen Quellen"),
      interfaces: copy("web preview", "Web-Vorschau"),
      maturity: copy("preview", "Vorschau"),
    },
  },
  {
    id: "paimos" as const,
    number: "02",
    name: "Paimos",
    role: copy("Build", "Umsetzung"),
    logo: paimosLogo,
    hero: paimosHero,
    video: paimosHeroLoop,
    href: siteUrls.paimos,
    simple: copy("The plan becomes a working version you can look at.", "Aus dem Plan wird eine funktionierende Version, die Sie ansehen können."),
    body: copy(
      "Project and specs guide an agentic build.",
      "Projekt und Spezifikationen steuern die Umsetzung mit Agenten.",
    ),
    technical: copy(
      "Tickets, specs and knowledge drive an agentic build into staging, with evidence attached.",
      "Tickets, Spezifikationen und Wissen steuern eine agentische Umsetzung ins Staging, mit angehängten Nachweisen.",
    ),
    approval: copy("You approve the staged build.", "Sie geben den Stand im Staging frei."),
    sheet: {
      repo: "github.com/inspr-at/paimos",
      runtime: copy("self-hosted, one container, sign-in via OIDC", "selbst gehostet, ein Container, Anmeldung per OIDC"),
      gate: copy("the staged result is reviewed in the same project model the agent worked from; the approval is recorded on the ticket", "der Staging-Stand wird im selben Projektmodell geprüft, aus dem der Agent gearbeitet hat; die Freigabe wird am Ticket festgehalten"),
      artefact: copy("tickets, specs, knowledge and run evidence, permission-aware", "Tickets, Spezifikationen, Wissen und Laufnachweise, berechtigungsbewusst"),
      interfaces: copy("UI, CLI, HTTP API", "UI, CLI, HTTP-API"),
      maturity: copy("released, AGPL-3.0-only", "veröffentlicht, AGPL-3.0-only"),
      command: 'paimos issue create -p PROJ --title "…"',
    },
  },
  {
    id: "pharos" as const,
    number: "03",
    name: "Pharos",
    role: copy("Deploy", "Bereitstellung"),
    logo: pharosLogo,
    hero: pharosHero,
    video: pharosHeroLoop,
    href: siteUrls.pharos,
    simple: copy("It picks a safe place to run it and checks the backup first.", "Es wählt einen sicheren Ort und prüft zuerst das Backup."),
    body: copy(
      "Choose a server, verify its backup and deploy to production.",
      "Server wählen, Backup prüfen und in Produktion bereitstellen.",
    ),
    technical: copy(
      "Fleet truth, backup evidence and a guarded deploy to a declared host; rollback is one symlink away.",
      "Flottenwahrheit, Backup-Nachweis und ein abgesichertes Deployment auf einen deklarierten Host; Rollback ist einen Symlink entfernt.",
    ),
    approval: copy("You approve production.", "Sie geben die Produktion frei."),
    sheet: {
      repo: "github.com/inspr-at/pharos",
      runtime: copy("Rust server plus an outbound host beacon; no inbound port on the host", "Rust-Server plus ausgehender Host-Beacon; kein eingehender Port am Host"),
      gate: copy("backup evidence, build result, authorisation and an explicit confirmation are recorded before the host may apply anything", "Backup-Nachweis, Build-Ergebnis, Autorisierung und eine explizite Bestätigung werden festgehalten, bevor der Host etwas anwenden darf"),
      artefact: copy("host reports, backup and restore evidence, the review record", "Host-Berichte, Backup- und Restore-Nachweise, das Prüfprotokoll"),
      interfaces: copy("UI, beacon, OIDC", "UI, Beacon, OIDC"),
      maturity: copy("released, AGPL-3.0-only", "veröffentlicht, AGPL-3.0-only"),
    },
  },
  {
    id: "janus" as const,
    number: "04",
    name: "Janus",
    role: copy("Access", "Zugriff"),
    logo: janusLogo,
    hero: janusHero,
    video: janusHeroLoop,
    href: siteUrls.janus,
    simple: copy("It hands out access only when allowed, and takes it back.", "Es vergibt Zugriff nur, wenn erlaubt, und nimmt ihn wieder zurück."),
    body: copy(
      "Enforce permits and rotate access safely.",
      "Freigaben werden durchgesetzt und Zugriffe sicher rotiert.",
    ),
    technical: copy(
      "Bounded secret permits with roles, delegation and value-free audit; rotation without exposure.",
      "Begrenzte Secret-Freigaben mit Rollen, Delegation und wertfreiem Audit; Rotation ohne Offenlegung.",
    ),
    approval: copy("You approve the permit.", "Sie geben die Berechtigung frei."),
    sheet: {
      repo: "github.com/inspr-at/janus",
      runtime: copy("Rust engine with an encrypted store; a separate Go envelope for human oversight", "Rust-Engine mit verschlüsseltem Speicher; ein separater Go-Envelope für die menschliche Aufsicht"),
      gate: copy("which reference, which requester, which sink: three decisions checked on their own; the value is materialised only inside the reviewed execution path", "welche Referenz, welcher Anfragende, welches Ziel: drei getrennt geprüfte Entscheidungen; der Wert wird nur im geprüften Ausführungspfad materialisiert"),
      artefact: copy("a bounded permit and a value-free audit record", "eine begrenzte Freigabe und ein wertfreier Audit-Eintrag"),
      interfaces: copy("engine API, envelope UI", "Engine-API, Envelope-UI"),
      maturity: copy("engine released, envelope live, early product", "Engine veröffentlicht, Envelope live, frühes Produkt"),
    },
  },
];
---

<MicrositeLayout
  title={copy(
    "INSPR Overview | From an idea to something that runs",
    "INSPR Überblick | Von einer Idee zu etwas, das läuft",
  )}
  description={copy(
    "A calm overview of how Aithema, Paimos, Pharos and Janus carry difficult work while a person approves every handoff.",
    "Ein ruhiger Überblick darüber, wie Aithema, Paimos, Pharos und Janus schwierige Arbeit übernehmen, während jede Übergabe von einem Menschen freigegeben wird.",
  )}
  canonical={canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  ogImage={ogImage}
  ogImageAlt={copy(
    "The INSPR idea becoming a human-approved path through four products",
    "Die INSPR-Idee wird zu einem von Menschen freigegebenen Weg durch vier Produkte",
  )}
  favicon={insprLogo.src}
  theme="inspr"
>
  <MicrositeHeader
    name="INSPR"
    category={copy(productTaxonomy.inspr, "Offene Produktfamilie")}
    logo={insprLogo.src}
    active="inspr"
    nav={nav}
    showSignIn={true}
    showProductSwitcher={false}
    primaryAction={{ label: copy("Full site", "Website"), href: fullSiteUrl }}
    locale={locale}
    languageLinks={{ en: "/overview/", de: "/de/ueberblick/" }}
    detailsSlider={{
      label: "Details",
      description: copy("How much detail this page shows", "Wie viel Detail diese Seite zeigt"),
      controls: "overview-details",
      levels: [
        { id: "simple", label: copy("Simple", "Einfach") },
        { id: "standard", label: "Standard" },
        { id: "technical", label: copy("Technical", "Technisch") },
      ],
    }}
  />

  <main id="main-content" class="overview-main">
    <section class="overview-hero page-shell" data-depth-layout aria-labelledby="overview-title">
      <div class="overview-hero__copy">
        <p class="overview-kicker" data-index="00">{copy("A clear starting point", "Ein klarer Einstieg")}</p>
        <h1 id="overview-title">
          {copy("From an idea to something that ", "Von einer Idee zu etwas, das ")}
          <em>{copy("runs.", "läuft.")}</em>
        </h1>
        <p class="overview-lede">
          <DetailLevels
            simple={copy(
              "INSPR is a set of open tools that do the hard technical work. You only decide what goes ahead.",
              "INSPR ist ein Satz offener Werkzeuge, die die schwere technische Arbeit erledigen. Sie entscheiden nur, was weitergeht.",
            )}
            standard={copy(
              "INSPR is an open product family. Its tools carry the difficult work while you choose what moves forward.",
              "INSPR ist eine offene Produktfamilie. Die Werkzeuge übernehmen die schwierige Arbeit, während Sie entscheiden, was weitergeht.",
            )}
            technical={copy(
              "INSPR is an AGPL product family: agents work inside declared boundaries, every handoff is a human-approved gate, and the whole stack from host config to doctrine is code.",
              "INSPR ist eine AGPL-Produktfamilie: Agenten arbeiten innerhalb deklarierter Grenzen, jede Übergabe ist ein von Menschen freigegebenes Gate, und der gesamte Stack von der Hostkonfiguration bis zur Doktrin ist Code.",
            )}
          />
        </p>
        <a class="overview-button" href="#path">
          {copy("See how it works", "So funktioniert es")} <span aria-hidden="true">↓</span>
        </a>
        <dl class="overview-spec overview-drawer" data-drawer aria-label={copy("This page, technically", "Diese Seite, technisch")}>
          <div class="overview-drawer__inner">
            <div><dt>{copy("release", "Release")}</dt><dd class="overview-spec__token" data-live="release">…</dd></div>
            <div><dt>{copy("source", "Quelle")}</dt><dd class="overview-spec__token" data-live="source">…</dd></div>
            <div><dt>{copy("deployed", "veröffentlicht")}</dt><dd class="overview-spec__token" data-live="deployed">…</dd></div>
            <div><dt>CSP</dt><dd class="overview-spec__token" data-live="csp">…</dd></div>
            <div><dt>HSTS</dt><dd class="overview-spec__token" data-live="hsts">…</dd></div>
            <div><dt>{copy("licence", "Lizenz")}</dt><dd class="overview-spec__token">AGPL-3.0-only</dd></div>
            <div><dt>{copy("hosts", "Hosts")}</dt><dd>{copy("1 build · 5 hostnames · 2 languages", "1 Build · 5 Hostnamen · 2 Sprachen")}</dd></div>
          </div>
        </dl>
      </div>

      <div class="overview-flow" role="img" aria-label={copy(
        "An idea moves through requirements, build, deployment and access",
        "Eine Idee durchläuft Anforderungen, Umsetzung, Bereitstellung und Zugriff",
      )}>
        <div class="overview-flow__line" aria-hidden="true"></div>
        <ol>
          {flowNodes.map((node, index) => (
            <li>
              <span class:list={["overview-flow__node", { "overview-flow__node--idea": index === 0 }]}>
                <img src={node.logo.src} alt="" width="46" height="46" />
              </span>
              <span>{node.label}</span>
              <span class="overview-flow__handoff" aria-hidden="true">{node.handoff}</span>
            </li>
          ))}
        </ol>
      </div>

      <ul class="overview-promises" data-depth-min="standard" aria-label={copy("What remains yours", "Was bei Ihnen bleibt")}>
        {promises.map((promise) => (
          <li>
            <span class="overview-promise__icon"><ContextIcon name={promise.icon} size={23} strokeWidth={1.65} /></span>
            <span>
              <strong>{promise.title}</strong>
              <small><DetailLevels simple={promise.simple} standard={promise.body} technical={promise.technical} /></small>
              <span class="overview-drawer overview-promise__mechanism" data-drawer>
                <span class="overview-drawer__inner"><b>{sheetLabels.mechanism}</b> {promise.mechanism}</span>
              </span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="overview-path page-shell" data-depth-layout id="path" aria-labelledby="path-title">
      <header class="overview-path__header">
        <div>
          <p class="overview-kicker" data-index="01">{copy("The path", "Der Weg")}</p>
          <h2 id="path-title">{copy("One path. Four tools. You approve.", "Ein Weg. Vier Werkzeuge. Sie geben frei.")}</h2>
        </div>
        <p>
          <DetailLevels
            simple={copy(
              "Each tool does one hard job, shows you what it made and waits for you.",
              "Jedes Werkzeug erledigt eine schwere Aufgabe, zeigt Ihnen das Ergebnis und wartet auf Sie.",
            )}
            standard={copy(
              "Each tool does one difficult job, shows you the result and waits.",
              "Jedes Werkzeug übernimmt eine schwierige Aufgabe, zeigt das Ergebnis und wartet.",
            )}
            technical={copy(
              "Each tool owns one stage, emits reviewable evidence and blocks on an explicit human approval.",
              "Jedes Werkzeug besitzt eine Stufe, erzeugt prüfbare Nachweise und blockiert bis zur expliziten menschlichen Freigabe.",
            )}
          />
        </p>
      </header>

      <ol class="overview-steps">
        {steps.map((step, index) => (
          <li class="overview-step-item">
            <a
              class="overview-step"
              href={step.href}
              data-product={step.id}
              data-hero-loop-interaction
              aria-labelledby={`overview-step-${step.id}-title`}
              aria-describedby={`overview-step-${step.id}-role overview-step-${step.id}-body overview-step-${step.id}-approval`}
            >
              <div class="overview-step__preview" data-depth-min="standard" aria-hidden="true">
                <HeroLoop
                  id={step.id}
                  poster={step.hero}
                  video={step.video}
                  alt=""
                  sizes="(min-width: 90rem) 17.5rem, (min-width: 80.0625rem) calc(20.5vw - 1.5rem), (min-width: 40rem) calc((100vw - 7.5rem) / 2), calc(100vw - 5.5rem)"
                  locale={locale}
                  activation="hover"
                  showControl={false}
                  loading="lazy"
                />
              </div>
              <div class="overview-step__content">
                <div class="overview-step__top">
                  <span class="overview-step__number">{step.number}</span>
                  <img src={step.logo.src} alt="" width="54" height="54" />
                </div>
                <p class="overview-step__role" id={`overview-step-${step.id}-role`}>{step.role}</p>
                <h3 id={`overview-step-${step.id}-title`}>
                  <span class="overview-step__name">{step.name}</span>
                  <span class="overview-step__arrow" aria-hidden="true">↗</span>
                </h3>
                <p class="overview-step__body" id={`overview-step-${step.id}-body`}><DetailLevels simple={step.simple} standard={step.body} technical={step.technical} /></p>
                <p class="overview-step__approval" data-depth-min="standard" id={`overview-step-${step.id}-approval`}>
                  <ContextIcon name="user-round-check" size={20} strokeWidth={1.75} />
                  <span>{step.approval}</span>
                </p>
              </div>
              {index < steps.length - 1 && (
                <span class="overview-step__connector" data-depth-min="standard" aria-hidden="true">
                  <ContextIcon name="user-round-check" size={18} strokeWidth={1.6} />
                </span>
              )}
            </a>
            <dl class="overview-sheet overview-drawer" data-drawer aria-label={`${step.name}, ${copy("technical sheet", "technisches Datenblatt")}`}>
              <div class="overview-drawer__inner">
                <div><dt>{sheetLabels.repo}</dt><dd>{step.sheet.repo}</dd></div>
                <div><dt>{sheetLabels.runtime}</dt><dd>{step.sheet.runtime}</dd></div>
                <div><dt>{sheetLabels.gate}</dt><dd>{step.sheet.gate}</dd></div>
                <div><dt>{sheetLabels.artefact}</dt><dd>{step.sheet.artefact}</dd></div>
                <div><dt>{sheetLabels.interfaces}</dt><dd>{step.sheet.interfaces}</dd></div>
                <div><dt>{sheetLabels.maturity}</dt><dd>{step.sheet.maturity}</dd></div>
                {"command" in step.sheet && step.sheet.command && (
                  <code class="overview-sheet__command">$ {step.sheet.command}</code>
                )}
              </div>
            </dl>
          </li>
        ))}
      </ol>

      <div class="overview-control" data-depth-min="standard">
        <p class="overview-control__default">
          <ContextIcon name="shield-check" size={23} strokeWidth={1.7} />
          <span>
            <strong>{copy("You stay in control.", "Sie behalten die Kontrolle.")}</strong>
            {copy(
              " Every transition waits for your approval. Nothing moves forward without you.",
              " Jede Übergabe wartet auf Ihre Freigabe. Ohne Sie geht nichts weiter.",
            )}
          </span>
        </p>
        {steps.map((step) => (
          <div class="overview-control__step" data-control-step={step.id} aria-hidden="true">
            <span class="overview-control__number">{step.number}</span>
            <span class="overview-control__copy">
              <strong>{step.role}</strong>
              <span><DetailLevels simple={step.simple} standard={step.body} technical={step.technical} /></span>
            </span>
            <span class="overview-control__approval">
              <ContextIcon name="user-round-check" size={20} strokeWidth={1.75} />
              <strong>{step.approval}</strong>
            </span>
          </div>
        ))}
      </div>
    </section>

    <OverviewStack locale={locale} />

    <section class="overview-next page-shell" data-depth-min="standard" aria-labelledby="next-title">
      <div class="overview-next__copy">
        <p class="overview-kicker" data-index="03">{copy("Beyond the overview", "Nach dem Überblick")}</p>
        <h2 id="next-title">{copy("The rest is open to you.", "Alles Weitere steht Ihnen offen.")}</h2>
        <p>
          <DetailLevels
            simple={copy(
              "The full website explains each tool in plain words.",
              "Die ganze Website erklärt jedes Werkzeug in einfachen Worten.",
            )}
            standard={copy(
              "The full site connects the four tools with their principles, evidence and complete product pages.",
              "Die ganze Website verbindet die vier Werkzeuge mit ihren Prinzipien, Nachweisen und vollständigen Produktseiten.",
            )}
            technical={copy(
              "The full site carries principles, evidence, source links and the complete product pages.",
              "Die ganze Website enthält Prinzipien, Nachweise, Quellcode-Links und die vollständigen Produktseiten.",
            )}
          />
        </p>
        <div class="overview-next__actions">
          <a class="overview-button" href={fullSiteUrl}>
            {copy("Continue to the full site", "Weiter zur ganzen Website")} <span aria-hidden="true">→</span>
          </a>
          <a class="overview-text-link" href={openSourceUrl} target="_blank" rel="noopener noreferrer">
            {copy("Source on GitHub", "Quellcode auf GitHub")} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="overview-threshold" aria-hidden="true">
        <span class="overview-threshold__line"></span>
        <span class="overview-threshold__aperture"></span>
      </div>
    </section>
  </main>

  <footer class="overview-footer page-shell">
    <p>© {new Date().getUTCFullYear()} <a href={siteUrls.author} rel="me">Markus Barta</a> · INSPR</p>
    <a href={fullSiteUrl}>{copy("Full site", "Ganze Website")} <span aria-hidden="true">→</span></a>
  </footer>
</MicrositeLayout>
