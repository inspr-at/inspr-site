---
import ContextIcon from "./ContextIcon.astro";
import HeroLoop from "./HeroLoop.astro";
import MicrositeHeader from "./MicrositeHeader.astro";
import DetailLevels from "./DetailLevels.astro";
import OverviewStack from "./OverviewStack.astro";
import StatusChip from "./StatusChip.astro";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import CalendarVersion from "./CalendarVersion.astro";
import { releaseMetadata } from "../../release-metadata.mjs";
import "../styles/overview.css";

import {
  contract,
  engineJobs,
  flow,
  message,
  productRole,
  products as familyProducts,
  trustContexts,
} from "../content/family";
import { localeUrls, productTaxonomy, productTaxonomyDe, siteUrls } from "../content/urls";
import insprHero from "../assets/products/inspr/hero.png";
import insprLogo from "../assets/products/inspr/logo.svg";
import aithemaHero from "../assets/products/aithema/hero.png";
import aithemaHeroLoop from "../assets/products/aithema/hero-loop.mp4";
import aithemaLogo from "../assets/products/aithema/logo.svg";
import paimosHero from "../assets/products/paimos/hero.png";
import paimosHeroLoop from "../assets/products/paimos/hero-loop.mp4";
import paimosLogo from "../assets/products/paimos/logo.svg";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosHeroLoop from "../assets/products/pharos/hero-loop.mp4";
import pharosLogo from "../assets/products/pharos/mark.svg";
import janusHero from "../assets/products/janus/hero.png";
import janusHeroLoop from "../assets/products/janus/hero-loop.mp4";
import janusLogo from "../assets/products/janus/logo.svg";

interface Props {
  locale?: "en" | "de";
}

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const legalLinks = localeUrls(locale);
const copy = (english: string, german: string) => locale === "de" ? german : english;
const productHref = (href: string) =>
  locale === "de" ? `${href}/de/?lang=de` : href;

const openSourceUrl = "https://github.com/inspr-at";
const englishUrl = siteUrls.overview;
const germanUrl = siteUrls.overviewGerman;
const canonicalUrl = locale === "de" ? germanUrl : englishUrl;
const fullSiteUrl = locale === "de" ? `${siteUrls.inspr}/de/` : `${siteUrls.inspr}/`;
const ogImage = new URL(insprHero.src, siteUrls.inspr).href;

const nav = [
  { label: copy("Overview", "Überblick"), href: canonicalUrl, current: true },
  { label: copy("Products", "Produkte"), href: `${fullSiteUrl}#products` },
  { label: copy("Principles", "Prinzipien"), href: `${fullSiteUrl}#principles` },
  { label: copy("Source", "Quellcode"), href: `${fullSiteUrl}#source` },
];

// INSPR-543: the stage vocabulary comes from family.ts, the same seven steps as the
// home page. Only the logo and the technical handoff label are local.
const flowNodes = [
  { key: "idea" as const, logo: insprLogo, handoff: copy("conversation + files", "Gespräch + Dateien") },
  { key: "requirements" as const, logo: aithemaLogo, handoff: copy("approved requirement set", "freigegebene Anforderungen") },
  { key: "plan" as const, logo: paimosLogo, handoff: copy("tickets + knowledge", "Tickets + Wissen") },
  { key: "build" as const, icon: "git-branch", handoff: copy("reviewed change", "geprüfte Änderung") },
  { key: "deploy" as const, logo: pharosLogo, handoff: copy("release on a declared host", "Release auf deklariertem Host") },
  { key: "access" as const, logo: janusLogo, handoff: copy("bounded permit", "begrenzte Freigabe") },
  { key: "learn" as const, icon: "rotate-ccw", handoff: copy("lessons back into knowledge", "Erkenntnisse zurück ins Wissen") },
].map((node) => ({
  ...node,
  label: flow.steps.find((step) => step.key === node.key)!.label[locale],
}));
const flowSummary = flowNodes.map((node) => node.label).join(" → ");

// Technical depth: the enforcement behind each promise.
const sheetLabels = {
  repo: copy("repo", "Repository"),
  runtime: copy("runtime", "Laufzeit"),
  gate: copy("gate", "Freigabe"),
  artefact: copy("artefact", "Artefakt"),
  interfaces: copy("interfaces", "Schnittstellen"),
  maturity: copy("maturity", "Reife"),
  mechanism: copy("enforced by", "durchgesetzt durch"),
};

// INSPR-543: the page's own build-time facts. Header-only values (CSP, HSTS) are not
// known at build, so they are not shown.
const buildFacts = {
  release: releaseMetadata.releaseId,
  source: releaseMetadata.gitLabel,
  deployed: releaseMetadata.deployedAt ?? copy("not deployed", "nicht veröffentlicht"),
};

const houseRuleDetail = copy(
  "Desired state lives in git, the products reconcile it, and drift becomes visible.",
  "Der Sollzustand liegt in Git, die Produkte gleichen ihn ab, und Abweichungen werden sichtbar.",
);

const promises = [
  {
    icon: "user-round-check",
    title: copy("Your decisions", "Ihre Entscheidungen"),
    simple: copy("You decide what goes ahead.", "Sie entscheiden, was weitergeht."),
    body: copy("People own policy, GO, taste and acceptance.", "Menschen verantworten Regeln, Freigabe, Geschmack und Abnahme."),
    technical: copy(
      "Agents request, people approve: an agent cannot grant itself more rights.",
      "Agenten fragen an, Menschen geben frei: Ein Agent kann sich selbst keine weiteren Rechte erteilen.",
    ),
    mechanism: copy(
      "Gates live in each product, not in a convention: Aithema asks for Continue, Paimos for a grant a person approves, Pharos for a confirmation before a host applies anything.",
      "Freigaben leben in jedem Produkt, nicht in einer Konvention: Aithema fragt nach „Weiter“, Paimos nach einer Freigabe durch eine Person, Pharos nach einer Bestätigung, bevor ein Host etwas anwendet.",
    ),
  },
  {
    icon: "git-branch",
    title: copy("Open source", "Offener Quellcode"),
    simple: copy("All four tools are free to inspect and use.", "Alle vier Werkzeuge sind frei einsehbar und nutzbar."),
    body: copy(
      "Aithema, Paimos, Pharos and Janus are open source under AGPL-3.0-only.",
      "Aithema, Paimos, Pharos und Janus sind Open Source unter AGPL-3.0-only.",
    ),
    technical: copy(
      "Aithema, Paimos, Pharos and Janus are AGPL-3.0-only on GitHub.",
      "Aithema, Paimos, Pharos und Janus sind AGPL-3.0-only auf GitHub.",
    ),
    mechanism: copy(
      "Each repository declares its SPDX licence; releases are tagged and the site links the exact sources. The Doctrine is AGPL-3.0-only too. Running it as a service obliges you to publish your changes.",
      "Jedes Repository deklariert seine SPDX-Lizenz; Releases sind getaggt, die Website verlinkt die exakten Quellen. Auch die Doktrin steht unter AGPL-3.0-only. Wer es als Dienst betreibt, muss Änderungen veröffentlichen.",
    ),
  },
  {
    icon: "database",
    title: copy("Your data", "Ihre Daten"),
    simple: copy("Nobody else gets your data.", "Niemand sonst bekommt Ihre Daten."),
    body: copy("Your data remains yours, throughout.", "Ihre Daten bleiben durchgehend Ihre Daten."),
    technical: copy(
      "Data stays in your instances; secret values never appear in transcripts or logs.",
      "Daten bleiben in Ihren Instanzen; Geheimniswerte erscheinen nie in Transkripten oder Logs.",
    ),
    mechanism: copy(
      "Self-hosted instances behind your own sign-in. Secrets are encrypted at rest and handed out as references and bounded permits, so a value cannot end up in a prompt or a log.",
      "Selbst betriebene Instanzen hinter Ihrer eigenen Anmeldung. Geheimnisse liegen verschlüsselt und werden als Referenzen und begrenzte Freigaben herausgegeben; ein Wert kann so nicht in einem Prompt oder Log landen.",
    ),
  },
  {
    icon: "server",
    title: copy("Your servers", "Ihre Server"),
    simple: copy("It runs where you say, even on your own machines.", "Es läuft, wo Sie es sagen, auch auf Ihren eigenen Maschinen."),
    body: copy("You choose where the result runs.", "Sie bestimmen, wo das Ergebnis läuft."),
    technical: copy(
      "Self-hosted by design: declared hosts, backup evidence, your cloud or your basement.",
      "Selbst betrieben von Grund auf: deklarierte Hosts, Backup-Nachweise, Ihre Cloud oder Ihr Keller.",
    ),
    mechanism: copy(
      "Hosts are described in Nix and built from that description. Pharos records the backup evidence of the target before a host may apply anything; the browser never sends commands to a host.",
      "Hosts sind in Nix beschrieben und werden daraus gebaut. Pharos hält den Backup-Nachweis des Ziels fest, bevor ein Host etwas anwenden darf; der Browser sendet nie Befehle an einen Host.",
    ),
  },
];

const steps = [
  {
    id: "aithema" as const,
    number: "01",
    name: "Aithema",
    logo: aithemaLogo,
    hero: aithemaHero,
    video: aithemaHeroLoop,
    href: siteUrls.aithema,
    simple: copy("You talk, it writes down what you need.", "Sie reden, es schreibt auf, was Sie brauchen."),
    technical: copy(
      "Conversation and documents become structured, reviewable requirements before any code exists.",
      "Gespräche und Dokumente werden zu strukturierten, prüfbaren Anforderungen, bevor Code existiert.",
    ),
    sheet: {
      repo: copy("github.com/inspr-at/aithema; hosted workspace by invitation", "github.com/inspr-at/aithema; gehosteter Arbeitsbereich auf Einladung"),
      runtime: copy("hosted web workspace", "gehosteter Web-Arbeitsbereich"),
      gate: copy("a person reviews the requirement set and chooses Continue; nothing downstream starts on a draft", "ein Mensch prüft den Anforderungssatz und wählt Weiter; nichts Nachgelagertes startet auf einem Entwurf"),
      artefact: copy("structured, versioned requirement set with its sources", "strukturierter, versionierter Anforderungssatz mit seinen Quellen"),
      interfaces: copy("web workspace", "Web-Arbeitsbereich"),
      maturity: copy("core released, AGPL-3.0-only; hosted workspace by invitation", "Kern veröffentlicht, AGPL-3.0-only; gehosteter Arbeitsbereich auf Einladung"),
    },
  },
  {
    id: "paimos" as const,
    number: "02",
    name: "Paimos",
    logo: paimosLogo,
    hero: paimosHero,
    video: paimosHeroLoop,
    href: siteUrls.paimos,
    simple: copy("Your plan, your notes and your agents' work live in one place.", "Ihr Plan, Ihre Notizen und die Arbeit Ihrer Agenten liegen an einem Ort."),
    technical: copy(
      "Tickets and knowledge in one tenant-scoped model; the engine admits, reviews and audits builder runs, with per-slice state and merge through Paimos still planned.",
      "Tickets und Wissen in einem mandantenfähigen Modell; die Arbeitssteuerung lässt Läufe von Entwicklungsagenten zu, prüft und protokolliert sie, Zustand je Arbeitsabschnitt und Zusammenführen über Paimos sind noch geplant.",
    ),
    sheet: {
      repo: "github.com/inspr-at/paimos",
      runtime: copy("self-hosted, one container, sign-in via OIDC", "selbst gehostet, ein Container, Anmeldung per OIDC"),
      gate: copy("an agent works within its key's scopes; gated steps need a grant a person approves, and the decision is an event in the log", "ein Agent arbeitet im Rahmen der Scopes seines Schlüssels; geschützte Schritte brauchen eine Freigabe durch eine Person, und die Entscheidung ist ein Ereignis im Protokoll"),
      artefact: copy("tickets, knowledge, work orders and run records, permission-aware", "Tickets, Wissen, Arbeitsaufträge und Laufprotokolle, berechtigungsbewusst"),
      interfaces: copy("UI, CLI, HTTP API", "UI, CLI, HTTP-API"),
      maturity: copy("released, AGPL-3.0-only; engine partly live", "veröffentlicht, AGPL-3.0-only; Arbeitssteuerung teilweise live"),
      command: 'aeon issue create -p PROJ --title "Write release notes"',
    },
  },
  {
    id: "pharos" as const,
    number: "03",
    name: "Pharos",
    logo: pharosLogo,
    hero: pharosHero,
    video: pharosHeroLoop,
    href: siteUrls.pharos,
    simple: copy("It shows where things run and whether they are backed up.", "Es zeigt, wo etwas läuft und ob es gesichert ist."),
    technical: copy(
      "Fleet truth, backup evidence and a guarded deploy to a declared host; rollback is one symlink away.",
      "Flottenzustand, Backup-Nachweis und eine abgesicherte Bereitstellung auf einen deklarierten Host; ein symbolischer Link genügt zum Zurücksetzen.",
    ),
    sheet: {
      repo: "github.com/inspr-at/pharos",
      runtime: copy("Rust server plus an outbound host beacon; no inbound port on the host", "Rust-Server plus ausgehender Meldedienst auf dem Host; kein eingehender Port am Host"),
      gate: copy("backup evidence, build result, authorisation and an explicit confirmation are recorded before the host may apply anything", "Backup-Nachweis, Build-Ergebnis, Autorisierung und eine ausdrückliche Bestätigung werden festgehalten, bevor der Host etwas anwenden darf"),
      artefact: copy("host reports, backup and restore evidence, the review record", "Host-Berichte, Backup- und Wiederherstellungsnachweise, das Prüfprotokoll"),
      interfaces: copy("UI, beacon, OIDC", "UI, Meldedienst, OIDC"),
      maturity: copy("released, AGPL-3.0-only; provisioning attended", "veröffentlicht, AGPL-3.0-only; Provisionierung betreut"),
    },
  },
  {
    id: "janus" as const,
    number: "04",
    name: "Janus",
    logo: janusLogo,
    hero: janusHero,
    video: janusHeroLoop,
    href: siteUrls.janus,
    simple: copy("It hands out access only when allowed, and takes it back.", "Es vergibt Zugriff nur, wenn erlaubt, und nimmt ihn wieder zurück."),
    technical: copy(
      "Bounded secret permits with roles, delegation and value-free audit; rotation without exposure.",
      "Begrenzte Freigaben für Geheimnisse mit Rollen, Delegation und Audit ohne Werte; Rotation ohne Offenlegung.",
    ),
    sheet: {
      repo: "github.com/inspr-at/janus",
      runtime: copy("Rust engine with an encrypted store; a separate Go envelope for human oversight", "Rust-Engine mit verschlüsseltem Speicher; eine separate Go-Hülle für die menschliche Aufsicht"),
      gate: copy("which reference, which requester, which sink: three decisions checked on their own; the value is materialised only inside the reviewed execution path", "welche Referenz, welcher Anfragende, welches Ziel: drei getrennt geprüfte Entscheidungen; der Wert wird nur im geprüften Ausführungspfad materialisiert"),
      artefact: copy("a bounded permit and a value-free audit record", "eine begrenzte Freigabe und ein Audit-Eintrag ohne Werte"),
      interfaces: copy("engine API, envelope UI", "Engine-API, Hüllen-UI"),
      maturity: copy("engine released, envelope live, AGPL-3.0-only; broker for agent identities planned", "Engine veröffentlicht, Hülle live, AGPL-3.0-only; Broker für Agenten-Identitäten geplant"),
    },
  },
];
---

<MicrositeLayout
  title={copy(
    "INSPR Overview | From an idea to something that runs",
    "INSPR Überblick | Von einer Idee zu etwas, das läuft",
  )}
  description={message.sub[locale]}
  canonical={canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  ogImage={ogImage}
  ogImageAlt={copy(
    "The INSPR flow from idea to running software, with four open products and a doctrine",
    "Der INSPR-Ablauf von der Idee zur laufenden Software, mit vier offenen Produkten und einer Doktrin",
  )}
  favicon={insprLogo.src}
  theme="inspr"
>
  <MicrositeHeader
    name="INSPR"
    category={locale === "de" ? productTaxonomyDe.inspr : productTaxonomy.inspr}
    logo={insprLogo.src}
    active="inspr"
    nav={nav}
    showProductSwitcher={false}
    primaryAction={{ label: copy("Full site", "Website"), href: fullSiteUrl }}
    locale={locale}
    languageLinks={{ en: "/overview/", de: "/de/ueberblick/" }}
    detailsSlider={{
      label: "Details",
      description: copy("How much detail this page shows", "Wie viel Detail diese Seite zeigt"),
      controls: "overview-details",
      levels: [
        { id: "simple", label: copy("Simple", "Einfach") },
        { id: "standard", label: "Standard" },
        { id: "technical", label: copy("Technical", "Technisch") },
      ],
    }}
  />

  <main id="main-content" class="overview-main">
    <section class="overview-hero page-shell" data-depth-layout aria-labelledby="overview-title">
      <div class="overview-hero__copy">
        <p class="overview-kicker" data-index="00">{copy("A clear starting point", "Ein klarer Einstieg")}</p>
        <h1 id="overview-title">
          {copy("From an idea to something that ", "Von einer Idee zu etwas, das ")}
          <em>{copy("runs.", "läuft.")}</em>
        </h1>
        <p class="overview-lede">
          <DetailLevels
            simple={message.hero[locale]}
            standard={message.sub[locale]}
            technical={copy(
              "INSPR is an AGPL-3.0-only product family: four open products and a doctrine, with the whole stack from hardware to doctrine declared in code.",
              "INSPR ist eine Produktfamilie unter AGPL-3.0-only: vier offene Produkte und eine Doktrin, und der gesamte technische Aufbau von der Hardware bis zur Doktrin ist als Code deklariert.",
            )}
          />
        </p>
        <a class="overview-button" href="#path">
          {copy("See how it works", "So funktioniert es")} <span aria-hidden="true">↓</span>
        </a>
        <dl class="overview-spec overview-drawer" data-drawer aria-label={copy("This page, technically", "Diese Seite, technisch")}>
          <div class="overview-drawer__inner">
            <div><dt>{copy("release", "Release")}</dt><dd class="overview-spec__token">{buildFacts.release}</dd></div>
            <div><dt>{copy("source", "Quelle")}</dt><dd class="overview-spec__token">{buildFacts.source}</dd></div>
            <div><dt>{copy("deployed", "veröffentlicht")}</dt><dd class="overview-spec__token">{buildFacts.deployed}</dd></div>
            <div><dt>{copy("licence", "Lizenz")}</dt><dd class="overview-spec__token">AGPL-3.0-only</dd></div>
            <div><dt>{copy("hosts", "Hosts")}</dt><dd>{copy("1 build · 5 hostnames · 2 languages", "1 Build · 5 Hostnamen · 2 Sprachen")}</dd></div>
          </div>
        </dl>
      </div>

      <div class="overview-flow" role="img" aria-label={`${copy("The INSPR flow: ", "Der INSPR-Ablauf: ")}${flowSummary}`}>
        <div class="overview-flow__line" aria-hidden="true"></div>
        <ol>
          {flowNodes.map((node, index) => (
            <li>
              <span class:list={["overview-flow__node", { "overview-flow__node--idea": index === 0 }]}>
                {node.logo ? (
                  <img src={node.logo.src} alt="" width="46" height="46" />
                ) : (
                  <ContextIcon name={node.icon} size={24} strokeWidth={1.6} />
                )}
              </span>
              <span>{node.label}</span>
              <span class="overview-flow__handoff" aria-hidden="true">{node.handoff}</span>
            </li>
          ))}
        </ol>
      </div>

      <ul class="overview-promises" data-depth-min="standard" aria-label={copy("What remains yours", "Was bei Ihnen bleibt")}>
        {promises.map((promise) => (
          <li>
            <span class="overview-promise__icon"><ContextIcon name={promise.icon} size={23} strokeWidth={1.65} /></span>
            <span>
              <strong>{promise.title}</strong>
              <small><DetailLevels simple={promise.simple} standard={promise.body} technical={promise.technical} /></small>
              <span class="overview-drawer overview-promise__mechanism" data-drawer>
                <span class="overview-drawer__inner"><b>{sheetLabels.mechanism}</b> {promise.mechanism}</span>
              </span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="overview-path page-shell" data-depth-layout id="path" aria-labelledby="path-title">
      <header class="overview-path__header">
        <div>
          <p class="overview-kicker" data-index="01">{copy("The path", "Der Weg")}</p>
          <h2 id="path-title">{copy("Four products, one flow.", "Vier Produkte, ein Ablauf.")}</h2>
        </div>
        <p>
          <DetailLevels
            simple={copy(
              "Each product does one job and says how far it is.",
              "Jedes Produkt erledigt eine Aufgabe und sagt, wie weit es ist.",
            )}
            standard={copy(
              "Each product does one job; a status shows how far it has shipped.",
              "Jedes Produkt erledigt eine Aufgabe; ein Status zeigt, wie weit es ist.",
            )}
            technical={copy(
              "Each product has its own release and runs standalone. The shared contract is being built.",
              "Jedes Produkt hat einen eigenen Release und läuft für sich. Der gemeinsame Vertrag ist im Aufbau.",
            )}
          />
        </p>
      </header>

      <ol class="overview-steps">
        {steps.map((step) => (
          <li class="overview-step-item">
            <a
              class="overview-step"
              href={productHref(step.href)}
              data-product={step.id}
              data-hero-loop-interaction
              aria-labelledby={`overview-step-${step.id}-title`}
              aria-describedby={`overview-step-${step.id}-role overview-step-${step.id}-body overview-step-${step.id}-approval`}
            >
              <div class="overview-step__preview" data-depth-min="standard" aria-hidden="true">
                <HeroLoop
                  id={step.id}
                  poster={step.hero}
                  video={step.video}
                  alt=""
                  sizes="(min-width: 90rem) 17.5rem, (min-width: 80.0625rem) calc(20.5vw - 1.5rem), (min-width: 40rem) calc((100vw - 7.5rem) / 2), calc(100vw - 5.5rem)"
                  locale={locale}
                  activation="hover"
                  showControl={false}
                  loading="lazy"
                />
              </div>
              <div class="overview-step__content">
                <div class="overview-step__top">
                  <span class="overview-step__number">{step.number}</span>
                  <img src={step.logo.src} alt="" width="54" height="54" />
                </div>
                <p class="overview-step__role" id={`overview-step-${step.id}-role`}>{productRole(step.id, locale)}</p>
                <h3 id={`overview-step-${step.id}-title`}>
                  <span class="overview-step__name">{step.name}</span>
                  <span class="overview-step__arrow" aria-hidden="true">↗</span>
                </h3>
                <p class="overview-step__body" id={`overview-step-${step.id}-body`}><DetailLevels simple={step.simple} standard={familyProducts[step.id].oneLiner[locale]} technical={step.technical} /></p>
                <p class="overview-step__approval" data-depth-min="standard" id={`overview-step-${step.id}-approval`}>
                  <StatusChip status={familyProducts[step.id].status} locale={locale} />
                  <span>{familyProducts[step.id].statusNote?.[locale]}</span>
                </p>
              </div>
            </a>
            <dl class="overview-sheet overview-drawer" data-drawer aria-label={`${step.name}, ${copy("technical sheet", "technisches Datenblatt")}`}>
              <div class="overview-drawer__inner">
                <div><dt>{sheetLabels.repo}</dt><dd>{step.sheet.repo}</dd></div>
                <div><dt>{sheetLabels.runtime}</dt><dd>{step.sheet.runtime}</dd></div>
                <div><dt>{sheetLabels.gate}</dt><dd>{step.sheet.gate}</dd></div>
                <div><dt>{sheetLabels.artefact}</dt><dd>{step.sheet.artefact}</dd></div>
                <div><dt>{sheetLabels.interfaces}</dt><dd>{step.sheet.interfaces}</dd></div>
                <div><dt>{sheetLabels.maturity}</dt><dd>{step.sheet.maturity}</dd></div>
                {"command" in step.sheet && step.sheet.command && (
                  <code class="overview-sheet__command">$ {step.sheet.command}</code>
                )}
              </div>
            </dl>
          </li>
        ))}
      </ol>

      <div class="overview-control" data-depth-min="standard">
        <p class="overview-control__default">
          <ContextIcon name="route" size={23} strokeWidth={1.7} />
          <span>
            <strong>{contract.label[locale]}.</strong>
            {" "}{contract.line[locale]}{" "}
            <StatusChip status={contract.status} locale={locale} />
            {" "}{contract.statusNote[locale]}
          </span>
        </p>
        {steps.map((step) => (
          <div class="overview-control__step" data-control-step={step.id} aria-hidden="true">
            <span class="overview-control__number">{step.number}</span>
            <span class="overview-control__copy">
              <strong>{productRole(step.id, locale)}</strong>
              <span><DetailLevels simple={step.simple} standard={familyProducts[step.id].oneLiner[locale]} technical={step.technical} /></span>
            </span>
            <span class="overview-control__approval">
              <StatusChip status={familyProducts[step.id].status} locale={locale} />
              <strong>{familyProducts[step.id].statusNote?.[locale]}</strong>
            </span>
          </div>
        ))}
      </div>
    </section>

    <section class="overview-engine page-shell" data-depth-min="standard" aria-labelledby="engine-title">
      <header class="overview-engine__header">
        <div>
          <p class="overview-kicker" data-index="02">{copy("The engine", "Die Arbeitssteuerung")}</p>
          <h2 id="engine-title">{copy("The engine's six jobs.", "Die sechs Aufgaben der Arbeitssteuerung.")}</h2>
        </div>
        <p>
          {copy(
            "Paimos is growing an engine that runs the work of coding agents: six jobs, each with its own status.",
            "Paimos baut eine Arbeitssteuerung, die die Arbeit von Entwicklungsagenten steuert: sechs Aufgaben, jede mit eigenem Status.",
          )}
        </p>
      </header>
      <ol class="overview-engine__jobs">
        {engineJobs.map((job, index) => (
          <li>
            <span class="overview-engine__number" aria-hidden="true">0{index + 1}</span>
            <div>
              <h3>{job.label[locale]}</h3>
              <p>{job.note[locale]}</p>
            </div>
            <StatusChip status={job.status} locale={locale} />
          </li>
        ))}
      </ol>
    </section>

    <section class="overview-rules page-shell" data-depth-min="standard" aria-labelledby="rules-title">
      <header>
        <p class="overview-kicker" data-index="03">{copy("The rules", "Die Regeln")}</p>
        <h2 id="rules-title">{copy("One house rule, separate tenants.", "Eine Hausregel, getrennte Mandanten.")}</h2>
      </header>
      <div class="overview-rules__grid">
        <article>
          <h3>{copy("The house rule", "Die Hausregel")}</h3>
          <p>{message.houseRule[locale]}</p>
          <p>{houseRuleDetail}</p>
        </article>
        <article>
          <h3>{copy("Trust contexts", "Vertrauenskontexte")}</h3>
          <p>{trustContexts[locale]}</p>
        </article>
      </div>
    </section>

    <OverviewStack locale={locale} />

    <section class="overview-next page-shell" data-depth-min="standard" aria-labelledby="next-title">
      <div class="overview-next__copy">
        <p class="overview-kicker" data-index="05">{copy("Beyond the overview", "Nach dem Überblick")}</p>
        <h2 id="next-title">{copy("The rest is open to you.", "Alles Weitere steht Ihnen offen.")}</h2>
        <p>
          <DetailLevels
            simple={copy(
              "The full website explains each tool in plain words.",
              "Die ganze Website erklärt jedes Werkzeug in einfachen Worten.",
            )}
            standard={copy(
              "The full site connects the four tools with their principles, evidence and complete product pages.",
              "Die ganze Website verbindet die vier Werkzeuge mit ihren Prinzipien, Nachweisen und vollständigen Produktseiten.",
            )}
            technical={copy(
              "The full site carries principles, evidence, source links and the complete product pages.",
              "Die ganze Website enthält Prinzipien, Nachweise, Quellcode-Links und die vollständigen Produktseiten.",
            )}
          />
        </p>
        <div class="overview-next__actions">
          <a class="overview-button" href={fullSiteUrl}>
            {copy("Continue to the full site", "Weiter zur ganzen Website")} <span aria-hidden="true">→</span>
          </a>
          <a class="overview-text-link" href={openSourceUrl} target="_blank" rel="noopener noreferrer">
            {copy("Source on GitHub", "Quellcode auf GitHub")} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="overview-threshold" aria-hidden="true">
        <span class="overview-threshold__line"></span>
        <span class="overview-threshold__aperture"></span>
      </div>
    </section>
  </main>

  <footer class="overview-footer page-shell">
    <p>© {new Date().getUTCFullYear()} <a href={siteUrls.author} rel="me">Markus Barta</a> · INSPR</p>
    {releaseMetadata.calendarVersion && releaseMetadata.versionScheme && (
      <p class="overview-footer__release" data-release-id={releaseMetadata.releaseId}>
        <span>Version</span>
        <CalendarVersion
          value={releaseMetadata.calendarVersion}
          scheme={releaseMetadata.versionScheme}
          locale={locale}
        />
      </p>
    )}
    <nav class="overview-footer__legal" aria-label={copy("Legal", "Rechtliches")}>
      <a href={legalLinks.imprint}>{copy("Legal notice", "Impressum")}</a>
      <a href={legalLinks.privacy}>{copy("Privacy", "Datenschutz")}</a>
    </nav>
    <a href={fullSiteUrl}>{copy("Full site", "Ganze Website")} <span aria-hidden="true">→</span></a>
  </footer>
</MicrositeLayout>
