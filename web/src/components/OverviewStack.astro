---
/**
 * "The stack": the seven layers everything runs on, as a datasheet table.
 * Part of the technical depth of the Overview: the section unfolds when the
 * Details control is at Technical, like every other drawer on the page.
 * Rows answer to #l1 … #l7. The script here handles the layer addresses; the
 * release facts are rendered at build time.
 *
 * Content rule: convey the kind of machine and the tool, never a host name,
 * internal domain, path, repository layout or provider SKU. Planned work
 * carries a StatusChip and no date.
 */
import "../styles/overview-details.css";
import StatusChip from "./StatusChip.astro";
import { message } from "../content/family";
import { releaseMetadata } from "../../release-metadata.mjs";

interface Props {
  locale?: "en" | "de";
}

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const copy = (english: string, german: string) => locale === "de" ? german : english;

const columns = {
  layer: copy("Layer", "Schicht"),
  what: copy("What it is", "Was es ist"),
  tools: copy("Tools", "Werkzeuge"),
  declared: copy("Declared in", "Deklariert in"),
  verified: copy("Verified by", "Geprüft durch"),
  evidence: copy("Evidence", "Nachweis"),
};

// INSPR-543: inspr.at DNS is declared in OpenTofu next to the identity provider;
// the second DNS zone, git-host settings and mesh ACLs are planned (`planned`).
const layers = [
  {
    id: "l7", number: "L7", name: copy("Doctrine", "Doktrin"),
    what: copy("The rulebook every AI agent loads at session start: a tiny always-on kernel for irreversible mistakes, deeper packs on demand.", "Das Regelwerk, das jeder KI-Agent zu Beginn jeder Sitzung lädt: ein winziger, immer aktiver Kern für unumkehrbare Fehler, tiefere Pakete bei Bedarf."),
    tools: [copy("kernel", "Kernel"), copy("domain packs", "Domain-Packs"), "inspr CLI"],
    declared: copy("INSPR modules, versioned by calendar and signed; each repository pins the version it follows", "INSPR-Module, nach Kalender versioniert und signiert; jedes Repository pinnt die Version, der es folgt"),
    verified: copy("inspr check on every machine; inspr heal repairs known drift", "inspr check auf jeder Maschine; inspr heal repariert bekannte Drift"),
    evidence: copy("signed release tags, pinned revisions", "signierte Release-Tags, gepinnte Revisionen"),
    command: "inspr check --profile=server",
  },
  {
    id: "l6", number: "L6", name: copy("Products", "Produkte"),
    what: copy("Aithema, Paimos, Pharos and Janus, four open products with their own repositories and releases. The site family that presents them is one static build on five hostnames, published by a script that can always roll back.", "Aithema, Paimos, Pharos und Janus, vier offene Produkte mit eigenen Repositories und Releases. Die Website-Familie, die sie vorstellt, ist ein statischer Build auf fünf Hostnamen, veröffentlicht von einem Skript, das jederzeit zurückrollen kann."),
    tools: ["Astro", "Caddy", copy("immutable releases", "unveränderliche Releases"), copy("strict CSP", "strikte CSP")],
    declared: copy("each product in its own repository; this site in its public repository, its container declared with the host", "jedes Produkt in einem eigenen Repository; diese Website in ihrem öffentlichen Repository, ihr Container zusammen mit dem Host deklariert"),
    verified: copy("content contracts, CSP hash verification, live probes of every hostname after each release", "Inhaltsverträge, CSP-Hash-Prüfung, Live-Prüfung jedes Hostnamens nach jedem Release"),
    evidence: copy("release manifest of this page, shown below", "Release-Manifest dieser Seite, unten gezeigt"),
    live: true,
  },
  {
    id: "l5", number: "L5", name: copy("Service config", "Dienstkonfiguration"),
    what: copy("Online services with an API are declared as code too. Today that is the DNS of inspr.at and the OIDC identity provider behind every sign-in.", "Auch Online-Dienste mit API werden als Code deklariert. Heute sind das das DNS von inspr.at und der OIDC-Identitätsanbieter hinter jeder Anmeldung."),
    tools: ["OpenTofu", "ZITADEL OIDC", copy("single sign-on", "Einmalanmeldung (SSO)")],
    declared: copy("service declarations in git: the inspr.at DNS and the identity provider", "Dienstdeklarationen in Git: das DNS von inspr.at und der Identitätsanbieter"),
    planned: copy("the second DNS zone and git-host settings", "die zweite DNS-Zone und die Einstellungen des Git-Hosts"),
    verified: copy("plan and apply show the difference before anything changes", "Plan und Anwendung zeigen den Unterschied, bevor sich etwas ändert"),
    evidence: copy("OpenTofu state and the plan before every apply", "Zustandsdatei von OpenTofu und der Plan vor jeder Anwendung"),
  },
  {
    id: "l4", number: "L4", name: "Secrets",
    what: copy("Encrypted at rest and unlocked only by the one host that owns the key. A password vault is the human master copy. Janus issues bounded permits to use a secret, with roles, delegation and a value-free audit, so the value never appears in a prompt or a log.", "Verschlüsselt gespeichert und nur von dem Host entschlüsselt, dem der Schlüssel gehört. Ein Passwort-Tresor ist die Stammkopie für Menschen. Janus stellt begrenzte Freigaben für die Nutzung eines Secrets aus, mit Rollen, Delegation und einem Audit ohne Werte; der Wert erscheint nie in einem Prompt oder Log."),
    tools: ["agenix", copy("password vault", "Passwort-Tresor"), copy("Janus permits", "Janus-Freigaben")],
    declared: copy("encrypted secret declarations in git; each host unlocks only its own", "verschlüsselte Secret-Deklarationen in Git; jeder Host entschlüsselt nur seine eigenen"),
    verified: copy("negative-path tests in Janus; value-free audit of every permit", "Negativpfad-Tests in Janus; Audit jeder Freigabe ohne Werte"),
    evidence: copy("audit records without values", "Audit-Einträge ohne Werte"),
  },
  {
    id: "l3", number: "L3", name: copy("Host config", "Hostkonfiguration"),
    what: copy("Each host is described in text and built from it. The repository is the truth; activation enforces it. Backups run from the same declaration to off-site storage.", "Jeder Host ist in Text beschrieben und wird daraus gebaut. Das Repository ist die Wahrheit; die Aktivierung setzt sie durch. Backups laufen aus derselben Deklaration auf externen Speicher."),
    tools: ["NixOS", "nix-darwin", "Home Manager", "disko", copy("ZFS snapshots", "ZFS-Snapshots"), "restic"],
    declared: copy("one Nix flake for every host, workstation and server", "ein Nix-Flake für jeden Host, Arbeitsplatz wie Server"),
    verified: copy("activation is the check; Pharos reports drift, lock age and backup posture", "die Aktivierung ist die Prüfung; Pharos meldet Drift, Alter der Versionssperre und Backup-Zustand"),
    evidence: copy("host reports, restore validation separate from the last run", "Host-Berichte, Restore-Validierung getrennt vom letzten Lauf"),
  },
  {
    id: "l2", number: "L2", name: copy("Network", "Netzwerk"),
    what: copy("Every machine sits on one private mesh, wherever it is; a self-hosted coordinator holds the keys. Public names go through Cloudflare.", "Jede Maschine hängt in einem privaten Mesh, egal wo sie steht; ein selbst betriebener Koordinator hält die Schlüssel. Öffentliche Namen laufen über Cloudflare."),
    tools: ["Tailscale", "Cloudflare", "Traefik"],
    declared: copy("mesh in the host configuration; the inspr.at DNS declared in OpenTofu (L5)", "Mesh in der Hostkonfiguration; das DNS von inspr.at in OpenTofu deklariert (L5)"),
    planned: copy("mesh access rules (ACLs) in OpenTofu", "Zugriffsregeln (ACLs) des Mesh in OpenTofu"),
    verified: copy("TLS per hostname, HSTS preload, strict CSP on every content page", "TLS pro Hostname, HSTS-Preload, strikte CSP auf jeder Inhaltsseite"),
    evidence: copy("the response headers of this page", "die Antwort-Header dieser Seite"),
  },
  {
    id: "l1", number: "L1", name: "Hardware",
    what: copy("Workstations, home servers and a few rented cloud VMs. Production hosts run production only; labs run on workstations or CI runners.", "Arbeitsplätze, Heimserver und einige gemietete Cloud-VMs. Produktionshosts betreiben nur Produktion; Labore laufen auf Arbeitsplätzen oder CI-Runnern."),
    tools: [copy("workstations", "Arbeitsplätze"), copy("home servers", "Heimserver"), copy("cloud VMs", "Cloud-VMs")],
    declared: copy("inventory lives in Pharos, never in a static list; Pharos provisioning is attended, one server at a time", "Inventar lebt in Pharos, nie in einer statischen Liste; die Provisionierung durch Pharos ist betreut, ein Server nach dem anderen"),
    planned: copy("ephemeral CI and lab VMs provisioned through Pharos", "kurzlebige CI- und Labor-VMs, bereitgestellt über Pharos"),
    verified: copy("liveness from received heartbeats and each host's declared cadence", "Erreichbarkeit aus empfangenen Heartbeats und der deklarierten Taktung jedes Hosts"),
    evidence: copy("heartbeat history with honest gaps", "Heartbeat-Verlauf mit ehrlichen Lücken"),
  },
];

// Values the build knows. CSP and HSTS are response headers, not build facts, so the
// page does not list them.
const live = {
  release: copy("release", "Release"),
  source: copy("source", "Quelle"),
  deployed: copy("deployed", "veröffentlicht"),
  values: {
    release: releaseMetadata.releaseId,
    source: releaseMetadata.gitLabel,
    deployed: releaseMetadata.deployedAt ?? copy("not deployed", "nicht veröffentlicht"),
  },
};

const houseRuleDetail = copy(
  "Desired state lives in git, the products reconcile it, and drift becomes visible.",
  "Der Sollzustand liegt in Git, die Produkte gleichen ihn ab, und Abweichungen werden sichtbar.",
);
---

<section class="overview-stack page-shell overview-drawer overview-drawer--section" id="stack" aria-labelledby="stack-title" data-drawer>
  <div class="overview-drawer__inner">
    <header class="overview-stack__header">
      <div>
        <p class="overview-kicker" data-index="04">{copy("The stack", "Der Stack")}</p>
        <h2 id="stack-title">{copy("What all of this runs on.", "Worauf das alles läuft.")}</h2>
      </div>
      <p>{message.houseRule[locale]} {houseRuleDetail}</p>
    </header>

    <div class="overview-stack__table" role="table" aria-label={copy("The seven layers", "Die sieben Schichten")}>
      <div class="overview-stack__row overview-stack__row--head" role="row">
        <span role="columnheader">{columns.layer}</span>
        <span role="columnheader">{columns.what}</span>
        <span role="columnheader">{columns.tools}</span>
        <span role="columnheader">{columns.declared}</span>
        <span role="columnheader">{columns.verified}</span>
        <span role="columnheader">{columns.evidence}</span>
      </div>
      {layers.map((layer) => (
        <div class="overview-stack__row" role="row" id={layer.id} data-stack-layer={layer.id}>
          <span role="rowheader" class="overview-stack__layer">
            <b>{layer.number}</b>
            <span>{layer.name}</span>
          </span>
          <span role="cell" data-column={columns.what}>
            {layer.what}
            {layer.command && <code class="overview-stack__command">$ {layer.command}</code>}
          </span>
          <span role="cell" data-column={columns.tools}>
            <ul class="overview-stack__tools">{layer.tools.map((tool) => <li>{tool}</li>)}</ul>
          </span>
          <span role="cell" data-column={columns.declared}>
            {layer.declared}
            {layer.planned && (
              <span class="overview-stack__planned">
                <StatusChip status="planned" locale={locale} />
                <span>{layer.planned}</span>
              </span>
            )}
          </span>
          <span role="cell" data-column={columns.verified}>{layer.verified}</span>
          <span role="cell" data-column={columns.evidence}>
            {layer.evidence}
            {layer.live && (
              <dl class="overview-stack__live" data-details-live>
                <div><dt>{live.release}</dt><dd>{live.values.release}</dd></div>
                <div><dt>{live.source}</dt><dd>{live.values.source}</dd></div>
                <div><dt>{live.deployed}</dt><dd>{live.values.deployed}</dd></div>
              </dl>
            )}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Technical depth of the Overview: answer to layer addresses.
  // Bundled by Astro as a same-origin module, so the strict CSP needs no hash.
  const root = document.documentElement;
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-stack-layer]"));

  const technical = () => root.getAttribute("data-details-level") === "technical";
  // Every layer row has an address: #l1 … #l7. Arriving with one asks for
  // the technical depth, then brings the row into view once it has unfolded.
  const rowOfHash = () => rows.find((row) => `#${row.dataset.stackLayer}` === window.location.hash) ?? null;
  const revealRow = () => {
    const row = rowOfHash();
    if (!row) return;
    window.setTimeout(() => row.scrollIntoView({ behavior: "smooth", block: "center" }), 700);
    row.setAttribute("data-stack-highlight", "");
    window.setTimeout(() => row.removeAttribute("data-stack-highlight"), 2600);
  };
  const followHash = () => {
    if (!rowOfHash()) return;
    if (!technical()) {
      document.dispatchEvent(new CustomEvent("inspr:details-request", { detail: { level: "technical" } }));
      return;
    }
    revealRow();
  };

  document.addEventListener("inspr:details-level", (event) => {
    if (!technical()) return;
    const source = (event as CustomEvent<{ source?: string }>).detail?.source;
    if (source === "user" && rowOfHash()) revealRow();
  });
  window.addEventListener("hashchange", followHash);
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !technical()) return;
    if ((event.target as HTMLElement | null)?.closest("[data-details-slider], input, textarea, select")) return;
    document.dispatchEvent(new CustomEvent("inspr:details-request", { detail: { level: "standard" } }));
  });

  followHash();
</script>
