---
/**
 * INSPR-572: paimos.com, the public front door. One screen, no site header:
 * the gold arc, the AEON mark under it, the tagline and one button. The
 * player bar already waits at the foot with the films' questions as chapters.
 * Watch now draws a black curtain over the whole page and plays the
 * "What if…?" films back to back, with sound, round and round until someone
 * pauses or leaves; Esc or Close lift the curtain back to the tagline.
 *
 * The films in the HTML come from the committed manifest snapshot
 * (src/content/films.ts). On the page the player also reads the live
 * manifest next to the films and, if it validates and differs, shows what
 * it lists: a film Markus clears and VID publishes plays without a release.
 *
 * The player picks each film's cut for the screen it plays on: 9:16 when the
 * screen is taller than wide, else 16:9, and the full 1080p60 file only for
 * large or dense screens on a connection that can carry it. Turning a phone
 * switches cut at the same moment of the film. Two video elements take turns,
 * so the next film is buffered while one plays and each change is a
 * crossfade, never a load.
 *
 * Without JavaScript Watch now opens the first film's file; without any
 * cleared film the button leads to paimos.inspr.at. On a fresh arrival the
 * arc draws itself and the rest follows (public/scripts/paimos-intro.js
 * decides, storing nothing).
 */
import { getImage } from "astro:assets";
import { Captions, Maximize, Minimize, Pause, Play, SkipBack, SkipForward, Volume2, VolumeX, X } from "@lucide/astro";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import MicrositeFooter from "./MicrositeFooter.astro";
import { paimosComContent as content } from "../content/paimos-com";
import { filmManifestUrl, films } from "../content/films";
import { siteUrls } from "../content/urls";
import { releaseMetadata } from "../../release-metadata.mjs";
import "@fontsource-variable/geist/index.css";
import "../styles/paimos-tokens.css";
import "../styles/paimos-com.css";

import aeonMark from "../assets/products/paimos/logo.svg";
import deliveryShot from "../assets/products/paimos-aeon/delivery.png";

const hasFilms = films.length > 0;
const lead = films[0];
const totalSeconds = films.reduce((sum, film) => sum + film.durationSeconds, 0);

// The share card is the first film's poster; before any film is cleared it is
// a real screen with demo data.
const fallbackOg = await getImage({ src: deliveryShot, width: 1200, format: "jpg", quality: 82 });
const ogImage = lead ? lead.poster["16x9"] : new URL(fallbackOg.src, siteUrls.paimosCom).href;
const ogImageAlt = lead ? lead.question : content.hero.screenAlt;

const clock = (seconds: number) => {
  const total = Math.round(seconds);
  return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
};
const filmLabel = (index: number) =>
  content.player.film.replace("{n}", String(index + 1)).replace("{total}", String(films.length));
const noScriptFilm = lead ? (lead.video["16x9"].web ?? lead.video["16x9"].full).src : siteUrls.paimos;
const filmKey = films.map((film) => `${film.id}:${film.version}`).join(",");
const icon = { "stroke-width": 1.75, "aria-hidden": "true" } as const;
---

<MicrositeLayout
  title={content.seo.title}
  description={content.seo.description}
  canonical={content.canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  favicon={aeonMark.src}
  theme="paimos"
>
  <script is:inline slot="head" src={`/scripts/paimos-intro.js?v=${releaseMetadata.releaseId}`}></script>

  <main id="main-content" class="landing">
    <section
      class="cinema"
      aria-labelledby="landing-title"
      data-section-pattern="front-door-cinema"
      data-cinema
      data-state={hasFilms ? "idle" : "none"}
      data-controls="shown"
      data-manifest={filmManifestUrl}
      data-films={filmKey}
      data-film-label={content.player.film}
    >
      <div class="cinema__intro page-shell">
        <svg class="cinema__arc" viewBox="0 0 600 150" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="cinema-arc-gold" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#d69b31" stop-opacity="0.15" />
              <stop offset="0.5" stop-color="#e6b04c" />
              <stop offset="1" stop-color="#d69b31" stop-opacity="0.15" />
            </linearGradient>
          </defs>
          <!-- Apex at y 20, ends at y 138: the stroke and its glow stay inside the viewBox. -->
          <path class="cinema__arc-glow" d="M30 138 A368 368 0 0 1 570 138" pathLength="1" />
          <path class="cinema__arc-line" d="M30 138 A368 368 0 0 1 570 138" pathLength="1" />
        </svg>
        <img class="cinema__mark" src={aeonMark.src} alt="" width="64" height="64" />
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="landing-title">
          <span>{content.hero.title}</span>
          <em class="landing-accent">{content.hero.accent}</em>
        </h1>
        <a
          class="cinema__watch"
          href={noScriptFilm}
          data-cinema-watch
          data-learn-href={siteUrls.paimos}
          data-learn-label={content.hero.learnLabel}
        >
          {hasFilms ? (
            <>
              <span class="cinema__watch-disc"><Play {...icon} fill="currentColor" /></span>
              <span>{content.player.watch}</span>
              <span class="cinema__watch-time" data-cinema-total>{clock(totalSeconds)}</span>
            </>
          ) : (
            <>
              <span>{content.hero.learnLabel}</span>
              <span aria-hidden="true">↗</span>
            </>
          )}
        </a>
      </div>

      {hasFilms && (
        <>
          <div class="cinema__curtain" aria-hidden="true"></div>
          <div class="cinema__screen" aria-hidden="true">
            <video class="cinema__video" playsinline preload="none" tabindex="-1" data-cinema-video></video>
            <video class="cinema__video" playsinline preload="none" tabindex="-1" data-cinema-video></video>
          </div>

          <button type="button" class="cinema__close cinema__icon" aria-label={content.player.close} title={`${content.player.close} (Esc)`} data-cinema-close hidden>
            <X {...icon} />
          </button>

          <div class="cinema__bar" role="group" aria-label={content.player.label} data-cinema-bar hidden>
            <div class="cinema__bar-inner page-shell">
              <button type="button" class="cinema__icon cinema__icon--primary" aria-label={content.player.play} title={`${content.player.play} (Space)`} data-cinema-toggle data-label-play={content.player.play} data-label-pause={content.player.pause}>
                <Play {...icon} fill="currentColor" class="cinema__glyph-play" />
                <Pause {...icon} fill="currentColor" class="cinema__glyph-pause" />
              </button>
              <button type="button" class="cinema__icon cinema__step" aria-label={content.player.previous} title={`${content.player.previous} (Shift ←)`} data-cinema-step="-1">
                <SkipBack {...icon} />
              </button>
              <button type="button" class="cinema__icon cinema__step" aria-label={content.player.next} title={`${content.player.next} (Shift →)`} data-cinema-step="1">
                <SkipForward {...icon} />
              </button>
              <p class="cinema__time" aria-hidden="true"><span data-cinema-elapsed>0:00</span> / <span data-cinema-total>{clock(totalSeconds)}</span></p>

              <div class="cinema__timeline">
                <ol class="cinema__chapters" data-cinema-chapters>
                  {films.map((film, index) => {
                    const web16 = film.video["16x9"].web;
                    const web9 = film.video["9x16"].web;
                    return (
                      <li style={`--share: ${film.durationSeconds}`}>
                        <button
                          type="button"
                          title={film.question}
                          aria-label={`${filmLabel(index)}: ${film.question}`}
                          data-cinema-chapter={index}
                          data-duration={film.durationSeconds}
                          data-question={film.question}
                          data-full-16x9={film.video["16x9"].full.src}
                          data-full-9x16={film.video["9x16"].full.src}
                          data-web-16x9={web16?.src}
                          data-web-9x16={web9?.src}
                        >{film.question}</button>
                      </li>
                    );
                  })}
                </ol>
                <div
                  class="cinema__track"
                  role="slider"
                  tabindex="0"
                  aria-label={content.player.seek}
                  aria-valuemin="0"
                  aria-valuemax={Math.round(totalSeconds)}
                  aria-valuenow="0"
                  aria-valuetext={`0:00 / ${clock(totalSeconds)}`}
                  data-cinema-track
                >
                  {films.map((film) => (
                    <span class="cinema__segment" style={`--share: ${film.durationSeconds}`} data-cinema-segment>
                      <span class="cinema__fill"></span>
                    </span>
                  ))}
                  <span class="cinema__handle" aria-hidden="true"></span>
                </div>
              </div>

              <button type="button" class="cinema__icon" aria-label={content.player.transcript} aria-pressed="false" aria-controls="cinema-transcript" title={`${content.player.transcript} (C)`} data-cinema-transcript-toggle>
                <Captions {...icon} />
              </button>
              <button type="button" class="cinema__icon" aria-label={content.player.soundOff} aria-pressed="true" title={`${content.player.soundOff} (M)`} data-cinema-sound data-label-on={content.player.soundOn} data-label-off={content.player.soundOff}>
                <Volume2 {...icon} class="cinema__glyph-sound" />
                <VolumeX {...icon} class="cinema__glyph-muted" />
              </button>
              <button type="button" class="cinema__icon" aria-label={content.player.fullscreen} title={`${content.player.fullscreen} (F)`} data-cinema-fullscreen data-label-enter={content.player.fullscreen} data-label-exit={content.player.exitFullscreen} hidden>
                <Maximize {...icon} class="cinema__glyph-enter" />
                <Minimize {...icon} class="cinema__glyph-exit" />
              </button>
            </div>
          </div>

          <div class="cinema__transcript" id="cinema-transcript" data-cinema-transcript>
            <h2 class="cinema__transcript-title">{content.player.transcriptTitle}</h2>
            <ol data-cinema-texts>
              {films.map((film, index) => (
                <li data-cinema-text={index}>
                  <h3>{film.question}</h3>
                  <ol>
                    {film.words.map((word) => (
                      <li data-kind={word.kind} data-start={word.start} data-end={word.end}>{word.text}</li>
                    ))}
                  </ol>
                </li>
              ))}
            </ol>
          </div>

          <p class="visually-hidden" aria-live="polite" data-cinema-status></p>
        </>
      )}
    </section>
  </main>

  <MicrositeFooter
    name={content.name}
    repositoryUrl={content.repositoryUrl}
    licenseName="AGPL-3.0-only"
    licenseUrl={content.licenseUrl}
    ctaTitle={content.finalCta.title}
    ctaBody={content.finalCta.body}
  />
</MicrositeLayout>

<script>
  // The player, bundled by Astro into a same-origin module. FADE matches
  // --cinema-fade in paimos-com.css.
  import { filmViews, parseFilmManifest, type FilmView } from "../../film-manifest.mjs";

  type Cut = "16x9" | "9x16";
  type Film = { question: string; duration: number; sources: Record<Cut, { full: string; web?: string }> };

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const portrait = window.matchMedia("(orientation: portrait)");
  const FADE = reducedMotion.matches ? 120 : 480;
  const SEEK_STEP = 5;
  const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));
  const frame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
  const clock = (seconds: number) => {
    const total = Math.max(0, Math.floor(seconds));
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
  };

  // The cut follows the screen's shape. The full 1080p60 file plays only where
  // its pixels show (long edge of at least 1700 device pixels) and the
  // connection is neither Save-Data nor slow; everywhere else the 720p file.
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const cut = (): Cut => (portrait.matches ? "9x16" : "16x9");
  const sourceFor = (film: Film) => {
    const sources = film.sources[cut()];
    const constrained = connection?.saveData === true || ["slow-2g", "2g", "3g"].includes(connection?.effectiveType ?? "");
    const longEdge = Math.max(window.innerWidth, window.innerHeight) * (window.devicePixelRatio || 1);
    return !sources.web || (!constrained && longEdge >= 1700) ? sources.full : sources.web;
  };

  const root = document.querySelector<HTMLElement>("[data-cinema]");
  const watchLink = root?.querySelector<HTMLAnchorElement>("[data-cinema-watch]");
  const bar = root?.querySelector<HTMLElement>("[data-cinema-bar]");
  const closeButton = root?.querySelector<HTMLButtonElement>("[data-cinema-close]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-cinema-toggle]");
  const soundButton = root?.querySelector<HTMLButtonElement>("[data-cinema-sound]");
  const fullscreenButton = root?.querySelector<HTMLButtonElement>("[data-cinema-fullscreen]");
  const transcriptButton = root?.querySelector<HTMLButtonElement>("[data-cinema-transcript-toggle]");
  const chapterList = root?.querySelector<HTMLElement>("[data-cinema-chapters]");
  const textList = root?.querySelector<HTMLElement>("[data-cinema-texts]");
  const track = root?.querySelector<HTMLElement>("[data-cinema-track]");
  const elapsedLabel = root?.querySelector<HTMLElement>("[data-cinema-elapsed]");
  const status = root?.querySelector<HTMLElement>("[data-cinema-status]");
  const videos = [...(root?.querySelectorAll<HTMLVideoElement>("[data-cinema-video]") ?? [])];

  if (root && watchLink && bar && closeButton && toggle && soundButton && fullscreenButton && transcriptButton && chapterList && textList && track && videos.length === 2) {
    let chapters: HTMLButtonElement[] = [];
    let segments: HTMLElement[] = [];
    let texts: HTMLElement[] = [];
    let films: Film[] = [];
    let starts: number[] = [];
    let total = 0;

    // Read the films from the chapter buttons, the one record the markup keeps.
    const collect = () => {
      chapters = [...chapterList.querySelectorAll<HTMLButtonElement>("[data-cinema-chapter]")];
      segments = [...track.querySelectorAll<HTMLElement>("[data-cinema-segment]")];
      texts = [...textList.querySelectorAll<HTMLElement>("[data-cinema-text]")];
      films = chapters.map((chapter) => ({
        question: chapter.dataset.question ?? "",
        duration: Number(chapter.dataset.duration) || 30,
        sources: {
          "16x9": { full: chapter.dataset.full16x9 ?? "", web: chapter.dataset.web16x9 || undefined },
          "9x16": { full: chapter.dataset.full9x16 ?? "", web: chapter.dataset.web9x16 || undefined },
        },
      }));
      starts = films.map((_, i) => films.slice(0, i).reduce((sum, film) => sum + film.duration, 0));
      total = films.reduce((sum, film) => sum + film.duration, 0);
      root.querySelectorAll<HTMLElement>("[data-cinema-total]").forEach((label) => { label.textContent = clock(total); });
      track.setAttribute("aria-valuemax", String(Math.round(total)));
    };
    collect();

    let index = 0;
    let active = 0;
    let playing = false;
    let open = false;
    let busy = false;
    let sound = true;
    let hideTimer = 0;
    let dragging = false;
    let pending: FilmView[] | null = null;
    const current = () => videos[active];
    const standby = () => videos[1 - active];

    root.dataset.enhanced = "";
    bar.hidden = false;
    closeButton.hidden = false;
    fullscreenButton.hidden = !document.fullscreenEnabled;

    // ---- Rendering -------------------------------------------------------
    const render = () => {
      if (films.length > 0) root.dataset.state = open ? "open" : "idle";
      root.toggleAttribute("data-paused", open && !playing);
      toggle.setAttribute("aria-label", (playing ? toggle.dataset.labelPause : toggle.dataset.labelPlay) ?? "");
      toggle.toggleAttribute("data-playing", playing);
      soundButton.setAttribute("aria-pressed", String(sound));
      soundButton.setAttribute("aria-label", (sound ? soundButton.dataset.labelOff : soundButton.dataset.labelOn) ?? "");
      soundButton.toggleAttribute("data-muted", !sound);
      const full = document.fullscreenElement === root;
      fullscreenButton.toggleAttribute("data-full", full);
      fullscreenButton.setAttribute("aria-label", (full ? fullscreenButton.dataset.labelExit : fullscreenButton.dataset.labelEnter) ?? "");
      chapters.forEach((chapter, i) => chapter.setAttribute("aria-current", String(open && i === index)));
      texts.forEach((text, i) => text.toggleAttribute("data-current", i === index));
      closeButton.inert = !open;
    };

    const progress = () => {
      if (films.length === 0) return;
      const video = current();
      const local = open && video.dataset.film === String(index) ? Math.min(video.currentTime, films[index].duration) : 0;
      const reel = open ? starts[index] + local : 0;
      segments.forEach((segment, i) => {
        const fill = !open ? 0 : i < index ? 1 : i > index ? 0 : local / films[i].duration;
        segment.style.setProperty("--fill", String(fill));
      });
      // The handle sits in the current segment, gaps between segments included.
      const segment = segments[index];
      const handle = open && segment ? segment.offsetLeft + (local / films[index].duration) * segment.offsetWidth : 0;
      track.style.setProperty("--handle", `${handle}px`);
      if (elapsedLabel) elapsedLabel.textContent = clock(reel);
      track.setAttribute("aria-valuenow", String(Math.round(reel)));
      track.setAttribute("aria-valuetext", `${clock(reel)} / ${clock(total)}, ${films[index].question}`);
      // The line of the transcript that is on screen now.
      const lines = texts[index]?.querySelectorAll<HTMLElement>("[data-start]") ?? [];
      lines.forEach((line) => {
        const on = open && local >= Number(line.dataset.start) && local < Number(line.dataset.end);
        line.toggleAttribute("data-now", on);
      });
    };
    const loop = () => {
      progress();
      if (open) requestAnimationFrame(loop);
    };

    // ---- Controls visibility --------------------------------------------
    // While a film plays the controls leave after a few still seconds, also
    // over the bar and in full screen, and return on any movement. Only
    // keyboard focus in the bar, an open transcript or a drag keep them; a
    // mouse click leaves focus on its button but is no reason to stay.
    const showControls = () => {
      root.dataset.controls = "shown";
      window.clearTimeout(hideTimer);
      if (!open || !playing) return;
      hideTimer = window.setTimeout(() => {
        const keepControls = bar.querySelector(":focus-visible") !== null || root.hasAttribute("data-transcript") || dragging;
        if (open && playing && !keepControls) root.dataset.controls = "hidden";
        else showControls();
      }, 2600);
    };

    // ---- Media -----------------------------------------------------------
    const prepare = (video: HTMLVideoElement, i: number, time = 0) =>
      new Promise<void>((resolve) => {
        const src = sourceFor(films[i]);
        const ready = () => {
          if (Math.abs(video.currentTime - time) > 0.25) video.currentTime = time;
          resolve();
        };
        video.dataset.film = String(i);
        if (video.getAttribute("src") !== src) {
          video.preload = "auto";
          video.src = src;
          video.addEventListener("loadeddata", ready, { once: true });
          video.load();
        } else if (video.readyState >= 2) {
          ready();
        } else {
          video.addEventListener("loadeddata", ready, { once: true });
        }
      });

    const start = async (video: HTMLVideoElement) => {
      video.muted = !sound;
      try {
        await video.play();
      } catch {
        // A browser that refuses sound without a fresh gesture still plays the film.
        sound = false;
        video.muted = true;
        await video.play().catch(() => {});
      }
    };

    const fadeOut = async (video: HTMLVideoElement) => {
      video.removeAttribute("data-shown");
      if (!video.muted && !reducedMotion.matches) {
        const from = video.volume;
        const begun = performance.now();
        while (performance.now() - begun < FADE) {
          video.volume = from * (1 - (performance.now() - begun) / FADE);
          await frame();
        }
        video.pause();
        video.volume = from;
      } else {
        await wait(FADE);
        video.pause();
      }
    };

    const unload = (video: HTMLVideoElement) => {
      video.pause();
      video.removeAttribute("data-shown");
      video.removeAttribute("src");
      video.removeAttribute("data-film");
      video.load();
    };

    // Buffer the next film in the waiting element while this one plays; after
    // the last film the reel starts again with the first.
    const bufferNext = () => {
      void prepare(standby(), (index + 1) % films.length);
    };

    // Change film, or change cut within a film: the waiting element takes
    // over with a crossfade. A film that is already buffered starts at once.
    const switchTo = async (i: number, time = 0) => {
      if (busy) return;
      busy = true;
      const outgoing = current();
      const incoming = standby();
      await prepare(incoming, i, time);
      index = i;
      active = 1 - active;
      render();
      if (playing) await start(incoming);
      incoming.setAttribute("data-shown", "");
      await fadeOut(outgoing);
      unload(outgoing);
      if (status) status.textContent = `${chapters[i].getAttribute("aria-label")}`;
      busy = false;
      bufferNext();
    };

    const openReel = async (i = 0, time = 0) => {
      if (busy || open || films.length === 0) return;
      busy = true;
      if (window.scrollY > 0) {
        window.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
        for (let tries = 0; tries < 40 && window.scrollY > 0; tries++) await wait(25);
      }
      document.documentElement.classList.add("cinema-open");
      open = true;
      playing = true;
      index = i;
      render();
      showControls();
      requestAnimationFrame(loop);
      const video = current();
      // The curtain falls while the film loads; the film rises once it plays.
      await Promise.all([prepare(video, i, time), wait(FADE)]);
      await start(video);
      video.setAttribute("data-shown", "");
      render();
      if (status) status.textContent = `${chapters[i].getAttribute("aria-label")}`;
      closeButton.focus({ preventScroll: true });
      busy = false;
      bufferNext();
    };

    const closeReel = async () => {
      if (!open) return;
      busy = true;
      if (document.fullscreenElement === root) await document.exitFullscreen().catch(() => {});
      await fadeOut(current());
      videos.forEach((video) => {
        video.pause();
        video.removeAttribute("data-shown");
      });
      open = false;
      playing = false;
      root.removeAttribute("data-transcript");
      transcriptButton.setAttribute("aria-pressed", "false");
      render();
      progress();
      showControls();
      await wait(FADE);
      document.documentElement.classList.remove("cinema-open");
      index = 0;
      busy = false;
      watchLink.focus({ preventScroll: true });
      // A live manifest that arrived while the films played applies now.
      if (pending) applyFilms(pending);
    };

    const setPlaying = async (next: boolean) => {
      if (!open) return openReel(index);
      playing = next;
      if (playing) await start(current());
      else current().pause();
      render();
      showControls();
    };

    const seek = (reel: number) => {
      if (films.length === 0) return;
      const target = Math.max(0, Math.min(total - 0.05, reel));
      let i = films.length - 1;
      while (i > 0 && starts[i] > target) i--;
      const time = target - starts[i];
      if (!open) return void openReel(i, time);
      if (i === index) current().currentTime = time;
      else void switchTo(i, time);
      progress();
    };

    // ---- The live manifest -------------------------------------------------
    // The films VID publishes next to the media are the record of what is
    // cleared. A manifest that validates and lists other films than the build
    // replaces the chapters, the timeline and the transcript; one that lists
    // none turns Watch now into Learn more. Anything else keeps the build's.
    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, attributes: Record<string, string | undefined> = {}, text?: string) => {
      const node = document.createElement(tag);
      for (const [name, value] of Object.entries(attributes)) if (value !== undefined) node.setAttribute(name, value);
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const applyFilms = (views: FilmView[]) => {
      pending = null;
      videos.forEach(unload);
      active = 0;
      index = 0;
      const label = root.dataset.filmLabel ?? "{n} / {total}";
      chapterList.replaceChildren(...views.map((film, i) => {
        const item = element("li", { style: `--share: ${film.durationSeconds}` });
        item.append(element("button", {
          type: "button",
          title: film.question,
          "aria-label": `${label.replace("{n}", String(i + 1)).replace("{total}", String(views.length))}: ${film.question}`,
          "data-cinema-chapter": String(i),
          "data-duration": String(film.durationSeconds),
          "data-question": film.question,
          "data-full-16x9": film.video["16x9"].full.src,
          "data-full-9x16": film.video["9x16"].full.src,
          "data-web-16x9": film.video["16x9"].web?.src,
          "data-web-9x16": film.video["9x16"].web?.src,
        }, film.question));
        return item;
      }));
      const handle = track.querySelector(".cinema__handle");
      track.replaceChildren(...views.map((film) => {
        const segment = element("span", { class: "cinema__segment", style: `--share: ${film.durationSeconds}`, "data-cinema-segment": "" });
        segment.append(element("span", { class: "cinema__fill" }));
        return segment;
      }), ...(handle ? [handle] : []));
      textList.replaceChildren(...views.map((film, i) => {
        const item = element("li", { "data-cinema-text": String(i) });
        const lines = element("ol");
        lines.append(...film.words.map((word) => element("li", {
          "data-kind": word.kind,
          "data-start": word.start === undefined ? undefined : String(word.start),
          "data-end": word.end === undefined ? undefined : String(word.end),
        }, word.text)));
        item.append(element("h3", {}, film.question), lines);
        return item;
      }));
      root.dataset.films = views.map((film) => `${film.id}:${film.version}`).join(",");
      collect();
      if (views.length === 0) {
        root.dataset.state = "none";
        bar.hidden = true;
        watchLink.href = watchLink.dataset.learnHref ?? "/";
        watchLink.replaceChildren(element("span", {}, watchLink.dataset.learnLabel ?? ""), element("span", { "aria-hidden": "true" }, "↗"));
      } else {
        watchLink.href = (views[0].video["16x9"].web ?? views[0].video["16x9"].full).src;
      }
      render();
      progress();
    };
    const refresh = async () => {
      const source = root.dataset.manifest;
      if (!source) return;
      try {
        const response = await fetch(String(document.querySelector<HTMLElement>("[data-cinema]")?.dataset.manifest), { cache: "no-cache", credentials: "omit" });
        if (!response.ok) return;
        const manifest = parseFilmManifest(await response.json(), { allowLoopbackBase: new URL(source).protocol === "http:" });
        const views = filmViews(manifest);
        if (views.map((film) => `${film.id}:${film.version}`).join(",") === root.dataset.films) return;
        if (open || busy) pending = views;
        else applyFilms(views);
      } catch {
        // An unreachable or invalid live manifest leaves the build's films playing.
      }
    };

    // ---- Events ----------------------------------------------------------
    videos.forEach((video) => {
      video.addEventListener("ended", () => {
        if (!open || video !== current()) return;
        chapters[index]?.setAttribute("data-watched", "");
        void switchTo((index + 1) % films.length);
      });
      video.addEventListener("waiting", () => root.setAttribute("data-buffering", ""));
      video.addEventListener("playing", () => root.removeAttribute("data-buffering"));
    });

    watchLink.addEventListener("click", (event) => {
      if (films.length === 0) return;
      event.preventDefault();
      void openReel(0);
    });
    closeButton.addEventListener("click", () => void closeReel());
    // A click on the film itself pauses or resumes it, like any player.
    root.querySelector(".cinema__screen")?.addEventListener("click", () => {
      if (open) void setPlaying(!playing);
    });
    toggle.addEventListener("click", () => void setPlaying(!playing));
    root.querySelectorAll<HTMLButtonElement>("[data-cinema-step]").forEach((step) => {
      const direction = Number(step.dataset.cinemaStep);
      step.addEventListener("click", () => {
        const target = (index + direction + films.length) % films.length;
        if (!open) void openReel(target);
        else if (target !== index) void switchTo(target);
        else current().currentTime = 0;
      });
    });
    chapterList.addEventListener("click", (event) => {
      const chapter = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cinema-chapter]");
      if (!chapter) return;
      const i = Number(chapter.dataset.cinemaChapter);
      if (!open) void openReel(i);
      else if (i !== index) void switchTo(i);
      else current().currentTime = 0;
    });
    soundButton.addEventListener("click", () => {
      sound = !sound;
      current().muted = !sound;
      render();
      showControls();
    });
    fullscreenButton.addEventListener("click", async () => {
      if (document.fullscreenElement === root) await document.exitFullscreen().catch(() => {});
      else await root.requestFullscreen().catch(() => {});
      if (!open) await openReel(index);
      render();
    });
    document.addEventListener("fullscreenchange", render);
    transcriptButton.addEventListener("click", () => {
      const on = !root.hasAttribute("data-transcript");
      root.toggleAttribute("data-transcript", on);
      transcriptButton.setAttribute("aria-pressed", String(on));
      if (on) texts[index]?.scrollIntoView({ block: "nearest" });
      showControls();
    });

    // The timeline: press or drag to seek, keys move by five seconds.
    const reelAt = (event: PointerEvent) => {
      const box = track.getBoundingClientRect();
      return ((event.clientX - box.left) / box.width) * total;
    };
    track.addEventListener("pointerdown", (event) => {
      dragging = true;
      track.setPointerCapture(event.pointerId);
      seek(reelAt(event));
    });
    track.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const reel = reelAt(event);
      // Within the current film follow the pointer; across films seek on release.
      if (open && reel >= starts[index] && reel < starts[index] + films[index].duration) seek(reel);
    });
    track.addEventListener("pointerup", (event) => {
      if (!dragging) return;
      dragging = false;
      seek(reelAt(event));
    });
    track.addEventListener("pointercancel", () => { dragging = false; });

    const reelNow = () => (open ? starts[index] + current().currentTime : 0);
    document.addEventListener("keydown", (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || films.length === 0) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest("input, textarea, select, [contenteditable]")) return;
      const onTrack = target === track;
      if (!open && !onTrack) return;
      const key = event.key.toLowerCase();
      let handled = true;
      if (key === "escape" && open && document.fullscreenElement !== root) void closeReel();
      else if ((key === " " && !target?.closest("button, a, summary")) || key === "k") void setPlaying(!playing);
      else if (key === "m") soundButton.click();
      else if (key === "f" && !fullscreenButton.hidden) fullscreenButton.click();
      else if (key === "c") transcriptButton.click();
      else if (key === "arrowright" && event.shiftKey) root.querySelector<HTMLButtonElement>('[data-cinema-step="1"]')?.click();
      else if (key === "arrowleft" && event.shiftKey) root.querySelector<HTMLButtonElement>('[data-cinema-step="-1"]')?.click();
      else if (key === "arrowright") seek(reelNow() + SEEK_STEP);
      else if (key === "arrowleft") seek(reelNow() - SEEK_STEP);
      else if (key === "home" && onTrack) seek(0);
      else if (key === "end" && onTrack) seek(total - 1);
      else handled = false;
      if (handled) {
        event.preventDefault();
        showControls();
      }
    });
    for (const type of ["pointermove", "pointerdown", "keydown", "focusin"] as const) root.addEventListener(type, showControls);

    // Turning the phone or resizing the window picks the right cut again,
    // and the film carries on from the same moment in it.
    let resizeTimer = 0;
    const recut = () => {
      if (!open || busy) return;
      const video = current();
      if (video.getAttribute("src") !== sourceFor(films[index])) void switchTo(index, video.currentTime);
    };
    portrait.addEventListener("change", recut);
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(recut, 250);
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && open && playing) void setPlaying(false);
    });

    render();
    progress();
    void refresh();
  }
</script>
