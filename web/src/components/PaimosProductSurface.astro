---
import { Image, getImage } from "astro:assets";
import ContextIcon from "./ContextIcon.astro";
import surfaceTicket from "../assets/products/paimos/surface-ticket.png";
import surfaceAgents from "../assets/products/paimos/surface-agents.png";
import surfaceKnowledge from "../assets/products/paimos/surface-knowledge.png";
import uiProjects from "../assets/products/paimos/ui-projects.png";
import uiWorkTree from "../assets/products/paimos/ui-work-tree.png";
import uiSearch from "../assets/products/paimos/ui-search.png";
import uiKnowledgeGraph from "../assets/products/paimos/ui-knowledge-graph.png";
import uiReleases from "../assets/products/paimos/ui-releases.png";
import loopTicketAgents from "../assets/products/paimos/loop-ticket-agents.mp4";
import loopSearchNavigate from "../assets/products/paimos/loop-search-navigate.mp4";
import captureManifest from "../assets/products/paimos/capture-manifest.json";
import { paimosContent } from "../content/paimos";

interface Props {
  locale?: "en" | "de";
}

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const copy = (english: string, german: string) => locale === "de" ? german : english;

// This tag describes the captured pixels, not the currently deployed
// application. Keep it unchanged until the images themselves are regenerated.
const captureRelease = captureManifest.tag;
const docsUrl = (document: string) =>
  `${paimosContent.repositoryUrl}/blob/main/docs/${document}`;

// Provenance suffix for every gallery caption. The captured product UI is
// English in both editions; only the editorial framing is localized.
const provenanceCaption = copy(
  `Demo workspace, PAIMOS AEON ${captureRelease}.`,
  `Demo-Arbeitsbereich, PAIMOS AEON ${captureRelease}.`,
);

// Site copy stays free of em dashes in both editions.
const captionSeparator = ": ";

const labels = locale === "de"
  ? {
      eyebrow: "Im Produkt",
      title: "Drei Flächen. Ein Projekt.",
      lead:
        "Diese Ansichten stammen aus einem PAIMOS-AEON-Build mit synthetischen Demo-Daten. Wählen Sie eine Markierung, um zu sehen, wo Absicht, Befugnis und Projektwissen im Produkt liegen, oder öffnen Sie die weiteren Ansichten unten.",
      figcaption: `Demo-Arbeitsbereich, PAIMOS AEON ${captureRelease}: synthetisch befüllte Demo-Daten.`,
      marker: "Markierung",
      markerInspect: "prüfen",
      annotationsAria: "Screenshot-Anmerkungen",
      inspectImplementation: "Die Dokumentation lesen",
      pause: "Pausieren",
      resume: "Fortsetzen",
      pauseLabel: "Automatischen Ablauf pausieren",
      resumeLabel: "Automatischen Ablauf fortsetzen",
      viewsAria: "Weitere Produktansichten",
      videoFallbackAria: "PAIMOS-AEON-Produktdemo",
    }
  : {
      eyebrow: "Inside the product",
      title: "Three surfaces. One project.",
      lead:
        "These views are captured from a PAIMOS AEON build with synthetic demo data. Select a marker to see where intent, authority and project knowledge live in the product, or open the other views below.",
      figcaption: `Demo workspace, PAIMOS AEON ${captureRelease}: seeded synthetic data.`,
      marker: "Marker",
      markerInspect: "Inspect",
      annotationsAria: "Screenshot annotations",
      inspectImplementation: "Read the documentation",
      pause: "Pause",
      resume: "Resume",
      pauseLabel: "Pause automatic progression",
      resumeLabel: "Resume automatic progression",
      viewsAria: "More product views",
      videoFallbackAria: "PAIMOS AEON product demo",
    };

// More views of the same demo workspace; each opens in a lightbox dialog.
const imageViews = [
  {
    id: "projects",
    image: uiProjects,
    title: copy("Workspace home", "Arbeitsbereich"),
    caption: copy(
      "Every project with its open work, as a list or as cards.",
      "Alle Projekte mit ihrer offenen Arbeit, als Liste oder als Karten.",
    ),
    alt: copy(
      "PAIMOS AEON workspace home listing synthetic demo projects with their open tickets",
      "PAIMOS-AEON-Arbeitsbereich mit synthetischen Demo-Projekten und ihren offenen Tickets",
    ),
  },
  {
    id: "work-tree",
    image: uiWorkTree,
    title: copy("Work tree", "Arbeitsbaum"),
    caption: copy(
      "Epics and their tickets in one outline, with status, priority and progress in view.",
      "Epics und ihre Tickets in einer Gliederung, mit Status, Priorität und Fortschritt im Blick.",
    ),
    alt: copy(
      "PAIMOS AEON project outline with synthetic epics expanded into their tickets",
      "PAIMOS-AEON-Projektgliederung mit synthetischen Epics, aufgeklappt bis zu ihren Tickets",
    ),
  },
  {
    id: "search",
    image: uiSearch,
    title: copy("Search", "Suche"),
    caption: copy(
      "One search across the workspace, from anywhere, by keyboard.",
      "Eine Suche über den ganzen Arbeitsbereich, von überall, per Tastatur.",
    ),
    alt: copy(
      "PAIMOS AEON search dialog showing synthetic results across projects",
      "PAIMOS-AEON-Suchdialog mit synthetischen Treffern aus mehreren Projekten",
    ),
  },
  {
    id: "knowledge-graph",
    image: uiKnowledgeGraph,
    title: copy("Knowledge graph", "Wissensgraph"),
    caption: copy(
      "Switch from the entry list to the graph to see how project knowledge connects.",
      "Wechseln Sie von der Eintragsliste zum Graphen und sehen Sie, wie Projektwissen zusammenhängt.",
    ),
    alt: copy(
      "PAIMOS AEON knowledge graph connecting synthetic runbooks, guidelines and memory entries",
      "PAIMOS-AEON-Wissensgraph, der synthetische Runbooks, Richtlinien und Memory-Einträge verbindet",
    ),
  },
  {
    id: "releases",
    image: uiReleases,
    title: copy("Releases", "Releases"),
    caption: copy(
      "The release history of the running instance, inside the product.",
      "Die Release-Historie der laufenden Instanz, direkt im Produkt.",
    ),
    alt: copy(
      "PAIMOS AEON releases page listing calendar-versioned releases with their notes",
      "PAIMOS-AEON-Release-Seite mit kalenderversionierten Releases und ihren Notizen",
    ),
  },
];

// Full-size renditions for the PhotoSwipe lightbox (width/height feed its
// layout engine; the anchor href is the progressive-enhancement fallback).
const LIGHTBOX_WIDTH = 1600;
const fullViews = await Promise.all(
  imageViews.map(async (view) => {
    const full = await getImage({
      src: view.image,
      width: LIGHTBOX_WIDTH,
      format: "webp",
      quality: 86,
    });
    return {
      ...view,
      kind: "image" as const,
      fullSrc: full.src,
      fullWidth: LIGHTBOX_WIDTH,
      fullHeight: Math.round((view.image.height / view.image.width) * LIGHTBOX_WIDTH),
    };
  }),
);

const videoViews = await Promise.all(
  [
    {
      id: "ticket-agents-flow",
      video: loopTicketAgents,
      image: surfaceTicket,
      title: copy("Ticket to agents", "Vom Ticket zu den Agenten"),
      caption: copy(
        "Open a ticket beside the work list, then follow the agents working on the project.",
        "Öffnen Sie ein Ticket neben der Arbeitsliste und verfolgen Sie dann die Agenten, die am Projekt arbeiten.",
      ),
      alt: copy(
        "Play a short seeded PAIMOS AEON flow from a docked ticket to the Agents workspace",
        "Kurzen synthetischen PAIMOS-AEON-Ablauf vom angedockten Ticket zum Agenten-Arbeitsbereich abspielen",
      ),
    },
    {
      id: "search-navigate-flow",
      video: loopSearchNavigate,
      image: uiSearch,
      title: copy("Search to context", "Von der Suche zum Kontext"),
      caption: copy(
        "Search the workspace, choose the result, and land on the work itself.",
        "Durchsuchen Sie den Arbeitsbereich, wählen Sie das Ergebnis und landen Sie direkt bei der Arbeit.",
      ),
      alt: copy(
        "Play a short seeded PAIMOS AEON flow that searches the workspace and opens the selected ticket",
        "Kurzen synthetischen PAIMOS-AEON-Ablauf abspielen, der den Arbeitsbereich durchsucht und das gewählte Ticket öffnet",
      ),
    },
  ].map(async (view) => {
    const poster = await getImage({
      src: view.image,
      width: 1280,
      format: "webp",
      quality: 86,
    });
    return {
      ...view,
      kind: "video" as const,
      fullSrc: view.video,
      fullWidth: 1280,
      fullHeight: 800,
      posterSrc: poster.src,
    };
  }),
);

const galleryViews = [...videoViews, ...fullViews];

// One screen per marker: the active tab shows its own capture, and the
// capture gate proves that hotspot N lands on landmark N of screen N.
const details = [
  {
    label: copy("Ticket context", "Ticketkontext"),
    image: surfaceTicket,
    alt: copy(
      "PAIMOS AEON project work list with a synthetic ticket open in the docked side pane",
      "PAIMOS-AEON-Arbeitsliste eines Projekts mit einem synthetischen Ticket im angedockten Seitenbereich",
    ),
    title: copy(
      "The ticket stays the unit of intent.",
      "Das Ticket bleibt die Einheit der Absicht.",
    ),
    body: copy(
      "A ticket opens beside the work list instead of replacing it. Its status, relations and history stay in view while you keep your place in the project.",
      "Ein Ticket öffnet sich neben der Arbeitsliste, statt sie zu ersetzen. Status, Beziehungen und Verlauf bleiben sichtbar, während Sie Ihren Platz im Projekt behalten.",
    ),
    icon: "folder-kanban",
    href: docsUrl("PLANNING_HIERARCHY.md"),
  },
  {
    label: copy("Agent authority", "Agentenbefugnis"),
    image: surfaceAgents,
    alt: copy(
      "PAIMOS AEON Agents workspace with synthetic agent sessions, runs and a pending approval",
      "PAIMOS-AEON-Agenten-Arbeitsbereich mit synthetischen Agentensitzungen, Läufen und einer offenen Freigabe",
    ),
    title: copy(
      "Agents ask. People decide.",
      "Agenten fragen. Menschen entscheiden.",
    ),
    body: copy(
      "Codex, Claude, Pi, Cursor and Grok sessions report what they are working on and how they pace. When an agent needs a grant for a gated step, the request waits under Needs you until a person answers.",
      "Sitzungen von Codex, Claude, Pi, Cursor und Grok zeigen, woran sie arbeiten und in welchem Tempo. Braucht ein Agent eine Freigabe für einen geschützten Schritt, wartet die Anfrage unter Needs you, bis ein Mensch antwortet.",
    ),
    icon: "shield-check",
    href: docsUrl("AGENT_INTEGRATION.md"),
  },
  {
    label: copy("Project knowledge", "Projektwissen"),
    image: surfaceKnowledge,
    alt: copy(
      "PAIMOS AEON Knowledge view with synthetic runbooks, guidelines and memory, one entry open in the docked pane",
      "PAIMOS-AEON-Wissensansicht mit synthetischen Runbooks, Richtlinien und Memory-Einträgen, ein Eintrag im angedockten Bereich geöffnet",
    ),
    title: copy(
      "Agents read the project before they work.",
      "Agenten lesen das Projekt, bevor sie arbeiten.",
    ),
    body: copy(
      "Runbooks, guidelines, memory, external systems and related projects belong to the project. Agents read them by slug, and the graph shows how the entries connect.",
      "Runbooks, Richtlinien, Memory, externe Systeme und verwandte Projekte gehören zum Projekt. Agenten lesen sie per Slug, und der Graph zeigt, wie die Einträge zusammenhängen.",
    ),
    icon: "book-open-check",
    href: docsUrl("AGENT_INTEGRATION.md"),
  },
];

const hotspotLabel = (index: number, label: string) =>
  locale === "de"
    ? `${labels.marker} ${index + 1}: ${label} ${labels.markerInspect}`
    : `${labels.marker} ${index + 1}: ${labels.markerInspect} ${label}`;
---

<section
  class="product-surface section page-shell"
  aria-labelledby="surface-title"
  data-product-surface
  data-pause-label={labels.pause}
  data-resume-label={labels.resume}
  data-pause-accessible-label={labels.pauseLabel}
  data-resume-accessible-label={labels.resumeLabel}
  data-section-pattern="annotated-product-surface"
>
  <header class="section-intro section-intro--wide">
    <p class="eyebrow">{labels.eyebrow}</p>
    <h2 id="surface-title">{labels.title}</h2>
    <p class="section-lead">{labels.lead}</p>
  </header>

  <div class="product-surface__grid">
    <figure class="product-surface__frame">
      {details.map((detail, index) => (
        <div class="product-surface__screen" data-surface-frame={index} hidden={index !== 0}>
          <Image
            src={detail.image}
            alt={detail.alt}
            widths={[720, 1080, 1440]}
            sizes="(min-width: 64rem) 68vw, 100vw"
            quality={86}
            loading="lazy"
          />
          <button
            type="button"
            class:list={["product-surface__hotspot", `product-surface__hotspot--${index + 1}`]}
            aria-label={hotspotLabel(index, detail.label)}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-controls={`surface-panel-${index}`}
            data-surface-trigger={index}
          >
            <span>{index + 1}</span>
          </button>
        </div>
      ))}
      <figcaption>{labels.figcaption}</figcaption>
    </figure>

    <div class="product-surface__details">
      <div class="product-surface__nav" role="tablist" aria-label={labels.annotationsAria}>
        {details.map((detail, index) => (
          <button
            type="button"
            role="tab"
            id={`surface-tab-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`surface-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-surface-trigger={index}
          >
            <ContextIcon name={detail.icon} size={19} strokeWidth={2.1} />
            <span>{detail.label}</span>
          </button>
        ))}
      </div>

      <div class="product-surface__timeline">
        <span class="product-surface__progress" aria-hidden="true">
          <i data-surface-progress></i>
        </span>
        <button
          class="product-surface__toggle"
          type="button"
          aria-label={labels.pauseLabel}
          aria-pressed="false"
          title={labels.pauseLabel}
          data-surface-toggle
        >
          <span aria-hidden="true"><i></i><i></i></span>
          <b data-surface-toggle-label>{labels.pause}</b>
        </button>
      </div>

      <div class="product-surface__panels">
        {details.map((detail, index) => (
          <div
            id={`surface-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`surface-tab-${index}`}
            hidden={index !== 0}
            data-surface-panel={index}
          >
            <p class="card-meta">{labels.marker} {String(index + 1).padStart(2, "0")}</p>
            <h3>{detail.title}</h3>
            <p>{detail.body}</p>
            <a href={detail.href} target="_blank" rel="noopener noreferrer">
              {labels.inspectImplementation} <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="product-surface__views" role="group" aria-label={labels.viewsAria}>
    {galleryViews.map((view) => (
      <a
        class:list={[
          "product-surface__view-open",
          { "product-surface__view-open--video": view.kind === "video" },
        ]}
        href={view.fullSrc}
        target="_blank"
        rel="noopener"
        data-pswp-width={view.fullWidth}
        data-pswp-height={view.fullHeight}
        data-pswp-type={view.kind === "video" ? "video" : undefined}
        data-video-src={view.kind === "video" ? view.fullSrc : undefined}
        data-video-poster={view.kind === "video" ? view.posterSrc : undefined}
        data-video-label={view.kind === "video" ? view.alt : undefined}
        data-caption={`${view.title}${captionSeparator}${view.caption} ${provenanceCaption}`}
      >
        <span class="product-surface__view-thumb">
          <Image
            src={view.image}
            alt={view.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 30vw, 100vw"
            quality={82}
            loading="lazy"
          />
          {view.kind === "video" && (
            <span class="product-surface__view-play" aria-hidden="true">
              <span>▶</span>
            </span>
          )}
        </span>
        <span class="product-surface__view-meta">
          <strong>{view.title}</strong>
          <span>{view.caption}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<script>
  // PhotoSwipe: the standard, polished image lightbox — zoom-from-thumbnail,
  // swipe/pinch, arrows, counter, keyboard, pull-down close. Bundled by
  // Astro into a hashed module, so script-src 'self' covers it.
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: ".product-surface__views",
    children: "a.product-surface__view-open",
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.86,
    padding: { top: 34, bottom: 64, left: 40, right: 40 },
  });

  // PhotoSwipe custom content for video. The gallery contains only a lazy
  // poster and data attributes; the MP4 source is assigned when its slide is
  // actually active, so browsing the page never downloads the video payload.
  lightbox.addFilter("domItemData", (itemData, element) => {
    const anchor = element.matches("a") ? element : element.querySelector("a");
    if (!(anchor instanceof HTMLAnchorElement) || anchor.dataset.pswpType !== "video") {
      return itemData;
    }
    itemData.type = "video";
    itemData.videoSrc = anchor.dataset.videoSrc;
    itemData.videoPoster = anchor.dataset.videoPoster;
    itemData.videoLabel = anchor.dataset.videoLabel;
    return itemData;
  });

  lightbox.on("contentLoad", (event) => {
    const { content } = event;
    if (content.data.type !== "video") return;
    event.preventDefault();
    const shell = document.createElement("div");
    shell.className = "pswp__content pswp__video-shell";
    const video = document.createElement("video");
    video.className = "pswp__video";
    video.controls = true;
    video.loop = true;
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.preload = "none";
    video.poster = content.data.videoPoster ?? "";
    video.setAttribute("aria-label", content.data.videoLabel ?? "PAIMOS AEON product demo");
    shell.append(video);
    content.element = shell;
  });

  lightbox.on("contentActivate", ({ content }) => {
    if (content.data.type !== "video") return;
    const video = content.element?.querySelector("video");
    if (!(video instanceof HTMLVideoElement)) return;
    if (!video.getAttribute("src")) {
      video.src = content.data.videoSrc ?? "";
      video.load();
    }
    void video.play().catch(() => undefined);
  });

  lightbox.on("contentDeactivate", ({ content }) => {
    if (content.data.type !== "video") return;
    const video = content.element?.querySelector("video");
    if (video instanceof HTMLVideoElement) video.pause();
  });

  lightbox.on("contentDestroy", ({ content }) => {
    if (content.data.type !== "video") return;
    const video = content.element?.querySelector("video");
    if (!(video instanceof HTMLVideoElement)) return;
    video.pause();
    video.removeAttribute("src");
    video.load();
  });

  // Caption element (official ui-register pattern) fed from data-caption.
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "custom-caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      onInit: (el, pswp) => {
        pswp.on("change", () => {
          const anchor = pswp.currSlide?.data?.element;
          el.textContent = anchor?.getAttribute("data-caption") ?? "";
        });
      },
    });
  });

  // Blur the page behind the lightbox (PhotoSwipe root is a body child).
  lightbox.on("beforeOpen", () => document.body.classList.add("lightbox-open"));
  lightbox.on("destroy", () => document.body.classList.remove("lightbox-open"));

  lightbox.init();
</script>

<script>
  const SURFACE_STAGE_DURATION = 5000;

  const initProductSurfaces = () => {
    document.querySelectorAll<HTMLElement>("[data-product-surface]").forEach((root) => {
      if (root.dataset.surfaceReady === "true") return;
      root.dataset.surfaceReady = "true";
      const controller = new AbortController();
      const triggers = [...root.querySelectorAll<HTMLButtonElement>("[data-surface-trigger]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-surface-panel]")];
      const frames = [...root.querySelectorAll<HTMLElement>("[data-surface-frame]")];
      const progress = root.querySelector<HTMLElement>("[data-surface-progress]");
      const toggle = root.querySelector<HTMLButtonElement>("[data-surface-toggle]");
      const toggleLabel = root.querySelector<HTMLElement>("[data-surface-toggle-label]");
      const interactionArea = root.querySelector<HTMLElement>(".product-surface__grid") ?? root;
      const observedDetails = root.querySelector<HTMLElement>(".product-surface__details") ?? root;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const hoverCapable = window.matchMedia("(hover: hover)");
      let activeIndex = 0;
      let inView = false;
      let userPaused = false;
      let hoverHeld = false;
      let focusHeld = false;
      let destroyed = false;
      let progressAnimation: Animation | undefined;

      const stopCycle = () => {
        const animation = progressAnimation;
        progressAnimation = undefined;
        animation?.cancel();
        root.dataset.surfaceCycle = "idle";
      };

      const interactionHeld = () => hoverHeld || focusHeld;

      const recomputeInteractionState = () => {
        hoverHeld = hoverCapable.matches && interactionArea.matches(":hover");
        focusHeld = interactionArea.querySelector(":focus-visible") !== null;
      };

      const updateToggle = () => {
        if (!toggle) return;
        const action = userPaused
          ? root.dataset.resumeLabel ?? "Resume"
          : root.dataset.pauseLabel ?? "Pause";
        const accessibleLabel = userPaused
          ? root.dataset.resumeAccessibleLabel ?? "Resume automatic progression"
          : root.dataset.pauseAccessibleLabel ?? "Pause automatic progression";
        toggle.disabled = reducedMotion.matches;
        toggle.setAttribute("aria-pressed", String(userPaused));
        toggle.setAttribute("aria-label", accessibleLabel);
        toggle.title = accessibleLabel;
        if (toggleLabel) toggleLabel.textContent = action;
      };

      const runCycle = () => {
        stopCycle();
        if (destroyed || !progress || !inView || reducedMotion.matches || panels.length < 2) return;
        const animation = progress.animate(
          [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
          { duration: SURFACE_STAGE_DURATION, easing: "linear", fill: "both" },
        );
        progressAnimation = animation;
        if (userPaused || interactionHeld()) {
          animation.pause();
          root.dataset.surfaceCycle = "paused";
        } else {
          root.dataset.surfaceCycle = "running";
        }
        animation.finished
          .then(() => {
            if (progressAnimation !== animation) return;
            progressAnimation = undefined;
            animation.cancel();
            if (!inView || userPaused || interactionHeld() || reducedMotion.matches) return;
            activate(activeIndex + 1);
          })
          .catch(() => undefined);
      };

      const syncCycle = () => {
        if (destroyed) return;
        if (!inView || reducedMotion.matches || panels.length < 2) {
          stopCycle();
          return;
        }
        if (!progressAnimation) {
          runCycle();
          return;
        }
        if (userPaused || interactionHeld()) {
          progressAnimation.pause();
          root.dataset.surfaceCycle = "paused";
        } else {
          progressAnimation.play();
          root.dataset.surfaceCycle = "running";
        }
      };

      const activate = (index: number, moveFocus = false) => {
        const nextIndex = (index + panels.length) % panels.length;
        const changed = nextIndex !== activeIndex;
        activeIndex = nextIndex;
        root.dataset.activeMarker = String(activeIndex);
        let activeTab: HTMLButtonElement | undefined;

        triggers.forEach((trigger) => {
          const active = Number(trigger.dataset.surfaceTrigger) === activeIndex;
          if (trigger.getAttribute("role") === "tab") {
            trigger.setAttribute("aria-selected", String(active));
            trigger.tabIndex = active ? 0 : -1;
            if (active) activeTab = trigger;
          } else {
            trigger.setAttribute("aria-pressed", String(active));
          }
        });
        panels.forEach((panel) => {
          panel.hidden = Number(panel.dataset.surfacePanel) !== activeIndex;
        });
        frames.forEach((frame) => {
          frame.hidden = Number(frame.dataset.surfaceFrame) !== activeIndex;
        });

        if (moveFocus && activeTab && document.activeElement !== activeTab) {
          activeTab.focus();
        }

        if (changed) runCycle();
        else syncCycle();
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener(
          "click",
          () => activate(Number(trigger.dataset.surfaceTrigger)),
          { signal: controller.signal },
        );
        trigger.addEventListener(
          "pointerenter",
          (event) => {
            if (event.pointerType === "touch") return;
            activate(Number(trigger.dataset.surfaceTrigger));
          },
          { signal: controller.signal },
        );
        trigger.addEventListener(
          "focus",
          () => activate(Number(trigger.dataset.surfaceTrigger)),
          { signal: controller.signal },
        );
        if (trigger.getAttribute("role") === "tab") {
          trigger.addEventListener(
            "keydown",
            (event) => {
              const tabs = triggers.filter((item) => item.getAttribute("role") === "tab");
              const current = tabs.indexOf(trigger);
              const keys = ["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp", "Home", "End"];
              if (!keys.includes(event.key)) return;
              event.preventDefault();
              const next = event.key === "Home"
                ? tabs[0]
                : event.key === "End"
                  ? tabs.at(-1)
                  : tabs[
                      (current + (event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1) + tabs.length) % tabs.length
                    ];
              if (next) activate(Number(next.dataset.surfaceTrigger), true);
            },
            { signal: controller.signal },
          );
        }
      });

      interactionArea.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType === "touch") return;
          hoverHeld = true;
          syncCycle();
        },
        { signal: controller.signal },
      );
      interactionArea.addEventListener(
        "pointerleave",
        (event) => {
          if (event.pointerType === "touch") return;
          hoverHeld = false;
          syncCycle();
        },
        { signal: controller.signal },
      );
      const syncFocusHold = () => {
        queueMicrotask(() => {
          if (destroyed) return;
          focusHeld = interactionArea.querySelector(":focus-visible") !== null;
          syncCycle();
        });
      };
      interactionArea.addEventListener("focusin", syncFocusHold, {
        signal: controller.signal,
      });
      interactionArea.addEventListener("focusout", syncFocusHold, {
        signal: controller.signal,
      });

      toggle?.addEventListener(
        "click",
        () => {
          userPaused = !userPaused;
          updateToggle();
          syncCycle();
        },
        { signal: controller.signal },
      );

      const observer = new IntersectionObserver(
        ([entry]) => {
          const nextInView = entry?.isIntersecting === true && entry.intersectionRatio >= 0.18;
          const visibilityChanged = nextInView !== inView;
          inView = nextInView;
          recomputeInteractionState();

          if (!inView) {
            userPaused = false;
            updateToggle();
            stopCycle();
            return;
          }

          if (visibilityChanged) runCycle();
          else syncCycle();
        },
        { threshold: [0, 0.18, 0.55] },
      );
      observer.observe(observedDetails);

      const handleReducedMotionChange = () => {
        updateToggle();
        if (reducedMotion.matches) stopCycle();
        else runCycle();
      };
      reducedMotion.addEventListener("change", handleReducedMotionChange);

      const cleanup = () => {
        if (destroyed) return;
        destroyed = true;
        controller.abort();
        observer.disconnect();
        reducedMotion.removeEventListener("change", handleReducedMotionChange);
        stopCycle();
        delete root.dataset.surfaceReady;
      };
      document.addEventListener("astro:before-swap", cleanup, {
        once: true,
        signal: controller.signal,
      });

      updateToggle();
      activate(0);
    });
  };

  initProductSurfaces();
  document.addEventListener("astro:page-load", initProductSurfaces);
</script>

