---
import { Image, getImage } from "astro:assets";
import ContextIcon from "./ContextIcon.astro";
import productSurface from "../assets/products/paimos/product-surface.png";
import uiIssues from "../assets/products/paimos/ui-issues.png";
import uiBoard from "../assets/products/paimos/ui-board.png";
import uiDashboard from "../assets/products/paimos/ui-dashboard.png";
import uiSearch from "../assets/products/paimos/ui-search.png";
import uiVoiceIntake from "../assets/products/paimos/ui-voice-intake.png";

// This version describes the captured pixels, not the currently deployed
// application. Keep it unchanged until the images themselves are regenerated.
const captureRelease = "v5.7.1";

// More views of the same demo workspace; each opens in a lightbox dialog.
// Ordered deliberately: the AI-era surfaces lead, the classic ceremony
// closes the row for the teams that still want it.
const views = [
  {
    id: "voice-intake",
    image: uiVoiceIntake,
    title: "Voice intake",
    caption:
      "Talk through an idea; the spec, the impact on existing work, and the ticket assemble as you speak.",
    alt: "Paimos voice intake workbench: a live specification beside impact analysis, an understanding check and a ticket preview",
  },
  {
    id: "search",
    image: uiSearch,
    title: "Search everything",
    caption: "Live results across every project as you type — keyboard-first, jump straight to the work.",
    alt: "Paimos global search overlay showing live cross-project results with keyboard shortcuts",
  },
  {
    id: "dashboard",
    image: uiDashboard,
    title: "Dashboard",
    caption: "Sign in to a working picture: active projects and recent movement at a glance.",
    alt: "Paimos dashboard showing active demo projects and a recent issues feed",
  },
  {
    id: "issues",
    image: uiIssues,
    title: "Issues",
    caption: "The classic backlog — saved views, filters, undo — for teams that live in lists.",
    alt: "Paimos issues list showing the demo backlog with type, status and action columns",
  },
  {
    id: "board",
    image: uiBoard,
    title: "Sprint board",
    caption: "Sprints, fully supported — for the teams that still run them. No judgement.",
    alt: "Paimos sprint board showing a demo sprint with done, in-progress and backlog tickets",
  },
];

// Full-size renditions for the PhotoSwipe lightbox (width/height feed its
// layout engine; the anchor href is the progressive-enhancement fallback).
const LIGHTBOX_WIDTH = 1600;
const fullViews = await Promise.all(
  views.map(async (view) => {
    const full = await getImage({
      src: view.image,
      width: LIGHTBOX_WIDTH,
      format: "webp",
      quality: 86,
    });
    return {
      ...view,
      fullSrc: full.src,
      fullWidth: LIGHTBOX_WIDTH,
      fullHeight: Math.round((view.image.height / view.image.width) * LIGHTBOX_WIDTH),
    };
  }),
);

const details = [
  {
    label: "Issue context",
    title: "The issue stays the unit of intent.",
    body:
      "Type, state, priority and project membership remain visible while agent work is prepared. The run starts from a real work item, not a detached chat.",
    icon: "folder-kanban",
    href: "https://github.com/inspr-at/paimos/blob/main/docs/AI_CONTROL_PLANE_UX.md",
  },
  {
    label: "Execution boundary",
    title: "Authority is chosen before work starts.",
    body:
      "The selected runner and deployment mode define what may happen. Draft providers can prepare work; trusted runners can edit and test; deployment remains separately deliberate.",
    icon: "shield-check",
    href: "https://github.com/inspr-at/paimos/blob/main/docs/IMPLEMENT_THIS_PROVIDERS.md",
  },
  {
    label: "Retrieved knowledge",
    title: "Applicable memory returns with provenance.",
    body:
      "Project knowledge, issue links and file anchors can be attached to the task. Agents receive relevant context without turning every run into a manual prompt-engineering exercise.",
    icon: "book-open-check",
    href: "https://github.com/inspr-at/paimos/blob/main/docs/agent-retrieval.md",
  },
];
---

<section
  class="product-surface section page-shell"
  aria-labelledby="surface-title"
  data-product-surface
  data-section-pattern="annotated-product-surface"
>
  <header class="section-intro section-intro--wide">
    <p class="eyebrow">Inside the product</p>
    <h2 id="surface-title">A real issue. Context attached.</h2>
    <p class="section-lead">
      This Paimos issue workbench is captured from a seeded demo build with
      synthetic data. Select a marker to inspect how intent, authority and
      retrieved knowledge meet in one work surface — or open the other views below.
    </p>
  </header>

  <div class="product-surface__grid">
    <figure class="product-surface__frame">
      <Image
        src={productSurface}
        alt="Paimos issue workbench with synthetic data, execution controls, applicable memory and activity evidence"
        widths={[720, 1080, 1440]}
        sizes="(min-width: 64rem) 68vw, 100vw"
        formats={["avif", "webp", "png"]}
        quality={86}
        loading="lazy"
      />
      {details.map((detail, index) => (
        <button
          type="button"
          class:list={["product-surface__hotspot", `product-surface__hotspot--${index + 1}`]}
          aria-label={`Marker ${index + 1}: Inspect ${detail.label}`}
          aria-pressed={index === 0 ? "true" : "false"}
          aria-controls={`surface-panel-${index}`}
          data-surface-trigger={index}
        >
          <span>{index + 1}</span>
        </button>
      ))}
      <figcaption>Demo workspace, Paimos {captureRelease} — seeded synthetic data.</figcaption>
    </figure>

    <div class="product-surface__details">
      <div class="product-surface__nav" role="tablist" aria-label="Screenshot annotations">
        {details.map((detail, index) => (
          <button
            type="button"
            role="tab"
            id={`surface-tab-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`surface-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-surface-trigger={index}
          >
            <ContextIcon name={detail.icon} size={19} strokeWidth={2.1} />
            <span>{detail.label}</span>
          </button>
        ))}
      </div>

      <div class="product-surface__timeline">
        <span class="product-surface__progress" aria-hidden="true">
          <i data-surface-progress></i>
        </span>
        <button
          class="product-surface__toggle"
          type="button"
          aria-label="Pause automatic progression"
          aria-pressed="false"
          title="Pause automatic progression"
          data-surface-toggle
        >
          <span aria-hidden="true"><i></i><i></i></span>
          <b data-surface-toggle-label>Pause</b>
        </button>
      </div>

      <div class="product-surface__panels">
        {details.map((detail, index) => (
          <div
            id={`surface-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`surface-tab-${index}`}
            hidden={index !== 0}
            data-surface-panel={index}
          >
            <p class="card-meta">Marker {String(index + 1).padStart(2, "0")}</p>
            <h3>{detail.title}</h3>
            <p>{detail.body}</p>
            <a href={detail.href} target="_blank" rel="noopener noreferrer">
              Inspect the implementation <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="product-surface__views" aria-label="More product views">
    {fullViews.map((view) => (
      <a
        class="product-surface__view-open"
        href={view.fullSrc}
        target="_blank"
        rel="noopener"
        data-pswp-width={view.fullWidth}
        data-pswp-height={view.fullHeight}
        data-caption={`${view.title} — ${view.caption} Demo workspace, Paimos ${captureRelease}.`}
      >
        <span class="product-surface__view-thumb">
          <Image
            src={view.image}
            alt={view.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 30vw, 100vw"
            formats={["avif", "webp", "png"]}
            quality={82}
            loading="lazy"
          />
        </span>
        <span class="product-surface__view-meta">
          <strong>{view.title}</strong>
          <span>{view.caption}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<script>
  // PhotoSwipe: the standard, polished image lightbox — zoom-from-thumbnail,
  // swipe/pinch, arrows, counter, keyboard, pull-down close. Bundled by
  // Astro into a hashed module, so script-src 'self' covers it.
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: ".product-surface__views",
    children: "a.product-surface__view-open",
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.86,
    padding: { top: 34, bottom: 64, left: 40, right: 40 },
  });

  // Caption element (official ui-register pattern) fed from data-caption.
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "custom-caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      onInit: (el, pswp) => {
        pswp.on("change", () => {
          const anchor = pswp.currSlide?.data?.element;
          el.textContent = anchor?.getAttribute("data-caption") ?? "";
        });
      },
    });
  });

  // Blur the page behind the lightbox (PhotoSwipe root is a body child).
  lightbox.on("beforeOpen", () => document.body.classList.add("lightbox-open"));
  lightbox.on("destroy", () => document.body.classList.remove("lightbox-open"));

  lightbox.init();
</script>

<script>
  const SURFACE_STAGE_DURATION = 5000;

  const initProductSurfaces = () => {
    document.querySelectorAll<HTMLElement>("[data-product-surface]").forEach((root) => {
      if (root.dataset.surfaceReady === "true") return;
      root.dataset.surfaceReady = "true";
      const controller = new AbortController();
      const triggers = [...root.querySelectorAll<HTMLButtonElement>("[data-surface-trigger]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-surface-panel]")];
      const progress = root.querySelector<HTMLElement>("[data-surface-progress]");
      const toggle = root.querySelector<HTMLButtonElement>("[data-surface-toggle]");
      const toggleLabel = root.querySelector<HTMLElement>("[data-surface-toggle-label]");
      const interactionArea = root.querySelector<HTMLElement>(".product-surface__grid") ?? root;
      const observedDetails = root.querySelector<HTMLElement>(".product-surface__details") ?? root;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const hoverCapable = window.matchMedia("(hover: hover)");
      let activeIndex = 0;
      let inView = false;
      let userPaused = false;
      let hoverHeld = false;
      let focusHeld = false;
      let destroyed = false;
      let progressAnimation: Animation | undefined;

      const stopCycle = () => {
        const animation = progressAnimation;
        progressAnimation = undefined;
        animation?.cancel();
        root.dataset.surfaceCycle = "idle";
      };

      const interactionHeld = () => hoverHeld || focusHeld;

      const recomputeInteractionState = () => {
        hoverHeld = hoverCapable.matches && interactionArea.matches(":hover");
        focusHeld = interactionArea.querySelector(":focus-visible") !== null;
      };

      const updateToggle = () => {
        if (!toggle) return;
        const action = userPaused ? "Resume" : "Pause";
        const accessibleLabel = userPaused
          ? "Resume automatic progression"
          : "Pause automatic progression";
        toggle.disabled = reducedMotion.matches;
        toggle.setAttribute("aria-pressed", String(userPaused));
        toggle.setAttribute("aria-label", accessibleLabel);
        toggle.title = accessibleLabel;
        if (toggleLabel) toggleLabel.textContent = action;
      };

      const runCycle = () => {
        stopCycle();
        if (destroyed || !progress || !inView || reducedMotion.matches || panels.length < 2) return;
        const animation = progress.animate(
          [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
          { duration: SURFACE_STAGE_DURATION, easing: "linear", fill: "both" },
        );
        progressAnimation = animation;
        if (userPaused || interactionHeld()) {
          animation.pause();
          root.dataset.surfaceCycle = "paused";
        } else {
          root.dataset.surfaceCycle = "running";
        }
        animation.finished
          .then(() => {
            if (progressAnimation !== animation) return;
            progressAnimation = undefined;
            animation.cancel();
            if (!inView || userPaused || interactionHeld() || reducedMotion.matches) return;
            activate(activeIndex + 1);
          })
          .catch(() => undefined);
      };

      const syncCycle = () => {
        if (destroyed) return;
        if (!inView || reducedMotion.matches || panels.length < 2) {
          stopCycle();
          return;
        }
        if (!progressAnimation) {
          runCycle();
          return;
        }
        if (userPaused || interactionHeld()) {
          progressAnimation.pause();
          root.dataset.surfaceCycle = "paused";
        } else {
          progressAnimation.play();
          root.dataset.surfaceCycle = "running";
        }
      };

      const activate = (index: number, moveFocus = false) => {
        const nextIndex = (index + panels.length) % panels.length;
        const changed = nextIndex !== activeIndex;
        activeIndex = nextIndex;
        root.dataset.activeMarker = String(activeIndex);
        let activeTab: HTMLButtonElement | undefined;

        triggers.forEach((trigger) => {
          const active = Number(trigger.dataset.surfaceTrigger) === activeIndex;
          if (trigger.getAttribute("role") === "tab") {
            trigger.setAttribute("aria-selected", String(active));
            trigger.tabIndex = active ? 0 : -1;
            if (active) activeTab = trigger;
          } else {
            trigger.setAttribute("aria-pressed", String(active));
          }
        });
        panels.forEach((panel) => {
          panel.hidden = Number(panel.dataset.surfacePanel) !== activeIndex;
        });

        if (moveFocus && activeTab && document.activeElement !== activeTab) {
          activeTab.focus();
        }

        if (changed) runCycle();
        else syncCycle();
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener(
          "click",
          () => activate(Number(trigger.dataset.surfaceTrigger)),
          { signal: controller.signal },
        );
        trigger.addEventListener(
          "pointerenter",
          (event) => {
            if (event.pointerType === "touch") return;
            activate(Number(trigger.dataset.surfaceTrigger));
          },
          { signal: controller.signal },
        );
        trigger.addEventListener(
          "focus",
          () => activate(Number(trigger.dataset.surfaceTrigger)),
          { signal: controller.signal },
        );
        if (trigger.getAttribute("role") === "tab") {
          trigger.addEventListener(
            "keydown",
            (event) => {
              const tabs = triggers.filter((item) => item.getAttribute("role") === "tab");
              const current = tabs.indexOf(trigger);
              const keys = ["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp", "Home", "End"];
              if (!keys.includes(event.key)) return;
              event.preventDefault();
              const next = event.key === "Home"
                ? tabs[0]
                : event.key === "End"
                  ? tabs.at(-1)
                  : tabs[
                      (current + (event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1) + tabs.length) % tabs.length
                    ];
              if (next) activate(Number(next.dataset.surfaceTrigger), true);
            },
            { signal: controller.signal },
          );
        }
      });

      interactionArea.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType === "touch") return;
          hoverHeld = true;
          syncCycle();
        },
        { signal: controller.signal },
      );
      interactionArea.addEventListener(
        "pointerleave",
        (event) => {
          if (event.pointerType === "touch") return;
          hoverHeld = false;
          syncCycle();
        },
        { signal: controller.signal },
      );
      const syncFocusHold = () => {
        queueMicrotask(() => {
          if (destroyed) return;
          focusHeld = interactionArea.querySelector(":focus-visible") !== null;
          syncCycle();
        });
      };
      interactionArea.addEventListener("focusin", syncFocusHold, {
        signal: controller.signal,
      });
      interactionArea.addEventListener("focusout", syncFocusHold, {
        signal: controller.signal,
      });

      toggle?.addEventListener(
        "click",
        () => {
          userPaused = !userPaused;
          updateToggle();
          syncCycle();
        },
        { signal: controller.signal },
      );

      const observer = new IntersectionObserver(
        ([entry]) => {
          const nextInView = entry?.isIntersecting === true && entry.intersectionRatio >= 0.18;
          const visibilityChanged = nextInView !== inView;
          inView = nextInView;
          recomputeInteractionState();

          if (!inView) {
            userPaused = false;
            updateToggle();
            stopCycle();
            return;
          }

          if (visibilityChanged) runCycle();
          else syncCycle();
        },
        { threshold: [0, 0.18, 0.55] },
      );
      observer.observe(observedDetails);

      const handleReducedMotionChange = () => {
        updateToggle();
        if (reducedMotion.matches) stopCycle();
        else runCycle();
      };
      reducedMotion.addEventListener("change", handleReducedMotionChange);

      const cleanup = () => {
        if (destroyed) return;
        destroyed = true;
        controller.abort();
        observer.disconnect();
        reducedMotion.removeEventListener("change", handleReducedMotionChange);
        stopCycle();
        delete root.dataset.surfaceReady;
      };
      document.addEventListener("astro:before-swap", cleanup, {
        once: true,
        signal: controller.signal,
      });

      updateToggle();
      activate(0);
    });
  };

  initProductSurfaces();
  document.addEventListener("astro:page-load", initProductSurfaces);
</script>

<style>
  .product-surface {
    padding-block: var(--section-space);
  }

  .product-surface__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(22rem, 0.86fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .product-surface__frame {
    position: relative;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.84);
    border-radius: var(--radius-lg);
    background: #e9eff4;
    box-shadow: var(--shadow-md);
  }

  .product-surface__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .product-surface__frame::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(11 43 65 / 0.09);
  }

  .product-surface__hotspot {
    position: absolute;
    z-index: 3;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: white;
    border: 2px solid white;
    border-radius: 50%;
    background: var(--accent-strong);
    box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--accent) 20%, transparent), var(--shadow-sm);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: transform 220ms var(--ease), background 180ms ease;
  }

  .product-surface__hotspot:hover,
  .product-surface__hotspot[aria-pressed="true"] {
    background: var(--night-deep);
    box-shadow:
      0 0 0 0.5rem color-mix(in srgb, var(--secondary) 44%, transparent),
      var(--shadow-sm);
    transform: translate(-50%, -50%) scale(1.12);
  }

  .product-surface__hotspot:focus-visible {
    outline-color: white;
  }

  .product-surface__hotspot span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  /* Positions are tuned to the v5.0.0 capture: 1 = issue chips beside the
     AI Workbench header, 2 = deploy mode + Implement controls, 3 = the
     applicable-memories return. Re-measure when the screenshot changes. */
  .product-surface__hotspot--1 {
    top: 28%;
    left: 85%;
  }

  .product-surface__hotspot--2 {
    top: 36%;
    left: 90%;
  }

  .product-surface__hotspot--3 {
    top: 84%;
    left: 73%;
  }

  .product-surface__frame figcaption {
    position: absolute;
    z-index: 2;
    right: 0.8rem;
    bottom: 0.8rem;
    left: 0.8rem;
    padding: 0.5rem 0.7rem;
    color: rgb(255 255 255 / 0.88);
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.65rem;
    background: rgb(5 31 47 / 0.62);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.4;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .product-surface__details {
    display: grid;
    grid-template-rows: auto auto minmax(15rem, 1fr);
    min-height: 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.62);
    box-shadow: var(--shadow-sm);
  }

  .product-surface__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .product-surface__nav button {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 0.45rem;
    align-items: center;
    min-height: 5rem;
    padding: 0.55rem 0.7rem;
    color: var(--ink-soft);
    border: 1px solid transparent;
    border-radius: 0.75rem;
    background: transparent;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .product-surface__nav button[aria-selected="true"] {
    color: var(--accent-strong);
    border-color: color-mix(in srgb, var(--accent) 22%, transparent);
    background: var(--accent-soft);
  }

  .product-surface__timeline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    margin-top: 1rem;
  }

  .product-surface__progress {
    position: relative;
    height: 1.2rem;
  }

  .product-surface__progress::before,
  .product-surface__progress > i {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 2px;
    content: "";
    background: var(--line);
  }

  .product-surface__progress > i {
    background: linear-gradient(90deg, var(--accent), var(--secondary));
    box-shadow: 0 0 0.8rem color-mix(in srgb, var(--secondary) 22%, transparent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .product-surface__toggle {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.4rem 0.68rem;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.8;
    transition: opacity 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .product-surface:hover .product-surface__toggle,
  .product-surface:focus-within .product-surface__toggle,
  .product-surface__toggle[aria-pressed="true"] {
    opacity: 1;
  }

  .product-surface__toggle > span {
    display: inline-flex;
    gap: 0.18rem;
    align-items: center;
    width: 0.7rem;
    height: 0.75rem;
  }

  .product-surface__toggle i {
    display: block;
    width: 0.16rem;
    height: 0.66rem;
    border-radius: 999px;
    background: var(--secondary);
  }

  .product-surface__toggle b {
    font-weight: 700;
  }

  .product-surface__toggle[aria-pressed="true"] {
    border-color: color-mix(in srgb, var(--secondary) 62%, transparent);
    background: color-mix(in srgb, var(--secondary) 10%, transparent);
  }

  .product-surface__toggle[aria-pressed="true"] i:first-child {
    width: 0;
    height: 0;
    border-block: 0.34rem solid transparent;
    border-left: 0.56rem solid var(--secondary);
    border-radius: 0;
    background: transparent;
  }

  .product-surface__toggle[aria-pressed="true"] i:last-child {
    display: none;
  }

  .product-surface__panels {
    display: grid;
    min-height: clamp(15rem, 20vw, 18rem);
  }

  .product-surface__details [data-surface-panel] {
    align-self: start;
