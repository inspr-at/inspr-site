---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Product = {
  name: string;
  label: string;
  href: string;
  logo: ImageMetadata;
  hero: ImageMetadata;
  alt: string;
  title: string;
  body: string;
  detail: string;
};

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="product-constellation">
  <div class="product-constellation__origin">
    <span class="product-constellation__beam" aria-hidden="true"></span>
    <div class="product-constellation__origin-copy">
      <p>Operating origin</p>
      <strong>INSPR</strong>
      <span>shared context · visible boundaries · recoverable evidence</span>
    </div>
  </div>

  <svg
    class="product-constellation__paths"
    viewBox="0 0 520 900"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d="M 52 450 C 174 450, 260 150, 520 150" pathLength="1" />
    <path d="M 52 450 C 188 450, 280 450, 520 450" pathLength="1" />
    <path d="M 52 450 C 174 450, 260 750, 520 750" pathLength="1" />
  </svg>

  <ol>
    {products.map((product, index) => (
      <li style={`--product-index:${index}`}>
        <article>
          <a class="product-constellation__visual" href={product.href} target="_blank" rel="noopener noreferrer" aria-label={`Explore ${product.name}, opens in a new tab`}>
            <Image
              src={product.hero}
              alt={product.alt}
              widths={[480, 720]}
              sizes="(min-width: 60rem) 29vw, 100vw"
              formats={["avif", "webp", "png"]}
              quality={80}
              loading="lazy"
            />
          </a>
          <div class="product-constellation__copy">
            <img src={product.logo.src} alt="" width="52" height="52" loading="lazy" />
            <div>
              <p>{product.label}</p>
              <h3>{product.name}</h3>
            </div>
            <h4>{product.title}</h4>
            <span>{product.body}</span>
            <small>{product.detail}</small>
            <a href={product.href} target="_blank" rel="noopener noreferrer">Explore {product.name} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </li>
    ))}
  </ol>
</div>

<style>
  .product-constellation {
    position: relative;
    display: grid;
    grid-template-columns: minmax(11rem, 0.36fr) minmax(0, 1.64fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: stretch;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding: clamp(1rem, 3vw, 2.5rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2.4rem;
    background:
      radial-gradient(ellipse at 11% 50%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 30%),
      linear-gradient(135deg, color-mix(in srgb, var(--paper) 97%, white), color-mix(in srgb, var(--paper) 91%, var(--accent)));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.78);
  }

  .product-constellation::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, transparent 0 15%, rgb(255 255 255 / 0.55) 22%, transparent 31%) no-repeat;
    background-size: 55% 100%;
    opacity: 0.58;
    pointer-events: none;
  }

  .product-constellation__origin {
    position: relative;
    z-index: 3;
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: clamp(1rem, 3vw, 2rem) 0;
  }

  .product-constellation__beam {
    position: absolute;
    inset-block: 4%;
    left: 50%;
    width: clamp(2.5rem, 4vw, 3.5rem);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, white);
    border-radius: 999px;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.18), rgb(255 255 255 / 0.82) 46%, rgb(255 255 255 / 0.12)),
      color-mix(in srgb, var(--accent) 17%, transparent);
    box-shadow:
      0 0 0 0.55rem color-mix(in srgb, var(--accent) 5%, transparent),
      0 0 2.8rem color-mix(in srgb, var(--accent) 28%, transparent),
      inset 0 0 1.2rem rgb(255 255 255 / 0.8);
    transform: translateX(-50%);
  }

  .product-constellation__origin-copy {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(100%, 15rem);
    padding: 1.25rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 1.25rem;
    text-align: center;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    box-shadow:
      0 1rem 2.5rem rgb(15 42 59 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    backdrop-filter: blur(18px);
  }

  .product-constellation__origin-copy p {
    margin: 0 0 0.5rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .product-constellation__origin-copy strong {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    letter-spacing: 0.08em;
  }

  .product-constellation__origin-copy span {
    max-width: 13rem;
    margin-top: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .product-constellation__paths {
    position: absolute;
    z-index: 1;
    top: 2.5rem;
    bottom: 2.5rem;
    left: clamp(5rem, 12vw, 12rem);
    width: clamp(15rem, 34vw, 34rem);
    height: calc(100% - 5rem);
    overflow: visible;
    pointer-events: none;
  }

  .product-constellation__paths path {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 44%, white);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 0.65rem color-mix(in srgb, var(--accent) 24%, transparent));
  }

  .product-constellation__paths path:nth-child(2) {
    stroke: color-mix(in srgb, var(--accent) 62%, white);
  }

  .product-constellation ol {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-constellation li {
    position: relative;
    min-width: 0;
  }

  .product-constellation li::before {
    content: "";
    position: absolute;
    left: -0.58rem;
    width: 0.72rem;
    aspect-ratio: 1;
    margin-top: 6.15rem;
    border: 2px solid white;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .product-constellation article {
    display: grid;
    grid-template-columns: minmax(10rem, 0.72fr) minmax(0, 1.28fr);
    min-height: 13rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.4rem;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8);
    backdrop-filter: blur(14px);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .product-constellation article:has(a:hover),
  .product-constellation article:has(a:focus-visible) {
    transform: translateX(0.35rem);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow: 0 1rem 2rem rgb(15 42 59 / 0.08);
  }

  .product-constellation__visual { display: block; min-height: 100%; overflow: hidden; }
  .product-constellation__visual :global(picture),
  .product-constellation__visual :global(img) { width: 100%; height: 100%; }
  .product-constellation__visual :global(img) { object-fit: cover; transition: transform 500ms ease; }
  .product-constellation__visual:hover :global(img),
  .product-constellation__visual:focus-visible :global(img) { transform: scale(1.035); }

  .product-constellation__copy {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.8rem;
    align-content: center;
    padding: 1rem 1.2rem;
  }

  .product-constellation__copy > img {
    grid-row: span 2;
    align-self: center;
  }

  .product-constellation__copy p {
    margin: 0;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .product-constellation h3 { margin: 0; font-size: 1.35rem; }
  .product-constellation h4,
  .product-constellation__copy > span,
  .product-constellation__copy > small,
  .product-constellation__copy > a { grid-column: 1 / -1; }
  .product-constellation h4 { margin: 0.7rem 0 0.25rem; font-size: 1.15rem; }
  .product-constellation__copy > span { color: var(--ink-soft); }
  .product-constellation__copy > small { margin-top: 0.65rem; color: var(--ink-soft); }
  .product-constellation__copy > a {
    margin-top: 0.75rem;
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 64rem) {
    .product-constellation { grid-template-columns: 1fr; }
    .product-constellation__origin {
      min-height: auto;
      padding: 0;
    }
    .product-constellation__beam,
    .product-constellation__paths { display: none; }
    .product-constellation__origin-copy { width: min(100%, 30rem); }
    .product-constellation li::before { display: none; }
  }

  @media (max-width: 42rem) {
    .product-constellation article { grid-template-columns: 1fr; }
    .product-constellation__visual { min-height: 12rem; max-height: 15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-constellation article,
    .product-constellation__visual :global(img) { transition: none; }
  }
</style>
