---
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import DetailLevels from "./DetailLevels.astro";
import MicrositeHeader from "./MicrositeHeader.astro";
import MicrositeFooter from "./MicrositeFooter.astro";
import ServiceRibbon from "./ServiceRibbon.astro";
import ContextIcon from "./ContextIcon.astro";
import PaimosProductSurface from "./PaimosProductSurface.astro";
import WorkflowExplorer from "./WorkflowExplorer.astro";
import InspectableRail from "./InspectableRail.astro";
import FractureAtlas from "./FractureAtlas.astro";
import FeatureExperience from "./FeatureExperience.astro";
import AudiencePaths from "./AudiencePaths.astro";
import ConstraintRegister from "./ConstraintRegister.astro";
import ProvenanceReceipt from "./ProvenanceReceipt.astro";
import SpecsGrid from "./SpecsGrid.astro";
import HeroLoop from "./HeroLoop.astro";
import FamilyBand from "./FamilyBand.astro";
import StatusChip from "./StatusChip.astro";
import { products, statusLabels } from "../content/family";
import type { ProductContent } from "../content/types";
import { siteUrls } from "../content/urls";

import paimosHero from "../assets/products/paimos/hero.png";
import paimosHeroLoop from "../assets/products/paimos/hero-loop.mp4";
import paimosLogo from "../assets/products/paimos/logo.svg";
import paimosWorkflow from "../assets/products/paimos/context-ledger.png";
import paimosProblem from "../assets/products/paimos/problem-context.png";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosHeroLoop from "../assets/products/pharos/hero-loop.mp4";
import pharosLogo from "../assets/products/pharos/mark.svg";
import pharosWorkflow from "../assets/products/pharos/fleet-gate.png";
import pharosProblem from "../assets/products/pharos/problem-evidence.png";
import janusHero from "../assets/products/janus/hero.png";
import janusHeroLoop from "../assets/products/janus/hero-loop.mp4";
import janusLogo from "../assets/products/janus/logo.svg";
import janusWorkflow from "../assets/products/janus/value-boundary.png";
import janusProblem from "../assets/products/janus/problem-boundary.png";

interface Props {
  content: ProductContent;
  locale?: "en" | "de";
  /**
   * Mount below the www host instead of the product host root (INSPR-492:
   * the retired Paimos page at www.inspr.at/paimos-legacy). Scopes canonical,
   * hreflang, the language switch and the brand link to that path, and keeps
   * the page out of search indexes.
   */
  mount?: { english: string; german: string };
}

const { content } = Astro.props;
const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const sheetLabels = locale === "de"
  ? { repo: "Repo", runtime: "Laufzeit", gate: "Freigabe", artefact: "Artefakt", interfaces: "Schnittstellen", maturity: "Reife", command: "Befehl" }
  : { repo: "repo", runtime: "runtime", gate: "gate", artefact: "artifact", interfaces: "interfaces", maturity: "maturity", command: "command" };
const product = products[content.slug];

// The shared DE/EN locale contract: English lives at the product-host root,
// German at /de/. Both alternates derive from the canonical host so hreflang
// stays correct regardless of which edition is being rendered.
const mount = Astro.props.mount;
const englishUrl = mount?.english ?? siteUrls[content.slug];
const germanUrl = mount?.german ?? `${englishUrl}/de/`;
const pathOf = (url: string) => new URL(url).pathname;
// Planned rows use the shared chip so they never read like a shipped status.
const isPlannedLabel = (status: string) =>
  status === statusLabels.planned.en || status === statusLabels.planned.de;

// UI chrome that does not belong to the content model. Section anchors stay
// identical across locales so the language switch preserves deep links.
const labels = locale === "de"
  ? {
      navWhy: "Warum",
      navModel: "Modell",
      navCapabilities: "Funktionen",
      navArchitecture: "Architektur",
      navTrust: "Vertrauen",
      navSource: "Quellcode",
      viewSource: "Quellcode ansehen",
      proofAria: "Produktmerkmale",
      proofLabel: "Betriebsprofil",
      specsEli10: "Einfach erklärt",
      detailsDescription: "Wie viel Detail diese Seite zeigt",
      detailsSimple: "Einfach",
      detailsTechnical: "Technisch",
      specsFlipAll: "Alle umdrehen",
      specsUnflipAll: "Alle zurückdrehen",
      specsShuffle: "Eckdaten-Raster mischen",
      capabilityRailLabel: "Das Fähigkeitssystem nachverfolgen",
      capabilityRailSignal: "Ausgewählte Fähigkeit",
      trustRailLabel: "Jede durchgesetzte Grenze prüfen",
      trustRailSignal: "Grenznachweis",
      architectureFlowAria: "Architekturfluss",
      architecturePlanesAria: "Zwei-Ebenen-Architektur mit wertfreier Nachweis-Rückgabe",
      policyPlane: "Richtlinien- und Aufsichtsebene",
      executionPlane: "Verwahr- und Ausführungsebene",
      executionPlaneNote: "Geheimnismaterial existiert nur innerhalb dieses freigegebenen Ausführungspfads.",
      planeReturn: "Kehrt ohne den Geheimniswert zur Aufsicht zurück",
      integrationFilterAria: "Integrationen nach Reifegrad filtern",
      integrationAll: "Alle",
      integrationShown: "angezeigt",
      integrationSwipe: "Wischen Sie für Details",
      integrationTableAria: "Integrationsmatrix",
      integrationColumn: "Integration",
      statusColumn: "Status",
      descriptionColumn: "Was sie leistet",
      faqEyebrow: "Praktische Fragen",
      faqTitle: "Bevor Sie es einführen.",
    }
  : {
      navWhy: "Why",
      navModel: "Model",
      navCapabilities: "Capabilities",
      navArchitecture: "Architecture",
      navTrust: "Trust",
      navSource: "Source",
      viewSource: "View the source",
      proofAria: "Product characteristics",
      proofLabel: "Operating posture",
      specsEli10: "ELI10 mode",
      detailsDescription: "How much detail this page shows",
      detailsSimple: "Simple",
      detailsTechnical: "Technical",
      specsFlipAll: "Flip all",
      specsUnflipAll: "Unflip all",
      specsShuffle: "Shuffle the specs grid",
      capabilityRailLabel: "Trace the capability system",
      capabilityRailSignal: "Selected capability",
      trustRailLabel: "Inspect each enforced boundary",
      trustRailSignal: "Boundary evidence",
      architectureFlowAria: "Architecture flow",
      architecturePlanesAria: "Two-plane architecture with value-free evidence return",
      policyPlane: "Policy and oversight plane",
      executionPlane: "Custody and execution plane",
      executionPlaneNote: "Secret material exists only inside this approved execution path.",
      planeReturn: "Returns to oversight without the secret value",
      integrationFilterAria: "Filter integrations by maturity",
      integrationAll: "All",
      integrationShown: "shown",
      integrationSwipe: "Swipe to inspect details",
      integrationTableAria: "Integration matrix",
      integrationColumn: "Integration",
      statusColumn: "Status",
      descriptionColumn: "What it does",
      faqEyebrow: "Practical questions",
      faqTitle: "Before you adopt it.",
    };

const assets = {
  paimos: {
    hero: paimosHero,
    heroLoop: paimosHeroLoop,
    logo: paimosLogo,
    problem: paimosProblem,
    workflow: paimosWorkflow,
    workflowAlt:
      "A shared translucent project ledger connecting work, context, execution and evidence.",
  },
  pharos: {
    hero: pharosHero,
    heroLoop: pharosHeroLoop,
    logo: pharosLogo,
    problem: pharosProblem,
    workflow: pharosWorkflow,
    workflowAlt:
      locale === "de"
        ? "Ein Instrument zur Flottensteuerung vergleicht beobachteten und deklarierten Zustand vor einer abgesicherten Freigabe."
        : "A fleet control instrument comparing observed state with declared state through a guarded change gate.",
  },
  janus: {
    hero: janusHero,
    heroLoop: janusHeroLoop,
    logo: janusLogo,
    problem: janusProblem,
    workflow: janusWorkflow,
    workflowAlt:
      locale === "de"
        ? "Eine Anfrage mit Geheimnisnutzung durchquert eine transparente Richtliniengrenze, während der Geheimniswert versiegelt bleibt."
        : "A secret-backed request crossing a transparent policy boundary while the secret value remains sealed.",
  },
}[content.slug];

const architectureIcons = {
  paimos: ["panels-top-left", "server", "braces", "database", "cloud"],
  pharos: ["server", "radio-tower", "database-zap", "panels-top-left"],
  janus: [
    "route",
    "key-round",
    "shield-check",
    "user-round-check",
    "ticket-check",
    "workflow",
    "lock-keyhole",
    "scroll-text",
  ],
}[content.slug];

const ogImage = new URL(assets.hero.src, content.canonicalUrl).href;
const nav = [
  { label: labels.navWhy, href: "#why" },
  { label: labels.navModel, href: "#model" },
  { label: labels.navCapabilities, href: "#capabilities" },
  { label: labels.navArchitecture, href: "#architecture" },
  { label: labels.navTrust, href: "#trust" },
  { label: labels.navSource, href: "#open-source" },
];
const integrationStatuses = [...new Set(content.integrations.items.map((item) => item.status))];
type FeaturePresentation =
  | "constellation"
  | "comparison"
  | "evidence-stack"
  | "ledger"
  | "sequence"
  | "rail";
const featurePresentations: Record<string, FeaturePresentation> = {
  "structured-work": "ledger",
  "agent-context": "evidence-stack",
  "execution-control": "rail",
  "customer-delivery": "sequence",
  fleet: "constellation",
  drift: "comparison",
  backups: "evidence-stack",
  onboarding: "sequence",
  "guarded-actions": "rail",
  capabilities: "rail",
  lifecycle: "sequence",
  oversight: "ledger",
};
---

<MicrositeLayout
  title={content.seo.title}
  description={content.seo.description}
  canonical={mount ? (locale === "de" ? germanUrl : englishUrl) : content.canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  robots={mount ? "noindex, follow" : undefined}
  ogImage={ogImage}
  ogImageAlt={content.hero.alt}
  favicon={assets.logo.src}
  theme={content.slug}
>
  <MicrositeHeader
    name={content.name}
    category={content.category}
    logo={assets.logo.src}
    active={content.slug}
    homeHref={mount ? pathOf(locale === "de" ? germanUrl : englishUrl) : undefined}
    nav={nav}
    locale={locale}
    languageLinks={mount ? { en: pathOf(englishUrl), de: pathOf(germanUrl) } : { en: "/", de: "/de/" }}
    detailsSlider={{
      label: "Details",
      description: labels.detailsDescription,
      levels: [
        { id: "simple", label: labels.detailsSimple },
        { id: "standard", label: "Standard" },
        { id: "technical", label: labels.detailsTechnical },
      ],
    }}
  />

  <main id="main-content">
    <ServiceRibbon text={content.serviceIntro} locale={locale} />

    <section
      class="product-hero page-shell"
      aria-labelledby="hero-title"
      data-section-pattern="editorial-hero"
    >
      <div class="product-hero__copy">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title">{content.hero.title}</h1>
        {content.slug !== "paimos" && <p>{product.oneLiner[locale]}</p>}
        <p class="hero-lead"><DetailLevels simple={content.hero.depths?.simple ?? content.hero.lead} standard={content.hero.lead} technical={content.hero.depths?.technical ?? content.hero.lead} /></p>
        {content.slug !== "paimos" && <p><StatusChip status={product.status} locale={locale} /> {product.statusNote?.[locale]}</p>}
        <div class="button-row">
          <a class="button" href={content.hero.primaryHref}>
            {content.hero.primaryLabel} <span aria-hidden="true">↓</span>
          </a>
          <a class="button button--ghost" href={content.repositoryUrl} target="_blank" rel="noopener noreferrer">
            {labels.viewSource} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="product-sheet details-drawer" data-drawer>
          <div class="details-drawer__inner">
            <dt>{sheetLabels.repo}</dt><dd>{content.hero.sheet.repo}</dd>
            <dt>{sheetLabels.runtime}</dt><dd>{content.hero.sheet.runtime}</dd>
            <dt>{sheetLabels.gate}</dt><dd>{content.hero.sheet.gate}</dd>
            <dt>{sheetLabels.artefact}</dt><dd>{content.hero.sheet.artefact}</dd>
            <dt>{sheetLabels.interfaces}</dt><dd>{content.hero.sheet.interfaces}</dd>
            <dt>{sheetLabels.maturity}</dt><dd>{content.hero.sheet.maturity}</dd>
            {content.hero.sheet.command && (
              <>
                <dt>{sheetLabels.command}</dt>
                <dd><code class="product-sheet__command">$ {content.hero.sheet.command}</code></dd>
              </>
            )}
          </div>
        </dl>
      </div>

      <figure class="product-hero__visual">
        <HeroLoop
          id={content.slug}
          poster={assets.hero}
          video={assets.heroLoop}
          alt={content.hero.alt}
          sizes="(min-width: 64rem) 55vw, 100vw"
          locale={locale}
        />
      </figure>
    </section>

    {content.slug !== "paimos" && (
      <>
        <FamilyBand highlight={content.slug} locale={locale} />
      </>
    )}

    <div
      data-depth-min="standard" class="proof-console page-shell"
      role="group"
      aria-label={labels.proofAria}
      data-section-pattern="proof-strip"
    >
      <div class="proof-console__label" aria-hidden="true">
        <span>{labels.proofLabel}</span>
        <strong>{String(content.proof.length).padStart(2, "0")}</strong>
      </div>
      <ol class="proof-strip">
        {
          content.proof.map((item, index) => (
            <li>
              <span class="proof-strip__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
    </div>

    {content.specs && (
      <SpecsGrid
        specs={content.specs}
        labels={{
          eli10: labels.specsEli10,
          flipAll: labels.specsFlipAll,
          unflipAll: labels.specsUnflipAll,
          shuffle: labels.specsShuffle,
        }}
      />
    )}

    <section data-depth-min="standard"
      class="section page-shell"
      id="why"
      aria-labelledby="problem-title"
      data-section-pattern="fracture-atlas"
    >
      <header class="section-intro">
        <p class="eyebrow">{content.problem.eyebrow}</p>
        <h2 id="problem-title">{content.problem.title}</h2>
        <p class="section-lead"><DetailLevels simple={content.problem.depths?.simple ?? content.problem.lead} standard={content.problem.lead} technical={content.problem.depths?.technical ?? content.problem.lead} /></p>
      </header>
      <FractureAtlas
        id={`${content.slug}-problem`}
        items={content.problem.items}
        image={assets.problem}
        alt={content.problem.visualAlt}
        caption={content.problem.visualCaption}
        locale={locale}
      />
    </section>

    <WorkflowExplorer
      id="model"
      eyebrow={content.model.eyebrow}
      title={content.model.title}
      lead={content.model.lead}
      leadDepths={content.model.depths}
      handoff={content.model.handoff}
      steps={content.model.steps}
      image={assets.workflow}
      alt={assets.workflowAlt}
      closing={content.model.closing}
      tone="ink"
      pattern="guided-workflow"
      locale={locale}
    />

    <div data-depth-min="standard">{content.slug === "paimos" && <PaimosProductSurface locale={locale} />}</div>

    <div id="capabilities">
      {content.featureSections.map((feature, index) => {
        const presentation = featurePresentations[feature.id] ?? "ledger";
        return (
          <section data-depth-min="standard"
            class:list={["section", "page-shell", { "section--tint": index % 2 === 1 }]}
            id={`feature-${feature.id}`}
            aria-labelledby={`${feature.id}-title`}
            data-section-pattern={presentation === "rail" ? "inspectable-rail" : `feature-${presentation}`}
          >
            <header class="section-intro">
              <p class="eyebrow">{feature.eyebrow}</p>
              <h2 id={`${feature.id}-title`}>{feature.title}</h2>
              <p class="section-lead">{feature.lead}</p>
            </header>
            {presentation === "rail" ? (
              <InspectableRail
                id={`${content.slug}-${feature.id}`}
                items={feature.items}
                label={labels.capabilityRailLabel}
                signalLabel={labels.capabilityRailSignal}
                locale={locale}
              />
            ) : (
              <FeatureExperience
                id={`${content.slug}-${feature.id}`}
                items={feature.items}
                variant={presentation}
                label={feature.eyebrow}
                locale={locale}
              />
            )}
          </section>
        );
      })}
    </div>

    <section data-depth-min="standard" data-depth-max="standard"
      class="section page-shell"
      aria-labelledby="audience-title"
      data-section-pattern="audience-paths"
    >
      <header class="section-intro">
        <p class="eyebrow">{content.audiences.eyebrow}</p>
        <h2 id="audience-title">{content.audiences.title}</h2>
        <p class="section-lead">{content.audiences.lead}</p>
      </header>
      <AudiencePaths id={`${content.slug}-audiences`} items={content.audiences.items} locale={locale} />
    </section>

    <section data-depth-min="standard"
      class="section architecture"
      id="architecture"
      aria-labelledby="architecture-title"
      data-section-pattern={content.slug === "janus" ? "two-plane-architecture" : "architecture-flow"}
    >
      <div class="page-shell architecture__grid">
        <div>
          <p class="eyebrow">{content.architecture.eyebrow}</p>
          <h2 id="architecture-title">{content.architecture.title}</h2>
          <p class="section-lead">{content.architecture.lead}</p>
          {content.architecture.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div
          class:list={["architecture__diagram", { "architecture__diagram--planes": content.slug === "janus" }]}
          role="group"
          aria-label={content.slug === "janus" ? labels.architecturePlanesAria : labels.architectureFlowAria}
        >
          {content.slug === "janus" ? (
            <>
              <div class="architecture__plane architecture__plane--policy">
                <p>{labels.policyPlane}</p>
                {content.architecture.flow.slice(0, 5).map((item, index) => (
                  <div class="architecture__node">
                    <span class="architecture__node-index">{String(index + 1).padStart(2, "0")}</span>
                    <span class="architecture__node-icon" aria-hidden="true">
                      <ContextIcon name={architectureIcons[index] ?? "circle-dot"} size={23} strokeWidth={2} />
                    </span>
                    <strong>{item}</strong>
                  </div>
                ))}
              </div>
              <div class="architecture__plane architecture__plane--execution">
                <p>{labels.executionPlane}</p>
                {content.architecture.flow.slice(5, 7).map((item, index) => {
                  const flowIndex = index + 5;
                  return (
                    <div class="architecture__node">
                      <span class="architecture__node-index">{String(flowIndex + 1).padStart(2, "0")}</span>
                      <span class="architecture__node-icon" aria-hidden="true">
                        <ContextIcon name={architectureIcons[flowIndex] ?? "circle-dot"} size={23} strokeWidth={2} />
                      </span>
                      <strong>{item}</strong>
                    </div>
                  );
                })}
                <p class="architecture__plane-note">
                  {labels.executionPlaneNote}
                </p>
              </div>
              <div class="architecture__node architecture__return">
                <span class="architecture__node-index">08</span>
                <span class="architecture__node-icon" aria-hidden="true">
                  <ContextIcon name={architectureIcons[7] ?? "circle-dot"} size={23} strokeWidth={2} />
                </span>
                <strong>{content.architecture.flow[7]}</strong>
                <small>{labels.planeReturn}</small>
              </div>
            </>
          ) : (
            content.architecture.flow.map((item, index) => (
              <div class="architecture__node">
                <span class="architecture__node-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="architecture__node-icon" aria-hidden="true">
                  <ContextIcon
                    name={architectureIcons[index] ?? "circle-dot"}
                    size={23}
                    strokeWidth={2}
                  />
                </span>
                <strong>{item}</strong>
              </div>
            ))
          )}
        </div>
        <ul class="architecture__facts">
          {content.architecture.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </section>

    <section data-depth-min="standard"
      class="section section--ink"
      id="trust"
      aria-labelledby="trust-title"
      data-section-pattern="inspectable-rail"
    >
      <div class="page-shell">
        <header class="section-intro section-intro--wide">
          <p class="eyebrow">{content.trust.eyebrow}</p>
          <h2 id="trust-title">{content.trust.title}</h2>
          <p class="section-lead">{content.trust.lead}</p>
        </header>
        <InspectableRail
          id={`${content.slug}-trust`}
          items={content.trust.items}
          label={labels.trustRailLabel}
          signalLabel={labels.trustRailSignal}
          tone="ink"
          locale={locale}
        />
      </div>
    </section>

    <section data-depth-min="standard"
      class="section page-shell"
      aria-labelledby="integrations-title"
      data-integration-matrix
      data-section-pattern="filterable-matrix"
    >
      <header class="section-intro">
        <p class="eyebrow">{content.integrations.eyebrow}</p>
        <h2 id="integrations-title">{content.integrations.title}</h2>
        <p class="section-lead">{content.integrations.lead}</p>
      </header>
      <div class="integration-filters" role="group" aria-label={labels.integrationFilterAria}>
        <button type="button" aria-pressed="true" data-integration-filter="all">{labels.integrationAll}</button>
        {integrationStatuses.map((status) => (
          <button type="button" aria-pressed="false" data-integration-filter={status}>
            {status}
          </button>
        ))}
        <span
          class="integration-filters__count"
          aria-live="polite"
          data-count-label={labels.integrationShown}
        >
          {content.integrations.items.length} {labels.integrationShown}
        </span>
      </div>
      <p class="table-scroll-hint" aria-hidden="true">{labels.integrationSwipe} <span>→</span></p>
      <div class="table-wrap" role="region" tabindex="0" aria-label={labels.integrationTableAria}>
        <table>
          <caption class="visually-hidden">{labels.integrationTableAria}</caption>
          <thead>
            <tr>
              <th scope="col">{labels.integrationColumn}</th>
              <th scope="col">{labels.statusColumn}</th>
              <th scope="col">{labels.descriptionColumn}</th>
            </tr>
          </thead>
          <tbody>
            {content.integrations.items.map((item) => (
              <tr data-integration-row={item.status}>
                <th scope="row">{item.name}</th>
                <td>
                  {isPlannedLabel(item.status)
                    ? <StatusChip status="planned" locale={locale} />
                    : <span class="status-label">{item.status}</span>}
                </td>
                <td>{item.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section data-depth-min="standard"
      class="section section--tint"
      id="limits"
      aria-labelledby="limits-title"
      data-section-pattern="constraint-register"
    >
      <div class="page-shell limits-grid">
        <header class="section-intro">
          <p class="eyebrow">{content.limits.eyebrow}</p>
          <h2 id="limits-title">{content.limits.title}</h2>
          <p class="section-lead">{content.limits.lead}</p>
        </header>
        <ConstraintRegister items={content.limits.items} locale={locale} />
      </div>
    </section>

    <section data-depth-min="standard"
      class="section page-shell open-source"
      id="open-source"
      aria-labelledby="source-title"
      data-section-pattern="provenance-receipt"
    >
      <div>
        <p class="eyebrow">{content.openSource.eyebrow}</p>
        <h2 id="source-title">{content.openSource.title}</h2>
        <p class="section-lead">{content.openSource.body}</p>
      </div>
      <ProvenanceReceipt links={content.openSource.links} locale={locale} />
    </section>

    <section data-depth-min="standard"
      class="section page-shell faq"
      aria-labelledby="faq-title"
      data-section-pattern="faq-accordion"
    >
      <header class="section-intro">
        <p class="eyebrow">{labels.faqEyebrow}</p>
        <h2 id="faq-title">{labels.faqTitle}</h2>
      </header>
      <div class="faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <MicrositeFooter
    name={content.name}
    repositoryUrl={content.repositoryUrl}
    licenseName={content.license.name}
    licenseUrl={content.license.url}
    ctaTitle={content.finalCta.title}
    ctaBody={content.finalCta.body}
    locale={locale}
  />
</MicrositeLayout>

<script>
  const initIntegrationMatrices = () => {
    document.querySelectorAll<HTMLElement>("[data-integration-matrix]").forEach((root) => {
      if (root.dataset.integrationReady === "true") return;
      root.dataset.integrationReady = "true";
      const filters = [
        ...root.querySelectorAll<HTMLButtonElement>("[data-integration-filter]"),
      ];
      const rows = [...root.querySelectorAll<HTMLTableRowElement>("[data-integration-row]")];
      const count = root.querySelector<HTMLElement>(".integration-filters__count");

      const countLabel = count?.dataset.countLabel ?? "shown";

      filters.forEach((filter) => {
        filter.addEventListener("click", () => {
          const selected = filter.dataset.integrationFilter ?? "all";
          let visible = 0;
          filters.forEach((item) => {
            item.setAttribute("aria-pressed", String(item === filter));
          });
          rows.forEach((row) => {
            row.hidden = selected !== "all" && row.dataset.integrationRow !== selected;
            if (!row.hidden) visible += 1;
          });
          if (count) count.textContent = `${visible} ${countLabel}`;
        });
      });
    });
  };

  initIntegrationMatrices();
  document.addEventListener("astro:page-load", initIntegrationMatrices);
</script>
