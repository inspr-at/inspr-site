---
import { siteUrls } from "../content/urls";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="service-ribbon page-shell" aria-label="Professional services">
  <span class="service-ribbon__signal" aria-hidden="true"></span>
  <p>{text}</p>
  <a href={siteUrls.business} target="_blank" rel="noopener noreferrer">Professional services <span aria-hidden="true">↗</span></a>
</aside>
