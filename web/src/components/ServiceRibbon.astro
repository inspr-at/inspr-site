---
import { siteUrls } from "../content/urls";

interface Props {
  text: string;
  locale?: "en" | "de";
}

const { text, locale = "en" } = Astro.props;
const label = locale === "de" ? "Professionelle Services" : "Professional services";
---

<aside class="service-ribbon page-shell" aria-label={label}>
  <span class="service-ribbon__signal" aria-hidden="true"></span>
  <p>{text}</p>
  <a href={siteUrls.business} target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a>
</aside>
