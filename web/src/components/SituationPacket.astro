---
interface Props {
  locale?: "en" | "de";
}

const { locale = "en" } = Astro.props;

const englishSignals = [
  {
    key: "goal",
    label: "Goal",
    question: "What are we trying to achieve?",
    explanation:
      "Name the outcome, the accountable owner and the rules that must hold. Everyone works toward the same result instead of interpreting a vague request.",
    example:
      "Release checkout-api revision 8f42 without interrupting active sessions. Operations owns the result.",
    missing: "People and agents can optimise for different outcomes.",
    clear: "Every next step can be checked against one shared result.",
    icon: "target",
  },
  {
    key: "reality",
    label: "Reality",
    question: "What is true right now?",
    explanation:
      "Bring the current revision, service health and work already in progress into the handoff. The plan starts from observed reality, not memory.",
    example:
      "Revision 7fc1 is live, health checks are green and a database migration is already running.",
    missing: "A sensible plan can still act on yesterday's situation.",
    clear: "The next action accounts for what is actually happening now.",
    icon: "pulse",
  },
  {
    key: "permission",
    label: "Permission",
    question: "What may this task do?",
    explanation:
      "Give the task the smallest useful capability and state where it must stop. Useful autonomy does not require broad, permanent access.",
    example:
      "The run may restart checkout-api after approval. It cannot read secret values or change another service.",
    missing: "People must either block the work or grant more access than it needs.",
    clear: "The task can move independently inside a visible boundary.",
    icon: "shield",
  },
  {
    key: "proof",
    label: "Proof",
    question: "How do we know it worked?",
    explanation:
      "Define the evidence that must return before work is complete. The next person receives a usable record, not a success claim.",
    example:
      "Return the deployed revision, health-check result, verifier and follow-up decision - without recording secret material.",
    missing: "The next handoff begins with another round of reconstruction.",
    clear: "The result is reviewable and ready for the next decision.",
    icon: "check",
  },
];

const germanSignals = [
  {
    key: "goal",
    label: "Ziel",
    question: "Was wollen wir erreichen?",
    explanation:
      "Benennen Sie das Ergebnis, die verantwortliche Person und die Regeln, die gelten müssen. So arbeiten alle auf dasselbe Ziel hin, statt eine vage Anfrage unterschiedlich auszulegen.",
    example:
      "Revision 8f42 der checkout-api ohne Unterbrechung aktiver Sitzungen veröffentlichen. Der Betrieb verantwortet das Ergebnis.",
    missing: "Menschen und Agenten können auf unterschiedliche Ergebnisse hinarbeiten.",
    clear: "Jeder nächste Schritt lässt sich an einem gemeinsamen Ergebnis prüfen.",
    icon: "target",
  },
  {
    key: "reality",
    label: "Ist-Zustand",
    question: "Was gilt gerade tatsächlich?",
    explanation:
      "Nehmen Sie die aktuelle Revision, den Zustand des Dienstes und laufende Arbeiten in die Übergabe auf. Der Plan beginnt bei beobachteten Fakten, nicht bei Erinnerungen.",
    example:
      "Revision 7fc1 ist aktiv, die Zustandsprüfungen sind grün und eine Datenbankmigration läuft bereits.",
    missing: "Ein sinnvoller Plan kann trotzdem auf die Situation von gestern reagieren.",
    clear: "Die nächste Aktion berücksichtigt, was gerade wirklich geschieht.",
    icon: "pulse",
  },
  {
    key: "permission",
    label: "Berechtigung",
    question: "Was darf diese Aufgabe tun?",
    explanation:
      "Geben Sie der Aufgabe nur die kleinste nützliche Berechtigung und halten Sie fest, wo sie stoppen muss. Nützliche Autonomie braucht keinen breiten, dauerhaften Zugriff.",
    example:
      "Der Lauf darf die checkout-api nach Freigabe neu starten. Er darf keine geheimen Werte lesen und keinen anderen Dienst verändern.",
    missing: "Menschen müssen die Arbeit blockieren oder mehr Zugriff gewähren als nötig.",
    clear: "Die Aufgabe kann sich innerhalb einer sichtbaren Grenze selbstständig bewegen.",
    icon: "shield",
  },
  {
    key: "proof",
    label: "Nachweis",
    question: "Woran erkennen wir, dass es funktioniert hat?",
    explanation:
      "Legen Sie fest, welche Nachweise zurückkommen müssen, bevor die Arbeit abgeschlossen ist. Die nächste Person erhält einen brauchbaren Beleg statt einer bloßen Erfolgsmeldung.",
    example:
      "Ausgelieferte Revision, Ergebnis der Zustandsprüfung, prüfende Person und Folgeentscheidung zurückgeben, ohne geheimes Material aufzuzeichnen.",
    missing: "Die nächste Übergabe beginnt wieder mit dem Rekonstruieren der Situation.",
    clear: "Das Ergebnis ist prüfbar und bereit für die nächste Entscheidung.",
    icon: "check",
  },
];

const signals = locale === "de" ? germanSignals : englishSignals;
const labels = locale === "de"
  ? {
      before: "Bevor die Arbeit beginnt",
      title: "Vier Fragen verhindern vermeidbares Rätselraten.",
      intro: "Wählen Sie eine Frage. Sie sehen, was eine gute Übergabe enthält und warum das in der Praxis zählt.",
      tablist: "Vier Fragen für eine verlässliche Übergabe",
      example: "Eine konkrete Übergabe",
      why: "Warum das zählt",
      without: "Ohne",
      with: "Mit",
      takeaway: "Klare Übergaben lassen Menschen und Agenten weiterarbeiten, ohne die Situation neu aufzubauen.",
    }
  : {
      before: "Before work starts",
      title: "Four questions prevent avoidable guesswork.",
      intro: "Choose a question to see what good handoff information looks like and why it matters in practice.",
      tablist: "Four questions for a reliable handoff",
      example: "One concrete handoff",
      why: "Why it matters",
      without: "Without",
      with: "With",
      takeaway: "Clear handoffs let people and agents continue without rebuilding the situation.",
    };

const firstSignal = signals[0];
---

<div class="situation-packet" data-situation-packet>
  <div class="situation-packet__intro">
    <p class="situation-packet__label">{labels.before}</p>
    <h3>{labels.title}</h3>
    <p>{labels.intro}</p>
  </div>

  <div class="handoff-guide">
    <div class="handoff-tabs" role="tablist" aria-label={labels.tablist}>
      {signals.map((signal, index) => (
        <button
          class:list={["handoff-tab", { "is-active": index === 0 }]}
          id={`handoff-tab-${signal.key}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls="handoff-panel"
          tabindex={index === 0 ? "0" : "-1"}
          data-handoff-tab
          data-label={signal.label}
          data-question={signal.question}
          data-explanation={signal.explanation}
          data-example={signal.example}
          data-missing={signal.missing}
          data-clear={signal.clear}
        >
          <span class="handoff-tab__number">0{index + 1}</span>
          <span class="handoff-tab__icon" aria-hidden="true">
            {signal.icon === "target" && (
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" /><circle cx="12" cy="12" r="2" /><path d="M12 2v3M22 12h-3M12 22v-3M2 12h3" /></svg>
            )}
            {signal.icon === "pulse" && (
              <svg viewBox="0 0 24 24"><path d="M3 12h4l2.2-5 4 10 2.2-5H21" /></svg>
            )}
            {signal.icon === "shield" && (
              <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.6 8 7 10 4.4-2 7-5.4 7-10V6l-7-3Zm-2.5 9 1.7 1.7 3.6-4" /></svg>
            )}
            {signal.icon === "check" && (
              <svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 12l2.5 2.5L16 9" /></svg>
            )}
          </span>
          <span>
            <strong>{signal.label}</strong>
            <small>{signal.question}</small>
          </span>
        </button>
      ))}
    </div>

    <div
      class="handoff-panel"
      id="handoff-panel"
      role="tabpanel"
      aria-labelledby="handoff-tab-goal"
      tabindex="0"
      data-handoff-panel
    >
      <div class="handoff-panel__answer">
        <p class="handoff-panel__eyebrow" data-handoff-eyebrow>01 · {firstSignal.label}</p>
        <h4 data-handoff-question>{firstSignal.question}</h4>
        <p class="handoff-panel__lead" data-handoff-explanation>{firstSignal.explanation}</p>

        <div class="handoff-example">
          <span>{labels.example}</span>
          <p data-handoff-example>{firstSignal.example}</p>
        </div>
      </div>

      <div class="handoff-impact" aria-live="polite">
        <p class="handoff-impact__label">{labels.why}</p>
        <div class="handoff-impact__row handoff-impact__row--missing">
          <span aria-hidden="true">{labels.without}</span>
          <p data-handoff-missing>{firstSignal.missing}</p>
        </div>
        <div class="handoff-impact__arrow" aria-hidden="true">↓</div>
        <div class="handoff-impact__row handoff-impact__row--clear">
          <span aria-hidden="true">{labels.with}</span>
          <p data-handoff-clear>{firstSignal.clear}</p>
        </div>
        <p class="handoff-impact__takeaway">
          {labels.takeaway}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-situation-packet]").forEach((guide) => {
    const tabs = Array.from(guide.querySelectorAll<HTMLButtonElement>("[data-handoff-tab]"));
    const panel = guide.querySelector<HTMLElement>("[data-handoff-panel]");
    const eyebrow = guide.querySelector<HTMLElement>("[data-handoff-eyebrow]");
    const question = guide.querySelector<HTMLElement>("[data-handoff-question]");
    const explanation = guide.querySelector<HTMLElement>("[data-handoff-explanation]");
    const example = guide.querySelector<HTMLElement>("[data-handoff-example]");
    const missing = guide.querySelector<HTMLElement>("[data-handoff-missing]");
    const clear = guide.querySelector<HTMLElement>("[data-handoff-clear]");

    const selectTab = (tab: HTMLButtonElement, moveFocus = false) => {
      const index = tabs.indexOf(tab);
      if (index < 0 || !panel || !eyebrow || !question || !explanation || !example || !missing || !clear) return;

      tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.classList.toggle("is-active", selected);
        candidate.setAttribute("aria-selected", String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      });

      panel.setAttribute("aria-labelledby", tab.id);
      eyebrow.textContent = `0${index + 1} · ${tab.dataset.label}`;
      question.textContent = tab.dataset.question ?? "";
      explanation.textContent = tab.dataset.explanation ?? "";
      example.textContent = tab.dataset.example ?? "";
      missing.textContent = tab.dataset.missing ?? "";
      clear.textContent = tab.dataset.clear ?? "";

      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        const current = tabs.indexOf(tab);
        let next = current;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (current + 1) % tabs.length;
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (current - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") next = 0;
        if (event.key === "End") next = tabs.length - 1;
        if (next === current) return;

        event.preventDefault();
        selectTab(tabs[next], true);
      });
    });
  });
</script>

<style>
  .situation-packet {
    display: grid;
    grid-template-columns: minmax(16rem, 0.34fr) minmax(40rem, 1fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: start;
    margin-top: clamp(3rem, 7vw, 6.5rem);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.13);
  }

  .situation-packet__intro {
    padding-top: 0.75rem;
  }

  .situation-packet__label,
  .handoff-tab__number,
  .handoff-panel__eyebrow,
  .handoff-example > span,
  .handoff-impact__label,
  .handoff-impact__row > span {
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .situation-packet__label {
    margin: 0 0 0.9rem;
    color: #8bd7d2;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .situation-packet__intro h3 {
    max-width: 13ch;
    margin: 0;
    color: #f8f5ef;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .situation-packet__intro > p:last-child {
    max-width: 28rem;
    margin: 1.25rem 0 0;
    color: rgb(228 237 235 / 0.7);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .handoff-guide {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(139 215 210 / 0.24);
    border-radius: 1.2rem;
    background:
      linear-gradient(145deg, rgb(75 178 175 / 0.08), transparent 48%),
      rgb(5 24 32 / 0.34);
    box-shadow:
      0 1.5rem 4rem rgb(0 0 0 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.04);
  }

  .handoff-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0.7rem;
    border-bottom: 1px solid rgb(139 215 210 / 0.15);
  }

  .handoff-tab {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 0.55rem;
    align-items: center;
    min-width: 0;
    min-height: 5.2rem;
    padding: 0.7rem;
    color: rgb(228 237 235 / 0.58);
    text-align: left;
    border: 1px solid transparent;
    border-radius: 0.85rem;
    background: rgb(255 255 255 / 0.025);
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .handoff-tab:hover {
    color: rgb(244 247 246 / 0.9);
    background: rgb(139 215 210 / 0.06);
  }

  .handoff-tab:focus-visible {
    outline: 3px solid rgb(139 215 210 / 0.35);
    outline-offset: 2px;
  }

  .handoff-tab.is-active {
    color: #f8f5ef;
    border-color: rgb(139 215 210 / 0.7);
    background: rgb(139 215 210 / 0.1);
  }

  .handoff-tab__number {
    align-self: start;
    padding-top: 0.15rem;
    color: #8bd7d2;
    font-size: 0.56rem;
    font-weight: 700;
  }

  .handoff-tab__icon {
    display: grid;
    width: 2.25rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 0.65rem;
    background: rgb(139 215 210 / 0.1);
  }

  .handoff-tab__icon svg {
    width: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .handoff-tab strong,
  .handoff-tab small {
    display: block;
  }

  .handoff-tab strong {
    font-size: 0.78rem;
  }

  .handoff-tab small {
    overflow: hidden;
    margin-top: 0.2rem;
    color: rgb(228 237 235 / 0.52);
    font-size: 0.6rem;
    line-height: 1.3;
  }

  .handoff-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    min-height: 25rem;
  }

  .handoff-panel:focus {
    outline: none;
  }

  .handoff-panel:focus-visible {
    outline: 2px solid rgb(139 215 210 / 0.32);
    outline-offset: -0.4rem;
  }

  .handoff-panel__answer,
  .handoff-impact {
    padding: clamp(1.5rem, 2.8vw, 2.3rem);
  }

  .handoff-panel__answer {
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgb(139 215 210 / 0.15);
  }

  .handoff-panel__eyebrow {
    margin: 0 0 0.9rem;
    color: #8bd7d2;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .handoff-panel h4 {
    min-height: 2.25em;
    margin: 0;
    color: #f8f5ef;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .handoff-panel__lead {
    min-height: 4.9em;
    margin: 1rem 0 0;
    color: rgb(228 237 235 / 0.74);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .handoff-example {
    min-height: 7.5rem;
    margin-top: auto;
    padding: 1.15rem 1.2rem;
    border: 1px solid rgb(139 215 210 / 0.18);
    border-radius: 0.85rem;
    background: rgb(255 255 255 / 0.025);
  }

  .handoff-example > span,
  .handoff-impact__label {
    color: rgb(139 215 210 / 0.78);
    font-size: 0.58rem;
    font-weight: 700;
  }

  .handoff-example p {
    margin: 0.65rem 0 0;
    color: rgb(228 237 235 / 0.72);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .handoff-impact {
    display: flex;
    flex-direction: column;
    background: rgb(255 255 255 / 0.018);
  }

  .handoff-impact__label {
    margin: 0 0 1rem;
  }

  .handoff-impact__row {
    min-height: 7rem;
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.8rem;
  }

  .handoff-impact__row > span {
    color: rgb(228 237 235 / 0.5);
    font-size: 0.56rem;
    font-weight: 700;
  }

  .handoff-impact__row p {
    margin: 0.55rem 0 0;
    color: rgb(228 237 235 / 0.68);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .handoff-impact__row--missing {
    background: rgb(228 237 235 / 0.025);
  }

  .handoff-impact__row--clear {
    border-color: rgb(139 215 210 / 0.28);
    background: rgb(139 215 210 / 0.075);
  }

  .handoff-impact__row--clear > span,
  .handoff-impact__row--clear p {
    color: #a9e3df;
  }

  .handoff-impact__arrow {
    height: 2rem;
    color: rgb(139 215 210 / 0.7);
    font-size: 1rem;
    line-height: 2rem;
    text-align: center;
  }

  .handoff-impact__takeaway {
    margin: auto 0 0;
    padding-top: 1.1rem;
    color: rgb(228 237 235 / 0.58);
    border-top: 1px solid rgb(139 215 210 / 0.14);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  @media (max-width: 75rem) {
    .situation-packet {
      grid-template-columns: 1fr;
    }

    .situation-packet__intro h3 {
      max-width: 21ch;
    }
  }

  @media (max-width: 56rem) {
    .handoff-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .handoff-panel {
      grid-template-columns: 1fr;
    }

    .handoff-panel__answer {
      border-right: 0;
      border-bottom: 1px solid rgb(139 215 210 / 0.15);
    }

    .handoff-panel h4,
    .handoff-panel__lead,
    .handoff-example,
    .handoff-impact__row {
      min-height: 0;
    }

    .handoff-example {
      margin-top: 1.5rem;
    }

    .handoff-impact__takeaway {
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 34rem) {
    .handoff-tabs {
      grid-template-columns: 1fr;
    }

    .handoff-tab {
      min-height: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .handoff-tab {
      transition: none;
    }
  }
</style>
