---
const signals = [
  {
    key: "context",
    title: "Context",
    packetTitle: "Project context",
    headline: "Why this work exists and the rules it must follow.",
    detail:
      "Purpose, scope, repository, accountable owner and operating rules travel with the task.",
    example:
      "A release task names the target service, desired outcome, repository revision, owner and non-negotiable operating rules.",
    decision:
      "The system can determine which sources and rules belong to this task.",
    icon: "layers",
  },
  {
    key: "state",
    title: "Current state",
    packetTitle: "Current state",
    headline: "What is true before the next step begins.",
    detail:
      "Observed service health, deployed revision and pending changes replace an assumed snapshot.",
    example:
      "At handoff time the packet records the live service state, deployed revision and any change already in progress.",
    decision:
      "A proposal can be checked against current evidence instead of yesterday's reality.",
    icon: "pulse",
  },
  {
    key: "authority",
    title: "Authority",
    packetTitle: "Authority",
    headline: "Exactly what this task may do and where it must stop.",
    detail:
      "A named capability and explicit boundary replace broad, ambient access.",
    example:
      "A maintenance run may restart one named service, but cannot read secret values or alter unrelated infrastructure.",
    decision:
      "Execution can use a narrow, reviewable capability rather than broad access.",
    icon: "shield",
  },
  {
    key: "evidence",
    title: "Evidence",
    packetTitle: "Return evidence",
    headline: "What must return before the work is considered complete.",
    detail:
      "Action, verifier, result and follow-up decision form a record the next step can use.",
    example:
      "The run returns what changed, who or what verified it, the resulting revision and the next decision without logging secret material.",
    decision:
      "The next person or agent receives a usable record, not a success claim.",
    icon: "check",
  },
];

const firstSignal = signals[0];
---

<div class="situation-packet" data-situation-packet>
  <div class="situation-packet__intro">
    <p class="situation-packet__label">A usable situation packet</p>
    <h3>Four signals turn intent into work that can safely continue.</h3>
    <p>
      Inspect each signal to see the decision it enables. Together they give people
      and agents one current, bounded and reviewable basis for work.
    </p>
  </div>

  <div class="packet-inspector">
    <div class="packet-tabs" role="tablist" aria-label="Situation packet signals">
      {signals.map((signal, index) => (
        <button
          class:list={["packet-tab", { "is-active": index === 0 }]}
          id={`packet-tab-${signal.key}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls="situation-packet-panel"
          tabindex={index === 0 ? "0" : "-1"}
          data-packet-tab
          data-key={signal.key}
          data-title={signal.title}
          data-headline={signal.headline}
          data-detail={signal.detail}
          data-example={signal.example}
          data-decision={signal.decision}
        >
          <span class="packet-tab__icon" aria-hidden="true">
            {signal.icon === "layers" && (
              <svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 4 8 4 8-4M4 16l8 4 8-4" /></svg>
            )}
            {signal.icon === "pulse" && (
              <svg viewBox="0 0 24 24"><path d="M3 12h4l2.2-5 4 10 2.2-5H21" /></svg>
            )}
            {signal.icon === "shield" && (
              <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.6 8 7 10 4.4-2 7-5.4 7-10V6l-7-3Zm-2.5 9 1.7 1.7 3.6-4" /></svg>
            )}
            {signal.icon === "check" && (
              <svg viewBox="0 0 24 24"><path d="M7 3h10v4h3v14H4V7h3V3Zm0 7v8h10v-8M9 14l2 2 4-5" /></svg>
            )}
          </span>
          <span class="packet-tab__number">0{index + 1}</span>
          <strong>{signal.title}</strong>
        </button>
      ))}
    </div>

    <div class="packet-workspace">
      <div
        class="packet-detail"
        id="situation-packet-panel"
        role="tabpanel"
        aria-labelledby="packet-tab-context"
        tabindex="0"
        data-packet-panel
      >
        <p class="packet-detail__eyebrow" data-packet-eyebrow>01 · {firstSignal.title}</p>
        <h4 data-packet-headline>{firstSignal.headline}</h4>
        <p class="packet-detail__lead" data-packet-detail>{firstSignal.detail}</p>

        <div class="packet-detail__example">
          <span>Operational example</span>
          <p data-packet-example>{firstSignal.example}</p>
        </div>

        <div class="packet-detail__decision" aria-live="polite">
          <span class="packet-detail__decision-icon" aria-hidden="true">✓</span>
          <div>
            <strong>Decision unlocked</strong>
            <p data-packet-decision>{firstSignal.decision}</p>
          </div>
        </div>
      </div>

      <aside class="packet-summary" aria-label="Assembled situation packet">
        <div class="packet-summary__header">
          <span>Situation packet</span>
          <strong>Complete · 4/4</strong>
        </div>

        <ol class="packet-summary__list">
          {signals.map((signal, index) => (
            <li
              class:list={["packet-summary__row", { "is-active": index === 0 }]}
              data-packet-row={signal.key}
            >
              <span class="packet-summary__number">0{index + 1}</span>
              <div>
                <strong>{signal.packetTitle}</strong>
                <small>Signal present</small>
              </div>
              <span class="packet-summary__check" aria-hidden="true">✓</span>
            </li>
          ))}
        </ol>

        <p class="packet-summary__note">
          The packet travels with the work. It is a handoff contract, not another
          dashboard.
        </p>
      </aside>
    </div>

    <div class="packet-readiness" role="status">
      <span class="packet-readiness__mark" aria-hidden="true">✓</span>
      <strong>Ready for bounded work</strong>
      <span>4/4 signals</span>
      <span class="packet-readiness__hint">Select a signal above to inspect its contribution.</span>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-situation-packet]").forEach((packet) => {
    const tabs = Array.from(packet.querySelectorAll<HTMLButtonElement>("[data-packet-tab]"));
    const panel = packet.querySelector<HTMLElement>("[data-packet-panel]");
    const eyebrow = packet.querySelector<HTMLElement>("[data-packet-eyebrow]");
    const headline = packet.querySelector<HTMLElement>("[data-packet-headline]");
    const detail = packet.querySelector<HTMLElement>("[data-packet-detail]");
    const example = packet.querySelector<HTMLElement>("[data-packet-example]");
    const decision = packet.querySelector<HTMLElement>("[data-packet-decision]");

    const selectTab = (tab: HTMLButtonElement, moveFocus = false) => {
      const index = tabs.indexOf(tab);
      if (index < 0 || !panel || !eyebrow || !headline || !detail || !example || !decision) return;

      tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.classList.toggle("is-active", selected);
        candidate.setAttribute("aria-selected", String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      });

      packet.querySelectorAll<HTMLElement>("[data-packet-row]").forEach((row) => {
        row.classList.toggle("is-active", row.dataset.packetRow === tab.dataset.key);
      });

      panel.setAttribute("aria-labelledby", tab.id);
      eyebrow.textContent = `0${index + 1} · ${tab.dataset.title}`;
      headline.textContent = tab.dataset.headline ?? "";
      detail.textContent = tab.dataset.detail ?? "";
      example.textContent = tab.dataset.example ?? "";
      decision.textContent = tab.dataset.decision ?? "";

      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        const current = tabs.indexOf(tab);
        let next = current;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (current + 1) % tabs.length;
        if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (current - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") next = 0;
        if (event.key === "End") next = tabs.length - 1;
        if (next === current) return;

        event.preventDefault();
        selectTab(tabs[next], true);
      });
    });
  });
</script>

<style>
  .situation-packet {
    display: grid;
    grid-template-columns: minmax(16rem, 0.38fr) minmax(38rem, 1fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: start;
    margin-top: clamp(3rem, 7vw, 6.5rem);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.13);
  }

  .situation-packet__intro {
    padding-top: 0.75rem;
  }

  .situation-packet__label {
    margin: 0 0 0.9rem;
    color: #8bd7d2;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .situation-packet__intro h3 {
    max-width: 13ch;
    margin: 0;
    color: #f8f5ef;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .situation-packet__intro > p:last-child {
    max-width: 31rem;
    margin: 1.25rem 0 0;
    color: rgb(228 237 235 / 0.7);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .packet-inspector {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgb(139 215 210 / 0.23);
    border-radius: 1.2rem;
    background:
      linear-gradient(145deg, rgb(75 178 175 / 0.08), transparent 48%),
      rgb(5 24 32 / 0.31);
    box-shadow:
      0 1.5rem 4rem rgb(0 0 0 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.04);
  }

  .packet-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
    padding: 0.75rem;
    border-bottom: 1px solid rgb(139 215 210 / 0.15);
  }

  .packet-tab {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 0.08rem 0.65rem;
    align-items: center;
    min-width: 0;
    min-height: 4.65rem;
    padding: 0.7rem;
    color: rgb(228 237 235 / 0.62);
    text-align: left;
    border: 1px solid transparent;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 0.025);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .packet-tab:hover {
    color: rgb(244 247 246 / 0.88);
    background: rgb(139 215 210 / 0.06);
  }

  .packet-tab:focus-visible {
    outline: 3px solid rgb(139 215 210 / 0.35);
    outline-offset: 2px;
  }

  .packet-tab.is-active {
    color: #f8f5ef;
    border-color: rgb(139 215 210 / 0.7);
    background: rgb(139 215 210 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04);
  }

  .packet-tab__icon {
    display: grid;
    grid-row: 1 / 3;
    width: 2.25rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 0.65rem;
    background: rgb(139 215 210 / 0.1);
  }

  .packet-tab__icon svg {
    width: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .packet-tab__number,
  .packet-detail__eyebrow,
  .packet-detail__example > span,
  .packet-summary__header,
  .packet-summary__number,
  .packet-readiness {
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .packet-tab__number {
    color: #8bd7d2;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .packet-tab strong {
    overflow: hidden;
    font-size: 0.74rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .packet-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(15rem, 0.85fr);
    min-height: 24rem;
  }

  .packet-detail,
  .packet-summary {
    padding: clamp(1.4rem, 2.5vw, 2rem);
  }

  .packet-detail {
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgb(139 215 210 / 0.15);
  }

  .packet-detail:focus {
    outline: none;
  }

  .packet-detail:focus-visible {
    outline: 2px solid rgb(139 215 210 / 0.32);
    outline-offset: -0.4rem;
  }

  .packet-detail__eyebrow {
    min-height: 1rem;
    margin: 0 0 0.9rem;
    color: #8bd7d2;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .packet-detail h4 {
    min-height: 2.8em;
    margin: 0;
    color: #f8f5ef;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .packet-detail__lead {
    min-height: 3.2em;
    margin: 0.75rem 0 0;
    color: rgb(228 237 235 / 0.72);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .packet-detail__example {
    min-height: 7.2rem;
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(139 215 210 / 0.16);
  }

  .packet-detail__example > span {
    color: rgb(139 215 210 / 0.76);
    font-size: 0.58rem;
    font-weight: 700;
  }

  .packet-detail__example p,
  .packet-detail__decision p,
  .packet-summary__note {
    color: rgb(228 237 235 / 0.68);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .packet-detail__example p {
    margin: 0.6rem 0 0;
  }

  .packet-detail__decision {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    min-height: 5.8rem;
    margin-top: auto;
    padding: 0.9rem;
    border: 1px solid rgb(139 215 210 / 0.2);
    border-radius: 0.8rem;
    background: rgb(139 215 210 / 0.055);
  }

  .packet-detail__decision-icon {
    display: grid;
    width: 1.6rem;
    aspect-ratio: 1;
    place-items: center;
    color: #06232d;
    border-radius: 50%;
    background: #8bd7d2;
    font-weight: 800;
  }

  .packet-detail__decision strong {
    color: #8bd7d2;
    font-size: 0.82rem;
  }

  .packet-detail__decision p {
    margin: 0.25rem 0 0;
  }

  .packet-summary {
    display: flex;
    flex-direction: column;
    background: rgb(255 255 255 / 0.015);
  }

  .packet-summary__header {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    color: rgb(139 215 210 / 0.76);
    font-size: 0.58rem;
  }

  .packet-summary__header strong {
    padding: 0.35rem 0.55rem;
    color: #8bd7d2;
    border: 1px solid rgb(139 215 210 / 0.25);
    border-radius: 0.4rem;
  }

  .packet-summary__list {
    overflow: hidden;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid rgb(139 215 210 / 0.17);
    border-radius: 0.8rem;
  }

  .packet-summary__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 3.45rem;
    padding: 0.65rem 0.75rem;
    color: rgb(228 237 235 / 0.62);
    border-bottom: 1px solid rgb(139 215 210 / 0.12);
    transition:
      color 180ms ease,
      background 180ms ease;
  }

  .packet-summary__row:last-child {
    border-bottom: 0;
  }

  .packet-summary__row.is-active {
    color: #f8f5ef;
    background: rgb(139 215 210 / 0.08);
  }

  .packet-summary__number {
    color: #8bd7d2;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .packet-summary__row strong,
  .packet-summary__row small {
    display: block;
  }

  .packet-summary__row strong {
    font-size: 0.76rem;
  }

  .packet-summary__row small {
    margin-top: 0.12rem;
    color: rgb(228 237 235 / 0.48);
    font-size: 0.62rem;
  }

  .packet-summary__check {
    color: #8bd7d2;
  }

  .packet-summary__note {
    margin: auto 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgb(139 215 210 / 0.12);
  }

  .packet-readiness {
    display: grid;
    grid-template-columns: auto auto auto 1fr;
    gap: 0.65rem;
    align-items: center;
    min-height: 4.1rem;
    padding: 0.8rem 1rem;
    color: #8bd7d2;
    border-top: 1px solid rgb(139 215 210 / 0.17);
    background: rgb(139 215 210 / 0.045);
    font-size: 0.62rem;
  }

  .packet-readiness__mark {
    display: grid;
    width: 1.55rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .packet-readiness strong {
    color: #b2e8e4;
  }

  .packet-readiness > span:nth-of-type(2) {
    color: rgb(139 215 210 / 0.7);
  }

  .packet-readiness__hint {
    justify-self: end;
    color: rgb(228 237 235 / 0.48);
    letter-spacing: 0;
    text-align: right;
    text-transform: none;
  }

  @media (max-width: 75rem) {
    .situation-packet {
      grid-template-columns: 1fr;
    }

    .situation-packet__intro h3 {
      max-width: 21ch;
    }
  }

  @media (max-width: 52rem) {
    .packet-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .packet-workspace {
      grid-template-columns: 1fr;
    }

    .packet-detail {
      border-right: 0;
      border-bottom: 1px solid rgb(139 215 210 / 0.15);
    }

    .packet-summary__note {
      margin-top: 1rem;
    }

    .packet-readiness {
      grid-template-columns: auto 1fr auto;
    }

    .packet-readiness__hint {
      display: none;
    }
  }

  @media (max-width: 31rem) {
    .packet-tabs {
      grid-template-columns: 1fr;
    }

    .packet-tab {
      min-height: 4rem;
    }

    .packet-detail h4,
    .packet-detail__lead,
    .packet-detail__example,
    .packet-detail__decision {
      min-height: 0;
    }

    .packet-readiness {
      grid-template-columns: auto 1fr;
    }

    .packet-readiness > span:nth-of-type(2) {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .packet-tab,
    .packet-summary__row {
      transition: none;
    }
  }
</style>
