---
/**
 * The capability specs grid shared by the product pages: flip cards, the
 * ELI10 wording, flip-all, shuffle and the live glossary line. Behaviour
 * lives in public/scripts/specs-pin.js, which binds to the #specs section.
 *
 * The AEON variant is simpler: calm liquid-glass tiles in stable order over
 * a full-bleed light field. Hovering or focusing a card fades its image in
 * as the section's background at 20%; clicking or tapping opens a
 * full-screen carousel (a dialog with prev/next, keys, swipe and a caption
 * that follows the Details level: Why, What or How, INSPR-497, as the lead
 * does). Everything AEON-only sits behind `field`,
 * so the other product pages render byte-identical markup. Behaviour:
 * AeonPage.astro, initSpecsCarousel.
 */
import { getImage } from "astro:assets";
import ContextIcon from "./ContextIcon.astro";
import DetailLevels from "./DetailLevels.astro";
import type { SpecsContent } from "../content/types";

type SpecsGroup = SpecsContent["items"][number]["group"];

export interface LensImage {
  image: ImageMetadata;
  /** "live" product screen, "art" generated scene, "web" public web page (caption source line). */
  kind: "live" | "art" | "web";
}

export interface LensLabels {
  live: string;
  illustration: string;
  web: string;
  close: string;
  prev: string;
  next: string;
  dialog: string;
}

interface Props {
  specs: SpecsContent;
  labels: { eli10: string; flipAll: string; unflipAll: string; shuffle: string };
  /** The AEON page adds a catalogue line (group and number) to each card. */
  variant?: "aeon";
  groupLabels?: Record<SpecsGroup, string>;
  /**
   * AEON only: the capability lens. `images` holds one image per spec in
   * content order (index 0 is spec 01) with its kind; `labels` the UI copy.
   */
  lens?: { images: LensImage[]; labels: LensLabels };
}

const { specs, labels, variant, groupLabels, lens } = Astro.props;
const catalogue = variant === "aeon" && groupLabels;
const sourceLabel = (kind?: LensImage["kind"]) =>
  kind === "art" ? lens?.labels.illustration : kind === "web" ? lens?.labels.web : lens?.labels.live;
const field = variant === "aeon";
const pad = (n: number) => String(n).padStart(2, "0");

// Renditions at build time: 1280, 1920 and 2560 wide as webp, shared by the
// section background and the carousel (one download). The browser picks by
// viewport width times devicePixelRatio through srcset and sizes=100vw.
const slides = field && lens
  ? await Promise.all(
      lens.images.map(async ({ image }) => {
        const [w1280, w1920, w2560] = await Promise.all(
          [1280, 1920, 2560].map((width) => getImage({ src: image, width, format: "webp", quality: 80 })),
        );
        return {
          src: w1920.src,
          srcset: `${w1280.src} 1280w, ${w1920.src} 1920w, ${w2560.src} 2560w`,
          width: image.width,
          height: image.height,
        };
      }),
    )
  : null;

// Cache-buster for the public/ scripts: unlike _astro assets they are not
// content-hashed, and their 5-minute edge cache once served a stale script
// against fresh HTML (dead controls). The release id changes per deploy.
const scriptVersion = process.env.INSPR_RELEASE_ID ?? "dev";

// Split a spec note into text/term segments so glossary terms become click
// targets. Longest match strings win at any position; matching is exact and
// case-sensitive (match strings carry the casing used in the notes).
type NoteSegment = { text: string; termId?: string };
const specGlossary = specs.glossary ?? [];
// Definitions travel on the term spans (data-def); the only glossary UI is
// the live help line under the grid that fills while a term is hovered.
const defById = Object.fromEntries(specGlossary.map((g) => [g.id, g.body]));
const termMatches = specGlossary
  .flatMap((entry) => entry.matches.map((m) => ({ s: m, id: entry.id })))
  .sort((a, b) => b.s.length - a.s.length);
const termSplitter = termMatches.length
  ? new RegExp(
      `(${termMatches.map((m) => m.s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`,
      "g",
    )
  : null;
const segmentNote = (text: string): NoteSegment[] => {
  if (!termSplitter) return [{ text }];
  return text
    .split(termSplitter)
    .filter(Boolean)
    .map((part) => {
      const hit = termMatches.find((m) => m.s === part);
      return hit ? { text: part, termId: hit.id } : { text: part };
    });
};
---

<section data-depth-min={field ? undefined : "standard"}
  class:list={["section page-shell specs", variant && `specs--${variant}`]}
  id="specs"
  aria-labelledby="specs-title"
  data-section-pattern="specs-grid"
  data-eli10="false"
>
  {field && (
    <div class="specs__field" aria-hidden="true">
      <div class="specs__aurora">
        <span class="specs__arcs"></span>
        <span class="specs__orb specs__orb--gold"></span>
        <span class="specs__orb specs__orb--glow"></span>
        <span class="specs__orb specs__orb--teal"></span>
      </div>
      {slides && (
        <div class="specs__bg" data-specs-bg>
          {slides.map((slide, i) => (
            <img
              class="specs__bg-img"
              src={slide.src}
              srcset={slide.srcset}
              sizes="100vw"
              alt=""
              width={slide.width}
              height={slide.height}
              loading="lazy"
              decoding="async"
              data-bg={pad(i + 1)}
            />
          ))}
        </div>
      )}
      <div class="specs__scrim"></div>
    </div>
  )}
  {/* The carousel: a full-screen dialog over the page. display:none until
      the section comes near (so the lazy images are not fetched), then
      present but hidden, so every image is decoded before the first tap.
      Inert while closed, the fade-out included. */}
  {field && slides && lens && (
    <div class="specs__carousel" data-specs-carousel tabindex="-1" inert>
      <span class="visually-hidden" id="specs-carousel-title">{lens.labels.dialog}</span>
      <div class="specs__carousel-stage">
        {slides.map((slide, i) => (
          <figure class="specs__slide" data-slide={pad(i + 1)} aria-hidden="true">
            <img
              class="specs__slide-img"
              src={slide.src}
              srcset={slide.srcset}
              sizes="100vw"
              alt=""
              data-alt={`${specs.items[i]?.label}, ${sourceLabel(lens.images[i]?.kind)}`}
              width={slide.width}
              height={slide.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="specs__slide-caption">
              <span class="specs__slide-cat">
                <span>{groupLabels?.[specs.items[i]?.group]}</span>
                <span aria-hidden="true">·</span>
                <span>{pad(i + 1)}</span>
              </span>
              <strong class="specs__slide-label" id={`specs-slide-label-${pad(i + 1)}`}>{specs.items[i]?.label}</strong>
              <p class="specs__slide-note" id={`specs-slide-note-${pad(i + 1)}`} data-copy-slot>
                <DetailLevels
                  simple={specs.items[i]?.noteEli10 ?? ""}
                  standard={specs.items[i]?.note ?? ""}
                  technical={specs.items[i]?.noteHow ?? specs.items[i]?.note ?? ""}
                />
              </p>
              <span class="specs__slide-source">{sourceLabel(lens.images[i]?.kind)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="specs__carousel-pos" id="specs-carousel-pos">
        <span data-carousel-index>01</span>
        <span class="specs__carousel-sep" aria-hidden="true">/</span>
        <span>{pad(slides.length)}</span>
      </p>
      <div class="specs__carousel-ticks" aria-hidden="true">
        {slides.map((_, i) => <i data-tick={pad(i + 1)}></i>)}
      </div>
      <button type="button" class="specs__carousel-nav specs__carousel-nav--close" data-carousel-close aria-label={lens.labels.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <button type="button" class="specs__carousel-nav specs__carousel-nav--prev" data-carousel-prev aria-label={lens.labels.prev}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="specs__carousel-nav specs__carousel-nav--next" data-carousel-next aria-label={lens.labels.next}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  )}
  <header class="section-intro">
    <p class="eyebrow">{specs.eyebrow}</p>
    <h2 id="specs-title">{specs.title}</h2>
    {specs.lead && field && (
      <p class="section-lead" data-copy-slot>
        <DetailLevels simple={specs.leadEli10 ?? specs.lead} standard={specs.lead} technical={specs.leadHow ?? specs.lead} />
      </p>
    )}
    {specs.lead && !field && (
      <p class="section-lead">
        <span class="specs__variant specs__variant--tech">{specs.lead}</span>
        {specs.leadEli10 && (
          <span class="specs__variant specs__variant--plain">{specs.leadEli10}</span>
        )}
      </p>
    )}
  </header>

  {!field && (
    <div class="specs__controls">
      <button type="button" class="specs__control" data-specs-eli10 aria-pressed="false">
        {labels.eli10}
      </button>
      <button
        type="button"
        class="specs__control"
        data-specs-flip-all
        data-label-flip={labels.flipAll}
        data-label-unflip={labels.unflipAll}
        aria-pressed="false"
      >
        {labels.flipAll}
      </button>
      <button
        type="button"
        class="specs__control specs__control--shuffle"
        data-specs-shuffle
        aria-label={labels.shuffle}
      >
        ⤨
      </button>
    </div>
  )}

  <ul class="specs__grid">
    {specs.items.map((item, index) => field ? (
      <li class:list={["specs__tile", `specs__tile--${item.group}`]} data-spec={pad(index + 1)}>
        <button type="button" class="specs__face specs__face--front specs__open" aria-haspopup="dialog">
          <span class="specs__catalogue" aria-hidden="true">
            <span>{groupLabels?.[item.group]}</span>
            <span>{pad(index + 1)}</span>
          </span>
          <span class="specs__icon" aria-hidden="true">
            <ContextIcon name={item.icon} size={34} strokeWidth={1.75} />
          </span>
          <span class="specs__label">{item.label}</span>
        </button>
      </li>
    ) : (
      <li class:list={["specs__tile", `specs__tile--${item.group}`]}>
        <div class="specs__flip" role="button" tabindex="0" aria-pressed="false">
          <span class="specs__face specs__face--front">
            {catalogue && (
              <span class="specs__catalogue" aria-hidden="true">
                <span>{groupLabels[item.group]}</span>
                <span>{String(index + 1).padStart(2, "0")}</span>
              </span>
            )}
            <span class="specs__icon" aria-hidden="true">
              <ContextIcon name={item.icon} size={34} strokeWidth={1.75} />
            </span>
            <span class="specs__label">{item.label}</span>
          </span>
          <span class="specs__face specs__face--back">
            <span class="specs__back-label">{item.label}</span>
            <span class="specs__note">
              <span class="specs__variant specs__variant--tech">
                {segmentNote(item.note).map((seg) =>
                  seg.termId ? (
                    <span class="specs__term" data-def={defById[seg.termId]}>{seg.text}</span>
                  ) : (
                    seg.text
                  ),
                )}
              </span>
              <span class="specs__variant specs__variant--plain">
                {segmentNote(item.noteEli10).map((seg) =>
                  seg.termId ? (
                    <span class="specs__term" data-def={defById[seg.termId]}>{seg.text}</span>
                  ) : (
                    seg.text
                  ),
                )}
              </span>
            </span>
            <span class="specs__pin" aria-hidden="true">
              <ContextIcon name={item.icon} size={13} strokeWidth={2} />
            </span>
          </span>
        </div>
      </li>
    ))}
  </ul>

  {!field && specGlossary.length > 0 && (
    <div class="specs__foot" aria-live="polite">
      <p class="specs__live" data-specs-live>
        <mark class="specs__live-term" data-gloss-live-term></mark>
        <span class="specs__live-body" data-gloss-live-body></span>
      </p>
    </div>
  )}
  {!field && <script is:inline src={`/scripts/specs-pin.js?v=${scriptVersion}`} defer></script>}
</section>
