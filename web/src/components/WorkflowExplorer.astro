---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { StepItem } from "../content/types";
import ContextIcon from "./ContextIcon.astro";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead: string;
  steps: StepItem[];
  image: ImageMetadata;
  alt: string;
  closing?: string;
  tone?: "light" | "ink";
}

const {
  id,
  eyebrow,
  title,
  lead,
  steps,
  image,
  alt,
  closing,
  tone = "ink",
} = Astro.props;
---

<section
  class:list={["workflow", `workflow--${tone}`]}
  id={id}
  aria-labelledby={`${id}-title`}
  data-workflow-explorer
  data-active-stage="0"
  style={`--workflow-count: ${steps.length}; --workflow-ratio: 0;`}
>
  <div class="workflow__shell page-shell">
    <header class="workflow__intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="section-lead">{lead}</p>
    </header>

    <div class="workflow__experience">
      <figure class="workflow__visual">
        <Image
          src={image}
          alt={alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 64rem) 48vw, 100vw"
          formats={["avif", "webp", "png"]}
          quality={84}
          loading="lazy"
        />
        <span class="workflow__glass" aria-hidden="true"></span>
        <span class="workflow__signal workflow__signal--one" aria-hidden="true"></span>
        <span class="workflow__signal workflow__signal--two" aria-hidden="true"></span>
        <figcaption>Explore the operating sequence. Each stage shows what it contributes.</figcaption>
      </figure>

      <div class="workflow__control">
        <div class="workflow__tabs" role="tablist" aria-label={`${title} stages`}>
          {steps.map((step, index) => (
            <button
              class="workflow__tab"
              type="button"
              role="tab"
              id={`${id}-tab-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`${id}-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
              data-workflow-tab={index}
            >
              <span class="workflow__tab-icon" aria-hidden="true">
                <ContextIcon name={step.icon} size={21} strokeWidth={2.1} />
              </span>
              <span>{step.title}</span>
            </button>
          ))}
        </div>

        <div class="workflow__progress" aria-hidden="true">
          <span class="workflow__progress-fill"></span>
          {steps.map((_, index) => <i style={`--marker-index: ${index}`}></i>)}
        </div>

        <button
          class="workflow__toggle"
          type="button"
          aria-pressed="false"
          data-workflow-toggle
        >
          <span class="workflow__toggle-state" aria-hidden="true"></span>
          <span data-workflow-toggle-label>Pause sequence</span>
        </button>

        <div class="workflow__panels">
          {steps.map((step, index) => (
            <div
              class="workflow__panel"
              id={`${id}-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`${id}-tab-${index}`}
              hidden={index !== 0}
              data-workflow-panel={index}
            >
              <p class="workflow__step">Stage {step.number}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.signal && (
                <p class="workflow__evidence">
                  <span aria-hidden="true"></span>
                  <strong>Result</strong>
                  {step.signal}
                </p>
              )}
              {step.reference && (
                <a
                  class="workflow__reference"
                  href={step.reference.href}
                  target={step.reference.external === false ? undefined : "_blank"}
                  rel={step.reference.external === false ? undefined : "noreferrer"}
                >
                  {step.reference.label} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    {closing && <p class="workflow__closing">{closing}</p>}
  </div>
</section>

<script>
  const initWorkflowExplorers = () => {
    document.querySelectorAll<HTMLElement>("[data-workflow-explorer]").forEach((root) => {
      if (root.dataset.workflowReady === "true") return;
      root.dataset.workflowReady = "true";

      const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-workflow-tab]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-workflow-panel]")];
      const tabStrip = root.querySelector<HTMLElement>(".workflow__tabs");
      const toggle = root.querySelector<HTMLButtonElement>("[data-workflow-toggle]");
      const toggleLabel = toggle?.querySelector<HTMLElement>("[data-workflow-toggle-label]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let activeIndex = 0;
      let inView = false;
      let interactionPaused = false;
      let userPaused = false;
      let timer: number | undefined;

      const stop = () => {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
      };

      const updateToggle = () => {
        if (!toggle || !toggleLabel) return;
        const motionPaused = reducedMotion.matches;
        toggle.disabled = motionPaused;
        toggle.setAttribute("aria-pressed", String(motionPaused || userPaused));
        toggleLabel.textContent = motionPaused
          ? "Sequence paused"
          : userPaused
            ? "Play sequence"
            : "Pause sequence";
      };

      const centerActiveTab = () => {
        const tab = tabs[activeIndex];
        if (!tabStrip || !tab || tabStrip.scrollWidth <= tabStrip.clientWidth + 1) return;
        const stripRect = tabStrip.getBoundingClientRect();
        const tabRect = tab.getBoundingClientRect();
        const left =
          tabStrip.scrollLeft +
          tabRect.left -
          stripRect.left -
          (tabStrip.clientWidth - tabRect.width) / 2;
        tabStrip.scrollTo({
          left: Math.max(0, left),
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
      };

      const activate = (index: number, moveFocus = false, manual = false) => {
        activeIndex = (index + tabs.length) % tabs.length;
        if (manual) {
          userPaused = true;
          updateToggle();
        }
        root.dataset.activeStage = String(activeIndex);
        root.style.setProperty(
          "--workflow-ratio",
          String(tabs.length > 1 ? activeIndex / (tabs.length - 1) : 1),
        );

        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === activeIndex;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && moveFocus) tab.focus();
        });
        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== activeIndex;
        });
        centerActiveTab();
      };

      const start = () => {
        stop();
        if (
          !inView ||
          interactionPaused ||
          userPaused ||
          reducedMotion.matches ||
          tabs.length < 2
        ) return;
        timer = window.setInterval(() => activate(activeIndex + 1), 4600);
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          activate(index, false, true);
          start();
        });
        tab.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            event.preventDefault();
            activate(activeIndex + 1, true, true);
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            event.preventDefault();
            activate(activeIndex - 1, true, true);
          } else if (event.key === "Home") {
            event.preventDefault();
            activate(0, true, true);
          } else if (event.key === "End") {
            event.preventDefault();
            activate(tabs.length - 1, true, true);
          }
        });
      });

      toggle?.addEventListener("click", () => {
        userPaused = !userPaused;
        updateToggle();
        if (userPaused) stop();
        else {
          interactionPaused = false;
          start();
        }
      });

      root.addEventListener("pointerenter", () => {
        interactionPaused = true;
        stop();
      });
      root.addEventListener("pointerleave", () => {
        interactionPaused = false;
        start();
      });
      root.addEventListener("focusin", () => {
        interactionPaused = true;
        stop();
      });
      root.addEventListener("focusout", (event) => {
        if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
        interactionPaused = false;
        start();
      });

      const observer = new IntersectionObserver(
        ([entry]) => {
          inView = entry?.isIntersecting === true && entry.intersectionRatio >= 0.28;
          start();
        },
        { threshold: [0, 0.28, 0.65] },
      );
      observer.observe(root);
      reducedMotion.addEventListener("change", () => {
        updateToggle();
        start();
      });
      updateToggle();
      activate(0);
    });
  };

  initWorkflowExplorers();
  document.addEventListener("astro:page-load", initWorkflowExplorers);
</script>

<style>
  .workflow {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-space);
    overflow: clip;
  }

  .workflow--ink {
    color: var(--night-text);
    background:
      radial-gradient(circle at 13% 20%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 26rem),
      radial-gradient(circle at 92% 78%, color-mix(in srgb, var(--secondary) 16%, transparent), transparent 24rem),
      var(--night);
  }

  .workflow--light {
    background: color-mix(in srgb, var(--accent-soft) 32%, var(--paper));
  }

  .workflow__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(18rem, 0.95fr);
    gap: 1.5rem clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.8rem);
  }

  .workflow__intro .eyebrow {
    grid-column: 1 / -1;
  }

  .workflow--ink :is(h2, h3),
  .workflow--ink .workflow__step,
  .workflow--ink .workflow__reference {
    color: var(--night-text);
  }

  .workflow--ink :is(.section-lead, .workflow__panel > p) {
    color: var(--night-soft);
  }

  .workflow__experience {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
    min-width: 0;
  }

  .workflow__visual,
  .workflow__control {
    min-width: 0;
    border-radius: var(--radius-lg);
  }

  .workflow__visual {
    position: relative;
    aspect-ratio: 3 / 2;
    align-self: center;
    overflow: hidden;
    background: var(--surface-solid);
    box-shadow: var(--shadow-deep);
  }

  .workflow__visual::after {
    position: absolute;
    inset: auto 7% 6% 7%;
    height: 18%;
    content: "";
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    filter: blur(34px);
    opacity: 0.62;
    transform: translate3d(calc((var(--workflow-ratio) - 0.5) * 20%), 0, 0);
    transition: transform 700ms var(--ease), opacity 400ms ease;
  }

  .workflow__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease), filter 700ms ease;
    transform: scale(1.015) translate3d(calc((0.5 - var(--workflow-ratio)) * 1.5%), 0, 0);
  }

  .workflow__glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 0.34), transparent 28%),
      linear-gradient(to top, rgb(4 25 39 / 0.18), transparent 42%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.42);
  }

  .workflow__signal {
    position: absolute;
    z-index: 2;
    width: 0.72rem;
    height: 0.72rem;
    border: 2px solid white;
    border-radius: 50%;
    background: var(--secondary);
    box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--secondary) 24%, transparent);
    transform: scale(calc(0.8 + var(--workflow-ratio) * 0.35));
    transition: transform 500ms var(--ease), opacity 350ms ease;
  }

  .workflow__signal--one {
    top: 23%;
    left: 19%;
  }

  .workflow__signal--two {
    right: 19%;
    bottom: 24%;
    background: var(--accent);
    box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--accent) 25%, transparent);
    transform: scale(calc(1.15 - var(--workflow-ratio) * 0.25));
  }

  .workflow__visual figcaption {
    position: absolute;
    z-index: 3;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    padding: 0.65rem 0.85rem;
    color: rgb(255 255 255 / 0.88);
    background: rgb(5 31 47 / 0.58);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.045em;
    line-height: 1.4;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .workflow__control {
    display: flex;
    flex-direction: column;
    min-height: clamp(28rem, 42vw, 36rem);
    padding: clamp(1rem, 2.2vw, 1.7rem);
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.075);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .workflow--light .workflow__control {
    border-color: var(--line);
    background: rgb(255 255 255 / 0.68);
    box-shadow: var(--shadow-sm);
  }

  .workflow__tabs {
    display: grid;
    grid-template-columns: repeat(var(--workflow-count), minmax(0, 1fr));
    gap: 0.45rem;
  }

  .workflow__tab {
    display: grid;
    place-items: center;
    gap: 0.45rem;
    min-width: 0;
    min-height: 5.7rem;
    padding: 0.7rem 0.35rem;
    color: #dce7eb;
    border: 1px solid transparent;
    border-radius: 0.85rem;
    background: rgb(5 27 43 / 0.38);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: clamp(0.63rem, 0.2vw + 0.58rem, 0.75rem);
    letter-spacing: 0.035em;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .workflow--light .workflow__tab {
    color: var(--ink-soft);
    background: transparent;
  }

  .workflow__tab:hover {
    transform: translateY(-2px);
  }

  .workflow__tab[aria-selected="true"] {
    color: var(--night-text);
    border-color: color-mix(in srgb, var(--accent) 58%, transparent);
    background: color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .workflow--light .workflow__tab[aria-selected="true"] {
    color: var(--ink);
    background: var(--accent-soft);
  }

  .workflow__tab-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--secondary);
    border-radius: 50%;
    background: color-mix(in srgb, var(--secondary) 13%, transparent);
  }

  .workflow__progress {
    position: relative;
    height: 1.4rem;
    margin: 1rem 0 1.3rem;
  }

  .workflow__progress::before,
  .workflow__progress-fill {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    content: "";
    background: rgb(255 255 255 / 0.16);
  }

  .workflow--light .workflow__progress::before {
    background: var(--line);
  }

  .workflow__progress-fill {
    background: linear-gradient(90deg, var(--accent), var(--secondary));
    transform: scaleX(var(--workflow-ratio));
    transform-origin: left center;
    transition: transform 600ms var(--ease);
  }

  .workflow__progress i {
    position: absolute;
    top: 50%;
    left: calc(var(--marker-index) * 100% / (var(--workflow-count) - 1));
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--night-soft) 60%, var(--night));
    transform: translate(-50%, -50%);
  }

  .workflow__toggle {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    align-self: flex-end;
    min-height: 2.5rem;
    margin: -0.55rem 0 1.1rem;
    padding: 0.45rem 0.75rem;
    color: var(--night-soft);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(1 18 30 / 0.24);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .workflow--light .workflow__toggle {
    color: var(--ink);
    border-color: var(--line);
    background: rgb(255 255 255 / 0.7);
  }

  .workflow__toggle-state {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 0.16rem;
    background: var(--secondary);
  }

  .workflow__toggle[aria-pressed="true"] .workflow__toggle-state {
    border-radius: 50%;
    background: var(--accent);
  }

  .workflow__toggle:disabled {
    cursor: default;
    opacity: 0.72;
  }

  .workflow__panels {
    display: grid;
    flex: 1;
  }

  .workflow__panel {
    align-self: start;
    animation: workflow-panel-in 520ms var(--ease) both;
  }

  .workflow__panel[hidden] {
    display: none;
  }

  .workflow__step {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .workflow__panel h3 {
    margin-top: 0.85rem;
    font-size: clamp(2.2rem, 3.6vw, 4rem);
  }

  .workflow__panel > p:not(.workflow__step, .workflow__evidence) {
    max-width: 36rem;
    margin-top: 1rem;
  }

  .workflow__evidence {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.55rem;
    padding: 0.85rem 1rem;
    color: var(--night-text);
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 0.85rem;
    background: rgb(1 18 30 / 0.25);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .workflow--light .workflow__evidence {
    color: var(--ink);
    border-color: var(--line);
    background: var(--paper-cool);
  }

  .workflow__evidence > span {
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .workflow__evidence strong {
    color: var(--night-text);
    font-weight: 700;
    text-transform: uppercase;
  }

  .workflow__reference {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: 1.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .workflow__reference:hover {
    color: currentColor;
    text-decoration: underline;
    text-decoration-color: var(--secondary);
    text-underline-offset: 0.2em;
  }

  .workflow--light .workflow__evidence strong {
    color: var(--ink);
  }

  .workflow__closing {
    max-width: 60rem;
    margin: 2rem auto 0;
    color: var(--night-soft);
    text-align: center;
  }

  .workflow--light .workflow__closing {
    color: var(--ink-soft);
  }

  @keyframes workflow-panel-in {
    from {
      opacity: 0;
      transform: translateY(0.65rem);
    }
  }

  @media (max-width: 68rem) {
    .workflow__intro,
    .workflow__experience {
      grid-template-columns: 1fr;
    }

    .workflow__control {
      min-height: 31rem;
    }
  }

  @media (max-width: 42rem) {
    .workflow__tabs {
      grid-template-columns: repeat(var(--workflow-count), minmax(5.4rem, 1fr));
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .workflow__tab {
      min-height: 5rem;
    }

    .workflow__control {
      min-height: 29rem;
    }

    .workflow__evidence {
      grid-template-columns: auto 1fr;
    }

    .workflow__evidence strong {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow__visual::after,
    .workflow__visual img,
    .workflow__signal,
    .workflow__progress-fill,
    .workflow__panel,
    .workflow__tab {
      animation: none;
      transition: none;
    }
  }
</style>
