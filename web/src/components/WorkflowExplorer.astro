---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { StepItem } from "../content/types";
import ContextIcon from "./ContextIcon.astro";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead: string;
  steps: StepItem[];
  image: ImageMetadata;
  alt: string;
  closing?: string;
  tone?: "light" | "ink";
  pattern?: string;
  locale?: "en" | "de";
}

const {
  id,
  eyebrow,
  title,
  lead,
  steps,
  image,
  alt,
  closing,
  tone = "ink",
  pattern = "guided-workflow",
  locale = "en",
} = Astro.props;

const labels = locale === "de"
  ? {
      caption: "Folgen Sie der aktiven Markierung. Jede Etappe verweist auf einen Punkt im System.",
      stages: "Etappen",
      pause: "Pausieren",
      resume: "Fortsetzen",
      pauseLabel: "Automatischen Ablauf pausieren",
      resumeLabel: "Automatischen Ablauf fortsetzen",
      stage: "Etappe",
      result: "Ergebnis",
    }
  : {
      caption: "Follow the active marker. Each stage maps to a point in the system.",
      stages: "stages",
      pause: "Pause",
      resume: "Resume",
      pauseLabel: "Pause automatic progression",
      resumeLabel: "Resume automatic progression",
      stage: "Stage",
      result: "Result",
    };
---

<section
  class:list={["workflow", `workflow--${tone}`]}
  id={id}
  aria-labelledby={`${id}-title`}
  data-workflow-explorer
  data-section-pattern={pattern}
  data-active-stage="0"
  data-pause-label={labels.pause}
  data-resume-label={labels.resume}
  data-pause-accessible-label={labels.pauseLabel}
  data-resume-accessible-label={labels.resumeLabel}
  style={`--workflow-count: ${steps.length}; --workflow-ratio: 0;`}
>
  <div class="workflow__shell page-shell">
    <header class="workflow__intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="section-lead">{lead}</p>
    </header>

    <div class="workflow__experience">
      <figure class="workflow__visual">
        <Image
          src={image}
          alt={alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 64rem) 48vw, 100vw"
          quality={84}
          loading="lazy"
        />
        <span class="workflow__glass" aria-hidden="true"></span>
        <div class="workflow__annotations" aria-hidden="true">
          {steps.map((step, index) => (
            <span
              class="workflow__annotation"
              data-workflow-annotation={index}
              data-active={index === 0 ? "true" : "false"}
              data-low={(step.visual?.y ?? 52) > 57 ? "true" : "false"}
              style={`--annotation-x: ${step.visual?.x ?? 18 + (index * 64) / Math.max(steps.length - 1, 1)}%; --annotation-y: ${step.visual?.y ?? 52}%;`}
            >
              <span class="workflow__annotation-node">{step.number}</span>
              <span class="workflow__annotation-label">{step.title}</span>
            </span>
          ))}
        </div>
        <figcaption>{labels.caption}</figcaption>
      </figure>

      <div class="workflow__control">
        <div class="workflow__tabs" role="tablist" aria-label={`${title} ${labels.stages}`}>
          {steps.map((step, index) => (
            <button
              class="workflow__tab"
              type="button"
              role="tab"
              id={`${id}-tab-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`${id}-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
              data-workflow-tab={index}
            >
              <span class="workflow__tab-icon" aria-hidden="true">
                <ContextIcon name={step.icon} size={21} strokeWidth={2.1} />
              </span>
              <span>{step.title}</span>
            </button>
          ))}
        </div>

        <div class="workflow__timeline">
          <div class="workflow__progress" aria-hidden="true">
            <span class="workflow__progress-fill" data-workflow-progress></span>
          </div>

          <button
            class="workflow__toggle"
            type="button"
            aria-label={labels.pauseLabel}
            aria-pressed="false"
            title={labels.pauseLabel}
            data-workflow-toggle
          >
            <span class="workflow__toggle-state" aria-hidden="true"><i></i><i></i></span>
            <span data-workflow-toggle-label>{labels.pause}</span>
          </button>
        </div>

        <div class="workflow__panels">
          {steps.map((step, index) => (
            <div
              class="workflow__panel"
              id={`${id}-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`${id}-tab-${index}`}
              hidden={index !== 0}
              data-workflow-panel={index}
            >
              <p class="workflow__step">{labels.stage} {step.number}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.signal && (
                <p class="workflow__evidence">
                  <span aria-hidden="true"></span>
                  <strong>{labels.result}</strong>
                  {step.signal}
                </p>
              )}
              {step.reference && (
                <a
                  class="workflow__reference"
                  href={step.reference.href}
                  target={step.reference.external === false ? undefined : "_blank"}
                  rel={step.reference.external === false ? undefined : "noopener noreferrer"}
                >
                  {step.reference.label} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    {closing && <p class="workflow__closing">{closing}</p>}
  </div>
</section>

<script>
  const WORKFLOW_STAGE_DURATION = 5000;

  const initWorkflowExplorers = () => {
    document.querySelectorAll<HTMLElement>("[data-workflow-explorer]").forEach((root) => {
      if (root.dataset.workflowReady === "true") return;
      root.dataset.workflowReady = "true";

      const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-workflow-tab]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-workflow-panel]")];
      const annotations = [
        ...root.querySelectorAll<HTMLElement>("[data-workflow-annotation]"),
      ];
      const tabStrip = root.querySelector<HTMLElement>(".workflow__tabs");
      const toggle = root.querySelector<HTMLButtonElement>("[data-workflow-toggle]");
      const toggleLabel = root.querySelector<HTMLElement>("[data-workflow-toggle-label]");
      const progress = root.querySelector<HTMLElement>("[data-workflow-progress]");
      const experience = root.querySelector<HTMLElement>(".workflow__experience") ?? root;
      const observedControl = root.querySelector<HTMLElement>(".workflow__control") ?? root;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const hoverCapable = window.matchMedia("(hover: hover)");
      const listeners = new AbortController();
      let activeIndex = -1;
      let inView = false;
      let userPaused = false;
      let hoverHeld = false;
      let focusHeld = false;
      let progressAnimation: Animation | undefined;

      const stopCycle = () => {
        progressAnimation?.cancel();
        progressAnimation = undefined;
        root.dataset.cycleState = "idle";
      };

      const updateToggle = () => {
        if (!toggle) return;
        const action = userPaused
          ? root.dataset.resumeLabel ?? "Resume"
          : root.dataset.pauseLabel ?? "Pause";
        const accessibleLabel = userPaused
          ? root.dataset.resumeAccessibleLabel ?? "Resume automatic progression"
          : root.dataset.pauseAccessibleLabel ?? "Pause automatic progression";
        toggle.disabled = reducedMotion.matches;
        toggle.setAttribute("aria-pressed", String(userPaused));
        toggle.setAttribute("aria-label", accessibleLabel);
        toggle.title = accessibleLabel;
        if (toggleLabel) toggleLabel.textContent = action;
        root.dataset.userPaused = String(userPaused);
      };

      const centerActiveTab = () => {
        const tab = tabs[activeIndex];
        if (!tabStrip || !tab || tabStrip.scrollWidth <= tabStrip.clientWidth + 1) return;
        const stripRect = tabStrip.getBoundingClientRect();
        const tabRect = tab.getBoundingClientRect();
        const left =
          tabStrip.scrollLeft +
          tabRect.left -
          stripRect.left -
          (tabStrip.clientWidth - tabRect.width) / 2;
        tabStrip.scrollTo({
          left: Math.max(0, left),
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
      };

      const interactionHeld = () => hoverHeld || focusHeld;

      const refreshInteractionState = () => {
        hoverHeld = hoverCapable.matches && experience.matches(":hover");
        focusHeld = experience.querySelector(":focus-visible") !== null;
      };

      const runCycle = () => {
        stopCycle();
        if (!progress || !inView || reducedMotion.matches || tabs.length < 2) return;

        const animation = progress.animate(
          [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
          {
            duration: WORKFLOW_STAGE_DURATION,
            easing: "linear",
            fill: "both",
          },
        );
        progressAnimation = animation;

        if (userPaused || interactionHeld()) {
          animation.pause();
          root.dataset.cycleState = "paused";
        } else {
          root.dataset.cycleState = "running";
        }

        animation.finished
          .then(() => {
            if (progressAnimation !== animation) return;
            animation.cancel();
            progressAnimation = undefined;
            if (!inView || userPaused || interactionHeld() || reducedMotion.matches) return;
            activate(activeIndex + 1);
          })
          .catch(() => undefined);
      };

      const syncCycle = () => {
        if (!inView || reducedMotion.matches || tabs.length < 2) {
          stopCycle();
          return;
        }
        if (!progressAnimation) {
          runCycle();
          return;
        }
        if (userPaused || interactionHeld()) {
          progressAnimation.pause();
          root.dataset.cycleState = "paused";
        } else {
          progressAnimation.play();
          root.dataset.cycleState = "running";
        }
      };

      const activate = (index: number, moveFocus = false) => {
        if (tabs.length === 0) return;
        const nextIndex = ((index % tabs.length) + tabs.length) % tabs.length;
        const stageChanged = nextIndex !== activeIndex;

        if (stageChanged) {
          activeIndex = nextIndex;
          root.dataset.activeStage = String(activeIndex);
          root.style.setProperty(
            "--workflow-ratio",
            String(tabs.length > 1 ? activeIndex / (tabs.length - 1) : 1),
          );

          tabs.forEach((tab, tabIndex) => {
            const active = tabIndex === activeIndex;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
          });
          panels.forEach((panel, panelIndex) => {
            panel.hidden = panelIndex !== activeIndex;
          });
          annotations.forEach((annotation, annotationIndex) => {
            annotation.dataset.active = String(annotationIndex === activeIndex);
          });
          centerActiveTab();
          runCycle();
        }

        if (moveFocus) tabs[nextIndex]?.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          activate(index);
        }, { signal: listeners.signal });
        tab.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "touch") return;
          activate(index);
        }, { signal: listeners.signal });
        tab.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            event.preventDefault();
            activate(activeIndex + 1, true);
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            event.preventDefault();
            activate(activeIndex - 1, true);
          } else if (event.key === "Home") {
            event.preventDefault();
            activate(0, true);
          } else if (event.key === "End") {
            event.preventDefault();
            activate(tabs.length - 1, true);
          }
        }, { signal: listeners.signal });
      });

      experience.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "touch") return;
        hoverHeld = true;
        syncCycle();
      }, { signal: listeners.signal });
      experience.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "touch") return;
        hoverHeld = false;
        syncCycle();
      }, { signal: listeners.signal });

      const syncFocusHold = () => {
        queueMicrotask(() => {
          if (listeners.signal.aborted) return;
          focusHeld = experience.querySelector(":focus-visible") !== null;
          syncCycle();
        });
      };
      experience.addEventListener("focusin", syncFocusHold, { signal: listeners.signal });
      experience.addEventListener("focusout", syncFocusHold, { signal: listeners.signal });

      toggle?.addEventListener("click", () => {
        userPaused = !userPaused;
        updateToggle();
        syncCycle();
      }, { signal: listeners.signal });

      const observer = new IntersectionObserver(
        ([entry]) => {
          const nextInView = entry?.isIntersecting === true && entry.intersectionRatio >= 0.18;
          if (nextInView === inView) return;
          inView = nextInView;
          if (!inView) {
            userPaused = false;
            updateToggle();
            stopCycle();
            return;
          }
          refreshInteractionState();
          runCycle();
        },
        { threshold: [0, 0.18, 0.55] },
      );
      observer.observe(observedControl);
      reducedMotion.addEventListener("change", () => {
        updateToggle();
        if (reducedMotion.matches) stopCycle();
        else {
          refreshInteractionState();
          runCycle();
        }
      }, { signal: listeners.signal });

      const cleanup = () => {
        stopCycle();
        observer.disconnect();
        listeners.abort();
        delete root.dataset.workflowReady;
      };
      document.addEventListener("astro:before-swap", cleanup, {
        once: true,
        signal: listeners.signal,
      });
      updateToggle();
      activate(0);
    });
  };

  initWorkflowExplorers();
  document.addEventListener("astro:page-load", initWorkflowExplorers);
</script>

<style>
  .workflow {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-space);
    overflow: clip;
  }

  .workflow--ink {
    color: var(--night-text);
    background:
      radial-gradient(circle at 13% 20%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 26rem),
      radial-gradient(circle at 92% 78%, color-mix(in srgb, var(--secondary) 16%, transparent), transparent 24rem),
      var(--night);
  }

  .workflow--light {
    background: color-mix(in srgb, var(--accent-soft) 32%, var(--paper));
  }

  .workflow__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(18rem, 0.95fr);
    gap: 1.5rem clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.8rem);
  }

  .workflow__intro .eyebrow {
    grid-column: 1 / -1;
  }

  .workflow--ink :is(h2, h3),
  .workflow--ink .workflow__step,
  .workflow--ink .workflow__reference {
    color: var(--night-text);
  }

  .workflow--ink :is(.section-lead, .workflow__panel > p) {
    color: var(--night-soft);
  }

  .workflow__experience {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    min-width: 0;
  }

  .workflow__visual,
  .workflow__control {
    min-width: 0;
    border-radius: var(--radius-lg);
  }

  .workflow__visual {
    position: relative;
    aspect-ratio: 3 / 2;
    align-self: start;
    overflow: hidden;
    background: var(--surface-solid);
    box-shadow: var(--shadow-deep);
  }

  .workflow__visual::after {
    position: absolute;
    inset: auto 7% 6% 7%;
    height: 18%;
    content: "";
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    filter: blur(34px);
    opacity: 0.62;
    transform: translate3d(calc((var(--workflow-ratio) - 0.5) * 20%), 0, 0);
    transition: transform 700ms var(--ease), opacity 400ms ease;
  }

  .workflow__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease), filter 700ms ease;
    transform: scale(1.015) translate3d(calc((0.5 - var(--workflow-ratio)) * 1.5%), 0, 0);
  }

  .workflow__glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 0.34), transparent 28%),
      linear-gradient(to top, rgb(4 25 39 / 0.18), transparent 42%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.42);
  }

  .workflow__annotations {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .workflow__annotation {
    position: absolute;
    top: var(--annotation-y);
    left: var(--annotation-x);
    display: grid;
    place-items: center;
    opacity: 0.34;
    transform: translate(-50%, -50%) scale(0.78);
    transition: opacity 240ms ease, transform 380ms var(--ease);
  }

  .workflow__annotation[data-active="true"] {
    z-index: 2;
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .workflow__annotation-node {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    color: white;
    border: 2px solid rgb(255 255 255 / 0.95);
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 86%, #05283d);
    box-shadow:
      0 0 0 0.42rem color-mix(in srgb, var(--accent) 18%, transparent),
      0 0.4rem 1rem rgb(2 24 38 / 0.2);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
  }

  .workflow__annotation[data-active="true"] .workflow__annotation-node {
    color: white;
    background: color-mix(in srgb, var(--night) 88%, var(--accent));
    box-shadow:
      0 0 0 0.52rem color-mix(in srgb, var(--secondary) 24%, transparent),
      0 0 0 0.78rem rgb(255 255 255 / 0.16),
      0 0.6rem 1.4rem rgb(2 24 38 / 0.26);
    animation: workflow-marker-breathe 2.4s ease-in-out infinite;
  }

  .workflow__annotation-label {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 50%;
    min-width: max-content;
    max-width: 10rem;
    padding: 0.38rem 0.58rem;
    color: rgb(255 255 255 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background: rgb(5 31 47 / 0.72);
    box-shadow: 0 0.5rem 1.2rem rgb(2 24 38 / 0.14);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    line-height: 1.2;
    opacity: 0;
    transform: translate(-50%, -0.3rem);
    transition: opacity 220ms ease, transform 320ms var(--ease);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .workflow__annotation[data-low="true"] .workflow__annotation-label {
    top: auto;
    bottom: calc(100% + 0.65rem);
    transform: translate(-50%, 0.3rem);
  }

  .workflow__annotation[data-active="true"] .workflow__annotation-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .workflow__visual figcaption {
    position: absolute;
    z-index: 3;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    padding: 0.65rem 0.85rem;
    color: rgb(255 255 255 / 0.88);
    background: rgb(5 31 47 / 0.58);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.045em;
    line-height: 1.4;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .workflow__control {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: clamp(1rem, 2.2vw, 1.7rem);
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.075);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .workflow--light .workflow__control {
    border-color: var(--line);
    background: rgb(255 255 255 / 0.68);
    box-shadow: var(--shadow-sm);
  }

  .workflow__tabs {
    display: grid;
    grid-template-columns: repeat(var(--workflow-count), minmax(0, 1fr));
    gap: 0.45rem;
  }

  .workflow__tab {
    display: grid;
    place-items: center;
    gap: 0.45rem;
    min-width: 0;
    min-height: 5.7rem;
    padding: 0.7rem 0.35rem;
    color: #dce7eb;
    border: 1px solid transparent;
    border-radius: 0.85rem;
    background: rgb(5 27 43 / 0.38);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: clamp(0.63rem, 0.2vw + 0.58rem, 0.75rem);
    letter-spacing: 0.035em;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .workflow--light .workflow__tab {
    color: var(--ink-soft);
    background: transparent;
  }

  .workflow__tab:hover {
    transform: translateY(-2px);
  }

  .workflow__tab[aria-selected="true"] {
    color: var(--night-text);
    border-color: color-mix(in srgb, var(--accent) 58%, transparent);
    background: color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .workflow--light .workflow__tab[aria-selected="true"] {
    color: var(--ink);
    background: var(--accent-soft);
  }

  .workflow__tab-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--secondary);
    border-radius: 50%;
    background: color-mix(in srgb, var(--secondary) 13%, transparent);
  }

  .workflow__timeline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    margin: 1rem 0 1.3rem;
  }

  .workflow__progress {
    position: relative;
    height: 1.4rem;
    margin-inline: 0;
  }

  .workflow__progress::before,
  .workflow__progress-fill {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 2px;
    content: "";
    background: rgb(255 255 255 / 0.16);
  }

  .workflow--light .workflow__progress::before {
    background: var(--line);
  }

  .workflow__progress-fill {
    background: linear-gradient(90deg, var(--accent), var(--secondary));
    box-shadow: 0 0 0.8rem color-mix(in srgb, var(--secondary) 24%, transparent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .workflow__toggle {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    min-height: 2.35rem;
    margin: 0;
    padding: 0.4rem 0.68rem;
    color: var(--night-soft);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    opacity: 0.68;
    transition: opacity 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .workflow:hover .workflow__toggle,
  .workflow:focus-within .workflow__toggle,
  .workflow__toggle[aria-pressed="true"] {
    opacity: 1;
  }

  .workflow--light .workflow__toggle {
    color: var(--ink);
    border-color: var(--line);
    background: transparent;
  }

  .workflow__toggle-state {
    display: inline-flex;
    gap: 0.18rem;
    align-items: center;
    justify-content: center;
    width: 0.7rem;
    height: 0.75rem;
  }

  .workflow__toggle-state i {
    display: block;
    width: 0.16rem;
