---
import { Image } from "astro:assets";
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/space-grotesk/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../../styles/eli10.css";

import { siteUrls } from "../../content/urls";
import insprHero from "../../assets/products/inspr/hero.png";
import insprLogo from "../../assets/products/inspr/logo.svg";
import aithemaLogo from "../../assets/products/aithema/logo.svg";
import paimosLogo from "../../assets/products/paimos/logo.svg";
import pharosLogo from "../../assets/products/pharos/mark.svg";
import janusLogo from "../../assets/products/janus/logo.svg";

const title = "INSPR — Inspiration is the only limit";
const description =
  "Tell us what you want. INSPR tools handle the difficult parts while you approve every handoff and keep your work.";
const canonical = `${siteUrls.inspr}/eli10/`;
const ogImage = new URL(insprHero.src, siteUrls.inspr).href;

const steps = [
  {
    number: "01",
    name: "Aithema",
    role: "Understand",
    logo: aithemaLogo,
    href: siteUrls.aithema,
    body: "You talk or add files. Aithema writes clear requirements — what should be made — and waits for you to press Continue.",
    handoff: "You approve the requirements.",
  },
  {
    number: "02",
    name: "Paimos",
    role: "Build",
    logo: paimosLogo,
    href: siteUrls.paimos,
    body: "Paimos gives coding agents a project and its instructions. They return a staged version you can try before it goes live.",
    handoff: "You approve the staged build.",
  },
  {
    number: "03",
    name: "Pharos",
    role: "Deliver",
    logo: pharosLogo,
    href: siteUrls.pharos,
    body: "With Pharos, you choose the server — the computer it will run on. Pharos proves there is a backup, then waits before production.",
    handoff: "You approve it going live.",
  },
  {
    number: "04",
    name: "Janus",
    role: "Protect",
    logo: janusLogo,
    href: siteUrls.janus,
    body: "Janus enforces the permits you approved — who may act, and when. It rotates access keys without ever revealing them.",
    handoff: "You approve the permit.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={insprLogo.src} />
    <meta name="theme-color" content="#f7f3eb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="The teal INSPR knot grows into a tree of connected ideas"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="eli-skip" href="#main-content">Skip to the idea</a>

    <header class="eli-header">
      <a class="eli-brand" href={siteUrls.inspr} aria-label="INSPR home">
        <img src={insprLogo.src} alt="" width="42" height="42" />
        <span>INSPR</span>
      </a>
      <a class="eli-header__link" href="#path">See the four steps <span aria-hidden="true">↓</span></a>
    </header>

    <main id="main-content">
      <section class="eli-hero" aria-labelledby="eli-title">
        <div class="eli-hero__copy">
          <p class="eli-kicker">One idea. Four tools. You stay in charge.</p>
          <h1 id="eli-title">Inspiration is<br />the only limit.</h1>
          <p class="eli-lede">
            Tell us what you want. The tools handle the difficult parts.
            You decide at every handoff, and the work remains yours.
          </p>
          <a class="eli-action" href="#path">Follow an idea <span aria-hidden="true">→</span></a>
        </div>

        <figure class="eli-hero__visual">
          <Image
            src={insprHero}
            alt="The teal INSPR knot growing into a tree of connected ideas"
            widths={[720, 960, 1280]}
            sizes="(max-width: 760px) 92vw, 48vw"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>People choose the direction. Tools carry the work.</figcaption>
        </figure>

        <ol class="eli-promise" aria-label="The INSPR promise">
          <li><strong>Tell us</strong><span>what you want</span></li>
          <li><strong>Tools handle</strong><span>the difficult parts</span></li>
          <li><strong>You decide</strong><span>at every handoff</span></li>
          <li><strong>You keep</strong><span>the work and its evidence</span></li>
        </ol>
      </section>

      <section class="eli-path" id="path" aria-labelledby="path-title">
        <div class="eli-path__intro">
          <p class="eli-kicker">From a thought to something that runs</p>
          <h2 id="path-title">One clear path. Four moments to say yes.</h2>
          <p>Each tool does one difficult job, shows you the result, and waits.</p>
        </div>

        <ol class="eli-steps">
          {steps.map((step) => (
            <li>
              <div class="eli-step__top">
                <span class="eli-step__number">{step.number}</span>
                <img src={step.logo.src} alt="" width="46" height="46" />
              </div>
              <p class="eli-step__role">{step.role}</p>
              <h3><a href={step.href}>{step.name}</a></h3>
              <p class="eli-step__body">{step.body}</p>
              <p class="eli-step__handoff"><span aria-hidden="true">✓</span> {step.handoff}</p>
            </li>
          ))}
        </ol>

        <div class="eli-ownership">
          <p>
            <strong>Your idea. Your source. Your data. Your servers.</strong>{" "}INSPR connects the steps without taking ownership away from you.
          </p>
          <div class="eli-ownership__links">
            <a href="https://github.com/inspr-at" target="_blank" rel="noopener noreferrer">Explore the source <span aria-hidden="true">↗</span></a>
            <a href={siteUrls.business} target="_blank" rel="noopener noreferrer">Augmentoring services <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="eli-footer">
      <p>© {new Date().getUTCFullYear()} <a href={siteUrls.author} rel="me">Markus Barta</a> · INSPR</p>
      <p>Aithema’s reusable open-source module is planned. Augmentoring provides professional services only.</p>
    </footer>
  </body>
</html>
