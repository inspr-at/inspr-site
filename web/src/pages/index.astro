---
import { Image } from "astro:assets";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import MicrositeHeader from "../components/MicrositeHeader.astro";
import MicrositeFooter from "../components/MicrositeFooter.astro";
import ServiceRibbon from "../components/ServiceRibbon.astro";
import WorkflowExplorer from "../components/WorkflowExplorer.astro";
import SituationPacket from "../components/SituationPacket.astro";
import PrincipleFieldNotes from "../components/PrincipleFieldNotes.astro";
import HeroLoop from "../components/HeroLoop.astro";
import { productTaxonomy, siteUrls } from "../content/urls";

import insprHero from "../assets/products/inspr/hero.png";
import insprHeroLoop from "../assets/products/inspr/hero-loop.mp4";
import insprLogo from "../assets/products/inspr/logo.svg";
import insprContinuity from "../assets/products/inspr/continuity.png";
import paimosHero from "../assets/products/paimos/hero.png";
import paimosLogo from "../assets/products/paimos/logo.svg";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosLogo from "../assets/products/pharos/mark.svg";
import janusHero from "../assets/products/janus/hero.png";
import janusLogo from "../assets/products/janus/logo.svg";
import aithemaHero from "../assets/products/aithema/hero.png";
import aithemaLogo from "../assets/products/aithema/logo.svg";
import zitadelLogo from "../assets/brands/zitadel-logo-solo-dark-icon.svg";

const isFableV2 = Astro.props.edition === "fable-v2";
const copy = (current: string, fable: string) => isFableV2 ? fable : current;

const repositoryUrl = "https://github.com/inspr-at/inspr-site";
const siteLicenseUrl = `${repositoryUrl}/blob/main/LICENSE`;
const umbrellaRepositoryUrl = "https://github.com/inspr-at/inspr";
const modulesUrl = "https://github.com/inspr-at/inspr-modules";
const canonicalUrl = siteUrls.inspr;
const ogImage = new URL(insprHero.src, canonicalUrl).href;

const nav = [
  { label: "Idea", href: "#idea" },
  { label: "Products", href: "#products" },
  { label: "Principles", href: "#principles" },
  { label: "Source", href: "#source" },
];

const products = [
  {
    name: "Aithema",
    label: productTaxonomy.aithema,
    href: siteUrls.aithema,
    logo: aithemaLogo,
    hero: aithemaHero,
    alt: "Open conversational threads becoming one structured and reviewable proposal",
    title: copy(
      "Turn conversation into approved requirements.",
      "Start by talking. Finish with requirements.",
    ),
    body: copy(
      "Speak, type or share files. Review the requirements, then decide whether to continue. The public preview is at start.augmentoring.com; the reusable module will follow as open source.",
      "Speak, type or add files; Aithema drafts the requirements. Read them and choose Continue when they say what you mean. The public preview runs at start.augmentoring.com, and a reusable open-source module is planned.",
    ),
    detail: copy(
      "Requirements · review · continue",
      "Conversation · requirements · Continue",
    ),
  },
  {
    name: "Paimos",
    label: productTaxonomy.paimos,
    href: siteUrls.paimos,
    logo: paimosLogo,
    hero: paimosHero,
    alt: "A shared project agora where people and agents work around the same project context",
    title: copy(
      "Turn requirements into a project agents can build.",
      "Give agents a project, not a prompt.",
    ),
    body: copy(
      "Keep the project, specs, repository context, decisions and run evidence together. Review the work before it reaches staging.",
      "Approved requirements become a project: specs, repository context, decisions and run evidence in one place. Agents build inside it; you review the staged result.",
    ),
    detail: copy(
      "Project · specs · agentic build · stage",
      "Specs · agent build · staged review",
    ),
  },
  {
    name: "Pharos",
    label: productTaxonomy.pharos,
    href: siteUrls.pharos,
    logo: pharosLogo,
    hero: pharosHero,
    alt: "A lighthouse overlooking a calm network of connected fleet nodes",
    title: copy(
      "Choose where it runs. Back up before you deploy.",
      "Pick the server. Prove the backup. Then deploy.",
    ),
    body: copy(
      "Select the server, verify backup evidence and approve the production deploy.",
      "You choose where it runs. Pharos verifies a backup before production, and the deploy itself happens only when you approve it.",
    ),
    detail: copy(
      "Target · backup · production deploy",
      "Server · verified backup · approved deploy",
    ),
  },
  {
    name: "Janus",
    label: productTaxonomy.janus,
    href: siteUrls.janus,
    logo: janusLogo,
    hero: janusHero,
    alt: "A transparent governance gateway mediating approved access between systems",
    title: copy(
      "Enforce who may act. Rotate access safely.",
      "Decide what may act. Keep secrets unseen.",
    ),
    body: copy(
      "Apply permits and policies without exposing secrets. Broader users, roles and ZITADEL integration come later.",
      "Janus enforces what may act under an approved permit and rotates access without exposing a secret. Broader permissions, users, roles and ZITADEL integration are planned for later.",
    ),
    detail: copy(
      "Permissions · enforcement · rotation",
      "Permits · rotation · no exposed secrets",
    ),
  },
];

const proofPoints = [
  {
    title: copy("Human approval", "Human review"),
    definition: copy(
      "You decide when work moves forward.",
      "Work advances only after you approve it.",
    ),
    href: "#flow",
  },
  {
    title: copy("Full ownership", "Yours to keep"),
    definition: copy(
      "Keep your source, data, infrastructure and evidence.",
      "Source, data, servers and evidence stay with you.",
    ),
    href: "#source",
  },
  {
    title: copy("Hard parts handled", "Difficult parts handled"),
    definition: copy(
      "The tools carry context, checks, backups and access.",
      "Context, checks, backups and access are the tools' job.",
    ),
    href: "#flow",
  },
  {
    title: "Open foundations",
    definition: copy(
      "Inspect, self-host and change the stack.",
      "Read the code, run it yourself, change it.",
    ),
    href: "#source",
  },
];

const principles = [
  {
    number: "01",
    title: copy("Context should travel", "Context travels with the work"),
    body: copy(
      "Keep requirements, specs, code, server state and operating rules with the work.",
      "Requirements, specs, code, server state and operating rules move together, so no one starts from a blank page.",
    ),
    avoids: copy(
      "Re-explaining the system and sending agents in blind.",
      "Re-explained systems and agents working blind.",
    ),
    protects: copy(
      "One current picture for people and agents.",
      "One current picture, shared by people and agents.",
    ),
  },
  {
    number: "02",
    title: copy("Approval should be explicit", "Approval is a visible act"),
    body: copy(
      "Requirements, builds, production deploys and permissions each need a visible decision.",
      "Requirements, builds, production deploys and permission changes each pass through a decision someone made on purpose.",
    ),
    avoids: copy(
      "Hidden escalation and accidental production authority.",
      "Quiet escalation and accidental production authority.",
    ),
    protects: copy(
      "A human decision at every handoff.",
      "A person at every handoff.",
    ),
  },
  {
    number: "03",
    title: copy("Changes should be recoverable", "A way back is part of the change"),
    body: copy(
      "Back up before production, record what ran and keep a tested way back.",
      "Back up before production, record what actually ran and keep a tested path to the previous state.",
    ),
    avoids: copy(
      "Blind deploys and recovery by memory.",
      "Deploys you cannot reverse and recovery from memory.",
    ),
    protects: copy(
      "Your systems, your evidence and a known rollback.",
      "Your systems and a known rollback.",
    ),
  },
];

const productFlowSteps = [
  {
    number: "01",
    title: "Aithema · Requirements",
    visual: { x: 18, y: 61 },
    body: copy(
      "Talk through the need, then review the requirements. Continue only when they match what you intend.",
      "Describe the need in conversation and files. Aithema drafts the requirements; read them and choose Continue when they are right.",
    ),
    icon: "mic",
    signal: copy(
      "You approve the requirements.",
      "The requirements wait for your Continue.",
    ),
    reference: {
      label: "Open Aithema",
      href: siteUrls.aithema,
      external: true,
    },
  },
  {
    number: "02",
    title: "Paimos · Build",
    visual: { x: 38, y: 51 },
    body: copy(
      "Create the project and specs. Agents build with the right context; you review what reaches staging.",
      "The approved requirements become a project with specs. Agents build with that context, and the result lands in staging for your review.",
    ),
    icon: "folder-kanban",
    signal: copy(
      "You approve the staged result.",
      "Staging waits for your review.",
    ),
    reference: {
      label: "Open Paimos",
      href: siteUrls.paimos,
      external: true,
    },
  },
  {
    number: "03",
    title: "Pharos · Deploy",
    visual: { x: 59, y: 55 },
    body: copy(
      "Select the server and verify a backup. Production waits for your approval.",
      "Select the target server. Pharos verifies a backup first; the production deploy then asks for your approval.",
    ),
    icon: "server-cog",
    signal: copy(
      "You approve the production deploy.",
      "Production waits for your approval.",
    ),
    reference: {
      label: "Open Pharos",
      href: siteUrls.pharos,
      external: true,
    },
  },
  {
    number: "04",
    title: "Janus · Enforce",
    visual: { x: 81, y: 58 },
    body: copy(
      "Enforce who or what may act, then rotate access without exposing secrets. Broader users, roles and ZITADEL integration come later.",
      "Enforce what may act under an approved permit and rotate access without exposing secrets. Broader permissions, users, roles and ZITADEL integration are planned for later.",
    ),
    icon: "lock-keyhole",
    signal: copy(
      "You approve permissions and rotation.",
      "Access changes wait for your approval.",
    ),
    reference: {
      label: "Open Janus",
      href: siteUrls.janus,
      external: true,
    },
  },
];
---

<MicrositeLayout
  title={copy(
    "INSPR | From idea to operation, with human approval",
    "INSPR | From idea to running software, with a person at every handoff",
  )}
  description={copy(
    "INSPR takes an idea through requirements, agentic building, safe deployment and enforced access, with human approval and full ownership at every step.",
    "Aithema shapes requirements, Paimos gives agents a project, Pharos deploys with a verified backup, Janus governs access. A person approves every handoff.",
  )}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt="The four INSPR products connected from requirements to governed operation"
  favicon={insprLogo.src}
  theme="inspr"
>
  <MicrositeHeader
    name="INSPR"
    category={productTaxonomy.inspr}
    logo={insprLogo.src}
    active="inspr"
    nav={nav}
    showSignIn={true}
  />

  <main id="main-content">
    <ServiceRibbon
      text={copy(
        "Professional implementation and support are available through Augmentoring.",
        "Augmentoring provides professional implementation and support for the INSPR products.",
      )}
    />

    <section
      class="umbrella-hero page-shell"
      aria-labelledby="hero-title"
      data-section-pattern="editorial-hero"
    >
      <div class="umbrella-hero__copy">
        <p class="eyebrow">{copy("The INSPR idea", "The idea")}</p>
        <h1 id="hero-title">Inspiration is the only limit.</h1>
        <p class="umbrella-hero__lead">
          {copy(
            "Aithema shapes the requirements. Paimos helps agents build. Pharos deploys with backup evidence. Janus enforces access. You approve every handoff and own the result.",
            "Talk through what you want to build. Aithema writes the requirements, Paimos gives agents the project, Pharos handles deployment and Janus controls access. Every handoff waits for you.",
          )}
        </p>
        <div class="button-row">
          <a class="button" href="#flow">
            See the flow <span aria-hidden="true">↓</span>
          </a>
          <a class="button button--ghost" href={repositoryUrl} target="_blank" rel="noopener noreferrer">
            {copy("Explore the source", "Read the source")} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="umbrella-hero__note">
          {copy(
            "The tools handle the hard parts. Your work stays yours.",
            "The tools carry the difficult parts. The decisions stay with you.",
          )}
        </p>
      </div>

      <figure class="umbrella-hero__visual">
        <HeroLoop
          id="inspr"
          poster={insprHero}
          video={insprHeroLoop}
          alt="A luminous INSPR core connecting requirements, project, fleet and governance tools"
          sizes="(min-width: 64rem) 54vw, 100vw"
        />
        <figcaption>
          {copy(
            "Four tools. One human-approved path from idea to operation.",
            "Four tools, one path, a review at every handoff.",
          )}
        </figcaption>
      </figure>
    </section>

    <ul
      class="umbrella-proof page-shell"
      aria-label="INSPR characteristics and definitions"
      data-section-pattern="proof-strip"
    >
      {proofPoints.map((point, index) => (
        <li>
          <a href={point.href}>
            <span class="umbrella-proof__number" aria-hidden="true">0{index + 1}</span>
            <strong>{point.title}</strong>
            <small>{point.definition}</small>
            <span class="umbrella-proof__arrow" aria-hidden="true">↓</span>
          </a>
        </li>
      ))}
    </ul>

    <section
      class="umbrella-idea"
      id="idea"
      aria-labelledby="idea-title"
      data-section-pattern="situation-packet"
    >
      <div class="page-shell umbrella-idea__grid">
        <header>
          <p class="eyebrow">{copy("The simple version", "In plain terms")}</p>
          <h2 id="idea-title">The tools handle the difficult parts.</h2>
        </header>
        <div class="umbrella-idea__copy">
          <p class="section-lead">
            {copy(
              "Start with what you want to make. INSPR carries the requirements, project context, deployment safety and access control around it.",
              "Start from the thing you want to build. The tools carry requirements, project context, deployment safety and access control alongside it.",
            )}
          </p>
          <p>
            {copy(
              "You approve each handoff. Your source, data, infrastructure and evidence stay under your control.",
              "You approve each step. The requirements, source, infrastructure and evidence remain under your control.",
            )}
          </p>
        </div>
        <SituationPacket />
      </div>
    </section>

    <section
      class="umbrella-products page-shell"
      id="products"
      aria-labelledby="products-title"
      data-section-pattern="editorial-product-stories"
    >
      <header class="section-intro section-intro--wide">
        <p class="eyebrow">Four products</p>
        <h2 id="products-title">
          {copy(
            "From idea to operation, without giving up control.",
            "Four tools, each with one clear job.",
          )}
        </h2>
        <p class="section-lead">
          {copy(
            "Use one product or follow the full path. Every handoff is explicit and human-approved.",
            "Adopt one, or follow the whole path from requirements to enforced access. Between every two steps stands a person who chooses to continue.",
          )}
        </p>
      </header>

      <div class="product-showcase">
        {products.map((product, index) => (
          <a
            class="product-story-link"
            href={product.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-labelledby={`product-${product.name.toLowerCase()}-link`}
          >
            <article class:list={["product-story", { "product-story--reverse": index % 2 === 0 }]}>
              <span class="product-story__visual">
                <Image
                  src={product.hero}
                  alt={product.alt}
                  widths={[560, 800, 1120]}
                  sizes="(min-width: 60rem) 48vw, 100vw"
                  quality={82}
                  loading="lazy"
                />
              </span>
              <div class="product-story__copy">
                <div class="product-story__identity">
                  <img src={product.logo.src} alt="" width="60" height="60" loading="lazy" />
                  <div>
                    <p class="eyebrow">{product.label}</p>
                    <h3>{product.name}</h3>
                  </div>
                </div>
                <h4>{product.title}</h4>
                <p>{product.body}</p>
                <p class="product-story__detail">{product.detail}</p>
                <span class="text-link" id={`product-${product.name.toLowerCase()}-link`}>
                  Explore {product.name} <span aria-hidden="true">→</span>
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </span>
              </div>
            </article>
          </a>
        ))}

      </div>
    </section>

    <section
      class="identity-utility page-shell"
      aria-labelledby="identity-title"
      data-section-pattern="identity-bridge"
    >
      <div class="identity-utility__mark">
        <img src={zitadelLogo.src} alt="ZITADEL logo" width="72" height="72" loading="lazy" />
      </div>
      <div class="identity-utility__copy">
        <p class="eyebrow">Shared utility · third party</p>
        <h2 id="identity-title">
          {copy(
            "One sign-in. Product permissions stay explicit.",
            "Sign in once. Permissions stay with each product.",
          )}
        </h2>
        <p>
          {copy(
            "ZITADEL provides sign-in. Each product still decides what that identity may do. Deeper Janus user and role integration comes later.",
            "ZITADEL provides the sign-in and nothing more. What a signed-in identity may do is decided inside each product. Deeper Janus user and role integration is planned for later.",
          )}
        </p>
        <ul class="identity-utility__facts" aria-label="Identity service properties">
          <li>Self-hosted</li>
          <li>OIDC</li>
          <li>Role-aware</li>
        </ul>
      </div>
      <div class="identity-utility__links">
        <p>Shared access</p>
        <a class="button" href={siteUrls.signIn} target="_blank" rel="noopener noreferrer">Sign in</a>
        <a class="identity-utility__service" href={siteUrls.identity} target="_blank" rel="noopener noreferrer">
          Open identity service <span aria-hidden="true">↗</span>
        </a>
        <small>auth.inspr.at · powered by ZITADEL</small>
      </div>
    </section>

    <WorkflowExplorer
      id="flow"
      eyebrow={copy("Your idea, under your control", "Four steps, four approvals")}
      title={copy("You decide. The tools handle the hard parts.", "The work moves. You decide when.")}
      lead={copy(
        "Approve the requirements, the staged build, the production deploy and access. Each product returns evidence before the next step.",
        "Requirements, staged build, production deploy, access: four approvals, each backed by evidence the tool puts in front of you.",
      )}
      steps={productFlowSteps}
      image={insprContinuity}
      alt="Four connected chambers carrying work through Aithema, Paimos, Pharos and Janus with a human approval at every handoff."
      closing={copy(
        "You own the requirements, source, infrastructure, permissions and evidence.",
        "At the end, everything is yours: the requirements, the source, the infrastructure, the permissions and the evidence behind every decision.",
      )}
      tone="light"
      pattern="guided-workflow"
    />

    <section
      class="umbrella-principles page-shell"
      id="principles"
      aria-labelledby="principles-title"
      data-section-pattern="editorial-field-notes"
    >
      <header class="section-intro">
        <p class="eyebrow">Working principles</p>
        <h2 id="principles-title">
          {copy("You remain the decision-maker.", "Built so you can say no.")}
        </h2>
        <p class="section-lead">
          {copy(
            "The tools prepare context, checks and evidence. You approve requirements, builds, deployments and access.",
            "Each rule keeps a decision informed, visible and reversible.",
          )}
        </p>
      </header>
      <PrincipleFieldNotes principles={principles} />
    </section>

    <section
      class="source-panel page-shell"
      id="source"
      aria-labelledby="source-title"
      data-section-pattern="source-manifest"
    >
      <div>
        <p class="eyebrow">{copy("Open foundations", "The source")}</p>
        <h2 id="source-title">
          {copy("Read the source. Own the stack.", "Read it before you run it.")}
        </h2>
        <p class="section-lead">
          {copy(
            "Paimos, Pharos and Janus are AGPL-3.0-only. Aithema's reusable module is planned as open source. Inspect the limits, run the tools yourself and adapt them to your work.",
            "Paimos, Pharos and Janus are open-source software by Markus Barta, licensed AGPL-3.0-only. Aithema's reusable module is planned as open source. What is published, you can inspect, run yourself and change.",
          )}
        </p>
      </div>
      <nav class="source-panel__links" aria-label="INSPR source links">
        <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">
          <span>INSPR site</span><small>{copy("Umbrella and microsite source", "This page and the product microsites")}</small><b aria-hidden="true">↗</b>
        </a>
        <a href={umbrellaRepositoryUrl} target="_blank" rel="noopener noreferrer">
          <span>INSPR umbrella</span><small>{copy("Vision and product family", "The vision and the product family")}</small><b aria-hidden="true">↗</b>
        </a>
        <a href={modulesUrl} target="_blank" rel="noopener noreferrer">
          <span>INSPR modules</span><small>{copy("Doctrine and shared operating modules", "Shared doctrine and operating modules")}</small><b aria-hidden="true">↗</b>
        </a>
        <a href={siteLicenseUrl} target="_blank" rel="noopener noreferrer">
          <span>License terms</span><small>{copy("Read this site's license", "This site's AGPL-3.0-only license")}</small><b aria-hidden="true">↗</b>
        </a>
      </nav>
    </section>

    <section
      class="umbrella-faq faq page-shell"
      aria-labelledby="faq-title"
      data-section-pattern="faq-accordion"
    >
      <header class="section-intro">
        <p class="eyebrow">A few useful answers</p>
        <h2 id="faq-title">Where does INSPR fit?</h2>
      </header>
      <div class="faq-list">
        <details>
          <summary>Is INSPR one product that has to be adopted all at once?</summary>
          <p>
            {copy(
              "No. Aithema, Paimos, Pharos and Janus have separate responsibilities. Use them separately or connect them in order. You keep control at every handoff.",
              "No. Each product stands on its own: requirements, project context, deployment, access. Adopt the one that solves your current problem; the path is there when you want the rest.",
            )}
          </p>
        </details>
        <details>
          <summary>Is this only for large infrastructure teams?</summary>
          <p>
            {copy(
              "No. INSPR began with one person, multiple agents and a real fleet. The same path works for a small team.",
              "No. INSPR began as one person, a handful of AI agents and a real fleet of servers. It is built for that scale and grows with it.",
            )}
          </p>
        </details>
        <details>
          <summary>Can we run the products ourselves?</summary>
          <p>
            {copy(
              "Paimos, Pharos and Janus are open source and self-hostable. Aithema's reusable module will follow; its public preview is at start.augmentoring.com.",
              "Paimos, Pharos and Janus, yes: they are open source and built to self-host. Aithema's reusable module is planned; until it ships, the public preview at start.augmentoring.com is the way in.",
            )}
          </p>
        </details>
      </div>
    </section>
  </main>

  <MicrositeFooter
    name="INSPR"
    repositoryUrl={repositoryUrl}
    licenseName="AGPL-3.0-only"
    licenseUrl={siteLicenseUrl}
    ctaTitle={copy("Want help running the open stack?", "Prefer not to run it alone?")}
    ctaBody={copy(
      "Augmentoring provides architecture, integration, rollout and operating support around the same products.",
      "Augmentoring provides architecture, integration, rollout and operating support as a professional service. Paimos, Pharos and Janus remain open source; Aithema's reusable module is planned to join them.",
    )}
  />
</MicrositeLayout>

<style>
  .umbrella-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(34rem, 1.12fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6.5rem);
    min-height: min(47rem, calc(100svh - 10rem));
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .umbrella-hero__copy {
    position: relative;
    z-index: 1;
  }

  .umbrella-hero h1 {
    max-width: 12ch;
    margin-block: 0.75rem 1.5rem;
    font-size: clamp(3.5rem, 6.5vw, 7.1rem);
    line-height: 0.93;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .umbrella-hero__lead {
    max-width: 42rem;
    margin: 0;
    color: var(--text-soft, #526269);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.6;
  }

  .umbrella-hero__note {
    margin: 1.5rem 0 0;
    color: var(--text-faint, #708087);
    font-size: 0.86rem;
    letter-spacing: 0.05em;
  }

  .umbrella-hero__visual {
    position: relative;
    margin: 0;
    isolation: isolate;
