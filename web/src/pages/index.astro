---
import { Image } from "astro:assets";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import MicrositeHeader from "../components/MicrositeHeader.astro";
import MicrositeFooter from "../components/MicrositeFooter.astro";
import ServiceRibbon from "../components/ServiceRibbon.astro";
import { siteUrls } from "../content/urls";

import insprHero from "../assets/products/inspr/hero.png";
import insprLogo from "../assets/products/inspr/logo.svg";
import paimosHero from "../assets/products/paimos/hero.png";
import paimosLogo from "../assets/products/paimos/logo.svg";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosLogo from "../assets/products/pharos/mark.svg";
import janusHero from "../assets/products/janus/hero.png";
import janusLogo from "../assets/products/janus/logo.svg";

const repositoryUrl = "https://github.com/markus-barta/inspr";
const modulesUrl = "https://github.com/markus-barta/inspr-modules";
const canonicalUrl = siteUrls.inspr;
const ogImage = new URL(insprHero.src, canonicalUrl).href;

const nav = [
  { label: "Idea", href: "#idea" },
  { label: "Products", href: "#products" },
  { label: "Principles", href: "#principles" },
  { label: "Source", href: "#source" },
];

const products = [
  {
    name: "Paimos",
    label: "Shared project context",
    href: siteUrls.paimos,
    logo: paimosLogo,
    hero: paimosHero,
    alt: "A shared project agora where people and agents work around the same project context",
    title: "Keep people and AI agents in the same project picture.",
    body:
      "Paimos brings work, repository context, operating knowledge, execution choices and run evidence into one self-hosted project model.",
    detail: "Project management · context · evidence",
  },
  {
    name: "Pharos",
    label: "Fleet operations",
    href: siteUrls.pharos,
    logo: pharosLogo,
    hero: pharosHero,
    alt: "A lighthouse overlooking a calm network of connected fleet nodes",
    title: "See what is running before you change it.",
    body:
      "Pharos keeps live observations, declared configuration and requested changes separate across servers, backups and guarded maintenance.",
    detail: "Fleet state · backup evidence · operations",
  },
  {
    name: "Janus",
    label: "Secret governance",
    href: siteUrls.janus,
    logo: janusLogo,
    hero: janusHero,
    alt: "A transparent governance gateway mediating approved access between systems",
    title: "Let work use a secret without revealing it.",
    body:
      "Janus turns secret-backed work into an explicit path from reference to permit to reviewed execution, with value-free evidence in return.",
    detail: "References · permits · approved execution",
  },
];

const principles = [
  {
    number: "01",
    title: "Context should travel",
    body:
      "Projects, repositories, hosts and operating rules should not have to be reconstructed every time a person or agent starts work.",
  },
  {
    number: "02",
    title: "Authority should stay visible",
    body:
      "A suggestion, a code change and a production action are different capabilities. The system should keep those boundaries explicit.",
  },
  {
    number: "03",
    title: "State should be recoverable",
    body:
      "Declare what can be declared, keep source and evidence, and make the path back to a working system understandable without folklore.",
  },
];
---

<MicrositeLayout
  title="INSPR | A shared operating layer for people and AI agents"
  description="INSPR is an open operating layer that keeps project context, fleet state, secret use and operating doctrine coherent for people and AI agents."
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt="The INSPR product constellation around a shared operating core"
  favicon={insprLogo.src}
  theme="inspr"
>
  <MicrositeHeader
    name="INSPR"
    category="Open operating layer"
    logo={insprLogo.src}
    active="inspr"
    nav={nav}
    showSignIn={true}
  />

  <main id="main-content">
    <ServiceRibbon
      text="Augmentoring is the professional path for supported INSPR deployments."
    />

    <section class="umbrella-hero page-shell" aria-labelledby="hero-title">
      <div class="umbrella-hero__copy">
        <p class="eyebrow">Inspiration is the only limit</p>
        <h1 id="hero-title">Ideas should outlive the tools that help make them.</h1>
        <p class="umbrella-hero__lead">
          INSPR is a shared operating layer for people and AI agents. It keeps the
          context, boundaries and evidence around real work coherent, while each
          product stays focused on one problem it can solve well.
        </p>
        <div class="button-row">
          <a class="button" href="#products">
            Meet the products <span aria-hidden="true">↓</span>
          </a>
          <a class="button button--ghost" href={repositoryUrl}>
            Explore the source <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="umbrella-hero__note">
          Living infrastructure, built in the open and shaped by daily use.
        </p>
      </div>

      <figure class="umbrella-hero__visual">
        <Image
          src={insprHero}
          alt="A luminous INSPR core connecting project, fleet and governance tools"
          widths={[720, 960, 1280, 1600]}
          sizes="(min-width: 64rem) 54vw, 100vw"
          formats={["avif", "webp", "png"]}
          quality={84}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          One operating idea, expressed through tools with clear responsibilities.
        </figcaption>
      </figure>
    </section>

    <ul class="umbrella-proof page-shell" aria-label="INSPR characteristics">
      <li>Shared doctrine</li>
      <li>Declarative where practical</li>
      <li>Human and agent ready</li>
      <li>Inspectable foundations</li>
    </ul>

    <section class="umbrella-idea" id="idea" aria-labelledby="idea-title">
      <div class="page-shell umbrella-idea__grid">
        <header>
          <p class="eyebrow">The simple version</p>
          <h2 id="idea-title">Spend less time rebuilding the situation.</h2>
        </header>
        <div class="umbrella-idea__copy">
          <p class="section-lead">
            Useful work depends on more than a good prompt. An agent needs the right
            project context. An operator needs current system state. Both need to know
            what authority exists and what actually happened.
          </p>
          <p>
            INSPR treats those conditions as infrastructure. The goal is not one large
            platform. It is a small set of connected tools and shared rules that make
            ambitious work easier to start, safer to continue and possible to recover.
          </p>
        </div>
      </div>
    </section>

    <section class="umbrella-products page-shell" id="products" aria-labelledby="products-title">
      <header class="section-intro section-intro--wide">
        <p class="eyebrow">The product constellation</p>
        <h2 id="products-title">Three focused tools. One coherent way of working.</h2>
        <p class="section-lead">
          Each product owns a distinct part of the operating picture. Use one where it
          helps, or connect them without hiding the boundaries between them.
        </p>
      </header>

      <div class="product-showcase">
        {products.map((product, index) => (
          <article class:list={["product-story", { "product-story--reverse": index % 2 === 1 }]}>
            <a class="product-story__visual" href={product.href} aria-label={`Explore ${product.name}`}>
              <Image
                src={product.hero}
                alt={product.alt}
                widths={[560, 800, 1120]}
                sizes="(min-width: 60rem) 48vw, 100vw"
                formats={["avif", "webp", "png"]}
                quality={82}
                loading="lazy"
              />
            </a>
            <div class="product-story__copy">
              <div class="product-story__identity">
                <img src={product.logo.src} alt="" width="60" height="60" loading="lazy" />
                <div>
                  <p class="eyebrow">{product.label}</p>
                  <h3>{product.name}</h3>
                </div>
              </div>
              <h4>{product.title}</h4>
              <p>{product.body}</p>
              <p class="product-story__detail">{product.detail}</p>
              <a class="text-link" href={product.href}>
                Explore {product.name} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="identity-utility page-shell" aria-labelledby="identity-title">
      <div class="identity-utility__mark" aria-hidden="true">ID</div>
      <div>
        <p class="eyebrow">Shared utility · third party</p>
        <h2 id="identity-title">One identity boundary across the tools.</h2>
        <p>
          INSPR uses self-hosted Zitadel as its identity and access layer. Zitadel is
          not an INSPR product, but it gives the product family one consistent place for
          sign-in and role-aware access.
        </p>
      </div>
      <div class="identity-utility__links">
        <a class="button button--ghost" href={siteUrls.signIn}>Sign in</a>
        <a class="text-link" href={siteUrls.identity}>
          Identity service <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="operating-flow" aria-labelledby="flow-title">
      <div class="page-shell operating-flow__inner">
        <header>
          <p class="eyebrow">From intent to evidence</p>
          <h2 id="flow-title">The useful part is the continuity.</h2>
          <p class="section-lead">
            Models, runtimes and infrastructure can change. The operating context and
            the record of what happened should remain legible.
          </p>
        </header>
        <ol>
          <li><span>01</span><strong>Intent</strong><small>What are we trying to change?</small></li>
          <li><span>02</span><strong>Context</strong><small>Which project and system facts apply?</small></li>
          <li><span>03</span><strong>Bounded action</strong><small>What is this actor allowed to do?</small></li>
          <li><span>04</span><strong>Evidence</strong><small>What ran, changed and returned?</small></li>
        </ol>
      </div>
    </section>

    <section class="umbrella-principles page-shell" id="principles" aria-labelledby="principles-title">
      <header class="section-intro">
        <p class="eyebrow">Working principles</p>
        <h2 id="principles-title">A substrate should remove friction, not judgment.</h2>
        <p class="section-lead">
          INSPR aims to make the repeatable parts dependable so people can spend more
          attention on design, decisions and the work that still needs imagination.
        </p>
      </header>
      <div class="principle-grid">
        {principles.map((principle) => (
          <article>
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="source-panel page-shell" id="source" aria-labelledby="source-title">
      <div>
        <p class="eyebrow">Open foundations</p>
        <h2 id="source-title">Inspect the ideas. Inspect the implementation.</h2>
        <p class="section-lead">
          INSPR is source-driven. Paimos, Pharos and Janus are licensed under
          AGPL-3.0-only. Their product pages state actual scope, maturity and limits,
          so open source does not become a substitute for clarity.
        </p>
      </div>
      <nav class="source-panel__links" aria-label="INSPR source links">
        <a href={repositoryUrl}>
          <span>INSPR umbrella</span><small>Vision and operating map</small><b aria-hidden="true">↗</b>
        </a>
        <a href={modulesUrl}>
          <span>INSPR modules</span><small>Doctrine and shared operating modules</small><b aria-hidden="true">↗</b>
        </a>
        <a href={siteUrls.agpl}>
          <span>AGPL-3.0-only</span><small>Read the license used by all three products</small><b aria-hidden="true">↗</b>
        </a>
      </nav>
    </section>

    <section class="umbrella-faq page-shell" aria-labelledby="faq-title">
      <header class="section-intro">
        <p class="eyebrow">A few useful answers</p>
        <h2 id="faq-title">Where does INSPR fit?</h2>
      </header>
      <div class="faq-list">
        <details>
          <summary>Is INSPR one product that has to be adopted all at once?</summary>
          <p>
            No. Paimos, Pharos and Janus have separate responsibilities and separate
            repositories. The shared value is a coherent operating model, not forced
            bundling.
          </p>
        </details>
        <details>
          <summary>Is this only for large infrastructure teams?</summary>
          <p>
            No. INSPR began with one human and multiple AI agents working across a real
            fleet. The same principles can help a small engineering team without asking
            it to imitate an enterprise platform group.
          </p>
        </details>
        <details>
          <summary>Can we run the products ourselves?</summary>
          <p>
            Yes. The repositories and product licenses are linked from every product
            page. If you need architecture, deployment, integration or operational
            support, Augmentoring provides a clear professional path alongside the open
            software.
          </p>
        </details>
      </div>
    </section>
  </main>

  <MicrositeFooter
    name="INSPR"
    repositoryUrl={repositoryUrl}
    ctaTitle="Open foundations, operated with professional care."
    ctaBody="Augmentoring helps teams assess, deploy, integrate and operate the INSPR product family without replacing the open products underneath."
  />
</MicrositeLayout>

<style>
  .umbrella-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(34rem, 1.12fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6.5rem);
    min-height: min(47rem, calc(100svh - 10rem));
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .umbrella-hero__copy {
    position: relative;
    z-index: 1;
  }

  .umbrella-hero h1 {
    max-width: 12ch;
    margin-block: 0.75rem 1.5rem;
    font-size: clamp(3.5rem, 6.5vw, 7.1rem);
    line-height: 0.93;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .umbrella-hero__lead {
    max-width: 42rem;
    margin: 0;
    color: var(--text-soft, #526269);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.6;
  }

  .umbrella-hero__note {
    margin: 1.5rem 0 0;
    color: var(--text-faint, #708087);
    font-size: 0.86rem;
    letter-spacing: 0.05em;
  }

  .umbrella-hero__visual {
    position: relative;
    margin: 0;
    isolation: isolate;
  }

  .umbrella-hero__visual::before {
    position: absolute;
    z-index: -1;
    inset: 4% 0 -4% 8%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 30%, rgb(255 190 82 / 0.22), transparent 42%),
      radial-gradient(circle at 72% 68%, rgb(71 193 195 / 0.22), transparent 45%);
    filter: blur(42px);
    content: "";
  }

  .umbrella-hero__visual :global(img) {
    display: block;
    width: 100%;
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: clamp(1.5rem, 3vw, 3rem);
    box-shadow:
      0 2rem 5rem rgb(43 61 64 / 0.16),
      inset 0 1px 0 rgb(255 255 255 / 0.85);
  }

  .umbrella-hero figcaption {
    max-width: 29rem;
    margin: 1rem 1.25rem 0 auto;
    color: var(--text-faint, #708087);
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: right;
  }

  .umbrella-proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-block: 0;
    padding-block: 1.35rem;
    border-block: 1px solid rgb(33 63 66 / 0.13);
    list-style: none;
  }

  .umbrella-proof li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
    color: var(--text-soft, #526269);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .umbrella-proof li::before {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent, #0e7772);
    box-shadow: 0 0 0 0.28rem rgb(14 119 114 / 0.1);
    content: "";
  }

  .umbrella-idea {
    margin-block: clamp(5rem, 10vw, 9rem);
    padding-block: clamp(4rem, 9vw, 8rem);
    background:
      linear-gradient(115deg, rgb(248 245 239 / 0.02), rgb(66 188 186 / 0.08)),
      #172f3a;
    color: #f8f5ef;
  }

  .umbrella-idea__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
  }

  .umbrella-idea h2 {
    max-width: 12ch;
    margin-top: 0.8rem;
    color: inherit;
    font-size: clamp(2.8rem, 5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .umbrella-idea .eyebrow,
  .operating-flow .eyebrow {
    color: #8bd7d2;
  }

  .umbrella-idea__copy {
    max-width: 48rem;
  }

  .umbrella-idea__copy .section-lead {
    color: rgb(244 247 246 / 0.91);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }

  .umbrella-idea__copy > p:last-child {
    max-width: 42rem;
    margin-top: 2rem;
    color: rgb(228 237 235 / 0.7);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .umbrella-products {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(6rem, 11vw, 10rem);
  }

  .product-showcase {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .product-story {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6.5rem);
  }

  .product-story--reverse .product-story__visual {
    order: 2;
  }

  .product-story--reverse .product-story__copy {
    order: 1;
  }

  .product-story__visual {
    display: block;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.82);
    border-radius: clamp(1.4rem, 2.4vw, 2.5rem);
    box-shadow: 0 1.5rem 4rem rgb(35 64 68 / 0.13);
    transition:
      transform 420ms cubic-bezier(0.2, 0.75, 0.25, 1),
      box-shadow 420ms ease;
  }

  .product-story__visual:hover,
  .product-story__visual:focus-visible {
    transform: translateY(-0.3rem);
    box-shadow: 0 2rem 4.5rem rgb(35 64 68 / 0.19);
  }

  .product-story__visual :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .product-story__visual:hover :global(img) {
    transform: scale(1.018);
  }

  .product-story__copy {
    max-width: 34rem;
  }

  .product-story__identity {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 2rem;
  }

  .product-story__identity img {
    width: 4.25rem;
    height: 4.25rem;
    padding: 0.65rem;
    border: 1px solid rgb(25 65 68 / 0.12);
    border-radius: 1.2rem;
    background: rgb(255 255 255 / 0.64);
    box-shadow: 0 0.65rem 1.5rem rgb(36 74 77 / 0.09);
    object-fit: contain;
  }

  .product-story__identity .eyebrow {
    margin: 0 0 0.15rem;
  }

  .product-story__identity h3 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.8rem);
  }

  .product-story h4 {
    max-width: 15ch;
    margin: 0 0 1.25rem;
    font-family: var(--font-display, "Fraunces Variable"), serif;
    font-size: clamp(2rem, 3.25vw, 3.5rem);
    font-weight: 450;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .product-story__copy > p:not(.product-story__detail) {
    color: var(--text-soft, #526269);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .product-story__detail {
    margin-block: 1.5rem;
    color: var(--accent, #0e7772);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink, #17313c);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    transition: transform 180ms ease;
  }

  .text-link:hover span,
  .text-link:focus-visible span {
    transform: translateX(0.2rem);
  }

  .identity-utility {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-bottom: clamp(5rem, 10vw, 9rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgb(25 65 68 / 0.12);
    border-radius: 2rem;
    background: rgb(255 255 255 / 0.5);
    box-shadow:
      0 1.5rem 3.5rem rgb(45 67 69 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.86);
    backdrop-filter: blur(18px);
  }

  .identity-utility__mark {
    display: grid;
    width: 5.25rem;
    height: 5.25rem;
    place-items: center;
    border: 1px solid rgb(14 119 114 / 0.2);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, rgb(255 255 255 / 0.9), rgb(72 188 185 / 0.12));
    color: var(--accent, #0e7772);
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .identity-utility h2 {
    margin: 0.4rem 0 0.5rem;
    font-size: clamp(1.7rem, 2.5vw, 2.6rem);
  }

  .identity-utility p:last-child {
    max-width: 52rem;
    margin: 0;
    color: var(--text-soft, #526269);
    line-height: 1.65;
  }

  .identity-utility__links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    white-space: nowrap;
  }

  .operating-flow {
    padding-block: clamp(5rem, 10vw, 9rem);
    background:
      radial-gradient(circle at 14% 25%, rgb(49 180 179 / 0.12), transparent 30%),
      radial-gradient(circle at 87% 70%, rgb(232 166 57 / 0.12), transparent 32%),
      #17313c;
    color: #f8f5ef;
  }

  .operating-flow__inner {
    display: grid;
    grid-template-columns: minmax(18rem, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .operating-flow h2 {
    margin-block: 0.75rem 1.25rem;
    color: inherit;
    font-size: clamp(2.8rem, 5vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .operating-flow .section-lead {
    color: rgb(235 242 241 / 0.75);
  }

  .operating-flow ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .operating-flow li {
    min-height: 11rem;
    padding: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .operating-flow li:nth-child(odd) {
    border-right: 1px solid rgb(255 255 255 / 0.16);
  }

  .operating-flow li span,
  .operating-flow li small,
  .operating-flow li strong {
    display: block;
  }

  .operating-flow li span {
    margin-bottom: 2rem;
    color: #8bd7d2;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
