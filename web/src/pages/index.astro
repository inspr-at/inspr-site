---
import { Image } from "astro:assets";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import MicrositeHeader from "../components/MicrositeHeader.astro";
import DetailLevels from "../components/DetailLevels.astro";
import MicrositeFooter from "../components/MicrositeFooter.astro";
import ServiceRibbon from "../components/ServiceRibbon.astro";
import HomeFlow from "../components/HomeFlow.astro";
import StatusChip from "../components/StatusChip.astro";
import SituationPacket from "../components/SituationPacket.astro";
import PrincipleFieldNotes from "../components/PrincipleFieldNotes.astro";
import HeroLoop from "../components/HeroLoop.astro";
import { aithemaContent, aithemaReleaseVersion } from "../content/aithema";
import { aithemaContentDe } from "../content/de/aithema";
import { paimosContent } from "../content/paimos";
import { paimosContentDe } from "../content/de/paimos";
import { paimosRelease } from "../content/paimos-aeon";
import { pharosContent, pharosRelease } from "../content/pharos";
import { pharosContentDe } from "../content/de/pharos";
import { janusContent, janusRelease } from "../content/janus";
import { janusContentDe } from "../content/de/janus";
import type { ProductSheet } from "../content/types";
import {
  actors,
  buildOrder,
  contract,
  engineJobs,
  message,
  productRole,
  products as familyProducts,
} from "../content/family";
import { productTaxonomy, productTaxonomyDe, siteUrls } from "../content/urls";
import { releaseMetadata } from "../../release-metadata.mjs";

import insprHero from "../assets/products/inspr/hero.png";
import insprHeroLoop from "../assets/products/inspr/hero-loop.mp4";
import insprLogo from "../assets/products/inspr/logo.svg";
import paimosHero from "../assets/products/paimos/hero.png";
import paimosLogo from "../assets/products/paimos/logo.svg";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosLogo from "../assets/products/pharos/mark.svg";
import janusHero from "../assets/products/janus/hero.png";
import janusLogo from "../assets/products/janus/logo.svg";
import aithemaHero from "../assets/products/aithema/hero.png";
import aithemaHeroLoop from "../assets/products/aithema/hero-loop.mp4";
import aithemaLogo from "../assets/products/aithema/logo.svg";
import zitadelLogo from "../assets/brands/zitadel-logo-solo-dark-icon.svg";

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const copy = (english: string, german: string) => locale === "de" ? german : english;
// Product hosts serve their German edition at /de/; ?lang=de records the
// choice on the destination origin (localStorage does not cross hosts).
const productHref = (href: string) =>
  locale === "de" ? `${href}/de/?lang=de` : href;

const repositoryUrl = "https://github.com/inspr-at/inspr-site";
const siteLicenseUrl = `${repositoryUrl}/blob/main/LICENSE`;
const productSourcesUrl = `${repositoryUrl}#product-sources`;
const modulesUrl = "https://github.com/inspr-at/inspr-modules";
const englishUrl = `${siteUrls.inspr}/`;
const germanUrl = `${siteUrls.inspr}/de/`;
const canonicalUrl = locale === "de" ? germanUrl : englishUrl;
const ogImage = new URL(insprHero.src, englishUrl).href;

const nav = [
  { label: copy("Overview", "Überblick"), href: locale === "de" ? siteUrls.overviewGerman : siteUrls.overview },
  { label: copy("Flow", "Ablauf"), href: "#flow" },
  { label: copy("Products", "Produkte"), href: "#products" },
  { label: copy("Principles", "Prinzipien"), href: "#principles" },
  { label: copy("Source", "Quellcode"), href: "#source" },
];

const sheetLabels = locale === "de"
  ? { repo: "Repository", runtime: "Laufzeit", gate: "Freigabe", artefact: "Artefakt", interfaces: "Schnittstellen", maturity: "Reife", command: "Befehl" }
  : { repo: "repo", runtime: "runtime", gate: "gate", artefact: "artefact", interfaces: "interfaces", maturity: "maturity", command: "command" };
const sheets: Record<"aithema" | "paimos" | "pharos" | "janus", ProductSheet> = {
  aithema: (locale === "de" ? aithemaContentDe : aithemaContent).hero.sheet,
  paimos: (locale === "de" ? paimosContentDe : paimosContent).hero.sheet,
  pharos: (locale === "de" ? pharosContentDe : pharosContent).hero.sheet,
  janus: (locale === "de" ? janusContentDe : janusContent).hero.sheet,
};

// INSPR-543: the four product cards read their question word, one-liner and status
// from family.ts; only the long copy, the plain-language line and the tags are local.
const products = [
  {
    key: "aithema" as const,
    name: "Aithema",
    sheet: sheets.aithema,
    simple: copy("Turn your words and files into a clear description of what you need.", "Aus Ihren Worten und Dateien entsteht eine klare Beschreibung dessen, was Sie brauchen."),
    label: productRole("aithema", locale),
    href: siteUrls.aithema,
    logo: aithemaLogo,
    hero: aithemaHero,
    video: aithemaHeroLoop,
    alt: copy(
      "Open conversational threads becoming one structured and reviewable proposal",
      "Offene Gesprächsfäden werden zu einem strukturierten und prüfbaren Vorschlag",
    ),
    body: copy(
      "Speak, type or add files; Aithema drafts the requirements. Read them and choose Continue when they say what you mean. The reusable core is open source, and the hosted workspace is open by invitation.",
      "Sprechen Sie, schreiben Sie oder fügen Sie Dateien hinzu. Aithema entwirft daraus Anforderungen. Prüfen Sie sie und wählen Sie „Weiter“, sobald sie wirklich passen. Der wiederverwendbare Kern ist Open Source; der gehostete Arbeitsbereich ist auf Einladung offen.",
    ),
    detail: copy(
      "Conversation · requirements · Continue",
      "Gespräch · Anforderungen · Weiter",
    ),
  },
  {
    key: "paimos" as const,
    name: "Paimos",
    sheet: sheets.paimos,
    simple: copy("Keep the plan, the notes and the agents' work together in one project.", "Behalten Sie Plan, Notizen und die Arbeit der Agenten in einem Projekt zusammen."),
    label: productRole("paimos", locale),
    href: siteUrls.paimos,
    logo: paimosLogo,
    hero: paimosHero,
    video: null,
    alt: copy(
      "A shared project agora where people and agents work around the same project context",
      "Ein gemeinsamer Projektraum, in dem Menschen und Agenten mit demselben Kontext arbeiten",
    ),
    body: copy(
      "Claude Code, Codex, Cursor and pi start under Paimos on macOS and Linux; Grok runs tool-free on Apple silicon; Gemini and OpenCode pair only, and starting them is planned. The engine admits, reviews and audits their work.",
      "Claude Code, Codex, Cursor und pi starten unter Paimos (macOS und Linux); Grok läuft ohne Werkzeuge auf Apple Silicon; Gemini und OpenCode: nur Kopplung, Start geplant. Die Arbeitssteuerung lässt ihre Arbeit zu, prüft und protokolliert sie.",
    ),
    detail: copy(
      "Projects · tickets · knowledge · engine",
      "Projekte · Tickets · Wissen · Arbeitssteuerung",
    ),
  },
  {
    key: "pharos" as const,
    name: "Pharos",
    sheet: sheets.pharos,
    simple: copy("See where everything runs and whether it is backed up.", "Sehen Sie, wo alles läuft und ob es gesichert ist."),
    label: productRole("pharos", locale),
    href: siteUrls.pharos,
    logo: pharosLogo,
    hero: pharosHero,
    video: null,
    alt: copy(
      "A lighthouse overlooking a calm network of connected fleet nodes",
      "Ein Leuchtturm über einem ruhigen Netz verbundener Server",
    ),
    body: copy(
      "Pharos shows the state of your fleet and its backup evidence, and records an explicit confirmation before a host applies a change.",
      "Pharos zeigt den Zustand Ihrer Flotte und die Backup-Nachweise und hält eine ausdrückliche Bestätigung fest, bevor ein Host eine Änderung anwendet.",
    ),
    detail: copy(
      "Fleet · backup evidence · guarded deploy",
      "Flotte · Backup-Nachweise · abgesicherte Bereitstellung",
    ),
  },
  {
    key: "janus" as const,
    name: "Janus",
    sheet: sheets.janus,
    simple: copy("Allow a specific use of a secret without showing the secret itself.", "Erlauben Sie eine bestimmte Nutzung eines Geheimnisses, ohne das Geheimnis selbst zu zeigen."),
    label: productRole("janus", locale),
    href: siteUrls.janus,
    logo: janusLogo,
    hero: janusHero,
    video: null,
    alt: copy(
      "A transparent governance gateway mediating approved access between systems",
      "Ein transparentes Governance-Gateway vermittelt freigegebenen Zugriff zwischen Systemen",
    ),
    body: copy(
      "A permit names which reference, which requester and which sink; the value is used only inside the reviewed execution path. Janus maps nine roles from the identity provider for its oversight plane.",
      "Eine Freigabe benennt, welche Referenz, wer anfragt und welches Ziel; der Wert wird nur im geprüften Ausführungspfad verwendet. Janus bildet neun Rollen des Identitätsanbieters für seine Aufsichtsebene ab.",
    ),
    detail: copy(
      "Permits · roles · value-free audit",
      "Freigaben · Rollen · Audit ohne Werte",
    ),
  },
];

// INSPR-540: each card names the release the site presents, from the same
// constants the product pages use. Doctrine carries none. The card is one
// link, so calendar versions stay on the product pages, where the shared
// renderer shows them with reveal and copy; the card shows the release date.
const releaseDate = (iso: string) =>
  locale === "de" ? `Release vom ${iso.split("-").reverse().join(".")}` : `Release of ${iso}`;
const productReleases = {
  aithema: copy(`Requirements core ${aithemaReleaseVersion}`, `Anforderungskern ${aithemaReleaseVersion}`),
  paimos: `Release ${paimosRelease.number} · ${paimosRelease.codename}`,
  pharos: releaseDate(pharosRelease.date),
  janus: releaseDate(janusRelease.date),
};

const doctrine = familyProducts.doctrine;
const doctrineBody = copy(
  "The rulebook every agent loads at session start: a small always-on kernel, domain packs on demand and the inspr CLI. Releases carry a calendar version and are signed.",
  "Das Regelwerk, das jeder Agent zu Beginn einer Sitzung lädt: ein kleiner, immer aktiver Kern, Regeln für einzelne Fachgebiete bei Bedarf und die inspr CLI. Releases tragen eine Kalenderversion und sind signiert.",
);

// INSPR-543: the page's own build-time facts. Header-only values (CSP, HSTS) are not
// known at build, so they are not shown.
const buildFacts = {
  release: releaseMetadata.releaseId,
  source: releaseMetadata.gitLabel,
  deployed: releaseMetadata.deployedAt ?? copy("not deployed", "nicht veröffentlicht"),
};

const proofPoints = [
  {
    title: copy("People decide", "Menschen entscheiden"),
    definition: actors.find((actor) => actor.key === "people")!.line[locale],
    href: "#actors",
  },
  {
    title: copy("Yours to keep", "Bleibt in Ihrer Hand"),
    definition: copy(
      "Source, data, servers and evidence stay with you.",
      "Quellcode, Daten, Server und Nachweise bleiben bei Ihnen.",
    ),
    href: "#source",
  },
  {
    title: engineJobs.find((job) => job.key === "audit")!.label[locale],
    definition: engineJobs.find((job) => job.key === "audit")!.note[locale],
    href: "#building",
  },
  {
    title: copy("Open foundations", "Offene Grundlage"),
    definition: copy(
      "Read the code, run it yourself, change it.",
      "Lesen Sie den Code, betreiben Sie ihn selbst und ändern Sie ihn.",
    ),
    href: "#source",
  },
];

const principles = [
  {
    number: "01",
    title: copy("Context stays with the work", "Kontext bleibt bei der Arbeit"),
    body: copy(
      "Each product keeps its context in one place: requirements in Aithema, plans and knowledge in Paimos, fleet state in Pharos, permits in Janus.",
      "Jedes Produkt hält seinen Kontext an einem Ort: Anforderungen in Aithema, Pläne und Wissen in Paimos, Flottenzustand in Pharos, Freigaben in Janus.",
    ),
    avoids: copy(
      "Re-explained systems and agents working blind.",
      "Wiederholte Erklärungen und Agenten im Blindflug.",
    ),
    protects: copy(
      "One current picture, shared by people and agents.",
      "Ein aktuelles Bild für Menschen und Agenten.",
    ),
  },
  {
    number: "02",
    title: copy("Approval is a visible act", "Freigabe ist eine sichtbare Handlung"),
    body: copy(
      "Requirements are approved in Aithema, review gates run in Paimos, production deploys are confirmed in Pharos and secret permits are issued in Janus.",
      "Anforderungen werden in Aithema freigegeben, Prüfschritte laufen in Paimos, Produktionsbereitstellungen werden in Pharos bestätigt und Freigaben für Geheimnisse werden in Janus erteilt.",
    ),
    avoids: copy(
      "Quiet escalation and accidental production authority.",
      "Stille Eskalation und versehentliche Produktionsrechte.",
    ),
    protects: copy(
      "A recorded decision wherever a product asks for one.",
      "Eine festgehaltene Entscheidung überall dort, wo ein Produkt eine verlangt.",
    ),
  },
  {
    number: "03",
    title: copy("A way back is part of the change", "Der Rückweg gehört zur Änderung"),
    body: copy(
      "Back up before production, record what actually ran and keep a way to the previous state.",
      "Sichern Sie vor der Produktion, halten Sie den tatsächlichen Lauf fest und bewahren Sie einen Weg zum vorigen Zustand.",
    ),
    avoids: copy(
      "Deploys you cannot reverse and recovery from memory.",
      "Nicht umkehrbare Bereitstellungen und Wiederherstellung aus dem Gedächtnis.",
    ),
    protects: copy(
      "Your systems and a known rollback.",
      "Ihre Systeme und einen bekannten Weg zum Zurücksetzen.",
    ),
  },
];

---

<MicrositeLayout
  title={copy(
    "INSPR | From idea to running software",
    "INSPR | Von der Idee zur laufenden Software",
  )}
  description={message.sub[locale]}
  canonical={canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  ogImage={ogImage}
  ogImageAlt={copy(
    "Four open INSPR products and a doctrine on one flow from idea to running software",
    "Vier offene INSPR-Produkte und eine Doktrin auf einem Ablauf von der Idee zur laufenden Software",
  )}
  favicon={insprLogo.src}
  theme="inspr"
>
  <MicrositeHeader
    name="INSPR"
    category={locale === "de" ? productTaxonomyDe.inspr : productTaxonomy.inspr}
    logo={insprLogo.src}
    active="inspr"
    nav={nav}
    locale={locale}
    languageLinks={{ en: "/", de: "/de/" }}
    detailsSlider={{
      label: "Details",
      description: copy("How much detail this page shows", "Wie viel Detail diese Seite zeigt"),
      levels: [
        { id: "simple", label: copy("Simple", "Einfach") },
        { id: "standard", label: "Standard" },
        { id: "technical", label: copy("Technical", "Technisch") },
      ],
    }}
  />

  <main id="main-content">
    <ServiceRibbon
      locale={locale}
      text={copy(
        "Augmentoring provides professional implementation and support for the INSPR products.",
        "Augmentoring bietet professionelle Umsetzung und Unterstützung für die INSPR-Produkte.",
      )}
    />

    <section
      class="umbrella-hero page-shell"
      aria-labelledby="hero-title"
      data-section-pattern="editorial-hero"
    >
      <div class="umbrella-hero__copy">
        {/* INSPR-543: the brand line stays; deploy.sh probes it, including after a rollback. */}
        <p class="eyebrow">{copy("Inspiration is the only limit.", "Inspiration ist die einzige Grenze.")}</p>
        <h1 id="hero-title">{message.hero[locale]}</h1>
        <p class="umbrella-hero__lead">{message.sub[locale]}</p>
        <div class="button-row">
          <a class="button" href="#flow">
            {copy("See the flow", "Ablauf ansehen")} <span aria-hidden="true">↓</span>
          </a>
          <a class="button button--ghost" href={repositoryUrl} target="_blank" rel="noopener noreferrer">
            {copy("Read the source", "Quellcode lesen")} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="umbrella-spec details-drawer" data-drawer aria-label={copy("This page, technically", "Diese Seite, technisch")}>
          <div class="details-drawer__inner">
            <div><dt>{copy("release", "Release")}</dt><dd class="umbrella-spec__token">{buildFacts.release}</dd></div>
            <div><dt>{copy("source", "Quelle")}</dt><dd class="umbrella-spec__token">{buildFacts.source}</dd></div>
            <div><dt>{copy("deployed", "veröffentlicht")}</dt><dd class="umbrella-spec__token">{buildFacts.deployed}</dd></div>
            <div><dt>{copy("licence", "Lizenz")}</dt><dd class="umbrella-spec__token">AGPL-3.0-only</dd></div>
            <div><dt>{copy("hosts", "Hosts")}</dt><dd>{copy("1 build · 5 hostnames · 2 languages", "1 Build · 5 Hostnamen · 2 Sprachen")}</dd></div>
          </div>
        </dl>
        <p class="umbrella-hero__note">{message.houseRule[locale]}</p>
      </div>

      <figure class="umbrella-hero__visual">
        <HeroLoop
          id="inspr"
          locale={locale}
          poster={insprHero}
          video={insprHeroLoop}
          alt={copy(
            "A luminous INSPR core with tools for requirements, project, fleet and access around it",
            "Ein leuchtender INSPR-Kern, umgeben von Werkzeugen für Anforderungen, Projekt, Server und Zugriff",
          )}
          sizes="(min-width: 64rem) 54vw, 100vw"
        />
      </figure>
    </section>

    <ul
      class="umbrella-proof page-shell" data-depth-min="standard"
      aria-label={copy("INSPR characteristics and definitions", "INSPR-Merkmale und Erklärungen")}
      data-section-pattern="proof-strip"
    >
      {proofPoints.map((point, index) => (
        <li>
          <a href={point.href}>
            <span class="umbrella-proof__number" aria-hidden="true">0{index + 1}</span>
            <strong>{point.title}</strong>
            <small>{point.definition}</small>
            <span class="umbrella-proof__arrow" aria-hidden="true">↓</span>
          </a>
        </li>
      ))}
    </ul>

    <HomeFlow locale={locale} doctrineHref={modulesUrl} />

    <section
      class="umbrella-products page-shell" data-depth-layout
      id="products"
      aria-labelledby="products-title"
      data-section-pattern="editorial-product-stories"
    >
      <header class="section-intro section-intro--wide">
        <p class="eyebrow">{copy("Four products and a doctrine", "Vier Produkte und eine Doktrin")}</p>
        <h2 id="products-title">
          {copy(
            "Four tools, each with one clear job.",
            "Vier Werkzeuge mit je einer klaren Aufgabe.",
          )}
        </h2>
        <p class="section-lead">
          <DetailLevels
            simple={copy(
              "Use one product or all four. Each one runs on its own.",
              "Nutzen Sie ein Produkt oder alle vier. Jedes läuft für sich.",
            )}
            standard={copy(
              "Adopt one, or all four. Each product runs on its own today; connecting them is being built.",
              "Nutzen Sie eines oder alle vier. Jedes Produkt läuft heute für sich; ihre Verbindung ist im Aufbau.",
            )}
            technical={copy(
              "Each product has its own repository and release, runs standalone and is AGPL-3.0-only. Connecting Paimos, Pharos and Janus through one tool contract is being built.",
              "Jedes Produkt hat ein eigenes Repository und einen eigenen Release, läuft für sich und steht unter AGPL-3.0-only. Die Anbindung von Paimos, Pharos und Janus über einen Werkzeugvertrag ist im Aufbau.",
            )}
          />
        </p>
      </header>

      <div class="product-showcase">
        {products.map((product, index) => (
          <div class="product-story-item">
            <a
              class="product-story-link"
              href={productHref(product.href)}
              target="_blank"
              rel="noopener noreferrer"
              aria-labelledby={`product-${product.name.toLowerCase()}-link`}
            >
              <article class:list={["product-story", { "product-story--reverse": index % 2 === 0 }]}>
                <span class="product-story__visual" data-depth-min="standard">
                  {product.video ? (
                    <HeroLoop
                      id="aithema"
                      poster={product.hero}
                      video={product.video}
                      alt={product.alt}
                      sizes="(min-width: 60rem) 48vw, 100vw"
                      locale={locale}
                      activation="hover"
                      showControl={false}
                      loading="lazy"
                    />
                  ) : (
                    <Image
                      src={product.hero}
                      alt={product.alt}
                      widths={[560, 800, 1120]}
                      sizes="(min-width: 60rem) 48vw, 100vw"
                      quality={82}
                      loading="lazy"
                    />
                  )}
                </span>
                <div class="product-story__copy">
                  <div class="product-story__identity">
                    <img src={product.logo.src} alt="" width="60" height="60" loading="lazy" />
                    <div>
                      <p class="eyebrow">{product.label}</p>
                      <h3 id={`product-${product.name.toLowerCase()}-link`}>{product.name}</h3>
                    </div>
                  </div>
                  <p class="product-story__status">
                    <StatusChip status={familyProducts[product.key].status} locale={locale} />
                    <span class="product-story__release">{productReleases[product.key]}</span>
                    <span class="product-story__licence">AGPL-3.0-only</span>
                    {familyProducts[product.key].statusNote && (
                      <span>{familyProducts[product.key].statusNote?.[locale]}</span>
                    )}
                  </p>
                  <h4 data-depth-min="standard">{familyProducts[product.key].oneLiner[locale]}</h4>
                  <p data-depth-min="standard">{product.body}</p>
                  <p class="product-story__simple" data-depth-max="simple">{product.simple}</p>
                  <div data-depth-min="standard"><p class="product-story__detail">{product.detail}</p></div>
                  <span data-depth-min="standard" class="text-link">
                    {locale === "de" ? `${product.name} ansehen` : `Explore ${product.name}`} <span aria-hidden="true">→</span>
                    <span class="visually-hidden"> ({copy("opens in a new tab", "öffnet in einem neuen Tab")})</span>
                  </span>
                </div>
              </article>
            </a>
            <dl class="product-sheet details-drawer" data-drawer>
              <div class="details-drawer__inner">
                <dt>{sheetLabels.repo}</dt><dd>{product.sheet.repo}</dd>
                <dt>{sheetLabels.runtime}</dt><dd>{product.sheet.runtime}</dd>
                <dt>{sheetLabels.gate}</dt><dd>{product.sheet.gate}</dd>
                <dt>{sheetLabels.artefact}</dt><dd>{product.sheet.artefact}</dd>
                <dt>{sheetLabels.interfaces}</dt><dd>{product.sheet.interfaces}</dd>
                <dt>{sheetLabels.maturity}</dt><dd>{product.sheet.maturity}</dd>
                {product.sheet.command && (
                  <>
                    <dt>{sheetLabels.command}</dt>
                    <dd><code class="product-sheet__command">$ {product.sheet.command}</code></dd>
                  </>
                )}
              </div>
            </dl>
          </div>
        ))}

        <div class="product-story-item product-story-item--doctrine">
          <a
            class="product-story-link"
            href={modulesUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-labelledby="product-doctrine-link"
          >
            <article class="doctrine-card">
              <div class="product-story__identity">
                <img src={insprLogo.src} alt="" width="60" height="60" loading="lazy" />
                <div>
                  <p class="eyebrow">{productRole("doctrine", locale)}</p>
                  <h3 id="product-doctrine-link">{doctrine.name[locale]}</h3>
                </div>
              </div>
              <div class="doctrine-card__copy">
                <p class="product-story__status">
                  <StatusChip status={doctrine.status} locale={locale} />
                  <span class="product-story__licence">AGPL-3.0-only</span>
                </p>
                <h4 data-depth-min="standard">{doctrine.oneLiner[locale]}</h4>
                <p data-depth-min="standard">{doctrineBody}</p>
                <p class="product-story__simple" data-depth-max="simple">{doctrine.oneLiner[locale]}</p>
                <span class="text-link">
                  {locale === "de" ? `${doctrine.name.de} ansehen` : `Explore the ${doctrine.name.en}`} <span aria-hidden="true">→</span>
                  <span class="visually-hidden"> ({copy("opens in a new tab", "öffnet in einem neuen Tab")})</span>
                </span>
              </div>
            </article>
          </a>
        </div>
      </div>
    </section>

    <section data-depth-min="standard"
      class="umbrella-idea"
      id="connect"
