---
import { Image } from "astro:assets";
import MicrositeLayout from "../layouts/MicrositeLayout.astro";
import MicrositeHeader from "../components/MicrositeHeader.astro";
import MicrositeFooter from "../components/MicrositeFooter.astro";
import ServiceRibbon from "../components/ServiceRibbon.astro";
import WorkflowExplorer from "../components/WorkflowExplorer.astro";
import SituationPacket from "../components/SituationPacket.astro";
import PrincipleFieldNotes from "../components/PrincipleFieldNotes.astro";
import HeroLoop from "../components/HeroLoop.astro";
import { productTaxonomy, siteUrls } from "../content/urls";

import insprHero from "../assets/products/inspr/hero.png";
import insprHeroLoop from "../assets/products/inspr/hero-loop.mp4";
import insprLogo from "../assets/products/inspr/logo.svg";
import insprContinuity from "../assets/products/inspr/continuity.png";
import paimosHero from "../assets/products/paimos/hero.png";
import paimosLogo from "../assets/products/paimos/logo.svg";
import pharosHero from "../assets/products/pharos/hero.png";
import pharosLogo from "../assets/products/pharos/mark.svg";
import janusHero from "../assets/products/janus/hero.png";
import janusLogo from "../assets/products/janus/logo.svg";
import aithemaHero from "../assets/products/aithema/hero.png";
import aithemaHeroLoop from "../assets/products/aithema/hero-loop.mp4";
import aithemaLogo from "../assets/products/aithema/logo.svg";
import zitadelLogo from "../assets/brands/zitadel-logo-solo-dark-icon.svg";

const locale: "en" | "de" = Astro.props.locale === "de" ? "de" : "en";
const copy = (english: string, german: string) => locale === "de" ? german : english;

const repositoryUrl = "https://github.com/inspr-at/inspr-site";
const siteLicenseUrl = `${repositoryUrl}/blob/main/LICENSE`;
const umbrellaRepositoryUrl = "https://github.com/inspr-at/inspr";
const modulesUrl = "https://github.com/inspr-at/inspr-modules";
const englishUrl = `${siteUrls.inspr}/`;
const germanUrl = `${siteUrls.inspr}/de/`;
const canonicalUrl = locale === "de" ? germanUrl : englishUrl;
const ogImage = new URL(insprHero.src, englishUrl).href;

const nav = [
  { label: copy("Idea", "Idee"), href: "#idea" },
  { label: copy("Products", "Produkte"), href: "#products" },
  { label: copy("Principles", "Prinzipien"), href: "#principles" },
  { label: copy("Source", "Quellcode"), href: "#source" },
];

const products = [
  {
    name: "Aithema",
    label: copy(productTaxonomy.aithema, "Anforderungen"),
    href: siteUrls.aithema,
    logo: aithemaLogo,
    hero: aithemaHero,
    video: aithemaHeroLoop,
    alt: copy(
      "Open conversational threads becoming one structured and reviewable proposal",
      "Offene Gesprächsfäden werden zu einem strukturierten und prüfbaren Vorschlag",
    ),
    title: copy(
      "Start by talking. Finish with requirements.",
      "Am Anfang steht ein Gespräch. Am Ende stehen klare Anforderungen.",
    ),
    body: copy(
      "Speak, type or add files; Aithema drafts the requirements. Read them and choose Continue when they say what you mean. The public preview runs at start.augmentoring.com, and a reusable open-source module is planned.",
      "Sprechen Sie, schreiben Sie oder fügen Sie Dateien hinzu. Aithema entwirft daraus Anforderungen. Prüfen Sie sie und wählen Sie „Weiter“, sobald sie wirklich passen. Die öffentliche Vorschau läuft auf start.augmentoring.com; ein wiederverwendbares Open-Source-Modul ist geplant.",
    ),
    detail: copy(
      "Conversation · requirements · Continue",
      "Gespräch · Anforderungen · Weiter",
    ),
  },
  {
    name: "Paimos",
    label: copy(productTaxonomy.paimos, "Projektkontext"),
    href: siteUrls.paimos,
    logo: paimosLogo,
    hero: paimosHero,
    video: null,
    alt: copy(
      "A shared project agora where people and agents work around the same project context",
      "Ein gemeinsamer Projektraum, in dem Menschen und Agenten mit demselben Kontext arbeiten",
    ),
    title: copy(
      "Give agents a project, not a prompt.",
      "Geben Sie Agenten ein Projekt, nicht nur einen Prompt.",
    ),
    body: copy(
      "Approved requirements become a project: specs, repository context, decisions and run evidence in one place. Agents build inside it; you review the staged result.",
      "Aus freigegebenen Anforderungen wird ein Projekt: Spezifikationen, Repository-Kontext, Entscheidungen und Laufnachweise an einem Ort. Agenten bauen darin; Sie prüfen das Ergebnis im Staging.",
    ),
    detail: copy(
      "Specs · agent build · staged review",
      "Spezifikationen · Agenten-Build · Prüfung im Staging",
    ),
  },
  {
    name: "Pharos",
    label: copy(productTaxonomy.pharos, "Serverzustand und Backup-Nachweise"),
    href: siteUrls.pharos,
    logo: pharosLogo,
    hero: pharosHero,
    video: null,
    alt: copy(
      "A lighthouse overlooking a calm network of connected fleet nodes",
      "Ein Leuchtturm über einem ruhigen Netz verbundener Server",
    ),
    title: copy(
      "Pick the server. Prove the backup. Then deploy.",
      "Server wählen. Backup prüfen. Dann bereitstellen.",
    ),
    body: copy(
      "You choose where it runs. Pharos verifies a backup before production, and the deploy itself happens only when you approve it.",
      "Sie wählen, wo die Anwendung läuft. Pharos prüft vor der Produktion das Backup. Die Bereitstellung beginnt erst mit Ihrer Freigabe.",
    ),
    detail: copy(
      "Server · verified backup · approved deploy",
      "Server · geprüftes Backup · freigegebene Bereitstellung",
    ),
  },
  {
    name: "Janus",
    label: copy(productTaxonomy.janus, "Governance für Geheimnisse"),
    href: siteUrls.janus,
    logo: janusLogo,
    hero: janusHero,
    video: null,
    alt: copy(
      "A transparent governance gateway mediating approved access between systems",
      "Ein transparentes Governance-Gateway vermittelt freigegebenen Zugriff zwischen Systemen",
    ),
    title: copy(
      "Decide what may act. Keep secrets unseen.",
      "Bestimmen Sie, was handeln darf. Geheimnisse bleiben verborgen.",
    ),
    body: copy(
      "Janus enforces what may act under an approved permit and rotates access without exposing a secret. Broader permissions, users, roles and ZITADEL integration are planned for later.",
      "Janus setzt durch, was mit einer freigegebenen Erlaubnis handeln darf, und rotiert Zugriffe, ohne Geheimnisse offenzulegen. Umfassendere Berechtigungen, Benutzer, Rollen und die ZITADEL-Integration sind für später geplant.",
    ),
    detail: copy(
      "Permits · rotation · no exposed secrets",
      "Erlaubnisse · Rotation · keine offengelegten Geheimnisse",
    ),
  },
];

const proofPoints = [
  {
    title: copy("Human review", "Menschliche Prüfung"),
    definition: copy(
      "Work advances only after you approve it.",
      "Die Arbeit geht erst nach Ihrer Freigabe weiter.",
    ),
    href: "#flow",
  },
  {
    title: copy("Yours to keep", "Bleibt in Ihrer Hand"),
    definition: copy(
      "Source, data, servers and evidence stay with you.",
      "Quellcode, Daten, Server und Nachweise bleiben bei Ihnen.",
    ),
    href: "#source",
  },
  {
    title: copy("Difficult parts handled", "Schwieriges wird erledigt"),
    definition: copy(
      "Context, checks, backups and access are the tools' job.",
      "Kontext, Prüfungen, Backups und Zugriffe übernehmen die Werkzeuge.",
    ),
    href: "#flow",
  },
  {
    title: copy("Open foundations", "Offene Grundlage"),
    definition: copy(
      "Read the code, run it yourself, change it.",
      "Lesen Sie den Code, betreiben Sie ihn selbst und ändern Sie ihn.",
    ),
    href: "#source",
  },
];

const principles = [
  {
    number: "01",
    title: copy("Context travels with the work", "Kontext reist mit der Arbeit"),
    body: copy(
      "Requirements, specs, code, server state and operating rules move together, so no one starts from a blank page.",
      "Anforderungen, Spezifikationen, Code, Serverzustand und Betriebsregeln bleiben zusammen. So beginnt niemand auf einer leeren Seite.",
    ),
    avoids: copy(
      "Re-explained systems and agents working blind.",
      "Wiederholte Erklärungen und Agenten im Blindflug.",
    ),
    protects: copy(
      "One current picture, shared by people and agents.",
      "Ein aktuelles Bild für Menschen und Agenten.",
    ),
  },
  {
    number: "02",
    title: copy("Approval is a visible act", "Freigabe ist eine sichtbare Handlung"),
    body: copy(
      "Requirements, builds, production deploys and permission changes each pass through a decision someone made on purpose.",
      "Anforderungen, Builds, Produktionsbereitstellungen und Berechtigungsänderungen durchlaufen jeweils eine bewusste Entscheidung.",
    ),
    avoids: copy(
      "Quiet escalation and accidental production authority.",
      "Stille Eskalation und versehentliche Produktionsrechte.",
    ),
    protects: copy(
      "A person at every handoff.",
      "Eine Person an jeder Übergabe.",
    ),
  },
  {
    number: "03",
    title: copy("A way back is part of the change", "Der Rückweg gehört zur Änderung"),
    body: copy(
      "Back up before production, record what actually ran and keep a tested path to the previous state.",
      "Sichern Sie vor der Produktion, halten Sie den tatsächlichen Lauf fest und bewahren Sie einen geprüften Weg zum vorigen Zustand.",
    ),
    avoids: copy(
      "Deploys you cannot reverse and recovery from memory.",
      "Nicht umkehrbare Bereitstellungen und Wiederherstellung aus dem Gedächtnis.",
    ),
    protects: copy(
      "Your systems and a known rollback.",
      "Ihre Systeme und einen bekannten Rollback.",
    ),
  },
];

const productFlowSteps = [
  {
    number: "01",
    title: copy("Aithema · Requirements", "Aithema · Anforderungen"),
    visual: { x: 18, y: 61 },
    body: copy(
      "Describe the need in conversation and files. Aithema drafts the requirements; read them and choose Continue when they are right.",
      "Beschreiben Sie den Bedarf im Gespräch und mit Dateien. Aithema entwirft die Anforderungen. Lesen Sie sie und wählen Sie „Weiter“, sobald sie stimmen.",
    ),
    icon: "mic",
    signal: copy(
      "The requirements wait for your Continue.",
      "Die Anforderungen warten auf Ihr „Weiter“.",
    ),
    reference: {
      label: copy("Open Aithema", "Aithema öffnen"),
      href: siteUrls.aithema,
      external: true,
    },
  },
  {
    number: "02",
    title: copy("Paimos · Build", "Paimos · Bauen"),
    visual: { x: 38, y: 51 },
    body: copy(
      "The approved requirements become a project with specs. Agents build with that context, and the result lands in staging for your review.",
      "Aus den freigegebenen Anforderungen wird ein Projekt mit Spezifikationen. Agenten bauen mit diesem Kontext; das Ergebnis landet zur Prüfung im Staging.",
    ),
    icon: "folder-kanban",
    signal: copy(
      "Staging waits for your review.",
      "Das Staging wartet auf Ihre Prüfung.",
    ),
    reference: {
      label: copy("Open Paimos", "Paimos öffnen"),
      href: siteUrls.paimos,
      external: true,
    },
  },
  {
    number: "03",
    title: copy("Pharos · Deploy", "Pharos · Bereitstellen"),
    visual: { x: 59, y: 55 },
    body: copy(
      "Select the target server. Pharos verifies a backup first; the production deploy then asks for your approval.",
      "Wählen Sie den Zielserver. Pharos prüft zuerst ein Backup; danach wartet die Produktionsbereitstellung auf Ihre Freigabe.",
    ),
    icon: "server-cog",
    signal: copy(
      "Production waits for your approval.",
      "Die Produktion wartet auf Ihre Freigabe.",
    ),
    reference: {
      label: copy("Open Pharos", "Pharos öffnen"),
      href: siteUrls.pharos,
      external: true,
    },
  },
  {
    number: "04",
    title: copy("Janus · Enforce", "Janus · Durchsetzen"),
    visual: { x: 81, y: 58 },
    body: copy(
      "Enforce what may act under an approved permit and rotate access without exposing secrets. Broader permissions, users, roles and ZITADEL integration are planned for later.",
      "Setzen Sie durch, was mit einer freigegebenen Erlaubnis handeln darf, und rotieren Sie Zugriffe, ohne Geheimnisse offenzulegen. Umfassendere Berechtigungen, Benutzer, Rollen und die ZITADEL-Integration sind für später geplant.",
    ),
    icon: "lock-keyhole",
    signal: copy(
      "Access changes wait for your approval.",
      "Zugriffsänderungen warten auf Ihre Freigabe.",
    ),
    reference: {
      label: copy("Open Janus", "Janus öffnen"),
      href: siteUrls.janus,
      external: true,
    },
  },
];
---

<MicrositeLayout
  title={copy(
    "INSPR | From idea to running software, with a person at every handoff",
    "INSPR | Von der Idee zur laufenden Software, mit Menschen an jeder Übergabe",
  )}
  description={copy(
    "Aithema shapes requirements, Paimos gives agents a project, Pharos deploys with a verified backup, Janus governs access. A person approves every handoff.",
    "Aithema formt Anforderungen, Paimos gibt Agenten ein Projekt, Pharos stellt mit geprüftem Backup bereit, Janus regelt den Zugriff. Jede Übergabe wird von einem Menschen freigegeben.",
  )}
  canonical={canonicalUrl}
  locale={locale}
  alternateEnglish={englishUrl}
  alternateGerman={germanUrl}
  detectLocale={locale === "en"}
  ogImage={ogImage}
  ogImageAlt={copy(
    "The four INSPR products connected from requirements to governed operation",
    "Die vier INSPR-Produkte verbinden Anforderungen mit einem kontrollierten Betrieb",
  )}
  favicon={insprLogo.src}
  theme="inspr"
>
  <MicrositeHeader
    name="INSPR"
    category={copy(productTaxonomy.inspr, "Offene Produktfamilie")}
    logo={insprLogo.src}
    active="inspr"
    nav={nav}
    showSignIn={true}
    locale={locale}
    languageLinks={{ en: "/", de: "/de/" }}
  />

  <main id="main-content">
    <ServiceRibbon
      locale={locale}
      text={copy(
        "Augmentoring provides professional implementation and support for the INSPR products.",
        "Augmentoring bietet professionelle Umsetzung und Unterstützung für die INSPR-Produkte.",
      )}
    />

    <section
      class="umbrella-hero page-shell"
      aria-labelledby="hero-title"
      data-section-pattern="editorial-hero"
    >
      <div class="umbrella-hero__copy">
        <p class="eyebrow">{copy("The idea", "Die Idee")}</p>
        <h1 id="hero-title">{copy("Inspiration is the only limit.", "Inspiration ist die einzige Grenze.")}</h1>
        <p class="umbrella-hero__lead">
          {copy(
            "Talk through what you want to build. Aithema writes the requirements, Paimos gives agents the project, Pharos handles deployment and Janus controls access. Every handoff waits for you.",
            "Besprechen Sie, was Sie bauen wollen. Aithema schreibt die Anforderungen, Paimos gibt Agenten das Projekt, Pharos übernimmt die Bereitstellung und Janus kontrolliert den Zugriff. Jede Übergabe wartet auf Sie.",
          )}
        </p>
        <div class="button-row">
          <a class="button" href="#flow">
            {copy("See the flow", "Ablauf ansehen")} <span aria-hidden="true">↓</span>
          </a>
          <a class="button button--ghost" href={repositoryUrl} target="_blank" rel="noopener noreferrer">
            {copy("Read the source", "Quellcode lesen")} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="umbrella-hero__note">
          {copy(
            "The tools carry the difficult parts. The decisions stay with you.",
            "Die Werkzeuge übernehmen die schwierigen Teile. Die Entscheidungen bleiben bei Ihnen.",
          )}
        </p>
      </div>

      <figure class="umbrella-hero__visual">
        <HeroLoop
          id="inspr"
          locale={locale}
          poster={insprHero}
          video={insprHeroLoop}
          alt={copy(
            "A luminous INSPR core connecting requirements, project, fleet and governance tools",
            "Ein leuchtender INSPR-Kern verbindet Werkzeuge für Anforderungen, Projekt, Server und Governance",
          )}
          sizes="(min-width: 64rem) 54vw, 100vw"
        />
        <figcaption>
          {copy(
            "Four tools, one path, a review at every handoff.",
            "Vier Werkzeuge, ein Weg, eine Prüfung an jeder Übergabe.",
          )}
        </figcaption>
      </figure>
    </section>

    <ul
      class="umbrella-proof page-shell"
      aria-label={copy("INSPR characteristics and definitions", "INSPR-Merkmale und Erklärungen")}
      data-section-pattern="proof-strip"
    >
      {proofPoints.map((point, index) => (
        <li>
          <a href={point.href}>
            <span class="umbrella-proof__number" aria-hidden="true">0{index + 1}</span>
            <strong>{point.title}</strong>
            <small>{point.definition}</small>
            <span class="umbrella-proof__arrow" aria-hidden="true">↓</span>
          </a>
        </li>
      ))}
    </ul>

    <section
      class="umbrella-idea"
      id="idea"
      aria-labelledby="idea-title"
      data-section-pattern="situation-packet"
    >
      <div class="page-shell umbrella-idea__grid">
        <header>
          <p class="eyebrow">{copy("In plain terms", "Einfach gesagt")}</p>
          <h2 id="idea-title">{copy("The tools handle the difficult parts.", "Die Werkzeuge übernehmen die schwierigen Teile.")}</h2>
        </header>
        <div class="umbrella-idea__copy">
          <p class="section-lead">
            {copy(
              "Start from the thing you want to build. The tools carry requirements, project context, deployment safety and access control alongside it.",
              "Beginnen Sie mit dem, was Sie bauen wollen. Die Werkzeuge tragen Anforderungen, Projektkontext, sichere Bereitstellung und Zugriffskontrolle mit.",
            )}
          </p>
          <p>
            {copy(
              "You approve each step. The requirements, source, infrastructure and evidence remain under your control.",
              "Sie geben jeden Schritt frei. Anforderungen, Quellcode, Infrastruktur und Nachweise bleiben unter Ihrer Kontrolle.",
            )}
          </p>
        </div>
        <SituationPacket locale={locale} />
      </div>
    </section>

    <section
      class="umbrella-products page-shell"
      id="products"
      aria-labelledby="products-title"
      data-section-pattern="editorial-product-stories"
    >
      <header class="section-intro section-intro--wide">
        <p class="eyebrow">{copy("Four products", "Vier Produkte")}</p>
        <h2 id="products-title">
          {copy(
            "Four tools, each with one clear job.",
            "Vier Werkzeuge mit je einer klaren Aufgabe.",
          )}
        </h2>
        <p class="section-lead">
          {copy(
            "Adopt one, or follow the whole path from requirements to enforced access. Between every two steps stands a person who chooses to continue.",
            "Nutzen Sie eines oder folgen Sie dem ganzen Weg von Anforderungen bis zum geregelten Zugriff. Zwischen zwei Schritten entscheidet immer ein Mensch, ob es weitergeht.",
          )}
        </p>
      </header>

      <div class="product-showcase">
        {products.map((product, index) => (
          <a
            class="product-story-link"
            href={product.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-labelledby={`product-${product.name.toLowerCase()}-link`}
          >
            <article class:list={["product-story", { "product-story--reverse": index % 2 === 0 }]}>
              <span class="product-story__visual">
                {product.video ? (
                  <HeroLoop
                    id="aithema"
                    poster={product.hero}
                    video={product.video}
                    alt={product.alt}
                    sizes="(min-width: 60rem) 48vw, 100vw"
                    locale={locale}
                    activation="hover"
                    showControl={false}
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={product.hero}
                    alt={product.alt}
                    widths={[560, 800, 1120]}
                    sizes="(min-width: 60rem) 48vw, 100vw"
                    quality={82}
                    loading="lazy"
                  />
                )}
              </span>
              <div class="product-story__copy">
                <div class="product-story__identity">
                  <img src={product.logo.src} alt="" width="60" height="60" loading="lazy" />
                  <div>
                    <p class="eyebrow">{product.label}</p>
                    <h3>{product.name}</h3>
                  </div>
                </div>
                <h4>{product.title}</h4>
                <p>{product.body}</p>
                <p class="product-story__detail">{product.detail}</p>
                <span class="text-link" id={`product-${product.name.toLowerCase()}-link`}>
                  {copy("Explore", "Ansehen")} {product.name} <span aria-hidden="true">→</span>
                  <span class="visually-hidden"> ({copy("opens in a new tab", "öffnet in einem neuen Tab")})</span>
                </span>
              </div>
            </article>
          </a>
        ))}

      </div>
    </section>

    <section
      class="identity-utility page-shell"
      aria-labelledby="identity-title"
      data-section-pattern="identity-bridge"
    >
      <div class="identity-utility__mark">
        <img src={zitadelLogo.src} alt="ZITADEL logo" width="72" height="72" loading="lazy" />
      </div>
      <div class="identity-utility__copy">
        <p class="eyebrow">{copy("Shared utility · third party", "Gemeinsamer Dienst · Drittanbieter")}</p>
        <h2 id="identity-title">
          {copy(
            "Sign in once. Permissions stay with each product.",
            "Einmal anmelden. Berechtigungen bleiben beim jeweiligen Produkt.",
          )}
        </h2>
        <p>
          {copy(
            "ZITADEL provides the sign-in and nothing more. What a signed-in identity may do is decided inside each product. Deeper Janus user and role integration is planned for later.",
            "ZITADEL übernimmt die Anmeldung und nichts weiter. Was eine angemeldete Identität tun darf, entscheidet jedes Produkt selbst. Eine tiefere Integration von Benutzern und Rollen in Janus ist für später geplant.",
          )}
        </p>
        <ul class="identity-utility__facts" aria-label={copy("Identity service properties", "Eigenschaften des Identitätsdienstes")}>
          <li>{copy("Self-hosted", "Selbst betrieben")}</li>
          <li>OIDC</li>
          <li>{copy("Role-aware", "Rollenfähig")}</li>
        </ul>
      </div>
      <div class="identity-utility__links">
        <p>{copy("Shared access", "Gemeinsamer Zugang")}</p>
        <a class="button" href={siteUrls.signIn} target="_blank" rel="noopener noreferrer">{copy("Sign in", "Anmelden")}</a>
        <a class="identity-utility__service" href={siteUrls.identity} target="_blank" rel="noopener noreferrer">
          {copy("Open identity service", "Identitätsdienst öffnen")} <span aria-hidden="true">↗</span>
        </a>
        <small>auth.inspr.at · {copy("powered by ZITADEL", "bereitgestellt mit ZITADEL")}</small>
      </div>
    </section>

    <WorkflowExplorer
      locale={locale}
      id="flow"
      eyebrow={copy("Four steps, four approvals", "Vier Schritte, vier Freigaben")}
      title={copy("The work moves. You decide when.", "Die Arbeit kommt voran. Sie bestimmen, wann.")}
      lead={copy(
        "Requirements, staged build, production deploy, access: four approvals, each backed by evidence the tool puts in front of you.",
        "Anforderungen, Build im Staging, Produktionsbereitstellung, Zugriff: vier Freigaben, jeweils gestützt auf Nachweise des Werkzeugs.",
      )}
      steps={productFlowSteps}
      image={insprContinuity}
      alt={copy(
        "Four connected chambers carrying work through Aithema, Paimos, Pharos and Janus with a human approval at every handoff.",
        "Vier verbundene Bereiche führen die Arbeit durch Aithema, Paimos, Pharos und Janus, mit menschlicher Freigabe an jeder Übergabe.",
      )}
      closing={copy(
        "At the end, everything is yours: the requirements, the source, the infrastructure, the permissions and the evidence behind every decision.",
        "Am Ende gehört alles Ihnen: Anforderungen, Quellcode, Infrastruktur, Berechtigungen und die Nachweise hinter jeder Entscheidung.",
      )}
      tone="light"
      pattern="guided-workflow"
    />

    <section
      class="umbrella-principles page-shell"
      id="principles"
      aria-labelledby="principles-title"
