---
// v2 Artifacts — each card has its own image inset, generated by cropping
// the same source image (a row of four geometric solids) at four different
// horizontal positions. Same imagery becomes part of each card's identity.
import { Image } from "astro:assets";
import plateImg from "../assets/v2/artifacts.jpg";

const artifacts = [
  {
    name: "Paimos",
    tagline: "Project management upstream of agents",
    status: "live",
    body: "A typed CLI and service for issues, anchors, plans, manifests. The first product to live inside INSPR. JSON-everywhere by default.",
    link: { href: "https://paimos.com", label: "paimos.com" },
    cropX: "12%",
  },
  {
    name: "FleetCom",
    tagline: "Declarative fleet management plane",
    status: "in flight",
    body: "Host-class profiles, declarative apply, a registry of typed verbs. Runs at fleet.barta.cm in the personal context.",
    link: null,
    cropX: "38%",
  },
  {
    name: "Bosun",
    tagline: "Per-host agent under FleetCom",
    status: "forthcoming",
    body: "One process per fleet member. Outward-facing API is a typed, versioned verb set with --json everywhere — the contract any harness adapter targets.",
    link: null,
    cropX: "62%",
  },
  {
    name: "inspr-modules",
    tagline: "Public flake of reusable modules",
    status: "live",
    body: "Mechanics public, values per-context. Same module composes into personal nixcfg, BYTEPOETS internal, family, future paid contexts.",
    link: null,
    cropX: "88%",
  },
];
---

<section class="v2-section v2-artifacts reveal-soft" id="artifacts" aria-labelledby="artifacts-h">
  <header class="v2-artifacts__head">
    <p class="marginalia v2-artifacts__chapter">
      <span class="dim">Ch&nbsp;</span>04 &middot; The artifacts
    </p>
    <span class="v2-chapter-rule" aria-hidden="true"></span>
    <h2 id="artifacts-h">Concrete things, named&nbsp;plainly.</h2>
    <p class="lede">
      What INSPR <em>is</em>, by the things it ships. Status is honest:
      live means running daily, in flight means exists but not at scale,
      forthcoming means designed but not yet built.
    </p>
  </header>

  <ol class="v2-artifacts__grid">
    {artifacts.map((a) => (
      <li class={`v2-artifact v2-artifact--${a.status.replace(/\s+/g, "-")}`}>
        <div class="v2-plate v2-artifact__plate">
          <Image
            src={plateImg}
            alt=""
            widths={[300, 450, 600, 900]}
            sizes="(min-width: 78rem) 22vw, (min-width: 40rem) 44vw, 100vw"
            formats={["avif", "webp", "jpeg"]}
            quality={82}
            loading="lazy"
            style={`object-position: ${a.cropX} center;`}
          />
        </div>
        <header class="v2-artifact__head">
          <h3 class="v2-artifact__name">{a.name}</h3>
          <span class={`v2-artifact__status v2-artifact__status--${a.status.replace(/\s+/g, "-")} mono`}>
            {a.status}
          </span>
        </header>
        <p class="v2-artifact__tagline">{a.tagline}</p>
        <p class="v2-artifact__body">{a.body}</p>
        {a.link && (
          <a class="v2-artifact__link mono" href={a.link.href}>
            {a.link.label}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .v2-artifacts {
    container-type: inline-size;
    padding-inline: clamp(1.25rem, 5cqi, 4rem);
    padding-block: clamp(4rem, 9cqi, 8rem);
  }

  .v2-artifacts__head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-inline-size: var(--measure-wide);
    margin-block-end: clamp(2.5rem, 5cqi, 4rem);
  }

  .v2-artifacts__chapter {
    color: var(--text-faint);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--t-xs);
  }
  .v2-artifacts__chapter .dim { opacity: 0.55; }

  .v2-artifacts__head h2 {
    font-size: var(--t-3xl);
    margin: 0;
  }
  .v2-artifacts__head .lede { margin: 0; }

  .v2-artifacts__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3cqi, 2.5rem);
  }

  @container (inline-size > 40rem) {
    .v2-artifacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (inline-size > 78rem) {
    .v2-artifacts__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .v2-artifact {
    display: grid;
    grid-template-rows: auto auto auto auto auto;
    gap: 0.7rem;
    transition: transform var(--dur-medium) var(--ease);
    container-type: inline-size;
  }

  .v2-artifact:hover {
    transform: translateY(-2px);
  }

  .v2-artifact__plate {
    aspect-ratio: 1 / 1;
    inline-size: 100%;
    margin-block-end: 0.4rem;
  }

  .v2-artifact__plate img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }

  .v2-artifact:hover .v2-artifact__plate img {
    transform: scale(1.04);
  }

  .v2-artifact__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .v2-artifact__name {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 480, "SOFT" 8, "WONK" 0;
    font-size: var(--t-xl);
    line-height: 1;
    margin: 0;
    color: var(--text);
  }

  .v2-artifact__status {
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    border-radius: 999px;
    border: 1px solid currentColor;
    line-height: 1.3;
    white-space: nowrap;
  }

  .v2-artifact__status--live { color: var(--accent); }
  .v2-artifact__status--in-flight { color: var(--text-muted); }
  .v2-artifact__status--forthcoming {
    color: var(--text-faint);
    opacity: 0.85;
  }

  .v2-artifact__tagline {
    color: var(--text);
    font-style: italic;
    font-size: var(--t-base);
    margin: 0;
    line-height: 1.4;
  }

  .v2-artifact__body {
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: 1.6;
    margin: 0;
  }

  .v2-artifact__link {
    margin-block-start: 0.4rem;
    color: var(--text);
    font-size: var(--t-xs);
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    text-decoration: none;
    border-block-end: 1px solid var(--rule);
    padding-block-end: 0.18em;
    transition: border-block-end-color var(--dur-quick) var(--ease);
    inline-size: fit-content;
  }

  .v2-artifact__link:hover,
  .v2-artifact__link:focus-visible {
    border-block-end-color: var(--accent);
  }
</style>
