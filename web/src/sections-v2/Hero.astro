---
// v2 Hero — full-bleed atmospheric image as canvas; type sits on top.
// The v2 hero image is a single light line on matte black metal, so we
// mostly let it dominate; type column has a subtle scrim for legibility.
import { Image } from "astro:assets";
import heroImage from "../assets/v2/hero.jpg";
---

<section class="v2-hero" aria-label="INSPR">
  <Image
    src={heroImage}
    alt=""
    widths={[768, 1024, 1376, 1920, 2560]}
    sizes="100vw"
    formats={["avif", "webp", "jpeg"]}
    quality={84}
    loading="eager"
    fetchpriority="high"
    class="v2-hero__plate"
  />

  <div class="v2-hero__inner">
    <p class="v2-hero__eyebrow mono">
      <span class="v2-hero__mark" aria-hidden="true">▋</span>
      <span><span class="dim">inspr.at</span> · ed. 02</span>
    </p>

    <h1 class="display v2-hero__h1">Upstream of the&nbsp;substrate.</h1>

    <p class="lede v2-hero__lede">
      A durable home for your wants — declarative at the centre,
      plural at the edges. INSPR outlives whichever agent, model,
      or tool happens to be in vogue.
    </p>

    <nav class="v2-hero__nav" aria-label="Primary">
      <a class="v2-hero__cta" href="#agent-contract">
        <span>Read the architecture</span>
        <span class="v2-hero__cta-mark" aria-hidden="true">→</span>
      </a>
      <a class="v2-hero__cta v2-hero__cta--quiet" href="#artifacts">
        <span>Index of artifacts</span>
      </a>
    </nav>
  </div>

  <aside class="v2-hero__margin marginalia" aria-hidden="true">
    <ul>
      <li><span class="dim">v</span>2.0</li>
      <li><span class="dim">date</span> 2026·05</li>
      <li><span class="dim">register</span> ed. 02 / tech-affinity</li>
      <li><span class="dim">stock</span> Fraunces / Inria&nbsp;Sans / JetBrains&nbsp;Mono</li>
    </ul>
  </aside>
</section>

<style>
  .v2-hero {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    min-block-size: 92dvh;
    display: grid;
    align-content: center;
    padding-inline: clamp(1.25rem, 5cqi, 4rem);
    padding-block: clamp(3rem, 8cqi, 7rem);
    overflow: hidden;
    background-color: var(--bg);
  }

  .v2-hero__plate {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 60% center;
    mix-blend-mode: normal;
    filter: contrast(1.0) saturate(0.9) brightness(0.92);
  }

  /* Legibility scrim — fades from cream-opacity at left to transparent
     at right so type stays readable over the image. */
  .v2-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to right,
        oklch(from var(--bg) l c h / 0.92) 0%,
        oklch(from var(--bg) l c h / 0.7) 28%,
        oklch(from var(--bg) l c h / 0.3) 56%,
        transparent 78%
      );
    pointer-events: none;
  }

  @media (prefers-color-scheme: dark) {
    .v2-hero::before {
      background:
        linear-gradient(
          to right,
          oklch(from var(--bg) l c h / 0.86) 0%,
          oklch(from var(--bg) l c h / 0.6) 28%,
          oklch(from var(--bg) l c h / 0.18) 56%,
          transparent 78%
        );
    }
  }

  .v2-hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3.4cqi, 3rem);
    max-inline-size: 64ch;
    z-index: 1;
  }

  .v2-hero__eyebrow {
    font-size: var(--t-xs);
    color: var(--text-faint);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .v2-hero__eyebrow .dim { opacity: 0.65; }

  .v2-hero__mark {
    color: var(--accent);
  }

  .v2-hero__h1 {
    font-size: var(--hero);
    --fr-opsz: 144;
    --fr-soft: 0;
    --fr-wonk: 0;
    margin: 0;
    color: var(--text);
    animation: hero-soften var(--dur-bloom) var(--ease) 220ms forwards;
  }

  .v2-hero__h1 { cursor: text; }

  .v2-hero__lede {
    margin: 0;
    max-inline-size: 56ch;
  }

  .v2-hero__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2.5cqi, 1.75rem) clamp(1.5rem, 3cqi, 2.5rem);
    margin-block-start: 0.4rem;
    align-items: baseline;
  }

  .v2-hero__cta {
    --line-color: var(--text);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--t-base);
    color: var(--text);
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
    padding-block-end: 0.32em;
    border-block-end: 1px solid var(--line-color);
    transition:
      --line-color var(--dur-quick) var(--ease),
      letter-spacing var(--dur-medium) var(--ease);
  }

  .v2-hero__cta:hover,
  .v2-hero__cta:focus-visible {
    --line-color: var(--accent);
    letter-spacing: 0.005em;
  }

  .v2-hero__cta-mark {
    font-family: var(--font-mono);
    font-size: 0.92em;
    transition: translate var(--dur-medium) var(--ease);
  }

  .v2-hero__cta:hover .v2-hero__cta-mark,
  .v2-hero__cta:focus-visible .v2-hero__cta-mark {
    translate: 0.3em 0;
  }

  .v2-hero__cta--quiet {
    --line-color: var(--rule);
    color: var(--text-muted);
  }

  .v2-hero__margin {
    display: none;
  }

  @container (inline-size > 60rem) {
    .v2-hero__margin {
      position: absolute;
      inset-block-end: clamp(2rem, 4cqi, 3rem);
      inset-inline-end: clamp(2rem, 4cqi, 3rem);
      display: block;
      padding: 0.85em 1em;
      background-color: oklch(from var(--bg) l c h / 0.75);
      backdrop-filter: blur(8px) saturate(1.1);
      -webkit-backdrop-filter: blur(8px) saturate(1.1);
      border: 1px solid var(--rule-soft);
      border-radius: 3px;
      z-index: 1;
    }
  }

  .v2-hero__margin ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4em;
  }

  .v2-hero__margin .dim {
    color: var(--text-faint);
    opacity: 0.55;
    margin-inline-end: 0.4em;
  }
</style>
