---
// Artifacts — concrete things INSPR is shipping today.
// Container-query-aware grid: 1 column narrow, 2 columns mid, 4 columns wide.
//
// Sources of truth:
//   architecture.md §1.6, §1.7  → Bosun verb set, fleet decision agent
//   playbook.md "Automation horizon" → FleetCom + Bosun
//   inspr-modules public flake → modular composition validated
//
// Status vocabulary:
//   live        — running daily today
//   in flight   — exists, not yet operating at scale
//   forthcoming — designed, not yet shipped
import { Image } from "astro:assets";
import plateImg from "../assets/artifacts.png";

const artifacts = [
  {
    name: "Paimos",
    tagline: "Project management upstream of agents",
    status: "live",
    body: "A typed CLI and service for issues, anchors, plans, and manifests. The first product to live inside INSPR. JSON-everywhere by default; the tool an agent and an operator can both reach for without reading different docs.",
    link: { href: "https://paimos.com", label: "paimos.com" },
  },
  {
    name: "FleetCom",
    tagline: "Declarative fleet management plane",
    status: "in flight",
    body: "The control plane that keeps an INSPR fleet in sync. Host-class profiles, declarative apply, and a registry of typed verbs. Public source; runs in the personal context today, opens to company and family contexts as their adapter shape stabilises.",
    link: { href: "https://github.com/markus-barta/fleetcom", label: "github.com/…/fleetcom" },
  },
  {
    name: "Bosun",
    tagline: "Per-host agent under FleetCom",
    status: "forthcoming",
    body: "One process per fleet member. The outward-facing API is a typed, versioned verb set with --json everywhere — the contract any harness adapter targets. Verbs evolve under SemVer; adapters declare which version they expect.",
    link: null,
  },
  {
    name: "inspr-modules",
    tagline: "Public flake of reusable modules",
    status: "live",
    body: "Mechanics public, values per-context. The same module — Tailscale-on-Headscale, agenix bootstrap, dev-tool bundles — composes into a personal nixcfg, a company-internal flake, a family flake, future paid contexts. Validated by two structurally-different consumers.",
    link: null,
  },
];
---

<section class="artifacts reveal-soft" id="artifacts" aria-labelledby="artifacts-h">
  <figure class="plate">
    <Image
      src={plateImg}
      alt=""
      widths={[768, 1024, 1376, 1920]}
      sizes="(min-width: 60rem) 80vw, 100vw"
      formats={["avif", "webp", "jpeg"]}
      quality={82}
      loading="lazy"
    />
  </figure>

  <header class="artifacts__head">
    <p class="marginalia artifacts__chapter">
      <span class="dim">Ch&nbsp;</span>04 &middot; The artifacts
    </p>
    <h2 id="artifacts-h">Concrete things, named&nbsp;plainly.</h2>
    <p class="lede">
      What INSPR <em>is</em>, by the things it ships. Status is honest:
      live means running daily, in flight means exists but not at scale,
      forthcoming means designed but not yet built.
    </p>
  </header>

  <ol class="artifacts__grid">
    {artifacts.map((a) => (
      <li class="artifact">
        <header class="artifact__head">
          <h3 class="artifact__name">{a.name}</h3>
          <span class={`artifact__status artifact__status--${a.status.replace(/\s+/g, "-")} mono`}>
            {a.status}
          </span>
        </header>
        <p class="artifact__tagline">{a.tagline}</p>
        <p class="artifact__body">{a.body}</p>
        {a.link && (
          <a class="artifact__link mono" href={a.link.href}>
            {a.link.label}
            <span class="artifact__link-mark" aria-hidden="true">↗</span>
          </a>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .artifacts {
    container-type: inline-size;
    padding-inline: clamp(1.25rem, 5cqi, 4rem);
    padding-block: clamp(4rem, 9cqi, 8rem);
    border-block-start: 1px solid var(--rule-soft);
  }

  .artifacts__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-inline-size: var(--measure-wide);
    margin-block-end: clamp(2.5rem, 5cqi, 4.5rem);
  }

  .artifacts__chapter {
    color: var(--text-faint);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--t-xs);
  }
  .artifacts__chapter .dim { opacity: 0.55; }

  .artifacts__head h2 {
    font-size: var(--t-3xl);
    margin: 0;
  }
  .artifacts__head .lede { margin: 0; }

  .artifacts__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3cqi, 2.5rem);
  }

  /* Two columns at >40rem container width */
  @container (inline-size > 40rem) {
    .artifacts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Four columns at >78rem (typically big laptop / 27" / 32" 6K) */
  @container (inline-size > 78rem) {
    .artifacts__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .artifact {
    display: grid;
    grid-template-rows: auto auto auto auto;
    gap: 0.85rem;
    border-block-start: 1px solid var(--rule);
    padding-block-start: 1.4rem;
    transition: border-block-start-color var(--dur-medium) var(--ease);
    container-type: inline-size;
  }

  .artifact:hover,
  .artifact:focus-within {
    border-block-start-color: var(--accent);
  }

  .artifact__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .artifact__name {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 460, "SOFT" 30, "WONK" 0;
    font-size: var(--t-xl);
    line-height: 1;
    margin: 0;
    color: var(--text);
  }

  .artifact__status {
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.22em 0.6em;
    border-radius: 999px;
    border: 1px solid currentColor;
    line-height: 1.3;
    white-space: nowrap;
  }

  .artifact__status--live {
    color: var(--accent);
  }
  .artifact__status--in-flight {
    color: var(--text-muted);
  }
  .artifact__status--forthcoming {
    color: var(--text-faint);
    opacity: 0.85;
  }

  .artifact__tagline {
    color: var(--text);
    font-style: italic;
    font-size: var(--t-base);
    margin: 0;
    line-height: 1.4;
    max-inline-size: 30ch;
  }

  .artifact__body {
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: 1.6;
    margin: 0;
    max-inline-size: 38ch;
  }

  .artifact__link {
    align-self: end;
    margin-block-start: 0.4rem;
    color: var(--text);
    font-size: var(--t-xs);
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    text-decoration: none;
    border-block-end: 1px solid var(--rule);
    padding-block-end: 0.18em;
    transition: border-block-end-color var(--dur-quick) var(--ease);
    align-self: start;
    inline-size: fit-content;
  }

  .artifact__link:hover,
  .artifact__link:focus-visible {
    border-block-end-color: var(--accent);
  }

  .artifact__link-mark {
    transition: translate var(--dur-medium) var(--ease);
  }
  .artifact__link:hover .artifact__link-mark,
  .artifact__link:focus-visible .artifact__link-mark {
    translate: 0.18em -0.18em;
  }
</style>
