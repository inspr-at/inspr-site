---
// Pipeline — five-step horizontal flow, mom-readable.
//
// Default state shows ONE word per step (Want · Talk · Plan · Make · Keep)
// — universal verbs anyone gets, no jargon. Hover (desktop) or tap
// (mobile, via <details>/<summary>) reveals the engineering reading
// underneath: a one-line description in the architecture's vocabulary.
//
// Reveal layering:
//   - Fraunces SOFT axis tightens 40 → 8 (informal → engineered)
//   - ember underline draws beneath the title (0 → 2.5em)
//   - "+" cue rotates to "×"
//   - description slides in via grid-template-rows 0fr → 1fr
//   - inner content fades in 80ms behind the row open

const steps = [
  {
    n: "01",
    title: "Want",
    body: "Fuzzy human intent. A CI runner. A collection to organise. Photos to sync.",
  },
  {
    n: "02",
    title: "Talk",
    body: "A conversation with an agent, a hand-authored draft, or a direct verb call. The platform does not care which.",
  },
  {
    n: "03",
    title: "Plan",
    body: "A canonical artifact emerges. Plain Nix, plain YAML, plain verb invocations. Byte-identical regardless of entrypoint.",
  },
  {
    n: "04",
    title: "Make",
    body: "Typed verbs hit the fleet. A host comes online. A secret rekeys. A service starts.",
  },
  {
    n: "05",
    title: "Keep",
    body: "git history is the audit trail. Any state is reproducible from any commit.",
  },
];
---

<section class="pipeline reveal-soft" id="pipeline" aria-labelledby="pipeline-h">
  <header class="pipeline__head">
    <p class="marginalia pipeline__chapter">
      <span class="dim">Ch&nbsp;</span>00 &middot; The pipeline
    </p>
    <h2 id="pipeline-h">From a want, to a&nbsp;thing.</h2>
    <p class="lede">
      Five steps from fuzzy intent to durable record. Hover (or tap) any
      step to see what the platform calls it underneath.
    </p>
  </header>

  <ol class="pipeline__steps" aria-label="Five-step flow">
    {steps.map((s) => (
      <li class="step">
        <details class="step__container">
          <summary class="step__summary">
            <span class="step__marker mono"><span class="dim">step&nbsp;</span>{s.n}</span>
            <h3 class="step__title">
              {s.title}
              <span class="step__rule" aria-hidden="true"></span>
            </h3>
            <span class="step__cue mono" aria-hidden="true">+</span>
          </summary>
          <div class="step__reveal">
            <p class="step__body">{s.body}</p>
          </div>
        </details>
      </li>
    ))}
  </ol>
</section>

<style>
  .pipeline {
    container-type: inline-size;
    padding-inline: clamp(1.25rem, 5cqi, 4rem);
    padding-block: clamp(4rem, 9cqi, 8rem);
    border-block-start: 1px solid var(--rule-soft);
  }

  .pipeline__head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-inline-size: var(--measure-wide);
    margin-block-end: clamp(2.5rem, 5cqi, 4rem);
  }

  .pipeline__chapter {
    color: var(--text-faint);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--t-xs);
  }
  .pipeline__chapter .dim { opacity: 0.55; }

  .pipeline__head h2 {
    font-size: var(--t-3xl);
    margin: 0;
  }

  .pipeline__head .lede { margin: 0; }

  /* ---- Steps grid ---- */
  .pipeline__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3cqi, 2.5rem);
    position: relative;
    align-items: start;
  }

  @container (inline-size > 56rem) {
    .pipeline__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: clamp(1rem, 2cqi, 1.6rem);
      row-gap: 0;
      padding-block-start: 1.6rem;
    }

    .pipeline__steps::before {
      content: "";
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      block-size: 1px;
      background: var(--rule);
      pointer-events: none;
    }
  }

  .step {
    position: relative;
    border-block-start: 1px solid var(--rule);
    padding-block-start: 1.2rem;
  }

  @container (inline-size > 56rem) {
    .step {
      border-block-start: 0;
      padding-block-start: 0;
    }
  }

  /* ---- The interactive container (details/summary) ---- */
  .step__container {
    /* native disclosure, no marker, our own affordance */
  }

  .step__container > summary {
    list-style: none;
    cursor: pointer;
  }

  .step__container > summary::-webkit-details-marker { display: none; }
  .step__container > summary::marker { display: none; }

  .step__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "marker cue"
      "title  cue";
    column-gap: 0.6rem;
    row-gap: 0.5rem;
    align-items: baseline;
  }

  .step__marker {
    grid-area: marker;
    font-size: var(--t-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1;
    margin: 0;
    transition: color var(--dur-quick) var(--ease);
  }

  .step__marker .dim {
    color: var(--text-faint);
    opacity: 0.55;
    margin-inline-end: 0.3em;
  }

  /* On wide viewports, lift the marker onto the parent's continuous
     hairline with a bg-color halo to mask the line behind it. */
  @container (inline-size > 56rem) {
    .step__marker {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      transform: translateY(-50%);
      background-color: var(--bg);
      padding-inline-end: 0.7em;
      padding-block: 0.05em;
      z-index: 2;
    }
  }

  .step__title {
    grid-area: title;
    --fr-soft: 40;
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 36, "wght" 460, "SOFT" var(--fr-soft), "WONK" 0;
    font-size: var(--t-2xl);
    line-height: 1;
    margin: 0;
    color: var(--text);
    position: relative;
    padding-block-end: 0.45rem;
    transition: --fr-soft var(--dur-medium) var(--ease);
  }

  @container (inline-size > 56rem) {
    .step__title {
      margin-block-start: 0.6rem;
    }
  }

  /* Underline rule that draws from 0 to 2.5em on hover/open — engineering tick. */
  .step__rule {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: 1px;
    background: var(--accent);
    transition: inline-size 380ms cubic-bezier(0.5, 0, 0.2, 1) 60ms;
  }

  /* Cue: + → × on open */
  .step__cue {
    grid-area: cue;
    align-self: end;
    color: var(--text-faint);
    font-size: var(--t-base);
    line-height: 1;
    transition:
      color var(--dur-quick) var(--ease),
      transform var(--dur-medium) cubic-bezier(0.34, 1.4, 0.64, 1);
    user-select: none;
  }

  /* ---- The reveal: opacity-only so layout never jumps -------------- *
   * The description is ALWAYS rendered (we override the browser's
   * `<details>:not([open])` hide), so the row reserves its full height
   * up-front. Click toggles [open] without shifting any neighbouring
   * cards. Hover and focus run the same effect.
   */
  .step__reveal {
    margin-block-start: 0.6rem;
    opacity: 0;
    transform: translateY(-3px);
    transition:
      opacity 280ms var(--ease) 80ms,
      transform 280ms var(--ease) 80ms;
    pointer-events: none;
  }

  /* Override <details>'s default content-hide so layout stays stable. */
  .step__container:not([open]) > .step__reveal {
    display: block;
  }

  .step__body {
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: 1.55;
    margin: 0;
    max-inline-size: 26ch;
  }

  /* ---- Reveal triggers: hover, focus-within, OR details[open] ---- */
  .step:hover .step__title,
  .step:focus-within .step__title,
  .step__container[open] .step__title {
    --fr-soft: 8;
  }

  .step:hover .step__rule,
  .step:focus-within .step__rule,
  .step__container[open] .step__rule {
    inline-size: 2.5em;
  }

  .step:hover .step__marker,
  .step:focus-within .step__marker,
  .step__container[open] .step__marker {
    color: var(--accent-strong);
  }

  .step:hover .step__cue,
  .step:focus-within .step__cue,
  .step__container[open] .step__cue {
    color: var(--accent);
    transform: rotate(45deg);
  }

  .step:hover .step__reveal,
  .step:focus-within .step__reveal,
  .step__container[open] .step__reveal {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ---- Reduced motion: snap, don't slide ---- */
  @media (prefers-reduced-motion: reduce) {
    .step__title, .step__rule, .step__cue,
    .step__reveal, .step__marker {
      transition: none !important;
    }
  }
</style>
