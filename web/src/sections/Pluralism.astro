---
// Pluralism — two axes (harness × abstraction) + a CSS-only convergence
// diagram showing plural entrypoints flowing through one canonical artifact.
import { Image } from "astro:assets";
import plateImg from "../assets/pluralism.png";
---

<section class="pluralism reveal-soft" id="pluralism" aria-labelledby="pluralism-h">
  <figure class="plate">
    <Image
      src={plateImg}
      alt=""
      widths={[768, 1024, 1376, 1920]}
      sizes="(min-width: 60rem) 80vw, 100vw"
      formats={["avif", "webp", "jpeg"]}
      quality={82}
      loading="lazy"
    />
  </figure>

  <header class="pluralism__head">
    <p class="marginalia pluralism__chapter">
      <span class="dim">Ch&nbsp;</span>02 &middot; Pluralism
    </p>
    <h2 id="pluralism-h">Two axes. One canonical&nbsp;artifact.</h2>
    <p class="lede">
      A single fixed abstraction excludes one population. A single
      fixed harness excludes most of the ecosystem. The architectural
      answer is plural along two axes — and byte-identical artifacts
      however you got there.
    </p>
  </header>

  <div class="pluralism__axes">
    <article class="axis">
      <p class="axis__label marginalia">Axis &middot; α</p>
      <h3>Harness pluralism</h3>
      <p>
        Multiple peer agent harnesses — Claude Code, opencode,
        Flue, a future local-model harness — sit behind an
        INSPR-defined protocol. None is the foundation of the
        platform. Each adapter is welcomed; none is owed.
      </p>
      <ul class="axis__list mono">
        <li>privacy &amp; IP — work that can&rsquo;t leave the machine</li>
        <li>availability — when a hosted vendor goes down or sanctions you</li>
        <li>local-model preference — running fully on your own iron</li>
      </ul>
    </article>

    <article class="axis">
      <p class="axis__label marginalia">Axis &middot; β</p>
      <h3>Abstraction pluralism</h3>
      <p>
        Multiple entrypoints — conversational agent, declarative
        authoring, direct verb calls — produce the same canonical
        artifacts. The agent never bypasses declarative. The user
        can always bypass the agent.
      </p>
      <ul class="axis__list mono">
        <li>collector — past what a spreadsheet can hold</li>
        <li>operator — declares every byte; reviews like a PR</li>
        <li>both — first-class on the same substrate</li>
      </ul>
    </article>
  </div>

  <figure class="convergence">
    <div
      class="convergence__board"
      role="img"
      aria-label="Three plural entrypoints — conversational agent, declarative authoring, direct verb calls — converge into one canonical artifact, which then fans out to fleet apply, git history, and audit replay."
    >
      <div class="convergence__col convergence__col--in">
        <span class="convergence__node">conversational agent</span>
        <span class="convergence__node">declarative authoring</span>
        <span class="convergence__node">direct verb calls</span>
      </div>

      <div class="convergence__pivot-wrap" aria-hidden="true">
        <span class="convergence__pivot">canonical&nbsp;artifact</span>
      </div>

      <div class="convergence__col convergence__col--out">
        <span class="convergence__node">fleet apply</span>
        <span class="convergence__node">git history</span>
        <span class="convergence__node">audit / replay</span>
      </div>
    </div>

    <figcaption class="convergence__cap marginalia">
      The platform&rsquo;s currency is declarative artifacts and typed verbs.
      Humans and agents both spend it. Nobody has a private mint.
    </figcaption>
  </figure>
</section>

<style>
  .pluralism {
    container-type: inline-size;
    padding-inline: clamp(1.25rem, 5cqi, 4rem);
    padding-block: clamp(4rem, 9cqi, 8rem);
    border-block-start: 1px solid var(--rule-soft);
  }

  .pluralism__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-inline-size: var(--measure-wide);
    margin-block-end: clamp(2.5rem, 5cqi, 4.5rem);
  }

  .pluralism__chapter {
    color: var(--text-faint);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--t-xs);
  }
  .pluralism__chapter .dim { opacity: 0.55; }

  .pluralism__head h2 {
    font-size: var(--t-3xl);
    margin: 0;
  }

  .pluralism__head .lede { margin: 0; }

  /* ---- Axis cards ---- */
  .pluralism__axes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4cqi, 3rem);
    margin-block-end: clamp(3rem, 6cqi, 5rem);
  }

  @container (inline-size > 50rem) {
    .pluralism__axes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 5cqi, 4rem);
    }
  }

  .axis {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-block-start: 1px solid var(--rule);
    padding-block-start: 1.4rem;
  }

  .axis__label {
    color: var(--accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: var(--t-xs);
    margin: 0;
  }

  .axis h3 { margin: 0; }

  .axis p {
    color: var(--text-muted);
    margin: 0;
    max-inline-size: 48ch;
  }

  .axis__list {
    list-style: none;
    padding: 0 0 0 0.9em;
    margin: 0.4rem 0 0;
    color: var(--text-faint);
    display: grid;
    gap: 0.55em;
    font-size: var(--t-sm);
    border-inline-start: 1px solid var(--rule-soft);
  }

  /* ---- Convergence diagram ---- */
  .convergence {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  .convergence__board {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: clamp(1.5rem, 3cqi, 2.5rem);
    border: 1px solid var(--rule-soft);
    background-color: var(--bg-raised);
    border-radius: 6px;
    container-type: inline-size;
    position: relative;
    overflow: hidden;
  }

  @container (inline-size > 44rem) {
    .convergence__board {
      grid-template-columns: 1fr auto 1fr;
      gap: clamp(1.5rem, 4cqi, 3rem);
    }
  }

  /* Pills are auto-width and align to the inner edge of their column,
     so the gap between pill and pivot reads as flow without literal
     arrows. A tiny hairline at each pill's inner edge points toward
     the pivot — engineered tick, not arrowhead. */
  .convergence__col {
    display: grid;
    gap: 0.7rem;
  }

  .convergence__col--in   { justify-items: stretch; }
  .convergence__col--out  { justify-items: stretch; }

  @container (inline-size > 44rem) {
    .convergence__col--in   { justify-items: end; }
    .convergence__col--out  { justify-items: start; }
  }

  .convergence__col--in .convergence__node,
  .convergence__col--out .convergence__node {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--text-muted);
    padding: 0.5em 0.85em;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background-color: var(--bg);
    inline-size: fit-content;
    position: relative;
    transition: border-color var(--dur-quick) var(--ease),
                color var(--dur-quick) var(--ease);
  }

  .convergence__col--in .convergence__node:hover,
  .convergence__col--out .convergence__node:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  /* Inner-edge tick marks: 1px hairline pointing toward the pivot. */
  @container (inline-size > 44rem) {
    .convergence__col--in .convergence__node::after,
    .convergence__col--out .convergence__node::before {
      content: "";
      position: absolute;
      inset-block-start: 50%;
      inline-size: clamp(0.8rem, 2cqi, 1.6rem);
      block-size: 1px;
      background: var(--rule);
      transform: translateY(-50%);
      pointer-events: none;
    }
    .convergence__col--in .convergence__node::after {
      inset-inline-start: calc(100% + 0.4em);
    }
    .convergence__col--out .convergence__node::before {
      inset-inline-end: calc(100% + 0.4em);
    }
  }

  .convergence__pivot-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .convergence__pivot {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 460, "SOFT" 50, "WONK" 0;
    font-size: var(--t-xl);
    color: var(--accent-strong);
    text-align: center;
    padding: clamp(0.7rem, 2cqi, 1.2rem) clamp(1rem, 3cqi, 1.8rem);
    border: 1px solid var(--accent);
    border-radius: 4px;
    background-color: oklch(from var(--accent) l c h / 0.06);
    white-space: nowrap;
    line-height: 1;
  }

  .convergence__cap {
    color: var(--text-faint);
    max-inline-size: 56ch;
    text-align: center;
    margin-inline: auto;
    line-height: 1.55;
  }
</style>
